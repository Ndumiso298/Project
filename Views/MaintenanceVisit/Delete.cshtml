@model MaintenanceVisit

@{
    Layout = "_CustomerLayout";
}
<h2>Delete Visit</h2>

<p>
    Are you sure you want to delete this visit scheduled on
    <strong>@Model.ScheduledDate.ToString("yyyy-MM-dd")</strong>
    for customer <strong>@Model.Customer?</strong>?
</p>


@using (Html.BeginForm("DeleteConfirmed", "MaintenanceVisit", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaintenanceVisitId)

    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary ms-2" })
}
