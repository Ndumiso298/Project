@model Project.Models.MaintenanceVisit

@{
    ViewBag.Title = "Maintenance Visit Details";
}

<h2>Maintenance Visit Details</h2>

<div>
    <strong>Scheduled Date:</strong> @Model.ScheduledDate.ToString("yyyy-MM-dd")<br />
    <strong>Status:</strong> @Model.Status<br />
    <strong>Customer:</strong> @Model.Customer?.TradingName<br />
    <strong>Technician:</strong> @Model.Technician?.UserAccount.FirstName<br />
    <strong>Technician:</strong> @Model.Technician?.UserAccount.LastName<br />
    <strong>Fridge Serial:</strong> @Model.Fridge?.SerialNumber<br />
    <strong>Fridge Model:</strong> @Model.Fridge?.Model<br />
</div>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.MaintenanceVisitId }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
</p>
