@model Project.Models.MaintenanceVisit
@{
    Layout = null; // Optional: remove layout for clean print
    var daysUntilDue = (Model.ScheduledDate - DateTime.Now).Days;
    var isOverdue = Model.ScheduledDate < DateTime.Now;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Maintenance Visit Summary</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
   
</head>
<body class="p-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Maintenance Visit Summary</h2>
            <button class="btn btn-outline-primary no-print" onclick="window.print()">🖨️ Print</button>
        </div>

        <div class="mb-3">
            <strong>Visit ID:</strong> @Model.MaintenanceVisitId<br />
            <strong>Scheduled Date:</strong> @Model.ScheduledDate.ToString("yyyy-MM-dd HH:mm")<br />
            <strong>Status:</strong> @Model.Status
            @if (isOverdue)
            {
                <span class="badge bg-danger ms-2">Overdue</span>
            }
            else if (Model.Status == "In Progress" && daysUntilDue <= 2)
            {
                <span class="badge bg-warning text-dark ms-2">Due in @daysUntilDue days</span>
            }
        </div>

        <hr />

        <div class="mb-3">
            <h5>Technician</h5>
            <p>
                <strong>Name:</strong> @Model.Technician?.UserAccount.FirstName<br />
                <strong>Name:</strong> @Model.Technician?.UserAccount.LastName<br />
                <strong>Phone:</strong> @Model.Technician?.UserAccount.PhoneNumber
            </p>
        </div>

        <div class="mb-3">
            <h5>Fridge Details</h5>
            <p>
                <strong>Serial Number:</strong> @Model.Fridge?.SerialNumber<br />
                <strong>Model:</strong> @Model.Fridge?.Model
            </p>
        </div>

        <div class="mb-3">
            <h5>Customer Note</h5>
            <p class="border p-2 bg-light">@Model.CustomerNote</p>
        </div>

        <div class="mb-3">
            <h5>Technician Note</h5>
            <p class="border p-2">@Model.TechnicianNotes</p>
        </div>

        <hr class="my-4" />

        <footer class="text-muted small">
            Generated on @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
        </footer>
    </div>
</body>
</html>
