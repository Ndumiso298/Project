@using Project.Utilities.Enums
@model Project.Models.FridgeFault

@{
    ViewData["Title"] = "FridgeFault Details";
    string statusClass = Model.Status switch
    {
        FaultStatus.Resolved => "success",
        FaultStatus.InProgress => "warning",
        FaultStatus.Reported => "danger",
        _ => "secondary"
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Fault Details
        </h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary me-2">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <button type="button" class="btn btn-outline-secondary me-2" onclick="window.print()">
                <i class="bi bi-printer"></i> Print
            </button>
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Fault Summary -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-semibold">
            <i class="bi bi-info-circle me-2"></i> Fault Summary
        </div>
        <div class="card-body">
            <p><strong>Reported Date:</strong> @Model.ReportedDate.ToString("yyyy-MM-dd HH:mm")</p>
            <p>
                <strong>Status:</strong>
                <span class="badge bg-@statusClass">@Model.Status</span>
            </p>
            <p><strong>Severity:</strong> <span class="badge bg-danger">@Model.Priority</span></p>
            <p><strong>Resolved Date:</strong> @(Model.ResolvedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p>
            <p><strong>Resolved By:</strong> @(Model.AssignedTechnician?.UserAccount.FirstName ?? "—")</p>
            <p><strong>Resolved By:</strong> @(Model.AssignedTechnician?.UserAccount.LastName ?? "—")</p>
            <p><strong>Resolution Notes:</strong> @(string.IsNullOrWhiteSpace(Model.ResolutionNotes) ? "—" : Model.ResolutionNotes)</p>
        </div>
    </div>

    <!-- Fridge Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white fw-semibold">
            <i class="bi bi-box-seam me-2"></i> Fridge Information
        </div>
        <div class="card-body">
            <p><strong>Model:</strong> @Model.Fridge?.Model</p>
            <p><strong>Serial:</strong> @Model.Fridge?.SerialNumber</p>
        </div>
    </div>

    <!-- Customer Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-semibold">
            <i class="bi bi-person-fill me-2"></i> Customer Information
        </div>
        <div class="card-body">
            <p><strong>First Name:</strong> @Model.ReportedBy?.Customer.UserAccount.FirstName</p>
            <p><strong>Last Name:</strong> @Model.ReportedBy?.Customer.UserAccount.LastName</p>
            <p><strong>AddressLine1:</strong> @Model.ReportedBy?.Customer.AddressLine1</p>
            <p><strong>AddressLine2:</strong> @Model.ReportedBy?.Customer.AddressLine2</p>
            <p><strong>City:</strong> @Model.ReportedBy?.Customer.City</p>
            <p><strong>Province:</strong> @Model.ReportedBy?.Customer.Province</p>
            <p><strong>Postal Code:</strong> @Model.ReportedBy?.Customer.PostalCode</p>
        </div>
    </div>
</div>

@section Scripts {
   
}
