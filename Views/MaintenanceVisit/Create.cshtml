@model Project.Models.Fault

@{
    ViewData["Title"] = "Fault Details";
    Layout = "_CustomerLayout";
    string statusClass = Model.Status switch
    {
        "Resolved" => "success",
        "In Progress" => "warning",
        "Reported" => "danger",
        _ => "secondary"
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> Fault Details
        </h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.FaultId" class="btn btn-outline-primary me-2">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <button type="button" class="btn btn-outline-secondary me-2" onclick="window.print()">
                <i class="bi bi-printer"></i> Print
            </button>
            <a asp-action="Index" class="btn btn-outline-dark">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Fault Summary -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-semibold">
            <i class="bi bi-info-circle me-2"></i> Fault Summary
        </div>
        <div class="card-body">
            <p><strong>Reported Date:</strong> @Model.ReportedAt.ToString("yyyy-MM-dd HH:mm")</p>
            <p>
                <strong>Status:</strong>
                <span class="badge bg-@statusClass">@Model.Status</span>
            </p>
            <p><strong>Severity:</strong> <span class="badge bg-danger">@Model.Severity</span></p>
            <p><strong>Resolved Date:</strong> @(Model.ResolvedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</p>
            <p><strong>Resolved By:</strong> @(Model.ResolvedByTechnician?.Name ?? "—")</p>
            <p><strong>Resolution Notes:</strong> @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</p>
        </div>
    </div>

    <!-- Fridge Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white fw-semibold">
            <i class="bi bi-box-seam me-2"></i> Fridge Information
        </div>
        <div class="card-body">
            <p><strong>Model:</strong> @Model.Fridge?.Model</p>
            <p><strong>Serial:</strong> @Model.Fridge?.FridgeNo</p>
            <p><strong>Location:</strong> @Model.Location</p>
        </div>
    </div>

    <!-- Customer Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-semibold">
            <i class="bi bi-person-fill me-2"></i> Customer Information
        </div>
        <div class="card-body">
            <p><strong>Name:</strong> @Model.ReportedByCustomer?.Name</p>
            <p><strong>Address:</strong> @Model.ReportedByCustomer?.Address</p>
            <p><strong>Customer Note:</strong> @(string.IsNullOrWhiteSpace(Model.ReportedByCustomer?.CustomerNote) ? "—" : Model.ReportedByCustomer.CustomerNote)</p>
        </div>
    </div>
</div>

@section Scripts {
   
}
