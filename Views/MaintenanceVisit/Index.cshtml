@* @model IEnumerable<Project.Models.MaintenanceVisit>

@{
    ViewBag.Title = "Maintenance Visits";
    

    Layout = "_CustomerLayout";

    var visits = Model.ToList();


    var totalMaintenanceVisits = visits.Count();
    var completedVisits = visits.Count(v => v.Status == "Completed");
    var upcomingVisits = visits.Count(v => v.ScheduledDate > DateTime.Now && v.Status != "Completed");
}

<div class="container mt-4">
    <h2 class="mb-4">Maintenance Visits</h2>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary">Total Visits</h5>
                    <p class="fs-4 fw-bold">@totalMaintenanceVisits</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center">
                    <h5 class="card-title text-success">Completed</h5>
                    <p class="fs-4 fw-bold">@completedVisits</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <h5 class="card-title text-warning">Upcoming</h5>
                    <p class="fs-4 fw-bold">@upcomingVisits</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <!-- Search -->
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by Customer, Technician, or Fridge"
                           value="@ViewBag.Search" />
                </div>
                @{
                    var statuses = new List<string> { "Scheduled", "In Progress", "Completed", "Cancelled" };
                    var selectedStatus = ViewBag.Status?.ToString();
                }

                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedStatus) ? "selected" : null)">-- Filter by Status --</option>
                        @foreach (var status in statuses)
                        {
                            <option value="@status" selected="@(status == selectedStatus ? "selected" : null)">@status</option>
                        }
                    </select>
                </div>
                <!-- Date Range -->
                <div class="col-md-2">
                    <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                </div>
               

                <!-- Buttons -->
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
                <div class="col-md-1 d-grid">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Visits Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Scheduled Date</th>
                       
                        <th>Status</th>
                        <th>Customer</th>
                        <th>Location</th>
                        <th>Customer Note</th>
                        <th>Technician</th>
                        <th>Fridge Serial</th>
                        <th>Fridge Model</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visit in visits)
                    {
                        <tr>
                            <td>@visit.ScheduledDate.ToString("yyyy-MM-dd")</td>
                            
                            <td>
                                <span class="badge 
                                    @(visit.Status == "Completed" ? "bg-success" : 
                                      visit.Status == "In Progress" ? "bg-info text-dark" : 
                                      visit.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                                    @visit.Status
                                </span>
                            </td>
                            <td>@visit.Customer?.Name</td>
                            <td>@visit.Customer?.Address</td>
                        <td>
                           
                            <span class="text-secondary">@visit.CustomerNote</span>
                        </td>


            
                       <td> @visit.Technician?.Name
                        <br />
                                                   
                        <small class="text-muted">@visit.Technician?.Phone</small>
                        </td>

                            <td>@visit.Fridge?.FridgeNo</td>
                            <td>@visit.Fridge?.Model</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center flex-wrap gap-2">
                                    <!-- Delete -->
                                    <a asp-controller="MaintenanceVisit" asp-action="Delete" asp-route-id="@visit.MaintenanceVisitId"
                                       class="btn btn-outline-danger btn-sm" title="Delete"
                                       onclick="return confirm('Are you sure you want to delete this visit?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>

                                    <!-- Edit -->
                                    <a asp-controller="MaintenanceVisit" asp-action="Edit" asp-route-id="@visit.MaintenanceVisitId"
                                       class="btn btn-outline-warning btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                   
                                   

                                    <!-- Create Fault -->
                                    <a asp-action="Create" asp-controller="Fault" asp-route-maintenanceVisitId="@visit.MaintenanceVisitId"
                                        class="btn btn-outline-info btn-sm" title="create fault">

                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                  </a>

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
 *@