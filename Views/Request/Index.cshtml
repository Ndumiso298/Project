@model IEnumerable<Project.Models.RequestHeader>
@using Project.Utility

@{
    ViewData["Title"] = "Requests";
    var isSupport = ViewBag.IsSupport ?? false;
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="h3 fw-bold text-gray-800 mb-1">
                <i class="fas fa-list-alt text-primary me-2"></i>@(isSupport ? "All Requests" : "My Requests")
            </h1>
            <p class="text-muted mb-0">@(isSupport ? "Manage and monitor all customer requests" : "Track and manage your fridge requests")</p>
        </div>
        
    </div>

    <!-- Support Dashboard Cards -->
    @if (isSupport)
    {
        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-4 border-start-primary shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs fw-semibold text-primary text-uppercase mb-1">Pending Requests</div>
                                <div class="h5 fw-bold text-gray-800 mb-0">@ViewBag.TotalPending</div>
                                <div class="text-xs text-muted">Awaiting review</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-clock fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-4 border-start-success shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs fw-semibold text-success text-uppercase mb-1">Approved</div>
                                <div class="h5 fw-bold text-gray-800 mb-0">@ViewBag.TotalApproved</div>
                                <div class="text-xs text-muted">Completed requests</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-4 border-start-danger shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs fw-semibold text-danger text-uppercase mb-1">Rejected</div>
                                <div class="h5 fw-bold text-gray-800 mb-0">@ViewBag.TotalRejected</div>
                                <div class="text-xs text-muted">Declined requests</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-times-circle fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-start-4 border-start-warning shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="flex-grow-1">
                                <div class="text-xs fw-semibold text-warning text-uppercase mb-1">Relaunched</div>
                                <div class="h5 fw-bold text-gray-800 mb-0">@ViewBag.TotalRelaunched</div>
                                <div class="text-xs text-muted">Resubmitted requests</div>
                            </div>
                            <div class="flex-shrink-0">
                                <i class="fas fa-redo fa-2x text-gray-300"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-bottom-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-semibold text-gray-800">
                    <i class="fas fa-filter text-primary me-2"></i>Filter Requests
                </h6>
                @if (!string.IsNullOrEmpty(selectedStatus))
                {
                    <span class="badge bg-light text-dark">
                        Filtered by: @selectedStatus
                        <a href="@Url.Action("Index")" class="text-danger ms-2">
                            <i class="fas fa-times"></i>
                        </a>
                    </span>
                }
            </div>
        </div>
        <div class="card-body pt-0">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4 col-lg-3">
                    <label class="form-label small fw-semibold text-muted">STATUS</label>
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        <option value="@SD.Pending" selected="@(selectedStatus == SD.Pending)">Pending</option>
                        <option value="@SD.Approved" selected="@(selectedStatus == SD.Approved)">Approved</option>
                        <option value="@SD.Rejected" selected="@(selectedStatus == SD.Rejected)">Rejected</option>
                    </select>
                </div>
                <div class="col-md-8 col-lg-9">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-search me-2"></i>Apply Filter
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="fas fa-refresh me-2"></i>Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-semibold text-gray-800">
                    <i class="fas fa-list text-primary me-2"></i>Request List
                    <span class="badge bg-primary ms-2">@Model.Count()</span>
                </h6>
                @if (isSupport && Model.Any())
                {
                    <div class="text-muted small">
                        Showing @Model.Count() request@(Model.Count() > 1 ? "s" : "")
                    </div>
                }
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="py-5">
                        <i class="fas fa-inbox fa-4x text-gray-300 mb-4"></i>
                        <h5 class="text-gray-500 mb-2">No requests found</h5>
                        <p class="text-muted mb-4">
                            @(isSupport ? "There are no requests matching your current filter criteria." : "You haven't made any requests yet.")
                        </p>
                        @if (!isSupport)
                        {
                            <a href="@Url.Action("CreateFridgeRequest")" class="btn btn-primary px-4">
                                <i class="fas fa-plus-circle me-2"></i>Create Your First Request
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                                <i class="fas fa-refresh me-2"></i>Clear Filters
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Requests Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 ps-4 fw-semibold text-muted text-uppercase small">Request ID</th>
                                <th class="border-0 fw-semibold text-muted text-uppercase small">Date</th>
                                @if (isSupport)
                                {
                                    <th class="border-0 fw-semibold text-muted text-uppercase small">Customer</th>
                                }
                                <th class="border-0 fw-semibold text-muted text-uppercase small text-center">Items</th>
                                <th class="border-0 fw-semibold text-muted text-uppercase small text-end">Total</th>
                                <th class="border-0 fw-semibold text-muted text-uppercase small">Status</th>
                                <th class="border-0 fw-semibold text-muted text-uppercase small text-center pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <span class="fw-bold text-gray-800">#@request.RequestHeaderId</span>
                                            @if (request.IsRelaunched)
                                            {
                                                <span class="badge bg-warning text-dark ms-2" title="Relaunched request">
                                                    <i class="fas fa-redo fa-xs me-1"></i>Relaunched
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-gray-800">@request.RequestDate.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted">@request.RequestDate.ToString("hh:mm tt")</small>
                                    </td>
                                    @if (isSupport)
                                    {
                                        <td>
                                            <div class="fw-medium text-gray-800">@request.FirstName @request.LastName</div>
                                            <small class="text-muted">@request.CellNumber</small>
                                        </td>
                                    }
                                    <td class="text-center">
                                        <span class="badge bg-primary rounded-pill">
                                            @request.RequestFridges.Sum(d => d.Count) item@(request.RequestFridges.Sum(d => d.Count) > 1 ? "s" : "")
                                        </span>
                                    </td>
                                    <td class="text-end fw-semibold text-gray-800 pe-4">
                                        @request.RequestTotal.ToString("C")
                                    </td>
                                    <td>
                                        @{
                                            var statusConfig = request.Status switch
                                            {
                                                SD.Pending => new { bgClass = "bg-warning", icon = "fa-clock", text = "Pending" },
                                                SD.Approved => new { bgClass = "bg-success", icon = "fa-check", text = "Approved" },
                                                SD.Rejected => new { bgClass = "bg-danger", icon = "fa-times", text = "Rejected" },
                                                _ => new { bgClass = "bg-secondary", icon = "fa-question", text = request.Status }
                                            };
                                        }
                                        <span class="badge @statusConfig.bgClass text-white rounded-pill d-inline-flex align-items-center">
                                            <i class="fas @statusConfig.icon fa-xs me-1"></i>
                                            @statusConfig.text
                                        </span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="@Url.Action("Details", new { id = request.RequestHeaderId })"
                                               class="btn btn-outline-primary rounded-start-2"
                                               title="View Details"
                                               data-bs-toggle="tooltip">
                                                <i class="fas fa-eye"></i>
                                                <span class="d-none d-md-inline ms-1">Details</span>
                                            </a>
                                            @if (isSupport && request.Status == SD.Pending)
                                            {
                                                <a href="@Url.Action("Details", new { id = request.RequestHeaderId })"
                                                   class="btn btn-outline-success rounded-end-2"
                                                   title="Quick Action"
                                                   data-bs-toggle="tooltip">
                                                    <i class="fas fa-bolt"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model.Any() && Model.Count() > 10)
        {
            <!-- Table Footer -->
            <div class="card-footer bg-transparent border-top-0 py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted small">
                        Showing @Model.Count() request@(Model.Count() > 1 ? "s" : "")
                    </div>
                    @if (isSupport)
                    {
                        <div class="text-muted small">
                            <i class="fas fa-info-circle me-1"></i>
                            Click on Details to manage requests
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: 1px solid #e3e6f0;
        }

        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }

        .border-start-4 {
            border-left-width: 4px !important;
        }

        .btn-group .btn {
            border-radius: 0.375rem;
        }

            .btn-group .btn:first-child {
                border-top-right-radius: 0;
                border-bottom-right-radius: 0;
            }

            .btn-group .btn:last-child {
                border-top-left-radius: 0;
                border-bottom-left-radius: 0;
            }

        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
        }
    </style>
}

@section Scripts {
    <script>
        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}