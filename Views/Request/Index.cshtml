@model IEnumerable<Project.Models.RequestHeader>
@using Project.Utility

@{
    ViewData["Title"] = "Fridge Requests";
    var isSupport = User.IsInRole(SD.CustomerSupport) || User.IsInRole(SD.AdminRole);
    var isCustomer = User.IsInRole(SD.CustomerRole);
}

<h2 class="text-primary mb-4">Fridge Requests</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Request #</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total (R)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.RequestHeaderId</td>
                <td>@(r.Customer?.ApplicationUser?.FirstName + " " + r.Customer?.ApplicationUser?.LastName)</td>
                <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge
                            @(r.Status == SD.Approved ? "bg-success" :
                                                    r.Status == SD.Rejected ? "bg-danger" :
                                                    r.Status == SD.Relaunched ? "bg-warning text-dark" :
                                                    "bg-secondary")">
                    @r.Status
                </span>
            </td>
            <td>@r.RequestTotal.ToString("N2")</td>
            <td>
                <a asp-action="Details" asp-route-id="@r.RequestHeaderId" class="btn btn-sm btn-outline-primary">View</a>

                @if (isSupport && r.Status == SD.Pending)
                    {
                        <button class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal" data-id="@r.RequestHeaderId">Approve</button>
                        <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#declineModal" data-id="@r.RequestHeaderId">Decline</button>
                    }

                    @if (isCustomer && r.Status == SD.Rejected)
                    {
                        <form asp-action="Relaunch" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@r.RequestHeaderId" />
                            <button type="submit" class="btn btn-sm btn-warning">Relaunch</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- ==================== Approve Modal ==================== -->
<div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Approve" method="post">
            <input type="hidden" id="approveRequestId" name="id" />
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="approveModalLabel">Approve Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to approve this request?
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Confirm</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- ==================== Decline Modal ==================== -->
<div class="modal fade" id="declineModal" tabindex="-1" aria-labelledby="declineModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Decline" method="post">
            <input type="hidden" id="declineRequestId" name="id" />
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="declineModalLabel">Decline Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label for="declineReason" class="form-label">Reason for Declining:</label>
                    <textarea name="declineReason" id="declineReason" class="form-control" rows="3" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">Decline</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-fill request IDs into modals
        const approveModal = document.getElementById('approveModal');
        approveModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            document.getElementById('approveRequestId').value = button.getAttribute('data-id');
        });

        const declineModal = document.getElementById('declineModal');
        declineModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            document.getElementById('declineRequestId').value = button.getAttribute('data-id');
        });
    </script>
}
