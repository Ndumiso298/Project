@model IEnumerable<Project.Models.RequestHeader>
@{
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Customer Orders</h2>
                    <p class="text-muted">Track and manage fridge Orders</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 font-weight-bold text-primary">Request List</h5>

            <input type="text" id="requestSearch" class="form-control form-control-sm w-25 ms-auto"
                   placeholder="Search requests...">
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="requestTable">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Customer Name</th>
                            <th scope="col">Customer Surname</th>
                            <th scope="col">Status</th>
                            <th scope="col">Request Date</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold align-middle">
                                    @item.Customer.ApplicationUser?.FirstName
                                </td>
                                <td class="align-middle">
                                    @item.Customer.ApplicationUser?.LastName
                                </td>
                                <td class="align-middle">
                                    @if (item.Status == "Needs Feedback")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-hourglass-split me-1"></i> Needs Feedback
                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                            <i class="bi bi-question-circle me-1"></i> Unknown
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @item.RequestDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.RequestHeaderId"
                                           class="btn btn-sm btn-outline-primary rounded me-2 d-flex align-items-center">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>

                                        <!-- Fault Report Button -->
                                        @if (item.Status == "Approved")
                                        {
                                            <a asp-controller="FaultTechnician"
                                               asp-action="CustomerFaultReport"
                                               asp-route-visitId="@item.RequestHeaderId"
                                               class="btn btn-sm btn-outline-warning rounded me-2 d-flex align-items-center">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Report Fault
                                            </a>
                                        }

                                        <!-- Replacement Button (if you still want this) -->
                                        <a asp-controller="Replacement"
                                           asp-action="RequestReplacement"
                                           asp-route-visitId="@item.RequestHeaderId"
                                           class="btn btn-sm btn-outline-success rounded d-flex align-items-center">
                                            <i class="bi bi-arrow-repeat me-1"></i> Replace
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard-data display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No Requests Found</h4>
                        <p class="text-muted">Once customers submit requests, they'll appear here</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectionModal" tabindex="-1" aria-labelledby="rejectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="rejectionModalLabel">
                    <i class="bi bi-x-circle-fill me-2"></i>Reject Request
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="rejectForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="requestId" name="requestId" />
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label fw-semibold">Reason for Rejection</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason"
                                  rows="4" placeholder="Please provide the reason for rejecting this request..."
                                  required maxlength="500"></textarea>
                        <div class="form-text">
                            <span id="charCount">0</span>/500 characters
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Search functionality
        document.getElementById('requestSearch').addEventListener('input', function() {
            const searchText = this.value.toLowerCase();
            const rows = document.querySelectorAll('#requestTable tbody tr');

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchText) ? '' : 'none';
            });
        });

        // Character count for rejection reason
        document.getElementById('rejectionReason')?.addEventListener('input', function() {
            document.getElementById('charCount').textContent = this.value.length;
        });

        // Set request ID when opening rejection modal
        function setRejectionRequestId(requestId) {
            document.getElementById('requestId').value = requestId;
        }
    </script>
}