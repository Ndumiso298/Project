@model IEnumerable<Project.Models.RequestHeader>
@{
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Customer Requests</h2>
                    <p class="text-muted">Track and manage fridge requests</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Request List Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 font-weight-bold text-primary">Request List</h5>

            <!-- Search Box -->
            <input type="text" id="requestSearch" class="form-control form-control-sm w-25 ms-auto"
                   placeholder="Search requests...">
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="requestTable">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Customer Name</th>
                            <th scope="col">Customer Surname</th>
                            <th scope="col">Status</th>
                            <th scope="col">Request Date</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold align-middle">
                                    @item.ApplicationUser?.FirstName
                                </td>
                                <td class="align-middle">
                                    @item.ApplicationUser?.LastName
                                </td>
                                <td class="align-middle">
                                    @if (item.Status == "Waiting For Payment")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-hourglass-split me-1"></i> Waiting For Payment
                                        </span>
                                    }
                                    else if (item.Status == "Allocated")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> Allocated
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                            <i class="bi bi-question-circle me-1"></i> Unknown
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @item.RequestDate.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.RequestHeaderId"
                                           class="btn btn-sm btn-outline-primary rounded me-2 d-flex align-items-center">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard-data display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No Requests Found</h4>
                        <p class="text-muted">Once customers submit requests, they’ll appear here</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('requestSearch');
            const rows = document.querySelectorAll('#requestTable tbody tr');

            searchInput.addEventListener('keyup', function () {
                const searchText = this.value.toLowerCase();

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });
       
    <partial name="_ValidationScriptsPartial" />

    </script>
}
