@model IEnumerable<Project.Models.RequestHeader>
@using System.Security.Claims
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Order Management";

    // Get user role for conditional rendering
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userRole = claimsIdentity.FindFirst(ClaimTypes.Role)?.Value;
    var isCustomer = userRole == "Customer";
    var isCustomerSupport = userRole == "CustomerSupport" || userRole == "Admin";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">Order Management</h1>
                    <p class="text-muted mb-0">Track and manage your refrigerator rental orders</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Order Status Filter -->
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                                id="statusFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-filter me-2"></i>Filter by Status
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="statusFilterDropdown">
                            <li><a class="dropdown-item filter-option" href="#" data-filter="all">All Orders</a></li>
                            <li><a class="dropdown-item filter-option" href="#" data-filter="Needs Feedback">Pending Review</a></li>
                            <li><a class="dropdown-item filter-option" href="#" data-filter="Approved">Approved</a></li>
                            <li><a class="dropdown-item filter-option" href="#" data-filter="Rejected">Rejected</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-primary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Orders</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-clipboard-data fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-success shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Approved</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.Count(r => r.Status == "Approved")</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-warning shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Pending</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.Count(r => r.Status == "Needs Feedback")</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-clock-history fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-danger shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-danger text-uppercase mb-1">Rejected</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.Count(r => r.Status == "Rejected")</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-x-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 fw-bold text-primary">
                <i class="bi bi-list-ul me-2"></i>Order Records
            </h5>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 300px;">
                    <span class="input-group-text bg-transparent">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" id="orderSearch" class="form-control border-start-0"
                           placeholder="Search orders by customer, status...">
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="orderTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 fw-semibold text-muted small text-uppercase">Order Details</th>
                            <th class="fw-semibold text-muted small text-uppercase">Customer</th>
                            <th class="fw-semibold text-muted small text-uppercase">Status</th>
                            <th class="fw-semibold text-muted small text-uppercase">Order Date</th>
                            <th class="text-end pe-4 fw-semibold text-muted small text-uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                        {
                            <tr class="order-row" data-status="@item.Status?.ToLower()">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-2 p-2 me-3">
                                            <i class="bi bi-refrigerator text-primary fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">Order #@item.RequestHeaderId</h6>
                                            <small class="text-muted">Refrigerator Rental</small>
                                            @if (item.IsRelaunched)
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-arrow-clockwise me-1"></i>Relaunched
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <h6 class="fw-semibold mb-0">@item.Customer?.ApplicationUser?.FirstName @item.Customer?.ApplicationUser?.LastName</h6>
                                        <small class="text-muted">@item.Customer?.CustomerNumber</small>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Needs Feedback")
                                    {
                                        <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-hourglass-split me-1"></i> Under Review
                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Approved
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-question-circle me-1"></i> @item.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold text-dark">@item.RequestDate.ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted">@item.RequestDate.ToString("hh:mm tt")</small>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.RequestHeaderId"
                                           class="btn btn-sm btn-outline-primary rounded-3 me-2 px-3"
                                           data-bs-toggle="tooltip" data-bs-title="View Order Details">
                                            <i class="bi bi-eye me-1"></i> Details
                                        </a>

                                        <!-- Relaunch Button for Rejected Requests - CUSTOMER ONLY -->
                                        @if (isCustomer && item.Status == "Rejected" && !item.IsRelaunched)
                                        {
                                            <a asp-action="RelaunchRequest" asp-route-id="@item.RequestHeaderId"
                                               class="btn btn-sm btn-outline-info rounded-3 me-2 px-3"
                                               data-bs-toggle="tooltip" data-bs-title="Relaunch This Request with Additional Information">
                                                <i class="bi bi-arrow-clockwise me-1"></i> Relaunch
                                            </a>
                                        }

                                        <!-- Fault Report Button - CUSTOMER ONLY -->
                                        @if (isCustomer && item.Status == "Approved")
                                        {
                                            <a asp-controller="FaultTechnician" asp-action="CustomerFaultReport"
                                               asp-route-visitId="@item.RequestHeaderId"
                                               class="btn btn-sm btn-outline-warning rounded-3 me-2 px-3"
                                               data-bs-toggle="tooltip" data-bs-title="Report Equipment Issue">
                                                <i class="bi bi-exclamation-triangle me-1"></i> Report Issue
                                            </a>
                                        }

                                        <!-- Admin/Customer Support Actions -->
                                        @if (isCustomerSupport)
                                        {
                                            <!-- Add any admin-specific actions here -->
                                            <a asp-action="Details" asp-route-id="@item.RequestHeaderId"
                                               class="btn btn-sm btn-outline-secondary rounded-3 me-2 px-3"
                                               data-bs-toggle="tooltip" data-bs-title="Manage Request">
                                                <i class="bi bi-gear me-1"></i> Manage
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="py-5">
                            <i class="bi bi-clipboard-x display-1 text-muted opacity-50"></i>
                            <h4 class="mt-4 text-muted fw-semibold">No Orders Found</h4>
                            <p class="text-muted mb-4">Customer orders will appear here once submitted</p>
                            <a asp-controller="Customer" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        .border-start-4 {
            border-left-width: 4px !important;
        }

        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }

        .order-row:hover {
            background-color: #f8f9fa;
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Search functionality
            const searchInput = document.getElementById('orderSearch');
            const orderRows = document.querySelectorAll('#orderTable tbody tr.order-row');

            searchInput.addEventListener('input', function () {
                const searchText = this.value.toLowerCase().trim();

                orderRows.forEach(row => {
                    const rowText = row.textContent.toLowerCase();
                    const isVisible = rowText.includes(searchText);
                    row.style.display = isVisible ? '' : 'none';
                });
            });

            // Status filter functionality
            const filterOptions = document.querySelectorAll('.filter-option');

            filterOptions.forEach(option => {
                option.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filterValue = this.getAttribute('data-filter');

                    // Update dropdown button text
                    document.getElementById('statusFilterDropdown').innerHTML =
                        `<i class="bi bi-filter me-2"></i>${this.textContent}`;

                    // Filter rows
                    orderRows.forEach(row => {
                        const rowStatus = row.getAttribute('data-status');

                        if (filterValue === 'all') {
                            row.style.display = '';
                        } else {
                            const isMatch = rowStatus === filterValue.toLowerCase();
                            row.style.display = isMatch ? '' : 'none';
                        }
                    });
                });
            });

            // Reset filters when search is cleared
            searchInput.addEventListener('keyup', function () {
                if (this.value === '') {
                    orderRows.forEach(row => {
                        row.style.display = '';
                    });
                }
            });
        });
    </script>
}