@model RequestVM
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <input asp-for="RequestHeader.RequestHeaderId" type="hidden" />

    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="card-header bg-primary text-light py-4 position-relative">
                <div class="row align-items-center">
                    <div class="col-12 text-center">
                        <h2 class="text-white fw-bold mb-1">Orders Details</h2>
                        <p class="text-light mb-0 opacity-75">Manage customer pickup & order information</p>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <!-- Back Button -->
                <div class="row mb-4">
                    <div class="col-12 col-md-3">
                        <a asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Back to Orders
                        </a>
                    </div>
                </div>

                <div class="row g-5">
                    <!-- Pickup / Shipping Details -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-person-lines-fill me-2"></i> Pickup Details
                        </h3>

                        <div class="specs-container mb-4">
                            <!-- First Name -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.FirstName" class="form-label fw-semibold text-dark">Name</label>
                                <input asp-for="RequestHeader.FirstName" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                                <span asp-validation-for="RequestHeader.FirstName" class="text-danger"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.LastName" class="form-label fw-semibold text-dark">Surname</label>
                                <input asp-for="RequestHeader.LastName" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                                <span asp-validation-for="RequestHeader.LastName" class="text-danger"></span>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.CellNumber" class="form-label fw-semibold text-dark">Phone</label>
                                <input asp-for="RequestHeader.CellNumber" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                                <span asp-validation-for="RequestHeader.CellNumber" class="text-danger"></span>
                            </div>

                            <!-- Address -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.StreetAddress" class="form-label fw-semibold text-dark">Street Address</label>
                                <input asp-for="RequestHeader.StreetAddress" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                                <span asp-validation-for="RequestHeader.StreetAddress" class="text-danger"></span>
                            </div>

                            <!-- City -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.City" class="form-label fw-semibold text-dark">City</label>
                                <input asp-for="RequestHeader.City" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                            </div>

                            <!-- State -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.State" class="form-label fw-semibold text-dark">Province</label>
                                <input asp-for="RequestHeader.State" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                            </div>

                            <!-- Postal Code -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.PostalCode" class="form-label fw-semibold text-dark">Postal Code</label>
                                <input asp-for="RequestHeader.PostalCode" class="form-control"
                                       readonly="@(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "false" : "true")" />
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Email</label>
                                <input asp-for="RequestHeader.Customer.ApplicationUser.Email" class="form-control" readonly />
                            </div>

                            <!-- Order Date -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Order Date</label>
                                <input value="@Model.RequestHeader.RequestDate.ToShortDateString()" class="form-control" readonly />
                            </div>

                            <!-- Carrier Dropdown -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.Carrier" class="form-label fw-semibold text-dark">Carrier</label>
                                <select asp-for="RequestHeader.Carrier" class="form-select"
                                        disabled="@(!(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport)))">
                                    <option value="">Select Carrier</option>
                                    @if (ViewBag.CarrierList != null)
                                    {
                                        foreach (var carrier in ViewBag.CarrierList)
                                        {
                                            <option value="@carrier">@carrier</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="RequestHeader.Carrier" class="text-danger"></span>
                            </div>

                            <!-- Shipping Date -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.ShippingDate" class="form-label fw-semibold text-dark">Shipping Date</label>
                                <input asp-for="RequestHeader.ShippingDate" type="date" class="form-control"
                                       disabled="@(!(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport)))" />
                                <span asp-validation-for="RequestHeader.ShippingDate" class="text-danger"></span>
                            </div>

                            <!-- Status -->
                            <div class="mb-3">
                                <label asp-for="RequestHeader.Status" class="form-label fw-semibold text-dark">Status</label>
                                <input asp-for="RequestHeader.Status" class="form-control" readonly />
                            </div>

                            <!-- Action Buttons -->
                            @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport))
                            {
                                <div class="row g-2 mt-4">
                                    <!-- Approve Button -->
                                    <div class="col-12 col-md-4">
                                        <button type="submit" asp-action="Approve"
                                                class="btn btn-success w-100 py-2 fw-semibold rounded-pill shadow">
                                            <i class="bi bi-check-circle me-1"></i> Approve
                                        </button>
                                    </div>

                                    

                                    <!-- Reject Button -->
                                    <div class="col-12 col-md-4">
                                        <button type="button" data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                class="btn btn-danger w-100 py-2 fw-semibold rounded-pill shadow">
                                            <i class="bi bi-x-circle me-1"></i> Reject
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-receipt me-2"></i> Order Summary
                        </h3>

                        <ul class="list-group mb-4 shadow-sm rounded-3 overflow-hidden">
                            @foreach (var detail in Model.RequestDetails)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-semibold mb-1 text-primary">@detail.Fridge.Brand</h6>
                                        <small class="text-muted">Price Per Month: @detail.Price.ToString("c")</small><br />
                                        <small class="text-muted">Quantity: @detail.Count</small>
                                    </div>
                                    <span class="fw-bold text-success">@((detail.Count * detail.Price).ToString("c"))</span>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between bg-primary text-white">
                                <small>Total Per Month</small>
                                <strong class="fs-5">@Model.RequestHeader.RequestTotal.ToString("c")</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Feedback Modal -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="feedbackModalLabel">Provide Feedback</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="feedbackReason" class="form-label fw-semibold">Feedback Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="feedbackReason" name="feedbackReason" rows="4"
                                  placeholder="Please provide detailed feedback for the customer..." required></textarea>
                        <div class="invalid-feedback">Please provide feedback reason.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" asp-action="Feedback" class="btn btn-info" onclick="return validateFeedback()">
                        <i class="bi bi-chat-dots me-1"></i> Submit Feedback
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="rejectModalLabel">Reject Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> Please provide a reason for rejecting this order.
                    </div>
                    <div class="mb-3">
                        <label for="rejectReason" class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="rejectReason" name="rejectReason" rows="4"
                                  placeholder="Please provide the reason for rejecting this order..." required></textarea>
                        <div class="invalid-feedback">Please provide rejection reason.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" asp-action="Reject" class="btn btn-danger" onclick="return validateReject()">
                        <i class="bi bi-x-circle me-1"></i> Confirm Reject
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Set minimum date for shipping date to today
            const shippingDateInput = document.querySelector('input[type="date"]');
            if (shippingDateInput) {
                const today = new Date().toISOString().split('T')[0];
                shippingDateInput.min = today;
            }

            // Enable/disable carrier and shipping date based on user role
            const isEditable = @(User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupport) ? "true" : "false");
            if (!isEditable) {
                const carrierSelect = document.querySelector('select[name$="Carrier"]');
                const shippingDateInput = document.querySelector('input[name$="ShippingDate"]');

                if (carrierSelect) carrierSelect.disabled = true;
                if (shippingDateInput) shippingDateInput.disabled = true;
            }
        });

        
        function validateReject() {
            const rejectReason = document.getElementById('rejectReason');
            if (!rejectReason.value.trim()) {
                rejectReason.classList.add('is-invalid');
                return false;
            }
            rejectReason.classList.remove('is-invalid');

            // Add the reject reason to the form as a hidden input
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'reason';
            hiddenInput.value = rejectReason.value.trim();
            document.querySelector('form').appendChild(hiddenInput);

            return true;
        }

        // Clear validation when modal is closed
        document.getElementById('feedbackModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('feedbackReason').classList.remove('is-invalid');
        });

        document.getElementById('rejectModal').addEventListener('hidden.bs.modal', function () {
            document.getElementById('rejectReason').classList.remove('is-invalid');
        });
    </script>
}

<style>
    .section-title {
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 0.5rem;
    }

    .specs-container {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 10px;
    }

    .form-control:read-only, .form-select:disabled {
        background-color: #e9ecef;
        opacity: 1;
    }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }
</style>