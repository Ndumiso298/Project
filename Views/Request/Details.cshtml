@model AllocationRequestVM
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <input asp-for="Id" type="hidden" />

    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="card-header bg-primary text-light py-4 position-relative">
                <div class="row align-items-center">
                    <div class="col-12 text-center">
                        <h2 class="text-white fw-bold mb-1">Request Details</h2>
                        <p class="text-light mb-0 opacity-75">Manage customer pickup & order information</p>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <!-- Back Button -->
                <div class="row mb-4">
                    <div class="col-12 col-md-3">
                        <a asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Back to Orders
                        </a>
                    </div>
                </div>

                <div class="row g-5">
                    <!-- Pickup / Shipping Details -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-person-lines-fill me-2"></i> Pickup Details
                        </h3>

                        <div class="specs-container mb-4">
                            <!-- First Name -->
                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label fw-semibold text-dark">Name</label>
                                <input asp-for="FirstName" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label fw-semibold text-dark">Surname</label>
                                <input asp-for="LastName" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <!-- Phone -->
                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold text-dark">Phone</label>
                                <input asp-for="PhoneNumber" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>

                            <!-- Address -->
                            <div class="mb-3">
                                <label asp-for="AddressLine1" class="form-label fw-semibold text-dark">Address Line 1</label>
                                <input asp-for="AddressLine1" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                                <span asp-validation-for="AddressLine1" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="AddressLine2" class="form-label fw-semibold text-dark">Address Line 2</label>
                                <input asp-for="AddressLine2" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                                <span asp-validation-for="AddressLine2" class="text-danger"></span>
                            </div>

                            <!-- City -->
                            <div class="mb-3">
                                <label asp-for="City" class="form-label fw-semibold text-dark">City</label>
                                <input asp-for="City" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                            </div>

                            <!-- State -->
                            <div class="mb-3">
                                <label asp-for="Province" class="form-label fw-semibold text-dark">State</label>
                                <input asp-for="Province" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                            </div>

                            <!-- Postal Code -->
                            <div class="mb-3">
                                <label asp-for="PostalCode" class="form-label fw-semibold text-dark">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                            </div>

                            <!-- Order Date -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Order Date</label>
                                <input value="@Model.RequestDate.ToShortDateString()" class="form-control" readonly />
                            </div>

                            <!-- Carrier -->
                            <div class="mb-3">
                                <label asp-for="Carrier" class="form-label fw-semibold text-dark">Carrier</label>
                                <input asp-for="Carrier" id="carrier" class="form-control"
                                       readonly="@(User.IsInRole("Admin") || User.IsInRole("CustomerSupport") ? "false" : "true")" />
                            </div>

                            <!-- Shipping Date -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Shipping Date</label>
                                <input value="@Model.ShippingDate?.ToShortDateString()" class="form-control" readonly />
                            </div>

                            <!-- Payment Status -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark">Payment Status</label>
                                <input asp-for="Status" class="form-control" readonly />
                            </div>

                            @if (User.IsInRole("Admin") || User.IsInRole("CustomerSupport"))
                            {
                                <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold rounded-pill shadow">
                                    <i class="bi bi-pencil-square me-1"></i> Update Order Details
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-receipt me-2"></i> Order Summary
                        </h3>

                        <ul class="list-group mb-4 shadow-sm rounded-3 overflow-hidden">
                            @foreach (var detail in Model.RequestDetails)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-semibold mb-1 text-primary">@detail.FridgeModel</h6>
                                        <small class="text-muted">Price: @detail.Price.ToString("C")</small><br />
                                        <small class="text-muted">Quantity: @detail.Quantity</small>
                                    </div>
                                    <span class="fw-bold text-success">@detail.TotalPrice.ToString("C")</span>
                                </li>
                            }

                            <li class="list-group-item d-flex justify-content-between bg-primary text-white">
                                <small>Total Monthly Cost</small>
                                <strong class="fs-5">@Model.RequestDetails.Sum(d => d.TotalPrice).ToString("C")</strong>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}