@model Project.Models.ViewModel.RequestVM
@using Project.Utility

@{
    ViewData["Title"] = "Request Details";
    var header = Model.RequstHeader;
    var declineReason = ViewBag.DeclineReason as string;
}

<div class="container mt-4">
    <h2 class="mb-4">Request Details - #@header.RequestHeaderId</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Customer Information</h5>
            <p><strong>@header.Customer?.ApplicationUser?.FirstName @header.Customer?.ApplicationUser?.LastName</strong></p>
            <p>@header.StreetAddress, @header.City, @header.State, @header.PostalCode</p>
            <p><strong>Cell:</strong> @header.CellNumber</p>
            <p>
                <strong>Status:</strong>
                <span class="badge @(header.Status == SD.Approved ? "bg-success" :
                                                            header.Status == SD.Rejected ? "bg-danger" :
                                                            header.Status == SD.Relaunched ? "bg-warning text-dark" :
                                                            "bg-secondary")">@header.Status</span>
            </p>

            @if (!string.IsNullOrEmpty(declineReason))
            {
                <div class="alert alert-danger mt-3">
                    <strong>Decline Reason:</strong>
                    <p>@declineReason</p>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Requested Fridges</h5>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Fridge</th>
                        <th>Model</th>
                        <th>Qty</th>
                        <th>Price/Month</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.RequstDetail)
                    {
                        <tr>
                            <td>@d.Fridge.Brand</td>
                            <td>@d.Fridge.Model</td>
                            <td>@d.Count</td>
                            <td>R @d.Price.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3 d-flex flex-wrap gap-2">
                @if (User.IsInRole(SD.CustomerRole) && header.Status == SD.Rejected)
                {
                    <form asp-action="Relaunch" method="post">
                        <input type="hidden" name="id" value="@header.RequestHeaderId" />
                        <button type="submit" class="btn btn-warning w-100">Relaunch Request</button>
                    </form>
                }

                @if (User.IsInRole(SD.CustomerRole) && header.Status == SD.Approved)
                {
                    <a asp-controller="Fault" asp-action="CreateFault"
                       asp-route-requestHeaderId="@header.RequestHeaderId"
                       class="btn btn-danger w-100">Report Fault</a>

                    <a asp-controller="Request" asp-action="CreateReplacement"
                       asp-route-fridgeId="@Model.RequstDetail.FirstOrDefault()?.FridgeId"
                       class="btn btn-info w-100">Request Replacement</a>

                }

                <a asp-action="Index" class="btn btn-outline-dark w-100">Back to List</a>
            </div>
        </div>
    </div>
</div>
