@model Project.Models.ViewModel.RelaunchRequestVM
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Relaunch Request";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="card-header bg-primary text-light py-4">
            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <h2 class="fw-bold text-white mb-1">Relaunch Request</h2>
                    <p class="text-light mb-0 opacity-75">Provide additional information to resubmit your request</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Rejection Information -->
            <div class="alert alert-warning border-0 rounded-3 mb-5">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                    <div>
                        <h5 class="alert-heading mb-2">Previous Request Rejected</h5>
                        <p class="mb-1"><strong>Reason for Rejection:</strong> @Model.RejectionReason</p>
                        @if (Model.RejectionDate.HasValue)
                        {
                            <p class="mb-0"><strong>Rejected on:</strong> @Model.RejectionDate.Value.ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                        }
                    </div>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <input type="hidden" asp-for="OriginalRequestId" />
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <!-- Original Request Summary -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-dark">
                                    <i class="bi bi-clipboard-check me-2 text-primary"></i>
                                    Original Request Summary
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-muted small">Customer</label>
                                    <p class="fw-bold mb-0">@Model.CustomerName</p>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-muted small">Original Request Date</label>
                                    <p class="fw-bold mb-0">@Model.OriginalRequestDate.ToString("MMMM dd, yyyy")</p>
                                </div>

                                <div class="mt-4">
                                    <h6 class="fw-bold text-dark mb-3">Requested Items</h6>
                                    <div class="list-group list-group-flush">
                                        @if (Model.OriginalFridges != null && Model.OriginalFridges.Any())
                                        {
                                            @foreach (var fridge in Model.OriginalFridges)
                                            {
                                                <div class="list-group-item px-0 border-bottom">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="fw-semibold">@(fridge.Fridge?.Brand ?? "Unknown Brand")</span>
                                                        <span class="badge bg-primary">Qty: @fridge.Count</span>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(fridge.Fridge?.Description))
                                                    {
                                                        <div class="mb-1">
                                                            <small class="text-muted">@fridge.Fridge.Description</small>
                                                        </div>
                                                    }
                                                    @if (fridge.Fridge?.CapacityLiters > 0)
                                                    {
                                                        <div class="mb-1">
                                                            <small class="text-muted">Capacity: @fridge.Fridge.CapacityLiters L</small>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(fridge.Fridge?.FridgeNo))
                                                    {
                                                        <div class="mb-1">
                                                            <small class="text-muted">Model: @fridge.Fridge.FridgeNo</small>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="list-group-item px-0">
                                                <p class="text-muted mb-0">No items found in original request.</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-dark">
                                    <i class="bi bi-plus-circle me-2 text-primary"></i>
                                    Additional Information Required
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-4">
                                    <label asp-for="AdditionalDescription" class="form-label fw-semibold">
                                        Additional Description *
                                    </label>
                                    <textarea asp-for="AdditionalDescription" class="form-control" rows="6"
                                              placeholder="Please provide additional information addressing the rejection reason. Explain any changes or additional details that support your request..."
                                              required maxlength="1000"></textarea>
                                    <span asp-validation-for="AdditionalDescription" class="text-danger small"></span>
                                    <div class="form-text">
                                        <span id="charCount">0</span>/1000 characters
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="AdditionalDocument" class="form-label fw-semibold">
                                        Additional Supporting Document
                                    </label>
                                    <input type="file" asp-for="AdditionalDocument" class="form-control"
                                           accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                                    <span asp-validation-for="AdditionalDocument" class="text-danger small"></span>
                                    <div class="form-text">
                                        Upload any supporting documents (PDF, JPG, PNG, DOC, DOCX). Max file size: 5MB
                                    </div>
                                </div>

                                <div class="alert alert-info border-0 mt-4">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Note:</strong> Your request will be reviewed again with this additional information. Please ensure you address the original rejection reason.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-5">
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-controller="Request" class="btn btn-outline-secondary px-4 py-2">
                                <i class="bi bi-arrow-left me-2"></i>Back to Requests
                            </a>
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                <i class="bi bi-send-check me-2"></i>Relaunch Request
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Character count for description
            const descriptionTextarea = document.getElementById('AdditionalDescription');
            const charCount = document.getElementById('charCount');

            if (descriptionTextarea && charCount) {
                // Update character count on input
                descriptionTextarea.addEventListener('input', function () {
                    const currentLength = this.value.length;
                    charCount.textContent = currentLength;

                    // Optional: Add warning when approaching limit
                    if (currentLength > 900) {
                        charCount.className = 'text-warning';
                    } else {
                        charCount.className = '';
                    }
                });

                // Initialize character count
                charCount.textContent = descriptionTextarea.value.length;
            }

            // File size validation
            const fileInput = document.querySelector('input[type="file"]');
            if (fileInput) {
                fileInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const fileSize = file.size;
                        const maxSize = 5 * 1024 * 1024; // 5MB

                        if (fileSize > maxSize) {
                            alert('File size must be less than 5MB. Selected file is ' + (fileSize / (1024 * 1024)).toFixed(2) + 'MB.');
                            this.value = '';
                        }
                    }
                });
            }

            // Form validation
            const form = document.querySelector('form');
            if (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');
                });
            }
        });
    </script>
}