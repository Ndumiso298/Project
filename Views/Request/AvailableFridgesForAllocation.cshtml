@model List<AvailableFridgeVM>
@{
    Layout = "_CustomerLayout";
}

<style>
    .fridge-card {
        border: 1px solid #e9ecef;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .fridge-card:hover {
            border-color: #3498db;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }

        .fridge-card.selected {
            border-color: #28a745;
            background-color: #f8fff9;
        }

    .fridge-number {
        font-family: 'Courier New', monospace;
        font-weight: bold;
        color: #2c3e50;
    }

    .condition-badge {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }
</style>

<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-light py-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="fw-bold text-white mb-1">Available Fridges for Allocation</h2>
                    <p class="text-light mb-0 opacity-75">Select fridges to allocate to customer requests</p>
                </div>
                <div class="col-md-4 text-end">
                    <a asp-action="Index" class="btn btn-light rounded-pill">
                        <i class="fas fa-arrow-left me-2"></i> Back to Requests
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            @if (Model.Any())
            {
                <div class="row g-4">
                    @foreach (var fridge in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="fridge-card p-3 h-100"
                                 onclick="toggleFridgeSelection(@fridge.FridgeInStockId, this)">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="fridge-number">@fridge.FridgeNo</span>
                                    <span class="condition-badge badge
                                          @(fridge.Condition == "Excellent" ? "bg-success" :
                                            fridge.Condition == "Good" ? "bg-info" :
                                            fridge.Condition == "Fair" ? "bg-warning" : "bg-danger")">
                                        @fridge.Condition
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(fridge.ImageUrl))
                                {
                                    <div class="text-center mb-3">
                                        <img src="@fridge.ImageUrl" alt="@fridge.Brand"
                                             class="img-fluid rounded" style="max-height: 120px;" />
                                    </div>
                                }

                                <h6 class="fw-bold text-primary">@fridge.Brand @fridge.Model</h6>

                                <div class="row small text-muted mb-2">
                                    <div class="col-6">
                                        <strong>Capacity:</strong><br>
                                        @fridge.CapacityLiters L
                                    </div>
                                    <div class="col-6">
                                        <strong>Type:</strong><br>
                                        @fridge.Type
                                    </div>
                                </div>

                                <div class="row small text-muted mb-2">
                                    <div class="col-6">
                                        <strong>Price:</strong><br>
                                        @fridge.RentalPricePerMonth.ToString("c")/month
                                    </div>
                                    <div class="col-6">
                                        <strong>Location:</strong><br>
                                        @fridge.Location
                                    </div>
                                </div>

                                <div class="small text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    Last Maintenance: @fridge.LastMaintenanceDate.ToString("MMM dd, yyyy")
                                </div>

                                <div class="form-check mt-2">
                                    <input class="form-check-input fridge-checkbox"
                                           type="checkbox"
                                           value="@fridge.FridgeInStockId"
                                           id="fridge_@fridge.FridgeInStockId"
                                           style="display: none;">
                                    <label class="form-check-label" for="fridge_@fridge.FridgeInStockId"></label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 p-3 bg-light rounded-3">
                    <form id="allocationForm" method="post" asp-action="AllocateToNewRequest">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h5 class="mb-2">Selected Fridges: <span id="selectedCount">0</span></h5>
                                <div id="selectedFridges" class="small text-muted"></div>
                            </div>
                            <div class="col-md-4 text-end">
                                <button type="submit" class="btn btn-success rounded-pill px-4" disabled id="allocateBtn">
                                    <i class="fas fa-check me-2"></i> Allocate Selected
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-refrigerator fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No Available Fridges</h4>
                    <p class="text-muted">All fridges are currently allocated or under maintenance.</p>
                    <a asp-controller="FridgeInStock" asp-action="Manage" class="btn btn-primary rounded-pill">
                        <i class="fas fa-plus me-2"></i> Manage Fridge Stock
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedFridges = [];

        function toggleFridgeSelection(fridgeId, element) {
            const checkbox = element.querySelector('.fridge-checkbox');
            const index = selectedFridges.indexOf(fridgeId);

            if (index > -1) {
                // Remove from selection
                selectedFridges.splice(index, 1);
                element.classList.remove('selected');
                checkbox.checked = false;
            } else {
                // Add to selection
                selectedFridges.push(fridgeId);
                element.classList.add('selected');
                checkbox.checked = true;
            }

            updateSelectionUI();
        }

        function updateSelectionUI() {
            const selectedCount = document.getElementById('selectedCount');
            const selectedFridgesDiv = document.getElementById('selectedFridges');
            const allocateBtn = document.getElementById('allocateBtn');

            selectedCount.textContent = selectedFridges.length;

            if (selectedFridges.length > 0) {
                selectedFridgesDiv.innerHTML = `<strong>Selected:</strong> ${selectedFridges.length} fridge(s)`;
                allocateBtn.disabled = false;
            } else {
                selectedFridgesDiv.innerHTML = 'No fridges selected';
                allocateBtn.disabled = true;
            }
        }

        document.getElementById('allocationForm').addEventListener('submit', function (e) {
            // Add selected fridge IDs to form
            selectedFridges.forEach(fridgeId => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedFridgeIds';
                input.value = fridgeId;
                this.appendChild(input);
            });
        });
    </script>
}