@model IEnumerable<Project.Models.RequestHeader>
@{
    ViewData["Title"] = "Support Dashboard";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2 text-gray-800">
                <i class="fas fa-tachometer-alt me-2"></i>@ViewData["Title"]
            </h1>
            <p class="mb-0">Manage and monitor all fridge requests</p>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Pending Requests</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalPending</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Approved</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalApproved</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Rejected</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalRejected</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-times fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Relaunched</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalRelaunched</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-redo fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Table -->
    <div class="card shadow">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list me-2"></i>All Requests
            </h6>
            <form method="get" class="d-flex">
                <select name="statusFilter" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="@SD.Pending" selected="@(ViewBag.SelectedStatus == SD.Pending)">Pending</option>
                    <option value="@SD.Approved" selected="@(ViewBag.SelectedStatus == SD.Approved)">Approved</option>
                    <option value="@SD.Rejected" selected="@(ViewBag.SelectedStatus == SD.Rejected)">Rejected</option>
                </select>
            </form>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-gray-300 mb-3"></i>
                    <h5 class="text-gray-500">No requests found</h5>
                    <p class="text-gray-400">There are no requests matching your criteria.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th>Request ID</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@request.RequestHeaderId</strong>
                                        @if (request.IsRelaunched)
                                        {
                                            <span class="badge bg-warning ms-1" title="Relaunched request">
                                                <i class="fas fa-redo"></i>
                                            </span>
                                        }
                                    </td>
                                    <td>@request.FirstName @request.LastName</td>
                                    <td>@request.RequestDate.ToString("MMM dd, yyyy")</td>
                                    <td>@request.RequestFridges.Sum(d => d.Count) items</td>
                                    <td>@request.RequestTotal.ToString("C")</td>
                                    <td>
                                        @{
                                            var statusClass = request.Status switch
                                            {
                                                SD.Pending => "status-pending",
                                                SD.Approved => "status-approved",
                                                SD.Rejected => "status-rejected",
                                                _ => "status-pending"
                                            };
                                        }
                                        <span class="status-badge @statusClass">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = request.RequestHeaderId })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>