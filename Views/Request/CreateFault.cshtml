@model Project.Models.ViewModel.FaultReportVM

@{
    ViewData["Title"] = "Report Fault";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                        <div>
                            <h4 class="mb-0">Report Fridge Fault</h4>
                            <p class="mb-0 opacity-75">Submit detailed information about the issue with your refrigerator</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateFault" method="post" enctype="multipart/form-data" id="faultForm">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Customer Information Card -->
                        <div class="card mb-4 border-0 bg-light">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label fw-bold text-muted small">CUSTOMER NAME</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="fas fa-user text-primary"></i>
                                                </span>
                                                <input type="text" class="form-control border-start-0 ps-0 bg-white" value="@Model.CustomerName" readonly />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label class="form-label fw-bold text-muted small">CUSTOMER ID</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white">
                                                    <i class="fas fa-id-card text-primary"></i>
                                                </span>
                                                <input type="text" class="form-control border-start-0 ps-0 bg-white" value="@Model.CustomerID" readonly />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fridge Selection -->
                        <div class="form-group mb-4">
                            <label asp-for="FridgeInStockId" class="form-label fw-semibold">
                                <i class="fas fa-refrigerator me-2 text-primary"></i>Select Fridge
                            </label>
                            <select asp-for="FridgeInStockId" class="form-select form-select-lg" required>
                                <option value="">-- Choose your refrigerator --</option>
                                @foreach (var fridge in Model.AvailableFridges)
                                {
                                    <option value="@fridge.FridgeInStockId" data-brand="@fridge.FridgeInStock.Fridge.Brand" data-model="@fridge.FridgeInStock.Fridge.Model">
                                        @fridge.FridgeInStock.FridgeNo - @fridge.FridgeInStock.Fridge.Brand @fridge.FridgeInStock.Fridge.Model
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FridgeInStockId" class="text-danger small"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1"></i>Select the refrigerator you're reporting an issue for
                            </div>
                        </div>

                        <!-- Fault Details Card -->
                        <div class="card mb-4 border-0">
                            <div class="card-header bg-transparent border-bottom">
                                <h5 class="mb-0">
                                    <i class="fas fa-tools me-2 text-warning"></i>Fault Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Fault Type -->
                                <div class="form-group mb-4">
                                    <label asp-for="FaultType" class="form-label fw-semibold">
                                        <i class="fas fa-bug me-2 text-danger"></i>Fault Type
                                    </label>
                                    <input asp-for="FaultType" class="form-control" placeholder="e.g., Not cooling, Strange noise, Water leakage..." required />
                                    <span asp-validation-for="FaultType" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="fas fa-lightbulb me-1"></i>Be specific about the type of fault you're experiencing
                                    </div>
                                </div>

                                <!-- Description -->
                                <div class="form-group mb-4">
                                    <label asp-for="Description" class="form-label fw-semibold">
                                        <i class="fas fa-file-alt me-2 text-info"></i>Fault Description
                                    </label>
                                    <textarea asp-for="Description" class="form-control" rows="5" 
                                              placeholder="Please provide a detailed description of the issue. Include when it started, any error messages, and how it affects the refrigerator's performance..." 
                                              required></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="fas fa-question-circle me-1"></i>Detailed descriptions help us diagnose and fix the issue faster
                                    </div>
                                </div>

                                <!-- Priority -->
                                <div class="form-group mb-4">
                                    <label asp-for="Priority" class="form-label fw-semibold">
                                        <i class="fas fa-flag me-2 text-warning"></i>Priority Level
                                    </label>
                                    <select asp-for="Priority" class="form-select" required>
                                        <option value="Low">
                                            <i class="fas fa-flag text-success me-2"></i>Low - Minor issue, fridge still functional
                                        </option>
                                        <option value="Medium" selected>
                                            <i class="fas fa-flag text-warning me-2"></i>Medium - Affecting performance but still usable
                                        </option>
                                        <option value="High">
                                            <i class="fas fa-flag text-orange me-2"></i>High - Significant impact on functionality
                                        </option>
                                        <option value="Critical">
                                            <i class="fas fa-flag text-danger me-2"></i>Critical - Fridge not working, urgent attention needed
                                        </option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Options Card -->
                        <div class="card mb-4 border-0">
                            <div class="card-header bg-transparent border-bottom">
                                <h5 class="mb-0">
                                    <i class="fas fa-cogs me-2 text-secondary"></i>Additional Options
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Request Replacement -->
                                <div class="form-check form-switch mb-4">
                                    <input asp-for="RequestReplacement" class="form-check-input" type="checkbox" role="switch" id="replacementSwitch">
                                    <label class="form-check-label fw-semibold" for="replacementSwitch">
                                        <i class="fas fa-exchange-alt me-2 text-primary"></i>Request Replacement
                                    </label>
                                    <div class="form-text">
                                        <i class="fas fa-exclamation-triangle me-1 text-warning"></i>Check this if you believe the refrigerator needs to be replaced
                                    </div>
                                </div>

                                <!-- Images -->
                                <div class="form-group">
                                    <label asp-for="FaultImages" class="form-label fw-semibold">
                                        <i class="fas fa-camera me-2 text-success"></i>Upload Images
                                    </label>
                                    <input asp-for="FaultImages" type="file" multiple 
                                           class="form-control" 
                                           accept="image/*"
                                           onchange="previewImages(this)" />
                                    <span asp-validation-for="FaultImages" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>Upload clear photos of the fault (max 5MB per image)
                                    </div>
                                    <div id="imagePreview" class="mt-3 row g-2 d-none"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
                            </a>
                            <div>
                                <button type="reset" class="btn btn-outline-danger me-2">
                                    <i class="fas fa-undo me-2"></i>Reset Form
                                </button>
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-paper-plane me-2"></i>Submit Fault Report
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 12px;
            transition: transform 0.2s ease-in-out;
        }

        .card:hover {
            transform: translateY(-2px);
        }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.1);
        }

        .form-label {
            font-weight: 600;
            color: #495057;
        }

        .input-group-text {
            border-radius: 8px 0 0 8px;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
        }

        .text-orange {
            color: #fd7e14;
        }

        .image-preview-container {
            position: relative;
            display: inline-block;
            margin: 5px;
        }

        .image-preview {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #e9ecef;
        }

        .remove-image {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
            cursor: pointer;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        // Image preview functionality
        function previewImages(input) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            preview.classList.add('d-none');

            if (input.files && input.files.length > 0) {
                preview.classList.remove('d-none');
                
                Array.from(input.files).forEach((file, index) => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const col = document.createElement('div');
                            col.className = 'col-auto';
                            col.innerHTML = `
                                <div class="image-preview-container">
                                    <img src="${e.target.result}" class="image-preview" alt="Preview ${index + 1}">
                                    <button type="button" class="remove-image" onclick="removeImage(${index})">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            `;
                            preview.appendChild(col);
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }
        }

        function removeImage(index) {
            const dt = new DataTransfer();
            const input = document.querySelector('input[type="file"]');
            const { files } = input;
            
            for (let i = 0; i < files.length; i++) {
                if (index !== i) {
                    dt.items.add(files[i]);
                }
            }
            
            input.files = dt.files;
            previewImages(input);
        }

        // Form submission enhancement
        document.getElementById('faultForm').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';
        });

        // Real-time validation
        const inputs = document.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
            input.addEventListener('blur', function() {
                if (this.value.trim() !== '') {
                    this.classList.add('is-valid');
                    this.classList.remove('is-invalid');
                } else {
                    this.classList.add('is-invalid');
                    this.classList.remove('is-valid');
                }
            });
        });
    </script>
}