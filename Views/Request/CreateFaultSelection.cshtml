@model Project.Models.ViewModel.FaultReportVM
@using Project.Utility

@{
    ViewData["Title"] = "Select Fridge to Report Fault";
    var statusConfigs = new Dictionary<string, (string Icon, string Color, string Text)>
    {
        { "Allocated", ("fa-check-circle", "success", "Allocated") },
        { "Active", ("fa-play-circle", "primary", "Active") },
        { "Maintenance", ("fa-tools", "warning", "Under Maintenance") }
    };
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
        <div class="mb-3 mb-md-0">
            <h1 class="h3 fw-bold text-gray-800 mb-1">
                <i class="fas fa-exclamation-triangle text-warning me-2"></i>@ViewData["Title"]
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")" class="text-decoration-none">Requests</a></li>
                    <li class="breadcrumb-item active text-gray-600">Report Fault</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Requests
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-primary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Fridges</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.AvailableFridges.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-refrigerator fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-success shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Active Units</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.AvailableFridges.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-info shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-info text-uppercase mb-1">Customer</div>
                            <div class="h6 mb-0 fw-bold text-gray-800 text-truncate">@Model.CustomerName</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start-4 border-start-warning shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Report Status</div>
                            <div class="h6 mb-0 fw-bold text-gray-800">Ready to Report</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-flag fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-bottom-0 py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                <div>
                    <h6 class="m-0 fw-semibold text-gray-800">
                        <i class="fas fa-refrigerator text-primary me-2"></i>Your Allocated Fridges
                    </h6>
                    <p class="text-muted mb-0 mt-1 small">Select a fridge to report a fault or issue</p>
                </div>
                <div class="mt-2 mt-md-0">
                    <span class="badge bg-primary rounded-pill">
                        <i class="fas fa-filter me-1"></i>@Model.AvailableFridges.Count units available
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model.AvailableFridges.Any())
            {
                <div class="row g-4">
                    @foreach (var fridge in Model.AvailableFridges)
                    {
                        var fridgeInfo = fridge.FridgeInStock?.Fridge;
                        var hasImage = !string.IsNullOrEmpty(fridgeInfo?.ImageUrl);

                        <div class="col-xl-4 col-lg-6 col-md-6">
                            <div class="card h-100 border-0 shadow-sm position-relative fridge-card">
                                <!-- Status Badge -->
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-success rounded-pill">
                                        <i class="fas fa-check-circle me-1"></i>Allocated
                                    </span>
                                </div>

                                <!-- Fridge Image Section -->
                                <div class="fridge-image-container position-relative">
                                    @if (hasImage)
                                    {
                                        <img src="@fridgeInfo.ImageUrl"
                                             alt="@fridgeInfo.Brand @fridgeInfo.Model"
                                             class="fridge-image img-fluid w-100">
                                    }
                                    else
                                    {
                                        <div class="fridge-placeholder d-flex align-items-center justify-content-center">
                                            <i class="fas fa-refrigerator fa-4x text-gray-300"></i>
                                        </div>
                                    }
                                    <div class="fridge-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                        <div class="text-white text-center">
                                            <i class="fas fa-search-plus fa-2x mb-2"></i>
                                            <div class="small">View Details</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Fridge Details -->
                                <div class="card-body">
                                    <!-- Brand and Model -->
                                    <div class="mb-3">
                                        <h5 class="card-title fw-bold text-gray-800 mb-1">@fridgeInfo?.Brand</h5>
                                        <h6 class="card-subtitle text-primary fw-semibold">@fridgeInfo?.Model</h6>
                                    </div>

                                    <!-- Serial Number -->
                                    <div class="d-flex align-items-center mb-3">
                                        <i class="fas fa-barcode text-muted me-2"></i>
                                        <small class="text-muted">Serial: @fridge.FridgeInStock?.FridgeNo</small>
                                    </div>

                                    <!-- Specifications -->
                                    <div class="fridge-specs mb-3">
                                        @if (fridgeInfo?.CapacityLiters > 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted small">
                                                    <i class="fas fa-arrows-alt-v me-1"></i>Capacity
                                                </span>
                                                <span class="fw-semibold text-gray-800 small">@fridgeInfo.CapacityLiters L</span>
                                            </div>
                                        }

                                        @if (!string.IsNullOrEmpty(fridgeInfo?.Type))
                                        {
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="text-muted small">
                                                    <i class="fas fa-tag me-1"></i>Type
                                                </span>
                                                <span class="fw-semibold text-gray-800 small">@fridgeInfo.Type</span>
                                            </div>
                                        }

                                        @if (fridgeInfo?.RentalPricePerMonth > 0)
                                        {
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-muted small">
                                                    <i class="fas fa-money-bill-wave me-1"></i>Monthly
                                                </span>
                                                <span class="fw-semibold text-success small">R @fridgeInfo.RentalPricePerMonth.ToString("N2")</span>
                                            </div>
                                        }
                                    </div>

                                    <!-- Description -->
                                    @if (!string.IsNullOrEmpty(fridgeInfo?.Description))
                                    {
                                        <div class="mb-3">
                                            <p class="small text-muted mb-0 line-clamp-2">@fridgeInfo.Description</p>
                                        </div>
                                    }
                                </div>

                                <!-- Action Section -->
                                <div class="card-footer bg-transparent border-top-0 pt-0">
                                    <a href="@Url.Action("CreateFault", new { id = fridge.FridgeInStockId })"
                                       class="btn btn-primary w-100 btn-report-fault">
                                        <i class="fas fa-exclamation-triangle me-2"></i>Report Fault
                                    </a>
                                    <div class="text-center mt-2">
                                        <small class="text-muted">
                                            <i class="fas fa-info-circle me-1"></i>Click to report issues
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Help Section -->
                <div class="row mt-5">
                    <div class="col-12">
                        <div class="card border-0 bg-light">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-1 text-center">
                                        <i class="fas fa-info-circle fa-2x text-primary"></i>
                                    </div>
                                    <div class="col-md-11">
                                        <h6 class="fw-bold text-gray-800 mb-2">Need Assistance?</h6>
                                        <p class="text-muted mb-3">Select the fridge experiencing issues. Common problems include temperature fluctuations, unusual noises, or physical damage.</p>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <ul class="list-unstyled text-muted small mb-3 mb-md-0">
                                                    <li class="mb-1"><i class="fas fa-thermometer-half text-warning me-2"></i>Not cooling properly</li>
                                                    <li class="mb-1"><i class="fas fa-tint text-info me-2"></i>Water leakage</li>
                                                    <li class="mb-1"><i class="fas fa-volume-up text-secondary me-2"></i>Unusual noises</li>
                                                </ul>
                                            </div>
                                            <div class="col-md-6">
                                                <ul class="list-unstyled text-muted small">
                                                    <li class="mb-1"><i class="fas fa-door-closed text-success me-2"></i>Door sealing issues</li>
                                                    <li class="mb-1"><i class="fas fa-lightbulb text-warning me-2"></i>Light not working</li>
                                                    <li class="mb-1"><i class="fas fa-snowflake text-primary me-2"></i>Ice maker problems</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">
                    <div class="empty-state-icon mb-4">
                        <i class="fas fa-refrigerator fa-4x text-gray-300"></i>
                    </div>
                    <h4 class="text-gray-600 mb-3">No Fridges Allocated</h4>
                    <p class="text-muted mb-4">You don't have any allocated fridges to report faults for.</p>

                    <div class="row justify-content-center mb-4">
                        <div class="col-md-8 col-lg-6">
                            <div class="card border-start-warning">
                                <div class="card-body">
                                    <div class="d-flex">
                                        <i class="fas fa-lightbulb text-warning fa-2x me-3"></i>
                                        <div>
                                            <h6 class="fw-bold text-warning mb-2">What to do next?</h6>
                                            <p class="text-muted mb-0 small">
                                                Contact our support team to get fridges allocated to your account, or check the status of your rental requests.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <i class="fas fa-list me-2"></i>View Requests
                        </a>
                        <a href="@Url.Action("Contact", "Support")" class="btn btn-outline-primary">
                            <i class="fas fa-headset me-2"></i>Contact Support
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-start-4 {
            border-left-width: 4px !important;
        }

        .fridge-card {
            transition: all 0.3s ease-in-out;
            border: 1px solid #e3e6f0;
        }

            .fridge-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1);
                border-color: #4e73df;
            }

        .fridge-image-container {
            height: 200px;
            overflow: hidden;
            position: relative;
            background: #f8f9fc;
        }

        .fridge-image {
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease-in-out;
        }

        .fridge-placeholder {
            height: 100%;
            background: linear-gradient(135deg, #f8f9fc 0%, #e3e6f0 100%);
        }

        .fridge-overlay {
            background: rgba(78, 115, 223, 0.9);
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .fridge-card:hover .fridge-overlay {
            opacity: 1;
        }

        .fridge-card:hover .fridge-image {
            transform: scale(1.05);
        }

        .fridge-specs {
            background: #f8f9fc;
            border-radius: 8px;
            padding: 12px;
        }

        .btn-report-fault {
            transition: all 0.3s ease-in-out;
            font-weight: 600;
            padding: 10px 16px;
        }

            .btn-report-fault:hover {
                transform: translateY(-2px);
                box-shadow: 0 0.25rem 0.5rem rgba(78, 115, 223, 0.3);
            }

        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .empty-state-icon {
            opacity: 0.7;
        }

        .card {
            border-radius: 0.5rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .fridge-image-container {
                height: 150px;
            }

            .card-body {
                padding: 1rem;
            }
        }

        @@media (max-width: 576px) {
            .fridge-image-container {
                height: 120px;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize fridge card interactions
            const fridgeCards = document.querySelectorAll('.fridge-card');

            fridgeCards.forEach(card => {
                // Add click effects
                card.addEventListener('click', function(e) {
                    if (!e.target.closest('a')) {
                        this.style.transform = 'scale(0.98)';
                        setTimeout(() => {
                            this.style.transform = '';
                        }, 150);
                    }
                });

                // Add hover effects
                card.addEventListener('mouseenter', function() {
                    this.classList.add('shadow-lg');
                });

                card.addEventListener('mouseleave', function() {
                    this.classList.remove('shadow-lg');
                });
            });

            // Report button loading states
            const reportButtons = document.querySelectorAll('.btn-report-fault');

            reportButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    const originalContent = this.innerHTML;

                    // Show loading state
                    this.innerHTML = `
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Loading...
                    `;
                    this.disabled = true;

                    // Fallback re-enable after 3 seconds
                    setTimeout(() => {
                        if (this.disabled) {
                            this.innerHTML = originalContent;
                            this.disabled = false;
                        }
                    }, 3000);
                });
            });

            // Smooth scrolling for navigation
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            console.log('Fridge selection page initialized successfully');
        });
    </script>
}