@model Project.Models.Fault

@{

    Layout = "_CustomerLayout";

}

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        h2 {
            color: #2c3e50;
            margin-bottom: 20px;
        }

        .section {
            margin-bottom: 30px;
        }

        .label {
            font-weight: bold;
            color: #34495e;
        }

        .value {
            margin-left: 10px;
        }

    

        }
    </style>

    <h2>Fault Report Summary</h2>

    <div class="section">
        <div><span class="label">Fault ID:</span><span class="value">@Model.FaultId</span></div>
        <div><span class="label">Status:</span><span class="value">@Model.Status</span></div>
        <div><span class="label">Resolved Date:</span><span class="value">@Model.ResolvedAt?.ToShortDateString()</span></div>
    </div>

    <div class="section">
        <h4>Technician Info</h4>
        <div><span class="label">Assigned Technician:</span><span class="value">@Model.ResolvedByTechnician?.Name</span></div>
        <div><span class="label">Technician Notes:</span><span class="value">@Model.Notes</span></div>
    </div>

    <div class="section">
        <h4>Customer Info</h4>
        <div><span class="label">Name:</span><span class="value">@Model.ReportedByCustomer?.Name</span></div>
        <div><span class="label">Address:</span><span class="value">@Model.ReportedByCustomer?.Address</span></div>
        <div><span class="label">Customer Note:</span><span class="value">@Model.ReportedByCustomer?.CustomerNote</span></div>
    </div>

    <div class="section">
        <h4>Fridge Info</h4>
        <div><span class="label">Model:</span><span class="value">@Model.Fridge?.Model</span></div>
        <div><span class="label">Serial Number:</span><span class="value">@Model.Fridge?.FridgeNo</span></div>
        <div><span class="label">Location:</span><span class="value">@Model.Location</span></div>
    </div>

    <div class="no-print">
        <button onclick="window.print()">🖨️ Print</button>
        <a href="@Url.Action("Index", "Fault")">🔙 Back to List</a>
    </div>

