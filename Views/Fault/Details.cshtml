@model Project.Models.FridgeFault

@{
    ViewData["Title"] = "Process FridgeFault";
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-3">
        <i class="bi bi-tools me-2"></i> Process Fault
    </h2>
    <p class="text-muted mb-4">Update fault status, assign a technician, and record resolution details.</p>

    <!-- Customer & Fridge Info -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white fw-semibold">
                    <i class="bi bi-person-fill me-2"></i> Customer Information
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Name:</strong> @Model.ReportedBy?.FirstName</p>
                    <p class="mb-2"><strong>Name:</strong> @Model.ReportedBy?.LastName</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.ReportedBy?.AddressLine1</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.ReportedBy?.AddressLine2</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.ReportedBy?.City</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.ReportedBy?.Province</p>
                    <p class="mb-2"><strong>Address:</strong> @Model.ReportedBy?.PostalCode</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white fw-semibold">
                    <i class="bi bi-box-seam me-2"></i> Fridge Information
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Model:</strong> @Model.Fridge?.Model</p>
                    <p class="mb-2"><strong>Serial:</strong> @Model.Fridge?.SerialNumber</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Processing Form -->
    <form asp-action="Process" method="post" class="card border-0 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label fw-semibold">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="In Progress">In Progress</option>
                        <option value="Resolved">Resolved</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Assign Technician</label>
                    <select asp-for="AssignedTechnician" class="form-select"
                            asp-items="@(ViewBag.Technicians as IEnumerable<SelectListItem>)">
                        <option value="">Select technician</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="ResolvedDate" class="form-label fw-semibold">Resolved Date</label>
                    <input asp-for="ResolvedDate" type="date" class="form-control" />
                    <span asp-validation-for="ResolvedDate" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ResolutionNotes" class="form-label fw-semibold">Technician Notes</label>
                    <textarea asp-for="ResolutionNotes" rows="4" class="form-control"
                              placeholder="Describe diagnostics, parts replaced, and outcome"></textarea>
                    <span asp-validation-for="ResolutionNotes" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light d-flex justify-content-between">
            <a asp-controller="Fault" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-printer me-1"></i> Print Fault Details
            </a>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check2-circle me-1"></i> Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Auto-fill ResolvedAt when status set to Resolved
        (function () {
            const status = document.getElementById("Status");
            const resolvedAt = document.getElementById("ResolvedAt");
            if (status && resolvedAt) {
                status.addEventListener("change", function () {
                    if (this.value === "Resolved" && !resolvedAt.value) {
                        const today = new Date().toISOString().substring(0, 10);
                        resolvedAt.value = today;
                    }
                });
            }
        })();
    </script>
}


