@model ReplacementRequestVM
@{
    ViewData["Title"] = "Edit Replacement Request";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-edit me-2"></i>@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FridgeAllocationId" class="form-label"></label>
                            <select asp-for="FridgeAllocationId" asp-items="Model.FridgeAllocationList" class="form-select">
                                <option value="">-- Select Fridge Allocation --</option>
                            </select>
                            <span asp-validation-for="FridgeAllocationId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FaultRecordId" class="form-label"></label>
                            <select asp-for="FaultRecordId" asp-items="Model.FaultRecordList" class="form-select">
                                <option value="">-- Select Related Fault (Optional) --</option>
                            </select>
                            <span asp-validation-for="FaultRecordId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequestType" class="form-label"></label>
                            <select asp-for="RequestType" asp-items="Model.RequestTypeList" class="form-select">
                                <option value="">-- Select Request Type --</option>
                            </select>
                            <span asp-validation-for="RequestType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Model.StatusList" class="form-select">
                                <option value="">-- Select Status --</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label"></label>
                            <select asp-for="Priority" asp-items="Model.PriorityList" class="form-select">
                                <option value="">-- Select Priority --</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" class="form-control" min="1" max="100" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequestedDate" class="form-label"></label>
                            <input asp-for="RequestedDate" type="date" class="form-control" />
                            <span asp-validation-for="RequestedDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AssignedEmployeeId" class="form-label"></label>
                            <select asp-for="AssignedEmployeeId" asp-items="Model.EmployeeList" class="form-select">
                                <option value="">-- Assign to Employee --</option>
                            </select>
                            <span asp-validation-for="AssignedEmployeeId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                    <div class="form-text">Maximum 500 characters</div>
                </div>

                <div class="mb-3">
                    <label asp-for="ResponseNotes" class="form-label"></label>
                    <textarea asp-for="ResponseNotes" class="form-control" rows="3"
                              placeholder="Add response notes here..."></textarea>
                    <span asp-validation-for="ResponseNotes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Update Request
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}