@model ReplacementRequest
@{
    ViewData["Title"] = "Replacement Request Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-info-circle me-2"></i>@ViewData["Title"]</h1>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
            @if (User.IsInRole("InventoryLiaison") || User.IsInRole("Administrator"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary ms-2">
                    <i class="fas fa-edit me-1"></i>Edit
                </a>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Basic Information Card -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-alt me-2"></i>Request Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Request ID:</dt>
                                <dd class="col-sm-8">#@Model.Id</dd>

                                <dt class="col-sm-4">Customer:</dt>
                                <dd class="col-sm-8">@Model.FridgeAllocation?.Customer?.Name</dd>

                                <dt class="col-sm-4">Fridge Model:</dt>
                                <dd class="col-sm-8">@Model.FridgeAllocation?.Fridge?.Model</dd>

                                <dt class="col-sm-4">Request Type:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-info">@Model.RequestType</span>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Priority:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @GetPriorityBadgeClass(Model.Priority)">
                                        @Model.Priority
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @GetStatusBadgeClass(Model.Status)">
                                        @Model.Status
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Quantity:</dt>
                                <dd class="col-sm-8">@Model.Quantity</dd>

                                <dt class="col-sm-4">Requested Date:</dt>
                                <dd class="col-sm-8">@Model.RequestedDate.ToString("dd/MM/yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mt-3">
                        <dt>Reason:</dt>
                        <dd class="border rounded p-3 bg-light">@Model.Reason</dd>
                    </div>
                </div>
            </div>

            <!-- Assignment Information -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-users me-2"></i>Assignment Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Assigned To:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.AssignedEmployee != null)
                                    {
                                        @($"{Model.AssignedEmployee.FirstName} {Model.AssignedEmployee.LastName}")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Assigned Date:</dt>
                                <dd class="col-sm-8">
                                    @(Model.AssignedDate?.ToString("dd/MM/yyyy") ?? "Not assigned")
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Response Date:</dt>
                                <dd class="col-sm-8">
                                    @(Model.ResponseDate?.ToString("dd/MM/yyyy") ?? "Not responded")
                                </dd>

                                <dt class="col-sm-4">Created:</dt>
                                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ResponseNotes))
                    {
                        <div class="mt-3">
                            <dt>Response Notes:</dt>
                            <dd class="border rounded p-3 bg-light">@Model.ResponseNotes</dd>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Actions Card -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-cogs me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    @if (User.IsInRole("InventoryLiaison") || User.IsInRole("Administrator"))
                    {
                        <!-- Assignment Form -->
                        <form asp-action="Assign" method="post" class="mb-3">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label">Assign to Employee:</label>
                                <select name="employeeId" class="form-select" required>
                                    <option value="">-- Select Employee --</option>
                                    @foreach (var emp in ViewBag.AvailableEmployees ?? new List<Employee>())
                                    {
                                        <option value="@emp.Id">@emp.FirstName @emp.LastName</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-success btn-sm w-100">
                                <i class="fas fa-user-check me-1"></i>Assign
                            </button>
                        </form>

                        <div class="d-grid gap-2">
                            @if (Model.Status != CustomerRequestStatus.Completed)
                            {
                                <a href="#" class="btn btn-success btn-sm"
                                   onclick="updateStatus(@Model.Id, '@CustomerRequestStatus.Completed')">
                                    <i class="fas fa-check me-1"></i>Mark Complete
                                </a>
                            }

                            @if (Model.Status != CustomerRequestStatus.Cancelled)
                            {
                                <a href="#" class="btn btn-danger btn-sm"
                                   onclick="updateStatus(@Model.Id, '@CustomerRequestStatus.Cancelled')">
                                    <i class="fas fa-times me-1"></i>Cancel Request
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Related Information -->
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>Related Information
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.FaultRecord != null)
                    {
                        <div class="mb-2">
                            <strong>Related Fault:</strong><br>
                            <a asp-controller="FaultRecords" asp-action="Details"
                               asp-route-id="@Model.FaultRecord.Id" class="text-decoration-none">
                                Fault #@Model.FaultRecord.Id
                            </a>
                        </div>
                    }

                    @if (Model.MaintenanceRecord != null)
                    {
                        <div class="mb-2">
                            <strong>Related Maintenance:</strong><br>
                            <a asp-controller="MaintenanceRecords" asp-action="Details"
                               asp-route-id="@Model.MaintenanceRecord.Id" class="text-decoration-none">
                                Maintenance #@Model.MaintenanceRecord.Id
                            </a>
                        </div>
                    }

                    <div class="mt-3">
                        <strong>Customer Location:</strong><br>
                        <small class="text-muted">
                            @Model.FridgeAllocation?.Customer?.AddressLine1<br>
                            @Model.FridgeAllocation?.Customer?.City
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateStatus(requestId, status) {
            if (confirm('Are you sure you want to update the status to ' + status + '?')) {
                $.post('@Url.Action("UpdateStatus", "ReplacementRequests")', {
                    id: requestId,
                    status: status
                }, function() {
                    location.reload();
                });
            }
        }
    </script>
}

@functions {
    public string GetPriorityBadgeClass(RequestPriority priority)
    {
        return priority switch
        {
            RequestPriority.Low => "bg-success",
            RequestPriority.Medium => "bg-warning",
            RequestPriority.High => "bg-danger",
            RequestPriority.Critical => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public string GetStatusBadgeClass(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Draft => "bg-secondary",
            CustomerRequestStatus.Pending => "bg-warning",
            CustomerRequestStatus.InProgress => "bg-info",
            CustomerRequestStatus.Completed => "bg-success",
            CustomerRequestStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}