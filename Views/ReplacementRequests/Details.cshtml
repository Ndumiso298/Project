@model ReplacementRequest
@{
    ViewData["Title"] = "Replacement Request Details";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-exchange-alt me-2"></i>Replacement Request #@Model.Id
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Details -->
        <div class="col-lg-8">
            <!-- Request Information -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Request Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Request ID:</dt>
                                <dd class="col-sm-8">#@Model.Id</dd>

                                <dt class="col-sm-4">Request Type:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@GetRequestTypeBadge(Model.RequestType)">
                                        @Model.RequestType
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Priority:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@GetPriorityBadge(Model.Priority)">
                                        @Model.Priority
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@GetStatusBadge(Model.Status)">
                                        @Model.Status
                                    </span>
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Requested Date:</dt>
                                <dd class="col-sm-8">@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                                <dt class="col-sm-4">Response Date:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.ResponseDate.HasValue)
                                    {
                                        @Model.ResponseDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Assigned Date:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.AssignedDate.HasValue)
                                    {
                                        @Model.AssignedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Quantity:</dt>
                                <dd class="col-sm-8">@Model.Quantity</dd>
                            </dl>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <dt>Reason:</dt>
                            <dd class="text-muted">@(string.IsNullOrEmpty(Model.Reason) ? "No reason provided" : Model.Reason)</dd>
                        </div>
                    </div>

                    <!-- Response Notes -->
                    @if (!string.IsNullOrEmpty(Model.ResponseNotes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <dt>Response Notes:</dt>
                                <dd class="bg-light p-3 rounded">
                                    @Html.Raw(Model.ResponseNotes.Replace("\n", "<br>"))
                                </dd>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Customer & Equipment Details -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Customer & Equipment Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Customer Information</h6>
                            <dl>
                                <dt>Customer:</dt>
                                <dd>@Model.FridgeAllocation?.Customer?.TradingName</dd>

                                <dt>Contact:</dt>
                                <dd>@Model.FridgeAllocation?.Customer?.UserAccount?.FirstName @Model.FridgeAllocation?.Customer?.UserAccount?.LastName</dd>

                                <dt>Email:</dt>
                                <dd>@Model.FridgeAllocation?.Customer?.UserAccount?.Email</dd>

                                <dt>Phone:</dt>
                                <dd>@Model.FridgeAllocation?.Customer?.UserAccount?.PhoneNumber</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6>Equipment Information</h6>
                            <dl>
                                <dt>Allocation ID:</dt>
                                <dd>#@Model.FridgeAllocationId</dd>

                                <dt>Fridge:</dt>
                                <dd>
                                    @if (Model.FridgeAllocation?.Fridge != null)
                                    {
                                        <a asp-controller="Fridges" asp-action="Details" asp-route-id="@Model.FridgeAllocation.Fridge.Id"
                                           class="text-decoration-none">
                                            @Model.FridgeAllocation.Fridge.SerialNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </dd>

                                <dt>Model:</dt>
                                <dd>@Model.FridgeAllocation?.Fridge?.FridgeModel?.Manufacturer @Model.FridgeAllocation?.Fridge?.FridgeModel?.ModelName</dd>

                                <dt>Assigned Technician:</dt>
                                <dd>
                                    @if (Model.AssignedEmployee != null)
                                    {
                                        @Model.AssignedEmployee.UserAccount?.FirstName @Model.AssignedEmployee.UserAccount?.LastName
                                        <br>
                                        <small class="text-muted">@Model.AssignedEmployee.EmployeeType</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Records -->
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-link me-2"></i>Related Records
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Fault Record</h6>
                            @if (Model.FaultRecord != null)
                            {
                                <dl>
                                    <dt>Fault ID:</dt>
                                    <dd>#@Model.FaultRecord.Id</dd>

                                    <dt>Description:</dt>
                                    <dd>@Model.FaultRecord.Description</dd>

                                    <dt>Status:</dt>
                                    <dd>
                                        <span class="badge bg-@GetFaultStatusBadge(Model.FaultRecord.Status)">
                                            @Model.FaultRecord.Status
                                        </span>
                                    </dd>

                                    <dt>Reported Date:</dt>
                                    <dd>@Model.FaultRecord.ReportedDate.ToString("dd/MM/yyyy")</dd>
                                </dl>
                                <a asp-controller="FaultRecords" asp-action="Details" asp-route-id="@Model.FaultRecord.Id"
                                   class="btn btn-sm btn-outline-warning">View Fault Details</a>
                            }
                            else
                            {
                                <p class="text-muted">No fault record linked</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6>Maintenance Record</h6>
                            @if (Model.MaintenanceRecord != null)
                            {
                                <dl>
                                    <dt>Service Date:</dt>
                                    <dd>@Model.MaintenanceRecord.ServiceDate.ToString("dd/MM/yyyy")</dd>

                                    <dt>Service Type:</dt>
                                    <dd>@Model.MaintenanceRecord.ServiceType</dd>

                                    <dt>Technician:</dt>
                                    <dd>@Model.MaintenanceRecord.Technician?.UserAccount?.FirstName</dd>
                                </dl>
                                <a asp-controller="MaintenanceRecords" asp-action="Details" asp-route-id="@Model.MaintenanceRecord.Id"
                                   class="btn btn-sm btn-outline-warning">View Maintenance</a>
                            }
                            else
                            {
                                <p class="text-muted">No maintenance record linked</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>Edit Request
                        </a>

                        @if (Model.AssignedEmployeeId == null && (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole)))
                        {
                            <div class="dropdown">
                                <button class="btn btn-warning dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-plus me-2"></i>Assign To
                                </button>
                                <ul class="dropdown-menu">
                                    @foreach (var tech in ViewBag.TechnicianList)
                                    {
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Assign", new { id = Model.Id, employeeId = tech.Value })">
                                                @tech.Text
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <a asp-controller="FridgeAllocations" asp-action="Details" asp-route-id="@Model.FridgeAllocationId"
                           class="btn btn-outline-primary">
                            <i class="fas fa-link me-2"></i>View Allocation
                        </a>

                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.FridgeAllocation?.CustomerId"
                           class="btn btn-outline-info">
                            <i class="fas fa-user me-2"></i>View Customer
                        </a>

                        @if (User.IsInRole(SD.AdminRole))
                        {
                            <button type="button" class="btn btn-danger"
                                    onclick="confirmDelete(@Model.Id, '@Model.Id')">
                                <i class="fas fa-trash me-2"></i>Delete Request
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Request Metadata -->
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-database me-2"></i>Request Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl>
                        <dt>Created Date:</dt>
                        <dd class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt>Last Updated:</dt>
                        <dd class="text-muted">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt>Status:</dt>
                        <dd>
                            @if (!Model.IsDeleted)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, requestNumber) {
            // Same implementation as in Index view
        }
    </script>
}

@functions {
    public string GetStatusBadge(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Draft => "warning",
            CustomerRequestStatus.InProgress => "info",
            CustomerRequestStatus.Completed => "success",
            CustomerRequestStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadge(CustomerRequestPriority priority)
    {
        return priority switch
        {
            CustomerRequestPriority.Low => "success",
            CustomerRequestPriority.Medium => "warning",
            CustomerRequestPriority.High => "danger",
            CustomerRequestPriority.Critical => "dark",
            _ => "secondary"
        };
    }

    public string GetRequestTypeBadge(CustomerRequestType requestType)
    {
        return requestType switch
        {
            CustomerRequestType.Replacement => "primary",
            CustomerRequestType.AdditionalUnits => "warning",
            CustomerRequestType.TemporaryAllocation => "info",
            CustomerRequestType.NewAllocation => "success",
            _ => "secondary"
        };
    }

    public string GetFaultStatusBadge(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "warning",
            FaultStatus.InProgress => "info",
            FaultStatus.Resolved => "success",
            FaultStatus.Closed => "danger",
            _ => "secondary"
        };
    }
}