@model ReplacementRequest
@{
    ViewData["Title"] = "Delete Replacement Request";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-danger">
                <i class="fas fa-trash me-2"></i>Delete Replacement Request
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>Confirm Deletion
            </h5>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h5 class="alert-heading">
                    <i class="fas fa-exclamation-circle me-2"></i>Warning!
                </h5>
                <p class="mb-0">
                    You are about to permanently delete replacement request <strong>#@Model.Id</strong>.
                    This action cannot be undone.
                </p>
            </div>

            <!-- Request Details -->
            <div class="row">
                <div class="col-md-6">
                    <h6>Request Information</h6>
                    <dl>
                        <dt>Request ID:</dt>
                        <dd>#@Model.Id</dd>

                        <dt>Customer:</dt>
                        <dd>@Model.FridgeAllocation?.Customer?.TradingName</dd>

                        <dt>Fridge:</dt>
                        <dd>@Model.FridgeAllocation?.Fridge?.SerialNumber</dd>

                        <dt>Request Type:</dt>
                        <dd>
                            <span class="badge bg-@GetRequestTypeBadge(Model.RequestType)">
                                @Model.RequestType
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h6>Status Information</h6>
                    <dl>
                        <dt>Status:</dt>
                        <dd>
                            <span class="badge bg-@GetStatusBadge(Model.Status)">
                                @Model.Status
                            </span>
                        </dd>

                        <dt>Priority:</dt>
                        <dd>
                            <span class="badge bg-@GetPriorityBadge(Model.Priority)">
                                @Model.Priority
                            </span>
                        </dd>

                        <dt>Requested Date:</dt>
                        <dd>@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt>Assigned To:</dt>
                        <dd>
                            @if (Model.AssignedEmployee != null)
                            {
                                @Model.AssignedEmployee.UserAccount?.FirstName @Model.AssignedEmployee.UserAccount?.LastName
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Reason -->
            <div class="row mt-3">
                <div class="col-12">
                    <h6>Reason for Request</h6>
                    <div class="bg-light p-3 rounded">
                        @(string.IsNullOrEmpty(Model.Reason) ? "No reason provided" : Model.Reason)
                    </div>
                </div>
            </div>

            <!-- Deletion Impact -->
            <div class="alert alert-info mt-4">
                <h6><i class="fas fa-info-circle me-2"></i>Deletion Impact</h6>
                <ul class="mb-0">
                    <li>This replacement request will be marked as deleted in the system</li>
                    <li>The request will no longer appear in standard reports or searches</li>
                    <li>Associated allocation and fault records will NOT be affected</li>
                    <li>This action is reversible only by database administrators</li>
                </ul>
            </div>
        </div>
        <div class="card-footer">
            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="row">
                    <div class="col-6">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                    </div>
                    <div class="col-6 text-end">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-2"></i>Confirm Delete
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadge(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Pending => "warning",
            CustomerRequestStatus.InProgress => "info",
            CustomerRequestStatus.Completed => "success",
            CustomerRequestStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadge(CustomerRequestPriority priority)
    {
        return priority switch
        {
            CustomerRequestPriority.Low => "success",
            CustomerRequestPriority.Medium => "warning",
            CustomerRequestPriority.High => "danger",
            CustomerRequestPriority.Critical => "dark",
            _ => "secondary"
        };
    }

    public string GetRequestTypeBadge(CustomerRequestType requestType)
    {
        return requestType switch
        {
            CustomerRequestType.Replacement => "primary",
            CustomerRequestType.Repair => "warning",
            CustomerRequestType.Maintenance => "info",
            CustomerRequestType.Upgrade => "success",
            _ => "secondary"
        };
    }
}