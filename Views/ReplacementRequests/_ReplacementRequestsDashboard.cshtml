@{
    var recentRequests = ViewBag.RecentReplacementRequests as IEnumerable<ReplacementRequest> ?? new List<ReplacementRequest>();
    var pendingCount = ViewBag.PendingReplacementRequestsCount as int? ?? 0;
    var highPriorityCount = ViewBag.HighPriorityReplacementRequestsCount as int? ?? 0;
}

<div class="card">
    <div class="card-header bg-warning text-white">
        <h5 class="mb-0">
            <i class="fas fa-exchange-alt me-2"></i>Replacement Requests
            @if (pendingCount > 0)
            {
                <span class="badge bg-light text-warning ms-2">@pendingCount Pending</span>
            }
        </h5>
    </div>
    <div class="card-body">
        @if (recentRequests.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var request in recentRequests.Take(5))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">
                                <a asp-controller="ReplacementRequests" asp-action="Details" asp-route-id="@request.Id" class="text-decoration-none">
                                    #@request.Id - @request.FridgeAllocation?.Customer?.TradingName
                                </a>
                            </div>
                            <small class="text-muted">
                                @request.FridgeAllocation?.Fridge?.SerialNumber •
                                <span class="badge bg-@GetPriorityBadge(request.Priority)">@request.Priority</span>
                            </small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-@GetStatusBadge(request.Status) mb-1">@request.Status</span>
                            <br>
                            <small class="text-muted">@request.RequestedDate.ToString("dd/MM")</small>
                        </div>
                    </div>
                }
            </div>

            <div class="row mt-3 text-center">
                <div class="col-6">
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-0 text-danger">@highPriorityCount</h6>
                            <small class="card-text">High Priority</small>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-light">
                        <div class="card-body py-2">
                            <h6 class="card-title mb-0 text-warning">@pendingCount</h6>
                            <small class="card-text">Pending</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3 text-center">
                <a asp-controller="ReplacementRequests" asp-action="Index" class="btn btn-sm btn-outline-warning me-2">
                    View All Requests
                </a>
                <a asp-controller="ReplacementRequests" asp-action="Upsert" class="btn btn-sm btn-warning">
                    <i class="fas fa-plus me-1"></i>New Request
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-3">
                <i class="fas fa-exchange-alt fa-2x text-muted mb-2"></i>
                <p class="text-muted mb-0">No replacement requests</p>
                <a asp-controller="ReplacementRequests" asp-action="Upsert" class="btn btn-sm btn-warning mt-2">
                    <i class="fas fa-plus me-1"></i>Create Request
                </a>
            </div>
        }
    </div>
</div>

@functions {
    public string GetStatusBadge(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Draft => "warning",
            CustomerRequestStatus.InProgress => "info",
            CustomerRequestStatus.Completed => "success",
            CustomerRequestStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadge(CustomerRequestPriority priority)
    {
        return priority switch
        {
            CustomerRequestPriority.Low => "success",
            CustomerRequestPriority.Medium => "warning",
            CustomerRequestPriority.High => "danger",
            CustomerRequestPriority.Critical => "dark",
            _ => "secondary"
        };
    }
}