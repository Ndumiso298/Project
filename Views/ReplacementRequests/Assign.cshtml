@model Project.Models.ReplacementRequest
@{
    ViewData["Title"] = "Assign Replacement Request";
}

<h2 class="mb-3">Assign Replacement Request #@Model.Id</h2>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Fridge</dt>
            <dd class="col-sm-9">@Model.FridgeAllocation?.Fridge?.SerialNumber</dd>

            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.FridgeAllocation?.Customer?.TradingName</dd>

            <dt class="col-sm-3">Request Type</dt>
            <dd class="col-sm-9">@Model.RequestType</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>
</div>

<form asp-action="Assign" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label for="employeeId" class="form-label">Assign To</label>
        <select id="employeeId" name="employeeId" class="form-select"
                asp-items="ViewBag.EmployeeList">
            <option value="">-- Select Employee --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-person-check"></i> Assign
    </button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Cancel
    </a>
</form>
