@model ReplacementRequest
@{
    ViewData["Title"] = "Assign Replacement Request";
    var technicianList = ViewBag.TechnicianList as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-user-plus me-2"></i>Assign Replacement Request
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Request
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Assignment Form -->
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-users me-2"></i>Assign Technician
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Request Summary -->
                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle me-2"></i>Request Summary</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Request #:</strong> #@Model.Id<br>
                                <strong>Customer:</strong> @Model.FridgeAllocation?.Customer?.TradingName<br>
                                <strong>Fridge:</strong> @Model.FridgeAllocation?.Fridge?.SerialNumber
                            </div>
                            <div class="col-md-6">
                                <strong>Request Type:</strong> @Model.RequestType<br>
                                <strong>Priority:</strong>
                                <span class="badge bg-@GetPriorityBadge(Model.Priority)">@Model.Priority</span><br>
                                <strong>Status:</strong>
                                <span class="badge bg-@GetStatusBadge(Model.Status)">@Model.Status</span>
                            </div>
                        </div>
                    </div>

                    <!-- Assignment Form -->
                    <form asp-action="Assign" method="post" id="assignForm">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="employeeId" class="form-label">Select Technician *</label>
                                    <select name="employeeId" id="employeeId" class="form-select" required>
                                        <option value="">-- Select Technician --</option>
                                        @foreach (var tech in technicianList)
                                        {
                                            <option value="@tech.Value">@tech.Text</option>
                                        }
                                    </select>
                                    <div class="form-text">Choose a technician to assign this replacement request to.</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Assignment Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")" readonly />
                                    <div class="form-text">Current date and time</div>
                                </div>
                            </div>
                        </div>

                        <!-- Technician Availability -->
                        <div class="card bg-light mt-3">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="fas fa-clock me-2"></i>Technician Workload
                                </h6>
                            </div>
                            <div class="card-body">
                                <div id="technicianWorkload">
                                    <p class="text-muted mb-0">Select a technician to view their current workload...</p>
                                </div>
                            </div>
                        </div>

                        <!-- Assignment Notes -->
                        <div class="mb-3 mt-3">
                            <label for="assignmentNotes" class="form-label">Assignment Notes (Optional)</label>
                            <textarea id="assignmentNotes" name="assignmentNotes" class="form-control" rows="3"
                                      placeholder="Add any specific instructions or notes for the technician..."></textarea>
                        </div>

                        <!-- Impact Summary -->
                        <div class="alert alert-warning mt-3">
                            <h6><i class="fas fa-exclamation-triangle me-2"></i>Assignment Impact</h6>
                            <ul class="mb-0">
                                <li>Request status will be automatically changed to <strong>In Progress</strong></li>
                                <li>Assigned technician will be notified of this assignment</li>
                                <li>Assignment date will be recorded as current date and time</li>
                                <li>This action can be changed later by editing the request</li>
                            </ul>
                        </div>
                    </form>
                </div>
                <div class="card-footer">
                    <div class="row">
                        <div class="col-6">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                        <div class="col-6 text-end">
                            <button type="submit" form="assignForm" class="btn btn-warning">
                                <i class="fas fa-user-check me-2"></i>Assign Technician
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Request Details -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-tasks me-2"></i>Request Details
                    </h5>
                </div>
                <div class="card-body">
                    <dl>
                        <dt>Request ID:</dt>
                        <dd>#@Model.Id</dd>

                        <dt>Customer:</dt>
                        <dd>@Model.FridgeAllocation?.Customer?.TradingName</dd>

                        <dt>Fridge Serial:</dt>
                        <dd>@Model.FridgeAllocation?.Fridge?.SerialNumber</dd>

                        <dt>Request Type:</dt>
                        <dd>
                            <span class="badge bg-@GetRequestTypeBadge(Model.RequestType)">
                                @Model.RequestType
                            </span>
                        </dd>

                        <dt>Priority:</dt>
                        <dd>
                            <span class="badge bg-@GetPriorityBadge(Model.Priority)">
                                @Model.Priority
                            </span>
                        </dd>

                        <dt>Current Status:</dt>
                        <dd>
                            <span class="badge bg-@GetStatusBadge(Model.Status)">
                                @Model.Status
                            </span>
                        </dd>

                        <dt>Requested Date:</dt>
                        <dd>@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt>Reason:</dt>
                        <dd class="text-muted small">@(string.IsNullOrEmpty(Model.Reason) ? "No reason provided" : Model.Reason)</dd>
                    </dl>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="fas fa-eye me-2"></i>View Request Details
                        </a>
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            <i class="fas fa-edit me-2"></i>Edit Request
                        </a>
                        <a href="@Url.Action("Index", "FaultRecords", new { allocationId = Model.FridgeAllocationId })"
                           class="btn btn-outline-info">
                            <i class="fas fa-exclamation-triangle me-2"></i>View Fault History
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Technician workload simulation
            $('#employeeId').change(function () {
                const technicianId = $(this).val();
                const workloadContainer = $('#technicianWorkload');

                if (technicianId) {
                    // Simulate loading technician workload
                    workloadContainer.html(`
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                            <span>Loading technician workload...</span>
                        </div>
                    `);

                    // Simulate API call delay
                    setTimeout(() => {
                        const workloads = {
                            '1': { active: 3, pending: 2, completed: 15 },
                            '2': { active: 1, pending: 1, completed: 22 },
                            '3': { active: 5, pending: 3, completed: 18 },
                            '4': { active: 2, pending: 0, completed: 25 }
                        };

                        const workload = workloads[technicianId] || { active: 0, pending: 0, completed: 0 };

                        workloadContainer.html(`
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="text-warning">
                                        <h5>${workload.active}</h5>
                                        <small>Active</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="text-info">
                                        <h5>${workload.pending}</h5>
                                        <small>Pending</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="text-success">
                                        <h5>${workload.completed}</h5>
                                        <small>Completed</small>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted">Total assigned requests: ${workload.active + workload.pending}</small>
                            </div>
                        `);
                    }, 1000);
                } else {
                    workloadContainer.html('<p class="text-muted mb-0">Select a technician to view their current workload...</p>');
                }
            });

            // Form validation
            $('#assignForm').submit(function (e) {
                const technicianId = $('#employeeId').val();
                if (!technicianId) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Technician Required',
                        text: 'Please select a technician to assign this request to.',
                        confirmButtonColor: '#3085d6'
                    });
                    return false;
                }

                // Show confirmation
                e.preventDefault();
                const technicianName = $('#employeeId option:selected').text();

                Swal.fire({
                    title: 'Confirm Assignment',
                    html: `Are you sure you want to assign this request to <strong>${technicianName}</strong>?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, Assign Now!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Submit the form
                        $(this).unbind('submit').submit();
                    }
                });
            });

            // Auto-focus on technician dropdown
            $('#employeeId').focus();
        });
    </script>
}

@functions {
    public string GetStatusBadge(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Draft => "warning",
            CustomerRequestStatus.InProgress => "info",
            CustomerRequestStatus.Completed => "success",
            CustomerRequestStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadge(CustomerRequestPriority priority)
    {
        return priority switch
        {
            CustomerRequestPriority.Low => "success",
            CustomerRequestPriority.Medium => "warning",
            CustomerRequestPriority.High => "danger",
            CustomerRequestPriority.Critical => "dark",
            _ => "secondary"
        };
    }

    public string GetRequestTypeBadge(CustomerRequestType requestType)
    {
        return requestType switch
        {
            CustomerRequestType.Replacement => "primary",
            CustomerRequestType.AdditionalUnits => "warning",
            CustomerRequestType.TemporaryAllocation => "info",
            CustomerRequestType.NewAllocation => "success",
            _ => "secondary"
        };
    }
}