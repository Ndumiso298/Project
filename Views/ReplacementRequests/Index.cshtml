@model IEnumerable<ReplacementRequest>
@{
    ViewData["Title"] = "Replacement Requests";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-exchange-alt me-2"></i>Replacement Requests
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Replacement Request
            </a>
        </div>
    </div>

    <!-- Replacement Requests Card -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Request #</th>
                                <th>Customer</th>
                                <th>Fridge</th>
                                <th>Request Type</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Requested Date</th>
                                <th>Assigned To</th>
                                <th>Response Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@request.Id</strong>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@request.FridgeAllocation?.Customer?.TradingName</div>
                                        <small class="text-muted">@request.FridgeAllocation?.Customer?.UserAccount?.FirstName @request.FridgeAllocation?.Customer?.UserAccount?.LastName</small>
                                    </td>
                                    <td>
                                        @if (request.FridgeAllocation?.Fridge != null)
                                        {
                                            <a asp-controller="Fridges" asp-action="Details" asp-route-id="@request.FridgeAllocation.Fridge.Id"
                                               class="text-decoration-none">
                                                @request.FridgeAllocation.Fridge.SerialNumber
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetRequestTypeBadge(request.RequestType)">
                                            @request.RequestType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetPriorityBadge(request.Priority)">
                                            @request.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadge(request.Status)">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td>
                                        @request.RequestedDate.ToString("dd/MM/yyyy")
                                        <br>
                                        <small class="text-muted">@request.RequestedDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (request.AssignedEmployee != null)
                                        {
                                            @request.AssignedEmployee.UserAccount?.FirstName @request.AssignedEmployee.UserAccount?.LastName
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (request.ResponseDate.HasValue)
                                        {
                                            @request.ResponseDate.Value.ToString("dd/MM/yyyy")
                                            <br>
                                            <small class="text-muted">@request.ResponseDate.Value.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@request.Id"
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Upsert" asp-route-id="@request.Id"
                                               class="btn btn-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (User.IsInRole(SD.AdminRole))
                                            {
                                                <button type="button" class="btn btn-danger btn-sm"
                                                        onclick="confirmDelete(@request.Id, '@request.Id')" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Statistics -->
                <div class="row mt-4">
                    <div class="col-md-2 col-6">
                        <div class="card bg-primary text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count()</h6>
                                <small class="card-text">Total</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-warning text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(r => r.Status == CustomerRequestStatus.Draft)</h6>
                                <small class="card-text">Pending</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-info text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(r => r.Status == CustomerRequestStatus.InProgress)</h6>
                                <small class="card-text">In Progress</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-success text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(r => r.Status == CustomerRequestStatus.Completed)</h6>
                                <small class="card-text">Completed</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-danger text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(r => r.Priority == CustomerRequestPriority.High || r.Priority == CustomerRequestPriority.Critical)</h6>
                                <small class="card-text">High Priority</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-secondary text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(r => r.AssignedEmployeeId == null)</h6>
                                <small class="card-text">Unassigned</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-exchange-alt fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Replacement Requests Found</h5>
                    <p class="text-muted">Create your first replacement request to get started.</p>
                    <a asp-action="Upsert" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Create First Request
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, requestNumber) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to delete replacement request #${requestNumber}. This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("DeleteConfirmed")', { id: id }, function () {
                        Swal.fire(
                            'Deleted!',
                            'Replacement request has been deleted.',
                            'success'
                        ).then(() => {
                            window.location.reload();
                        });
                    }).fail(function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the replacement request.',
                            'error'
                        );
                    });
                }
            });
        }
    </script>
}

@functions {
    public string GetStatusBadge(CustomerRequestStatus status)
    {
        return status switch
        {
            CustomerRequestStatus.Draft => "warning",
            CustomerRequestStatus.InProgress => "info",
            CustomerRequestStatus.Completed => "success",
            CustomerRequestStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadge(CustomerRequestPriority priority)
    {
        return priority switch
        {
            CustomerRequestPriority.Low => "success",
            CustomerRequestPriority.Medium => "warning",
            CustomerRequestPriority.High => "danger",
            CustomerRequestPriority.Critical => "dark",
            _ => "secondary"
        };
    }

    public string GetRequestTypeBadge(CustomerRequestType requestType)
    {
        return requestType switch
        {
            CustomerRequestType.Replacement => "primary",
            CustomerRequestType.AdditionalUnits => "warning",
            CustomerRequestType.TemporaryAllocation => "info",
            CustomerRequestType.NewAllocation => "success",
            _ => "secondary"
        };
    }
}