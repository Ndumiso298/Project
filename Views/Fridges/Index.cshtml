@model IEnumerable<FridgeVM>
@using Microsoft.AspNetCore.Identity
@using Project.Utilities
@using Project.Data
@using Project.Models
@using System.Security.Claims
@inject ApplicationDbContext _db

@{
    ViewData["Title"] = "Fridge Inventory Management";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="bi bi-refrigerator me-2"></i>@ViewData["Title"]
                </h1>
                @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole))
                {
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Add New Fridge
                    </a>
                }
            </div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Fridge Inventory</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Search and Filter Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="bi bi-funnel me-2"></i>Search & Filter
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <label for="searchString" class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchString" name="searchString"
                           value="@ViewBag.SearchString" placeholder="Search by serial number, model, manufacturer...">
                </div>
                <div class="col-md-2">
                    <label for="statusFilter" class="form-label">Status</label>
                    <select class="form-select" id="statusFilter" name="statusFilter">
                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item.Value" selected="@(item.Value == ViewBag.StatusFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="conditionFilter" class="form-label">Condition</label>
                    <select class="form-select" id="conditionFilter" name="conditionFilter">
                        @foreach (var item in ViewBag.ConditionList)
                        {
                            <option value="@item.Value" selected="@(item.Value == ViewBag.ConditionFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="locationFilter" class="form-label">Location</label>
                    <select class="form-select" id="locationFilter" name="locationFilter">
                        @foreach (var item in ViewBag.LocationList)
                        {
                            <option value="@item.Value" selected="@(item.Value == ViewBag.LocationFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-outline-primary w-100 me-2">
                        <i class="bi bi-search me-1"></i>Apply
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count()</div>
                            <div>Total Fridges</div>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-refrigerator fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(f => f.Status == FridgeStatus.Available)</div>
                            <div>Available</div>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-check-circle fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(f => f.Status == FridgeStatus.Allocated)</div>
                            <div>Allocated</div>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-person-check fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-danger text-white mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="fs-4 fw-bold">@Model.Count(f => f.Status == FridgeStatus.Quarantined)</div>
                            <div>Under Repair</div>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-tools fs-1"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridges Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="bi bi-list-ul me-2"></i>Fridge Inventory
            </h5>
            <div class="text-muted small">
                Showing @Model.Count() of @ViewBag.TotalCount fridges
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Serial Number</th>
                                <th>Model</th>
                                <th>Status</th>
                                <th>Condition</th>
                                <th>Location</th>
                                <th>Last Service</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@item.SerialNumber</div>
                                        <small class="text-muted">@item.DisplayName</small>
                                    </td>
                                    <td>
                                        <div>@item.FridgeModelDetails?.Manufacturer</div>
                                        <small class="text-muted">@item.FridgeModelDetails?.ModelName</small>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status)">
                                            @item.Status.GetDisplayName()
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetConditionBadgeClass(item.Condition)">
                                            @item.Condition.GetDisplayName()
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.LocationDetails != null)
                                        {
                                            <div>@item.LocationDetails.City</div>
                                            <small class="text-muted">@item.LocationDetails.Suburb</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not set</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.LastServiceDate.HasValue)
                                        {
                                            <div>@item.LastServiceDate.Value.ToString("dd/MM/yyyy")</div>
                                            <small class="@(item.RequiresMaintenance ? "text-danger" : "text-success")">
                                                @(item.RequiresMaintenance ? "Due" : "OK")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-warning">Never serviced</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole))
                                            {
                                                <a asp-action="Upsert" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }

                                            @if (User.IsInRole(SD.AdminRole))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        title="Delete" data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal_@item.Id">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }

                                            @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole))
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning"
                                                        title="Scrap" data-bs-toggle="modal"
                                                        data-bs-target="#scrapModal_@item.Id">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        </div>

                                        <!-- Delete Modal -->
                                        @if (User.IsInRole(SD.AdminRole))
                                        {
                                            <div class="modal fade" id="deleteModal_@item.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title">Confirm Delete</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Are you sure you want to delete fridge <strong>@item.SerialNumber</strong>?</p>
                                                            <p class="text-danger"><small>This action cannot be undone. The fridge will be marked as scrapped.</small></p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-action="Delete" method="post">
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button type="submit" class="btn btn-danger">Delete</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Scrap Modal -->
                                        @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole))
                                        {
                                            <div class="modal fade" id="scrapModal_@item.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-warning text-dark">
                                                            <h5 class="modal-title">Scrap Fridge</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-action="Scrap" method="post">
                                                            <div class="modal-body">
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <p>Are you sure you want to scrap fridge <strong>@item.SerialNumber</strong>?</p>
                                                                <div class="mb-3">
                                                                    <label for="scrapReason_@item.Id" class="form-label">Scrap Reason *</label>
                                                                    <textarea class="form-control" id="scrapReason_@item.Id" name="scrapReason"
                                                                              rows="3" placeholder="Enter reason for scrapping..." required></textarea>
                                                                </div>
                                                                <p class="text-warning"><small>The fridge will be marked as scrapped and removed from active inventory.</small></p>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-warning">Scrap Fridge</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-refrigerator display-1 text-muted"></i>
                    <h4 class="text-muted mt-3">No fridges found</h4>
                    <p class="text-muted">No fridges match your search criteria.</p>
                    @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.StockControllerRole))
                    {
                        <a asp-action="Upsert" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-1"></i>Add First Fridge
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-outline-secondary mt-2 ms-2">
                        <i class="bi bi-arrow-clockwise me-1"></i>Clear Filters
                    </a>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-light">
                <nav aria-label="Fridge pagination">
                    <ul class="pagination justify-content-center mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-statusFilter="@ViewBag.StatusFilter"
                                   asp-route-conditionFilter="@ViewBag.ConditionFilter"
                                   asp-route-locationFilter="@ViewBag.LocationFilter">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
                <div class="text-center text-muted small mt-2">
                    Page @ViewBag.CurrentPage of @ViewBag.TotalPages - Showing @Model.Count() items per page
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit form when filter selects change
        document.addEventListener('DOMContentLoaded', function() {
            const filterSelects = document.querySelectorAll('#statusFilter, #conditionFilter, #locationFilter');
            filterSelects.forEach(select => {
                select.addEventListener('change', function() {
                    this.form.submit();
                });
            });

            // Enhance search with debounce
            let searchTimeout;
            const searchInput = document.getElementById('searchString');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        this.form.submit();
                    }, 500);
                });
            }

            // Show toast messages
            const successMessage = '@TempData["success"]';
            const errorMessage = '@TempData["error"]';

            if (successMessage) {
                showToast('Success', successMessage, 'success');
            }

            if (errorMessage) {
                showToast('Error', errorMessage, 'danger');
            }

            function showToast(title, message, type) {
                // You can implement a toast notification here
                console.log(`${title}: ${message} (${type})`);
                // For now, we'll use alert for simplicity
                alert(`${title}: ${message}`);
            }
        });
    </script>
}

@functions {
    private string GetStatusBadgeClass(FridgeStatus status)
    {
        return status switch
        {
            FridgeStatus.Available => "bg-success",
            FridgeStatus.Allocated => "bg-warning",
            FridgeStatus.InService => "bg-info",
            FridgeStatus.Quarantined => "bg-danger",
            FridgeStatus.Scrapped => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private string GetConditionBadgeClass(FridgeCondition condition)
    {
        return condition switch
        {
            FridgeCondition.New => "bg-success",
            FridgeCondition.PreOwned => "bg-info",
            FridgeCondition.Refurbished => "bg-primary",
            FridgeCondition.Poor => "bg-danger",
            _ => "bg-secondary"
        };
    }
}