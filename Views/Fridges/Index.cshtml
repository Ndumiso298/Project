@model IEnumerable<FridgeVM>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Fridge Management";
    var searchString = ViewBag.SearchString as string;
    var statusFilter = ViewBag.StatusFilter as string;
    var conditionFilter = ViewBag.ConditionFilter as string;
    var locationFilter = ViewBag.LocationFilter as string;
    var currentPage = ViewBag.Page ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalCount = ViewBag.TotalCount ?? 0;
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Fridge Management</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-primary">
                    <i class="fas fa-refrigerator me-2"></i>Fridge Management
                </h1>
                <a asp-action="Upsert" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Add New Fridge
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count()</h4>
                            <small>Total Fridges</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-refrigerator fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(f => f.Status == FridgeStatus.Available)</h4>
                            <small>Available</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(f => f.Status == FridgeStatus.Allocated)</h4>
                            <small>Allocated</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-users fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(f => f.RequiresMaintenance)</h4>
                            <small>Maintenance Due</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-tools fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Count(f => f.Status == FridgeStatus.Faulty)</h4>
                            <small>Faulty</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="card bg-secondary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="mb-0">@Model.Sum(f => f.OpenFaultCount)</h4>
                            <small>Open Faults</small>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-bug fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-filter me-2"></i>Filters & Search
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="searchString" class="form-label">Search</label>
                    <input type="text" class="form-control" id="searchString" name="searchString"
                           value="@searchString" placeholder="Serial number, model, customer...">
                </div>
                <div class="col-md-2">
                    <label for="statusFilter" class="form-label">Status</label>
                    <select class="form-select" id="statusFilter" name="statusFilter">
                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item.Value" selected="@(item.Value == statusFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="conditionFilter" class="form-label">Condition</label>
                    <select class="form-select" id="conditionFilter" name="conditionFilter">
                        @foreach (var item in ViewBag.ConditionList)
                        {
                            <option value="@item.Value" selected="@(item.Value == conditionFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="locationFilter" class="form-label">Location</label>
                    <select class="form-select" id="locationFilter" name="locationFilter">
                        @foreach (var item in ViewBag.LocationList)
                        {
                            <option value="@item.Value" selected="@(item.Value == locationFilter)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="btn-group w-100">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i>Search
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-redo me-1"></i>Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Fridges Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Fridges (@totalCount total)
                    </h5>
                </div>
                <div class="col-auto">
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-download me-1"></i>Export
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#"><i class="fas fa-file-excel me-2"></i>Excel</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-file-pdf me-2"></i>PDF</a></li>
                            <li><a class="dropdown-item" href="#"><i class="fas fa-file-csv me-2"></i>CSV</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Serial Number</th>
                            <th>Fridge Model</th>
                            <th>Location</th>
                            <th>Customer</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Last Service</th>
                            <th>Next Service</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fridge in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0">
                                            <i class="fas fa-refrigerator text-primary me-2"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <strong>@fridge.SerialNumber</strong>
                                            @if (fridge.UnderWarranty)
                                            {
                                                <span class="badge bg-success ms-1" title="Under Warranty">
                                                    <i class="fas fa-shield-alt"></i>
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (fridge.FridgeModelDetails != null)
                                    {
                                        <div>
                                            <strong>@fridge.FridgeModelDetails.Manufacturer</strong>
                                            <div class="text-muted small">@fridge.FridgeModelDetails.ModelName</div>
                                            <div class="text-muted small">@fridge.FridgeModelDetails.ModelCode</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (fridge.LocationDetails != null)
                                    {
                                        <div>
                                            <div>@fridge.LocationDetails.Suburb</div>
                                            <div class="text-muted small">@fridge.LocationDetails.City</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Assigned</span>
                                    }
                                </td>
                                <td>
                                    @if (fridge.CustomerDetails != null)
                                    {
                                        <div>
                                            <div>@fridge.CustomerDetails.BusinessName</div>
                                            <div class="text-muted small">@fridge.CustomerDetails.BusinessType</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Allocated</span>
                                    }
                                </td>
                                <td>
                                    @switch (fridge.Condition)
                                    {
                                        case FridgeCondition.Excellent:
                                            <span class="badge bg-success">@fridge.Condition</span>
                                            break;
                                        case FridgeCondition.Good:
                                            <span class="badge bg-info">@fridge.Condition</span>
                                            break;
                                        case FridgeCondition.Fair:
                                            <span class="badge bg-warning">@fridge.Condition</span>
                                            break;
                                        case FridgeCondition.Poor:
                                            <span class="badge bg-danger">@fridge.Condition</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@fridge.Condition</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (fridge.Status)
                                    {
                                        case FridgeStatus.Available:
                                            <span class="badge bg-success">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.Allocated:
                                            <span class="badge bg-primary">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.UnderMaintenance:
                                            <span class="badge bg-warning">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.Faulty:
                                            <span class="badge bg-danger">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.InTransit:
                                            <span class="badge bg-info">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.Quarantined:
                                            <span class="badge bg-secondary">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.Scrapped:
                                            <span class="badge bg-dark">@fridge.Status</span>
                                            break;
                                        case FridgeStatus.LostStolen:
                                            <span class="badge bg-danger">@fridge.Status</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@fridge.Status</span>
                                            break;
                                    }
                                    @if (fridge.RequiresMaintenance)
                                    {
                                        <span class="badge bg-warning mt-1" title="Maintenance Due">
                                            <i class="fas fa-tools"></i>
                                        </span>
                                    }
                                    @if (fridge.OpenFaultCount > 0)
                                    {
                                        <span class="badge bg-danger mt-1" title="@fridge.OpenFaultCount open fault(s)">
                                            <i class="fas fa-exclamation-triangle"></i> @fridge.OpenFaultCount
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (fridge.LastServiceDate.HasValue)
                                    {
                                        <div>@fridge.LastServiceDate.Value.ToString("dd/MM/yyyy")</div>
                                        <div class="text-muted small">@fridge.TotalServiceCount services</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    @if (fridge.NextServiceDue.HasValue)
                                    {
                                        var daysUntilDue = fridge.DaysUntilServiceDue;
                                        <div class="@(daysUntilDue <= 7 ? "text-warning fw-bold" : "text-muted")">
                                            @fridge.NextServiceDue.Value.ToString("dd/MM/yyyy")
                                        </div>
                                        @if (daysUntilDue.HasValue)
                                        {
                                            <div class="text-muted small">
                                                @if (daysUntilDue <= 0)
                                                {
                                                    <span class="text-danger">Overdue</span>
                                                }
                                                else
                                                {
                                                    <span>in @daysUntilDue days</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Set</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@fridge.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Upsert" asp-route-id="@fridge.Id"
                                           class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <div class="dropdown">
                                            <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                                    data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-cog"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" href="#" data-bs-toggle="modal"
                                                       data-bs-target="#statusModal" data-fridge-id="@fridge.Id"
                                                       data-current-status="@fridge.Status">
                                                        <i class="fas fa-sync me-2"></i>Change Status
                                                    </a>
                                                </li>
                                                @if (fridge.CanBeServiced)
                                                {
                                                    <li>
                                                        <a class="dropdown-item" href="#" data-bs-toggle="modal"
                                                           data-bs-target="#serviceModal" data-fridge-id="@fridge.Id">
                                                            <i class="fas fa-tools me-2"></i>Record Service
                                                        </a>
                                                    </li>
                                                }
                                                @if (fridge.CanBeScrapped)
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-danger" href="#" data-bs-toggle="modal"
                                                           data-bs-target="#scrapModal" data-fridge-id="@fridge.Id">
                                                            <i class="fas fa-trash me-2"></i>Scrap Fridge
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-refrigerator fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">No Fridges Found</h4>
                    <p class="text-muted">Try adjusting your search criteria or add a new fridge.</p>
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Add New Fridge
                    </a>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer">
                <nav aria-label="Fridge pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-searchString="@searchString"
                               asp-route-statusFilter="@statusFilter"
                               asp-route-conditionFilter="@conditionFilter"
                               asp-route-locationFilter="@locationFilter">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@searchString"
                                   asp-route-statusFilter="@statusFilter"
                                   asp-route-conditionFilter="@conditionFilter"
                                   asp-route-locationFilter="@locationFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-searchString="@searchString"
                               asp-route-statusFilter="@statusFilter"
                               asp-route-conditionFilter="@conditionFilter"
                               asp-route-locationFilter="@locationFilter">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
                <div class="text-center text-muted small mt-2">
                    Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalCount) of @totalCount fridges
                </div>
            </div>
        }
    </div>
</div>

<!-- Status Change Modal -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="fas fa-sync me-2"></i>Change Fridge Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="statusForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="statusFridgeId" name="id">
                    <input type="hidden" id="currentStatus" name="currentStatus">

                    <div class="mb-3">
                        <label for="newStatus" class="form-label">New Status</label>
                        <select class="form-select" id="newStatus" name="status" required>
                            <option value="">-- Select Status --</option>
                            @foreach (var status in Enum.GetValues<FridgeStatus>())
                            {
                                <option value="@status">@status.GetDisplayName()</option>
                            }
                        </select>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Current Status:</strong> <span id="currentStatusDisplay"></span>
                    </div>

                    <div id="statusValidation" class="alert alert-warning d-none">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <span id="statusValidationMessage"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="submitStatusChange">
                        <i class="fas fa-save me-1"></i>Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Record Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fas fa-tools me-2"></i>Record Service
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="serviceForm" method="post" asp-action="RecordService">
                <div class="modal-body">
                    <input type="hidden" id="serviceFridgeId" name="id">

                    <div class="mb-3">
                        <label for="serviceDate" class="form-label required">Service Date</label>
                        <input type="date" class="form-control" id="serviceDate" name="serviceDate"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                    </div>

                    <div class="mb-3">
                        <label for="serviceNotes" class="form-label">Service Notes</label>
                        <textarea class="form-control" id="serviceNotes" name="serviceNotes"
                                  rows="3" placeholder="Describe the service performed..."></textarea>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Next service due date will be automatically calculated based on the fridge model's service interval.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save me-1"></i>Record Service
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scrap Fridge Modal -->
<div class="modal fade" id="scrapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-trash me-2"></i>Scrap Fridge
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="scrapForm" method="post" asp-action="Scrap">
                <div class="modal-body">
                    <input type="hidden" id="scrapFridgeId" name="id">

                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <h5 class="alert-heading">Warning: This action cannot be undone!</h5>
                        <p class="mb-0">
                            Scrapping a fridge will permanently remove it from active inventory.
                            This action should only be performed for fridges that are beyond repair.
                        </p>
                    </div>

                    <div class="mb-3">
                        <label for="scrapReason" class="form-label required">Scrap Reason</label>
                        <textarea class="form-control" id="scrapReason" name="reason"
                                  rows="3" placeholder="Explain why this fridge is being scrapped..."
                                  required></textarea>
                        <div class="form-text">
                            Please provide a detailed reason for scrapping this fridge for audit purposes.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i>Confirm Scrap
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Status Modal Handling
        document.addEventListener('DOMContentLoaded', function() {
            // Status Modal
            const statusModal = document.getElementById('statusModal');
            statusModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const fridgeId = button.getAttribute('data-fridge-id');
                const currentStatus = button.getAttribute('data-current-status');

                document.getElementById('statusFridgeId').value = fridgeId;
                document.getElementById('currentStatus').value = currentStatus;
                document.getElementById('currentStatusDisplay').textContent = currentStatus;

                // Update form action
                document.getElementById('statusForm').action = `@Url.Action("UpdateStatus")/${fridgeId}`;
            });

            // Service Modal
            const serviceModal = document.getElementById('serviceModal');
            serviceModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const fridgeId = button.getAttribute('data-fridge-id');
                document.getElementById('serviceFridgeId').value = fridgeId;
            });

            // Scrap Modal
            const scrapModal = document.getElementById('scrapModal');
            scrapModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const fridgeId = button.getAttribute('data-fridge-id');
                document.getElementById('scrapFridgeId').value = fridgeId;
            });

            // Status validation
            document.getElementById('newStatus').addEventListener('change', function() {
                const currentStatus = document.getElementById('currentStatus').value;
                const newStatus = this.value;
                const validationDiv = document.getElementById('statusValidation');

                if (currentStatus === newStatus) {
                    validationDiv.classList.remove('d-none');
                    document.getElementById('statusValidationMessage').textContent =
                        'New status is the same as current status.';
                    document.getElementById('submitStatusChange').disabled = true;
                } else {
                    validationDiv.classList.add('d-none');
                    document.getElementById('submitStatusChange').disabled = false;
                }
            });

            // Form submissions
            document.getElementById('statusForm').addEventListener('submit', function(e) {
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Updating...';
            });

            document.getElementById('serviceForm').addEventListener('submit', function(e) {
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Recording...';
            });

            document.getElementById('scrapForm').addEventListener('submit', function(e) {
                const submitBtn = this.querySelector('button[type="submit"]');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Scrapping...';
            });
        });

        // Quick actions
        function quickAction(fridgeId, action) {
            switch(action) {
                case 'available':
                    updateStatus(fridgeId, 'Available');
                    break;
                case 'maintenance':
                    updateStatus(fridgeId, 'UnderMaintenance');
                    break;
                case 'faulty':
                    updateStatus(fridgeId, 'Faulty');
                    break;
            }
        }

        function updateStatus(fridgeId, status) {
            if (confirm(`Change fridge status to ${status}?`)) {
                fetch(`@Url.Action("UpdateStatus")/${fridgeId}?status=${status}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        alert('Error updating status');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error updating status');
                });
            }
        }
    </script>
}