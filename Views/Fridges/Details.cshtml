@model FridgeVM
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Fridge Details";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Fridge Management</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-primary">
                    <i class="fas fa-refrigerator me-2"></i>Fridge Details
                </h1>
                <div class="btn-group">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to List
                    </a>
                    <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="fas fa-edit me-1"></i>Edit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row">
        <!-- Left Column - Fridge Information -->
        <div class="col-lg-8">
            <!-- Basic Information Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Basic Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Serial Number</dt>
                                <dd class="col-sm-8">
                                    <strong class="fs-5">@Model.SerialNumber</strong>
                                    @if (Model.UnderWarranty)
                                    {
                                        <span class="badge bg-success ms-2" title="Under Warranty">
                                            <i class="fas fa-shield-alt me-1"></i>Warranty
                                        </span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Fridge Model</dt>
                                <dd class="col-sm-8">
                                    @if (Model.FridgeModelDetails != null)
                                    {
                                        <div>
                                            <strong>@Model.FridgeModelDetails.Manufacturer @Model.FridgeModelDetails.ModelName</strong>
                                            <div class="text-muted small">@Model.FridgeModelDetails.ModelCode</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Location</dt>
                                <dd class="col-sm-8">
                                    @if (Model.LocationDetails != null)
                                    {
                                        <div>
                                            <div>@Model.LocationDetails.StreetAddress</div>
                                            <div class="text-muted small">
                                                @Model.LocationDetails.Suburb, @Model.LocationDetails.City, @Model.LocationDetails.Province
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Assigned</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Customer</dt>
                                <dd class="col-sm-8">
                                    @if (Model.CustomerDetails != null)
                                    {
                                        <div>
                                            <strong>@Model.CustomerDetails.BusinessName</strong>
                                            <div class="text-muted small">@Model.CustomerDetails.BusinessType</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Allocated</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Condition</dt>
                                <dd class="col-sm-8">
                                    @switch (Model.Condition)
                                    {
                                        case FridgeCondition.Excellent:
                                            <span class="badge bg-success fs-6">@Model.Condition</span>
                                            break;
                                        case FridgeCondition.Good:
                                            <span class="badge bg-info fs-6">@Model.Condition</span>
                                            break;
                                        case FridgeCondition.Fair:
                                            <span class="badge bg-warning fs-6">@Model.Condition</span>
                                            break;
                                        case FridgeCondition.Poor:
                                            <span class="badge bg-danger fs-6">@Model.Condition</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary fs-6">@Model.Condition</span>
                                            break;
                                    }
                                </dd>

                                <dt class="col-sm-4">Status</dt>
                                <dd class="col-sm-8">
                                    @switch (Model.Status)
                                    {
                                        case FridgeStatus.Available:
                                            <span class="badge bg-success fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.Allocated:
                                            <span class="badge bg-primary fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.UnderMaintenance:
                                            <span class="badge bg-warning fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.Faulty:
                                            <span class="badge bg-danger fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.InTransit:
                                            <span class="badge bg-info fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.Quarantined:
                                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.Scrapped:
                                            <span class="badge bg-dark fs-6">@Model.Status</span>
                                            break;
                                        case FridgeStatus.LostStolen:
                                            <span class="badge bg-danger fs-6">@Model.Status</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary fs-6">@Model.Status</span>
                                            break;
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Purchase & Warranty Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>Purchase & Warranty Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Purchase Date</dt>
                                <dd class="col-sm-8">@(Model.PurchaseDate?.ToString("dd/MM/yyyy") ?? "Not Set")</dd>

                                <dt class="col-sm-4">Supplier</dt>
                                <dd class="col-sm-8">@(Model.Supplier ?? "Not Specified")</dd>

                                <dt class="col-sm-4">Purchase Price</dt>
                                <dd class="col-sm-8">@(Model.PurchasePrice?.ToString("C") ?? "Not Set")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Warranty Expiry</dt>
                                <dd class="col-sm-8">
                                    @if (Model.WarrantyExpiryDate.HasValue)
                                    {
                                        var warrantyStatus = Model.UnderWarranty ? "text-success" : "text-danger";
                                        <span class="@warrantyStatus">
                                            @Model.WarrantyExpiryDate.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Set</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Age</dt>
                                <dd class="col-sm-8">
                                    @if (Model.AgeInYears.HasValue)
                                    {
                                        <span>@Model.AgeInYears.Value.ToString("F1") years</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Last Fault</dt>
                                <dd class="col-sm-8">
                                    @(Model.LastFaultDate?.ToString("dd/MM/yyyy") ?? "Never")
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Maintenance Information -->
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-tools me-2"></i>Maintenance Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Last Service</dt>
                                <dd class="col-sm-8">
                                    @(Model.LastServiceDate?.ToString("dd/MM/yyyy") ?? "Never")
                                </dd>

                                <dt class="col-sm-4">Total Services</dt>
                                <dd class="col-sm-8">@Model.TotalServiceCount</dd>

                                <dt class="col-sm-4">Service Interval</dt>
                                <dd class="col-sm-8">
                                    @(Model.FridgeModelDetails?.ServiceIntervalMonths ?? 6) months
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Next Service Due</dt>
                                <dd class="col-sm-8">
                                    @if (Model.NextServiceDue.HasValue)
                                    {
                                        var daysUntilDue = Model.DaysUntilServiceDue;
                                        var textClass = daysUntilDue <= 0 ? "text-danger fw-bold" :
                                        daysUntilDue <= 7 ? "text-warning fw-bold" : "text-success";
                                        <span class="@textClass">
                                            @Model.NextServiceDue.Value.ToString("dd/MM/yyyy")
                                        </span>
                                        @if (daysUntilDue.HasValue)
                                        {
                                            <div class="text-muted small">
                                                @if (daysUntilDue <= 0)
                                                {
                                                    <span class="text-danger">Overdue by @Math.Abs(daysUntilDue.Value) days</span>
                                                }
                                                else
                                                {
                                                    <span>in @daysUntilDue days</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Set</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Maintenance Required</dt>
                                <dd class="col-sm-8">
                                    @if (Model.RequiresMaintenance)
                                    {
                                        <span class="badge bg-danger">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Actions & Statistics -->
        <div class="col-lg-4">
            <!-- Quick Actions Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <!-- Status Change -->
                        <button type="button" class="btn btn-outline-primary text-start" data-bs-toggle="modal" data-bs-target="#statusModal">
                            <i class="fas fa-sync me-2"></i>Change Status
                        </button>

                        <!-- Record Service -->
                        @if (Model.CanBeServiced)
                        {
                            <button type="button" class="btn btn-outline-warning text-start" data-bs-toggle="modal" data-bs-target="#serviceModal">
                                <i class="fas fa-tools me-2"></i>Record Service
                            </button>
                        }

                        <!-- Scrap Fridge -->
                        @if (Model.CanBeScrapped)
                        {
                            <button type="button" class="btn btn-outline-danger text-start" data-bs-toggle="modal" data-bs-target="#scrapModal">
                                <i class="fas fa-trash me-2"></i>Scrap Fridge
                            </button>
                        }

                        <!-- Allocate Fridge -->
                        @if (Model.CanBeAllocated)
                        {
                            <a href="#" class="btn btn-outline-info text-start">
                                <i class="fas fa-user-plus me-2"></i>Allocate to Customer
                            </a>
                        }

                        <!-- View History -->
                        <a href="#" class="btn btn-outline-secondary text-start">
                            <i class="fas fa-history me-2"></i>View Full History
                        </a>
                    </div>
                </div>
            </div>

            <!-- Statistics Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Statistics
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="bg-primary text-white rounded p-3">
                                <i class="fas fa-history fa-2x mb-2"></i>
                                <h4 class="mb-0">@Model.AllocationHistoryCount</h4>
                                <small>Allocations</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="bg-success text-white rounded p-3">
                                <i class="fas fa-tools fa-2x mb-2"></i>
                                <h4 class="mb-0">@Model.MaintenanceHistoryCount</h4>
                                <small>Services</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="bg-warning text-dark rounded p-3">
                                <i class="fas fa-bug fa-2x mb-2"></i>
                                <h4 class="mb-0">@Model.FaultReportCount</h4>
                                <small>Fault Reports</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="bg-danger text-white rounded p-3">
                                <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                                <h4 class="mb-0">@Model.OpenFaultCount</h4>
                                <small>Open Faults</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Summary Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-clipboard-list me-2"></i>Status Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <strong>Current Status:</strong>
                        <div class="mt-1">
                            @switch (Model.Status)
                            {
                                case FridgeStatus.Available:
                                    <span class="badge bg-success">Available for Allocation</span>
                                    break;
                                case FridgeStatus.Allocated:
                                    <span class="badge bg-primary">Currently Allocated</span>
                                    break;
                                case FridgeStatus.UnderMaintenance:
                                    <span class="badge bg-warning">Under Maintenance</span>
                                    break;
                                case FridgeStatus.Faulty:
                                    <span class="badge bg-danger">Faulty - Needs Repair</span>
                                    break;
                                case FridgeStatus.InTransit:
                                    <span class="badge bg-info">In Transit</span>
                                    break;
                                case FridgeStatus.Quarantined:
                                    <span class="badge bg-secondary">Quarantined</span>
                                    break;
                                case FridgeStatus.Scrapped:
                                    <span class="badge bg-dark">Scrapped</span>
                                    break;
                                case FridgeStatus.LostStolen:
                                    <span class="badge bg-danger">Lost/Stolen</span>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Condition:</strong>
                        <div class="mt-1">
                            @switch (Model.Condition)
                            {
                                case FridgeCondition.Excellent:
                                    <span class="badge bg-success">Excellent - Like New</span>
                                    break;
                                case FridgeCondition.Good:
                                    <span class="badge bg-info">Good - Minor Wear</span>
                                    break;
                                case FridgeCondition.Fair:
                                    <span class="badge bg-warning">Fair - Needs Attention</span>
                                    break;
                                case FridgeCondition.Poor:
                                    <span class="badge bg-danger">Poor - Replacement Recommended</span>
                                    break;
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Maintenance Status:</strong>
                        <div class="mt-1">
                            @if (Model.RequiresMaintenance)
                            {
                                <span class="badge bg-danger">Maintenance Overdue</span>
                            }
                            else if (Model.DaysUntilServiceDue <= 30)
                            {
                                <span class="badge bg-warning">Maintenance Due Soon</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Maintenance Up to Date</span>
                            }
                        </div>
                    </div>

                    <div>
                        <strong>Warranty Status:</strong>
                        <div class="mt-1">
                            @if (Model.UnderWarranty)
                            {
                                <span class="badge bg-success">Under Warranty</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Warranty Expired</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Modals (same as in Index view) -->
    <!-- Status Change Modal -->
    <div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-sync me-2"></i>Change Fridge Status
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="statusForm" method="post" asp-action="UpdateStatus">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="newStatus" class="form-label">New Status</label>
                            <select class="form-select" id="newStatus" name="status" required>
                                <option value="">-- Select Status --</option>
                                @foreach (var status in Enum.GetValues<FridgeStatus>())
                                {
                                    <option value="@status" selected="@(status == Model.Status)">@status.GetDisplayName()</option>
                                }
                            </select>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Current Status:</strong> @Model.Status
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Update Status
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Record Service Modal -->
    <div class="modal fade" id="serviceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title">
                        <i class="fas fa-tools me-2"></i>Record Service
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="RecordService">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="serviceDate" class="form-label required">Service Date</label>
                            <input type="date" class="form-control" id="serviceDate" name="serviceDate"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="mb-3">
                            <label for="serviceNotes" class="form-label">Service Notes</label>
                            <textarea class="form-control" id="serviceNotes" name="serviceNotes"
                                      rows="3" placeholder="Describe the service performed..."></textarea>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Next service due: @Model.NextServiceDue?.ToString("dd/MM/yyyy") ?? "Not set"
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-1"></i>Record Service
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scrap Fridge Modal -->
    <div class="modal fade" id="scrapModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-trash me-2"></i>Scrap Fridge
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-action="Scrap">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-body">
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                            <h5 class="alert-heading">Warning: This action cannot be undone!</h5>
                            <p class="mb-0">
                                Scrapping fridge <strong>@Model.SerialNumber</strong> will permanently remove it from active inventory.
                            </p>
                        </div>

                        <div class="mb-3">
                            <label for="scrapReason" class="form-label required">Scrap Reason</label>
                            <textarea class="form-control" id="scrapReason" name="reason"
                                      rows="3" placeholder="Explain why this fridge is being scrapped..."
                                      required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i>Confirm Scrap
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set max date for service date to today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('serviceDate').max = today;

            // Form submission handlers
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                    }
                });
            });

            // Auto-refresh for real-time updates
            setInterval(() => {
                // You could implement real-time status updates here
            }, 30000); // Every 30 seconds
        });
    </script>
}