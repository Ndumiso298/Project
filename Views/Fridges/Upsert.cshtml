@model FridgeVM
@using Microsoft.AspNetCore.Identity
@using Project.Utilities
@using Project.Models

@{
    ViewData["Title"] = Model.Id == 0 ? "Create New Fridge" : "Edit Fridge";
    var isCreate = Model.Id == 0;
    var action = isCreate ? "Create" : "Edit";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 text-primary">
                        <i class="bi bi-refrigerator me-2"></i>@ViewData["Title"]
                    </h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item"><a asp-action="Index">Fridge Inventory</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@action</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Fridge @action Form
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Upsert" method="post" id="fridgeForm">
                        <input type="hidden" asp-for="Id" />

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Basic Information Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-info-circle me-2"></i>Basic Information
                                </h5>
                            </div>

                            <!-- Serial Number -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="SerialNumber" class="form-label required"></label>
                                <input asp-for="SerialNumber" class="form-control"
                                       placeholder="Enter serial number (e.g., FRIDGE-001)" />
                                <span asp-validation-for="SerialNumber" class="text-danger"></span>
                                <div class="form-text">Serial number must be unique.</div>
                            </div>

                            <!-- Fridge Model -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="FridgeModelId" class="form-label required"></label>
                                <select asp-for="FridgeModelId" asp-items="Model.FridgeModelList"
                                        class="form-select" id="fridgeModelSelect">
                                    <option value="">-- Select Fridge Model --</option>
                                </select>
                                <span asp-validation-for="FridgeModelId" class="text-danger"></span>
                            </div>

                            <!-- Status and Condition -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label required"></label>
                                <select asp-for="Status" asp-items="Model.StatusList" class="form-select">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Condition" class="form-label required"></label>
                                <select asp-for="Condition" asp-items="Model.ConditionList" class="form-select">
                                    <option value="">-- Select Condition --</option>
                                </select>
                                <span asp-validation-for="Condition" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Location Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-geo-alt me-2"></i>Location Information
                                </h5>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label asp-for="LocationId" class="form-label required"></label>
                                <select asp-for="LocationId" asp-items="Model.LocationList" class="form-select">
                                    <option value="">-- Select Location --</option>
                                </select>
                                <span asp-validation-for="LocationId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Purchase Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-cart me-2"></i>Purchase Information
                                </h5>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchaseDate" class="form-label"></label>
                                <input asp-for="PurchaseDate" type="date" class="form-control" />
                                <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="PurchasePrice" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <input asp-for="PurchasePrice" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Supplier" class="form-label"></label>
                                <select asp-for="Supplier" asp-items="Model.SupplierList" class="form-select">
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="Supplier" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Warranty Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-shield-check me-2"></i>Warranty Information
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="WarrantyExpiryDate" class="form-label"></label>
                                <input asp-for="WarrantyExpiryDate" type="date" class="form-control" />
                                <span asp-validation-for="WarrantyExpiryDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Model Warranty</label>
                                <div class="form-control-plaintext" id="modelWarrantyDisplay">
                                    <em class="text-muted">Select a fridge model to see warranty information</em>
                                </div>
                            </div>
                        </div>

                        <!-- Maintenance Information -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="bi bi-tools me-2"></i>Maintenance Information
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastServiceDate" class="form-label"></label>
                                <input asp-for="LastServiceDate" type="date" class="form-control" id="lastServiceDate" />
                                <span asp-validation-for="LastServiceDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Next Service Due</label>
                                <div class="form-control-plaintext" id="nextServiceDueDisplay">
                                    <em class="text-muted">Will be calculated based on last service date</em>
                                </div>
                            </div>

                            <div class="col-md-12 mb-3">
                                <label class="form-label">Service Interval</label>
                                <div class="form-control-plaintext" id="serviceIntervalDisplay">
                                    <em class="text-muted">Select a fridge model to see service interval</em>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-1"></i>Cancel
                                    </a>
                                    <div class="btn-group">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-check-circle me-1"></i>@(isCreate ? "Create Fridge" : "Update Fridge")
                                        </button>
                                        @if (!isCreate)
                                        {
                                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                                                <i class="bi bi-eye me-1"></i>View Details
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fridgeModelSelect = document.getElementById('fridgeModelSelect');
            const lastServiceDate = document.getElementById('lastServiceDate');
            const modelWarrantyDisplay = document.getElementById('modelWarrantyDisplay');
            const serviceIntervalDisplay = document.getElementById('serviceIntervalDisplay');
            const nextServiceDueDisplay = document.getElementById('nextServiceDueDisplay');

            // Load fridge model details when model is selected
            fridgeModelSelect.addEventListener('change', function() {
                const modelId = this.value;
                if (modelId) {
                    fetch(`/Fridges/GetFridgeModelDetails?modelId=${modelId}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.error) {
                                modelWarrantyDisplay.innerHTML = `<span class="text-danger">${data.error}</span>`;
                                serviceIntervalDisplay.innerHTML = `<span class="text-danger">${data.error}</span>`;
                            } else {
                                modelWarrantyDisplay.innerHTML = `${data.warrantyPeriodMonths} months warranty`;
                                serviceIntervalDisplay.innerHTML = `Service required every ${data.serviceIntervalMonths} months`;
                                updateNextServiceDue();
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            modelWarrantyDisplay.innerHTML = '<span class="text-danger">Error loading model details</span>';
                            serviceIntervalDisplay.innerHTML = '<span class="text-danger">Error loading model details</span>';
                        });
                } else {
                    modelWarrantyDisplay.innerHTML = '<em class="text-muted">Select a fridge model to see warranty information</em>';
                    serviceIntervalDisplay.innerHTML = '<em class="text-muted">Select a fridge model to see service interval</em>';
                    nextServiceDueDisplay.innerHTML = '<em class="text-muted">Will be calculated based on last service date</em>';
                }
            });

            // Update next service due when last service date changes
            lastServiceDate.addEventListener('change', updateNextServiceDue);

            function updateNextServiceDue() {
                const serviceDate = lastServiceDate.value;
                const modelId = fridgeModelSelect.value;

                if (serviceDate && modelId) {
                    fetch(`/Fridges/GetFridgeModelDetails?modelId=${modelId}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.serviceIntervalMonths) {
                                const serviceDateObj = new Date(serviceDate);
                                const nextDue = new Date(serviceDateObj);
                                nextDue.setMonth(nextDue.getMonth() + data.serviceIntervalMonths);

                                const options = { year: 'numeric', month: 'short', day: 'numeric' };
                                nextServiceDueDisplay.innerHTML = nextDue.toLocaleDateString('en-ZA', options);
                            }
                        });
                } else if (serviceDate) {
                    nextServiceDueDisplay.innerHTML = '<em class="text-warning">Select a fridge model to calculate next service due</em>';
                } else {
                    nextServiceDueDisplay.innerHTML = '<em class="text-muted">Will be calculated based on last service date</em>';
                }
            }

            // Serial number validation
            const serialNumberInput = document.querySelector('input[name="SerialNumber"]');
            if (serialNumberInput) {
                serialNumberInput.addEventListener('blur', function() {
                    const serialNumber = this.value;
                    const fridgeId = @Model.Id;

                    if (serialNumber.length > 0) {
                        fetch(`/Fridges/VerifySerialNumber?serialNumber=${encodeURIComponent(serialNumber)}&id=${fridgeId}`)
                            .then(response => response.json())
                            .then(data => {
                                const feedbackElement = this.nextElementSibling;
                                if (data.isValid) {
                                    this.classList.remove('is-invalid');
                                    this.classList.add('is-valid');
                                    if (feedbackElement) {
                                        feedbackElement.className = 'text-success';
                                        feedbackElement.textContent = data.message;
                                    }
                                } else {
                                    this.classList.remove('is-valid');
                                    this.classList.add('is-invalid');
                                    if (feedbackElement) {
                                        feedbackElement.className = 'text-danger';
                                        feedbackElement.textContent = data.message;
                                    }
                                }
                            });
                    }
                });
            }

            // Initialize displays if values are already set
            if (fridgeModelSelect.value) {
                fridgeModelSelect.dispatchEvent(new Event('change'));
            }
            if (lastServiceDate.value) {
                updateNextServiceDue();
            }
        });
    </script>

    <style>
        .required::after {
            content: " *";
            color: red;
        }

        .form-control.is-valid, .form-select.is-valid {
            border-color: #198754;
            padding-right: calc(1.5em + 0.75rem);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
    </style>
}