@model FridgeVM
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Add New Fridge" : "Edit Fridge";
    var action = isCreate ? "Create" : "Edit";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Fridge Management</a></li>
                    <li class="breadcrumb-item active">@(isCreate ? "Add New" : "Edit")</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-primary">
                    <i class="fas fa-refrigerator me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas @(isCreate ? "fa-plus" : "fa-edit") me-2"></i>
                @(isCreate ? "Add a new fridge to inventory" : "Edit fridge details")
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Upsert" method="post" id="fridgeForm">
                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <!-- Basic Information Column -->
                    <div class="col-lg-6">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-info-circle me-2"></i>Basic Information
                        </h5>

                        <!-- Serial Number -->
                        <div class="mb-3">
                            <label asp-for="SerialNumber" class="form-label required"></label>
                            <input asp-for="SerialNumber" class="form-control"
                                   placeholder="Enter unique serial number"
                                   id="serialNumberInput"
                                   onblur="validateSerialNumber()" />
                            <div class="form-text">
                                Serial number must be unique and contain only uppercase letters, numbers, and hyphens.
                            </div>
                            <span asp-validation-for="SerialNumber" class="text-danger"></span>
                            <div id="serialNumberFeedback" class="invalid-feedback"></div>
                        </div>

                        <!-- Fridge Model -->
                        <div class="mb-3">
                            <label asp-for="FridgeModelId" class="form-label required"></label>
                            <select asp-for="FridgeModelId" class="form-select" id="fridgeModelSelect" required>
                                <option value="">-- Select Fridge Model --</option>
                                @if (Model.FridgeModelList != null)
                                {
                                    foreach (var item in Model.FridgeModelList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.FridgeModelId.ToString())">
                                            @item.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="FridgeModelId" class="text-danger"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="LocationId" class="form-label"></label>
                            <select asp-for="LocationId" class="form-select">
                                <option value="">-- Select Location --</option>
                                @if (Model.LocationList != null)
                                {
                                    foreach (var item in Model.LocationList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.LocationId?.ToString())">
                                            @item.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>

                        <!-- Customer -->
                        <div class="mb-3">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">-- Select Customer --</option>
                                @if (Model.CustomerList != null)
                                {
                                    foreach (var item in Model.CustomerList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.CustomerId?.ToString())">
                                            @item.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Status & Condition Column -->
                    <div class="col-lg-6">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-cog me-2"></i>Status & Condition
                        </h5>

                        <!-- Condition -->
                        <div class="mb-3">
                            <label asp-for="Condition" class="form-label required"></label>
                            <select asp-for="Condition" class="form-select" required>
                                <option value="">-- Select Condition --</option>
                                @if (Model.ConditionList != null)
                                {
                                    foreach (var item in Model.ConditionList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.Condition.ToString())">
                                            @item.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Condition" class="text-danger"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label required"></label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="">-- Select Status --</option>
                                @if (Model.StatusList != null)
                                {
                                    foreach (var item in Model.StatusList)
                                    {
                                        <option value="@item.Value" selected="@(item.Value == Model.Status.ToString())">
                                            @item.Text
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- Purchase Information -->
                        <div class="mb-3">
                            <label asp-for="PurchaseDate" class="form-label"></label>
                            <input asp-for="PurchaseDate" type="date" class="form-control" />
                            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
                        </div>

                        <!-- Supplier -->
                        <div class="mb-3">
                            <label asp-for="Supplier" class="form-label"></label>
                            <input asp-for="Supplier" class="form-control"
                                   placeholder="Enter supplier name" />
                            <span asp-validation-for="Supplier" class="text-danger"></span>
                        </div>

                        <!-- Purchase Price -->
                        <div class="mb-3">
                            <label asp-for="PurchasePrice" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="PurchasePrice" class="form-control"
                                       placeholder="0.00" step="0.01" min="0" max="100000" />
                            </div>
                            <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Maintenance Information -->
                <div class="row mt-4">
                    <div class="col-12">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-tools me-2"></i>Maintenance Information
                        </h5>
                    </div>
                    <div class="col-md-6">
                        <!-- Warranty Expiry -->
                        <div class="mb-3">
                            <label asp-for="WarrantyExpiryDate" class="form-label"></label>
                            <input asp-for="WarrantyExpiryDate" type="date" class="form-control" />
                            <span asp-validation-for="WarrantyExpiryDate" class="text-danger"></span>
                        </div>

                        <!-- Last Service Date -->
                        <div class="mb-3">
                            <label asp-for="LastServiceDate" class="form-label"></label>
                            <input asp-for="LastServiceDate" type="date" class="form-control"
                                   id="lastServiceDate" />
                            <span asp-validation-for="LastServiceDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Next Service Due (Read-only) -->
                        <div class="mb-3">
                            <label for="nextServiceDueDisplay" class="form-label">Next Service Due</label>
                            <input type="text" class="form-control" id="nextServiceDueDisplay"
                                   readonly placeholder="Will be calculated automatically" />
                            <input type="hidden" asp-for="NextServiceDue" id="nextServiceDue" />
                            <div class="form-text">
                                Calculated based on last service date and fridge model service interval.
                            </div>
                        </div>

                        <!-- Total Service Count -->
                        <div class="mb-3">
                            <label asp-for="TotalServiceCount" class="form-label"></label>
                            <input asp-for="TotalServiceCount" class="form-control"
                                   min="0" max="1000" />
                            <span asp-validation-for="TotalServiceCount" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Fridge Model Details Preview -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-search me-2"></i>Fridge Model Details
                                </h6>
                                <div id="fridgeModelPreview" class="text-muted">
                                    Select a fridge model to see details...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            <div class="btn-group">
                                @if (!isCreate)
                                {
                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                        <i class="fas fa-eye me-1"></i>View Details
                                    </a>
                                }
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <i class="fas fa-save me-1"></i>@(isCreate ? "Create Fridge" : "Update Fridge")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Serial number validation
        async function validateSerialNumber() {
            const serialNumber = document.getElementById('serialNumberInput').value.trim().toUpperCase();
            const fridgeId = @Model.Id;

            if (!serialNumber) return;

            try {
                const response = await fetch('@Url.Action("VerifySerialNumber", "Fridges")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        serialNumber: serialNumber,
                        id: fridgeId
                    })
                });

                const data = await response.json();
                const feedback = document.getElementById('serialNumberFeedback');
                const input = document.getElementById('serialNumberInput');

                if (data.isValid) {
                    input.classList.remove('is-invalid');
                    input.classList.add('is-valid');
                    feedback.textContent = data.message;
                    feedback.className = 'valid-feedback';
                } else {
                    input.classList.remove('is-valid');
                    input.classList.add('is-invalid');
                    feedback.textContent = data.message;
                    feedback.className = 'invalid-feedback';
                }
            } catch (error) {
                console.error('Error validating serial number:', error);
            }
        }

        // Fridge model details loading
        document.getElementById('fridgeModelSelect').addEventListener('change', async function() {
            const modelId = this.value;

            if (!modelId) {
                document.getElementById('fridgeModelPreview').innerHTML =
                    'Select a fridge model to see details...';
                return;
            }

            try {
                const response = await fetch(`@Url.Action("GetFridgeModelDetails", "Fridges")?modelId=${modelId}`);
                const data = await response.json();

                if (data.error) {
                    document.getElementById('fridgeModelPreview').innerHTML =
                        `<span class="text-danger">${data.error}</span>`;
                    return;
                }

                document.getElementById('fridgeModelPreview').innerHTML = `
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Manufacturer:</strong> ${data.manufacturer}<br>
                            <strong>Model:</strong> ${data.modelName}<br>
                            <strong>Code:</strong> ${data.modelCode}
                        </div>
                        <div class="col-md-6">
                            <strong>Service Interval:</strong> ${data.serviceIntervalMonths} months<br>
                            <strong>Monthly Rental:</strong> R ${data.monthlyRentalPrice?.toFixed(2) || '0.00'}<br>
                            <strong>Warranty:</strong> ${data.warrantyPeriodMonths} months
                        </div>
                    </div>
                `;

                // Auto-calculate next service due if last service date exists
                calculateNextServiceDue();
            } catch (error) {
                console.error('Error loading fridge model details:', error);
                document.getElementById('fridgeModelPreview').innerHTML =
                    '<span class="text-danger">Error loading model details</span>';
            }
        });

        // Calculate next service due date
        function calculateNextServiceDue() {
            const lastServiceDate = document.getElementById('lastServiceDate').value;
            const modelId = document.getElementById('fridgeModelSelect').value;

            if (!lastServiceDate || !modelId) {
                document.getElementById('nextServiceDueDisplay').value = '';
                document.getElementById('nextServiceDue').value = '';
                return;
            }

            // Calculate next service due (this would typically be done server-side)
            // For now, we'll just display a message
            document.getElementById('nextServiceDueDisplay').value =
                'Will be calculated after saving';
        }

        // Attach event listener to last service date
        document.getElementById('lastServiceDate').addEventListener('change', calculateNextServiceDue);

        // Form submission handling
        document.getElementById('fridgeForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving...';

            // Auto-format serial number to uppercase
            const serialInput = document.getElementById('serialNumberInput');
            serialInput.value = serialInput.value.trim().toUpperCase();
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Trigger fridge model details if already selected
            const modelSelect = document.getElementById('fridgeModelSelect');
            if (modelSelect.value) {
                modelSelect.dispatchEvent(new Event('change'));
            }

            // Format dates for display
            const purchaseDate = document.querySelector('input[asp-for="PurchaseDate"]');
            if (purchaseDate && purchaseDate.value) {
                const date = new Date(purchaseDate.value);
                purchaseDate.value = date.toISOString().split('T')[0];
            }

            const warrantyDate = document.querySelector('input[asp-for="WarrantyExpiryDate"]');
            if (warrantyDate && warrantyDate.value) {
                const date = new Date(warrantyDate.value);
                warrantyDate.value = date.toISOString().split('T')[0];
            }

            const lastServiceDate = document.getElementById('lastServiceDate');
            if (lastServiceDate && lastServiceDate.value) {
                const date = new Date(lastServiceDate.value);
                lastServiceDate.value = date.toISOString().split('T')[0];
            }
        });

        // Auto-save draft (optional)
        let autoSaveTimeout;
        function autoSaveDraft() {
            clearTimeout(autoSaveTimeout);
            autoSaveTimeout = setTimeout(() => {
                const formData = new FormData(document.getElementById('fridgeForm'));
                // Could implement local storage auto-save here
                console.log('Auto-save triggered');
            }, 2000);
        }

        // Attach auto-save to form fields
        document.querySelectorAll('#fridgeForm input, #fridgeForm select').forEach(element => {
            element.addEventListener('input', autoSaveDraft);
        });
    </script>

    <style>
        .required::after {
            content: " *";
            color: #dc3545;
        }

        .form-label {
            font-weight: 500;
            color: #495057;
        }

        .card-header {
            border-bottom: none;
        }

        .is-valid {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
        }

        .is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }

        .btn-group .btn {
            border-radius: 0.375rem;
        }

            .btn-group .btn:not(:first-child) {
                margin-left: 0.5rem;
            }
    </style>
}