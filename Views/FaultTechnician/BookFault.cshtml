@model Project.Models.FaultTechnician

@{
    var source = ViewBag.Source as string ?? "Fault";
    ViewData["Title"] = $"Book {source} Repair";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">@ViewData["Title"]</h6>
                    <span class="badge @(source == "Maintenance" ? "badge-warning" : "badge-primary")">@source</span>
                </div>
                <div class="card-body">
                    <!-- Fault Information -->
                    @if (Model.FridgeVisit != null)
                    {
                        <div class="alert alert-info">
                            <h6 class="alert-heading"><i class="fas fa-tools"></i> Maintenance Fault</h6>
                            <hr>
                            <p class="mb-1"><strong>Customer:</strong> @Model.FridgeVisit.RequestHeader?.FirstName @Model.FridgeVisit.RequestHeader?.LastName</p>
                            <p class="mb-1"><strong>Fridge:</strong> @Model.FridgeVisit.RequestHeader?.RequestFridges.FirstOrDefault()?.Fridge.Model</p>
                            <p class="mb-0"><strong>Description:</strong> @Model.FaultDescription</p>
                        </div>
                    }
                    else if (Model.FaultReport != null)
                    {
                        <div class="alert alert-primary">
                            <h6 class="alert-heading"><i class="fas fa-user"></i> Customer Reported Fault</h6>
                            <hr>
                            <p class="mb-1"><strong>Customer:</strong> @Model.FaultReport.Customer?.ApplicationUser?.UserName</p>
                            <p class="mb-1"><strong>Fridge:</strong> @Model.FaultReport.FridgeInStock?.Fridge.Model</p>
                            <p class="mb-0"><strong>Fault Type:</strong> @Model.FaultReport.FaultType</p>
                        </div>
                    }

                    <form asp-action="BookFault" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="FaultId" />
                        <input type="hidden" asp-for="VisitId" />
                        <input type="hidden" asp-for="FaultReportId" />

                        <div class="row">
                            <div class="col-md-6">
                                <!-- Technician Assigned -->
                                <div class="form-group">
                                    <label asp-for="TechnicianAssigned" class="font-weight-bold text-dark"></label>
                                    <input asp-for="TechnicianAssigned" class="form-control" placeholder="Enter technician name" required />
                                    <span asp-validation-for="TechnicianAssigned" class="text-danger small"></span>
                                    <div class="invalid-feedback">Please enter technician name.</div>
                                </div>

                                <!-- Booking Date -->
                                <div class="form-group">
                                    <label asp-for="Bookingate" class="font-weight-bold text-dark"></label>
                                    <input asp-for="Bookingate" type="datetime-local" class="form-control" required />
                                    <span asp-validation-for="Bookingate" class="text-danger small"></span>
                                    <div class="invalid-feedback">Please select booking date and time.</div>
                                </div>

                                <!-- Priority -->
                                <div class="form-group">
                                    <label asp-for="Priority" class="font-weight-bold text-dark"></label>
                                    <select asp-for="Priority" class="form-control" required>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>
                                        <option value="Critical">Critical</option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <!-- Fault Description -->
                                <div class="form-group">
                                    <label asp-for="FaultDescription" class="font-weight-bold text-dark"></label>
                                    <textarea asp-for="FaultDescription" class="form-control" rows="4"
                                              placeholder="Enter detailed fault description..." required></textarea>
                                    <span asp-validation-for="FaultDescription" class="text-danger small"></span>
                                    <div class="invalid-feedback">Please provide fault description.</div>
                                </div>

                                <!-- Repair Status -->
                                <div class="form-group">
                                    <label asp-for="RepairStatus" class="font-weight-bold text-dark"></label>
                                    <select asp-for="RepairStatus" asp-items="ViewBag.RepairStatusList" class="form-control" required>
                                        <option value="">-- Select Status --</option>
                                    </select>
                                    <span asp-validation-for="RepairStatus" class="text-danger small"></span>
                                    <div class="invalid-feedback">Please select repair status.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="card border-left-secondary">
                                    <div class="card-header">
                                        <h6 class="m-0 font-weight-bold text-dark">Additional Information</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label asp-for="EstimatedRepairTime" class="font-weight-bold text-dark"></label>
                                                    <input asp-for="EstimatedRepairTime" class="form-control" placeholder="e.g., 2 hours" />
                                                    <span asp-validation-for="EstimatedRepairTime" class="text-danger small"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label asp-for="RepairCost" class="font-weight-bold text-dark"></label>
                                                    <div class="input-group">
                                                        <div class="input-group-prepend">
                                                            <span class="input-group-text">$</span>
                                                        </div>
                                                        <input asp-for="RepairCost" class="form-control" placeholder="0.00" />
                                                    </div>
                                                    <span asp-validation-for="RepairCost" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a href="@Url.Action(source == "Maintenance" ? "ViewMaintenanceFaults" : "ViewCustomerFaults")"
                                       class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-calendar-check"></i> Book Repair
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Set minimum booking date to today
            var today = new Date().toISOString().slice(0, 16);
            $('#Bookingate').attr('min', today);

            // Bootstrap validation
            (function() {
                'use strict';
                window.addEventListener('load', function() {
                    var forms = document.getElementsByClassName('needs-validation');
                    var validation = Array.prototype.filter.call(forms, function(form) {
                        form.addEventListener('submit', function(event) {
                            if (form.checkValidity() === false) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                }, false);
            })();
        });
    </script>
}