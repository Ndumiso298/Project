@model IEnumerable<Project.Models.FaultTechnician>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Failed Fridges Needing Maintenance";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Failed Fridges Needing Maintenance</h2>
                    <p class="text-muted">Book maintenance for your failed fridges</p>
                </div>
                <a asp-action="MaintenanceBookings" class="btn btn-outline-primary">
                    <i class="bi bi-list-check me-2"></i>My Bookings
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var fault in Model)
            {
                var fridge = fault.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge;
                var customer = fault.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser;

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>Maintenance Required
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6 class="text-primary">Fridge Details</h6>
                                @if (fridge != null)
                                {
                                    <p class="mb-1"><strong>Model:</strong> @fridge.Model</p>
                                    <p class="mb-1"><strong>Brand:</strong> @fridge.Brand</p>
                                    <p class="mb-1"><strong>Capacity:</strong> @fridge.CapacityLiters L</p>
                                }
                            </div>

                            <div class="mb-3">
                                <h6 class="text-primary">Fault Information</h6>
                                <p class="mb-1"><strong>Description:</strong> @fault.FaultDescription</p>
                                <p class="mb-1">
                                    <strong>Status:</strong>
                                    <span class="badge bg-secondary">@fault.RepairStatus</span>
                                </p>
                            </div>

                            <div class="mb-3">
                                <h6 class="text-primary">Checkup Details</h6>
                                <p class="mb-1">
                                    <strong>Date:</strong>
                                    @fault.FridgeVisit.VisitDate.ToString("MMM dd, yyyy")
                                </p>
                                <p class="mb-1">
                                    <strong>Technician:</strong>
                                    @fault.FridgeVisit.TechnicianName
                                </p>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-action="BookMaintenance" asp-route-faultId="@fault.FaultId"
                               class="btn btn-primary w-100">
                                <i class="bi bi-calendar-plus me-2"></i>Book Maintenance
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-check-circle display-1 text-success"></i>
                        <h4 class="mt-3 text-muted">No Maintenance Required</h4>
                        <p class="text-muted">All your fridges are in good condition!</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>