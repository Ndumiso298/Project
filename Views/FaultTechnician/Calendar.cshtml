@model IEnumerable<Project.Models.FaultTechnician>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Repair Schedule Calendar";
}

<style>
    :root {
        --primary-color: #2c3e50;
        --secondary-color: #3498db;
        --accent-color: #e74c3c;
        --success-color: #2ecc71;
        --warning-color: #f39c12;
        --light-bg: #f8f9fa;
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        --border-radius: 10px;
    }

    body {
        background-color: #f5f7f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        padding-bottom: 2rem;
    }

    .header-container {
        background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
        color: white;
        padding: 1.5rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 var(--border-radius) var(--border-radius);
    }

    .calendar-container {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .calendar-header {
        background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
        color: white;
        padding: 1.2rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .calendar-nav-btn {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

        .calendar-nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }

    .view-options {
        display: flex;
        gap: 0.5rem;
    }

    .view-option {
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.9rem;
        transition: all 0.3s;
    }

        .view-option.active {
            background: rgba(255, 255, 255, 0.4);
        }

        .view-option:hover {
            background: rgba(255, 255, 255, 0.3);
        }

    .weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        background-color: #f0f3f5;
        font-weight: 600;
        color: var(--primary-color);
    }

        .weekdays div {
            padding: 1rem;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }

    .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        grid-gap: 1px;
        background-color: #e0e0e0;
    }

    .day {
        min-height: 120px;
        background: white;
        padding: 0.5rem;
        position: relative;
        transition: all 0.3s;
    }

        .day:hover {
            background: #f9f9f9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
            z-index: 1;
        }

    .day-number {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .other-month {
        background-color: #f8f9fa;
        color: #adb5bd;
    }

    .today .day-number {
        background: var(--secondary-color);
        color: white;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .event {
        background: #e8f4fc;
        border-left: 3px solid var(--secondary-color);
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.4rem;
        border-radius: 4px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .event:hover {
            background: #d4eafc;
            transform: translateX(2px);
        }

    .event-dot {
        height: 10px;
        width: 10px;
        background-color: var(--secondary-color);
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }

    .event-type-1 {
        border-left-color: #3498db;
        background: #e8f4fc;
    }

    .event-type-2 {
        border-left-color: #2ecc71;
        background: #eafaf1;
    }

    .event-type-3 {
        border-left-color: #e74c3c;
        background: #fdedec;
    }

    .event-type-4 {
        border-left-color: #f39c12;
        background: #fef5e7;
    }

    .more-events {
        font-size: 0.8rem;
        color: var(--secondary-color);
        cursor: pointer;
        margin-top: 0.2rem;
    }

    .legend {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
        padding: 1.5rem;
        text-align: center;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .btn-loading {
        position: relative;
        color: transparent !important;
    }

        .btn-loading::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 20px;
            top: 50%;
            left: 50%;
            margin-left: -10px;
            margin-top: -10px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            border-right-color: transparent;
            animation: spin 0.75s linear infinite;
        }

    .no-data {
        text-align: center;
        padding: 3rem;
        color: #6c757d;
    }

        .no-data i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

    .action-buttons {
        margin-bottom: 1.5rem;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="header-container">
    <div class="container">
        <div class="d-flex align-items-center">
            <div class="icon-container me-3 bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="fas fa-calendar-alt fa-lg text-white"></i>
            </div>
            <div>
                <h1 class="h3 mb-0">Repair Schedules</h1>
                <p class="mb-0 opacity-75">View all scheduled fridge repairs</p>
            </div>
        </div>
    </div>
</div>



    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-number">@(Model?.Count() ?? 0)</div>
            <div class="stat-label">Total Repairs</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model?.Count(v => v.Bookingate.HasValue && v.Bookingate.Value.Date == DateTime.Today) ?? 0)</div>
            <div class="stat-label">Repairs Today</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model?.Count(v => v.Bookingate.HasValue && v.Bookingate.Value.Date > DateTime.Today) ?? 0)</div>
            <div class="stat-label">Upcoming Repairs</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">@(Model?.Where(v => !string.IsNullOrEmpty(v.TechnicianAssigned))?.Select(v => v.TechnicianAssigned)?.Distinct()?.Count() ?? 0)</div>
            <div class="stat-label">Technicians</div>
        </div>
    </div>

    <div class="calendar-container">
        <div class="calendar-header">
            <button class="calendar-nav-btn" id="prevMonth">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="d-flex flex-column align-items-center">
                <h4 class="mb-0" id="monthTitle"></h4>
                <div class="view-options mt-2">
                    <button class="view-option active" data-view="month">Month</button>
                    <button class="view-option" data-view="week">Week</button>
                    <button class="view-option" data-view="day">Day</button>
                </div>
            </div>

            <button class="calendar-nav-btn" id="nextMonth">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <div class="weekdays">
            <div>Sun</div>
            <div>Mon</div>
            <div>Tue</div>
            <div>Wed</div>
            <div>Thu</div>
            <div>Fri</div>
            <div>Sat</div>
        </div>

        <div class="days" id="calendarDays">
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="no-data">
            <i class="fas fa-calendar-times"></i>
            <h4>No Repair Schedules Found</h4>
            <p>There are no repair visits scheduled yet.</p>
            <a href="@Url.Action("Index")" class="btn btn-primary">
                <i class="fas fa-list me-2"></i>View Failed Visits to Book Repairs
            </a>
        </div>
    }

    <div class="legend">
        <h5 class="mb-3">Event Legend</h5>
        <div class="d-flex flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <span class="event-dot" style="background-color: #3498db;"></span>
                <span class="ms-2">Scheduled Repairs</span>
            </div>
            <div class="d-flex align-items-center">
                <span class="event-dot" style="background-color: #2ecc71;"></span>
                <span class="ms-2">Completed Repairs</span>
            </div>
            <div class="d-flex align-items-center">
                <span class="event-dot" style="background-color: #e74c3c;"></span>
                <span class="ms-2">Urgent Repairs</span>
            </div>
            <div class="d-flex align-items-center">
                <span class="event-dot" style="background-color: #f39c12;"></span>
                <span class="ms-2">In Progress</span>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Repair Visit Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="eventDetails">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <a id="editVisitLink" class="btn btn-primary" style="display: none;">
                    <i class="fas fa-edit me-1"></i> Edit Visit
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const monthTitle = document.getElementById('monthTitle');
            const calendarDays = document.getElementById('calendarDays');
            const prevMonthBtn = document.getElementById('prevMonth');
            const nextMonthBtn = document.getElementById('nextMonth');
            const viewOptions = document.querySelectorAll('.view-option');

            let currentDate = new Date();
            let currentView = 'month';

            // Fridge visits data with proper null checking
            const fridgeVisits = [
        @if (Model != null && Model.Any())
        {
            foreach (var visit in Model.Where(v => v.Bookingate.HasValue))
            {
                var status = visit.RepairStatus ?? "Not Started";
                var technician = visit.TechnicianAssigned ?? "Unassigned";
                var notes = visit.ResolutionNotes ?? "No notes available";
               

                <text>
                        {
                            id: @visit.FaultId,
                            visitId: @visit.VisitId,
                            date: new Date('@visit.Bookingate.Value.ToString("yyyy-MM-dd")'),
                            technician: '@Html.Raw(technician.Replace("'", "\\'"))',
                            status: '@Html.Raw(status.Replace("'", "\\'"))',
                            notes: '@Html.Raw(notes.Replace("'", "\\'"))',
                          
                            customerName: '@Html.Raw(visit.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.UserName?.Replace("'", "\\'") ?? "Unknown Customer")',
                            fridgeModel: '@Html.Raw(visit.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model?.Replace("'", "\\'") ?? "Unknown Fridge")'
                        },
                </text>
            }
        }
                    ];

            console.log('Loaded visits:', fridgeVisits.length);

            // Initialize the calendar only if we have data
            if (fridgeVisits.length > 0) {
                renderCalendar();
            } else {
                calendarDays.innerHTML = `
                            <div class="col-12 text-center p-5">
                                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                <h5>No Repair Schedules</h5>
                                <p class="text-muted">No repair visits have been scheduled yet.</p>
                            </div>
                        `;
            }

            // Event listeners
            prevMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar();
            });

            nextMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar();
            });

            viewOptions.forEach(option => {
                option.addEventListener('click', function () {
                    viewOptions.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    currentView = this.getAttribute('data-view');
                    renderCalendar();
                });
            });

            function renderCalendar() {
                try {
                    const year = currentDate.getFullYear();
                    const month = currentDate.getMonth();

                    const firstDay = new Date(year, month, 1);
                    const lastDay = new Date(year, month + 1, 0);
                    const prevLastDay = new Date(year, month, 0);

                    const firstDayIndex = firstDay.getDay();
                    const lastDayIndex = lastDay.getDay();
                    const nextDays = 7 - lastDayIndex - 1;

                    const options = { month: 'long', year: 'numeric' };
                    monthTitle.textContent = currentDate.toLocaleDateString('en-US', options);

                    let days = "";

                    // Previous month days
                    for (let x = firstDayIndex; x > 0; x--) {
                        const dayNum = prevLastDay.getDate() - x + 1;
                        const dateStr = `${prevLastDay.getFullYear()}-${(prevLastDay.getMonth() + 1).toString().padStart(2, '0')}-${dayNum.toString().padStart(2, '0')}`;

                        days += `<div class="day other-month"><div class="day-number">${dayNum}</div>`;
                        days += renderEventsForDate(dateStr);
                        days += `</div>`;
                    }

                    // Current month days
                    const today = new Date();
                    for (let i = 1; i <= lastDay.getDate(); i++) {
                        const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${i.toString().padStart(2, '0')}`;
                        const isToday = today.getDate() === i && today.getMonth() === month && today.getFullYear() === year;

                        days += `<div class="day ${isToday ? 'today' : ''}"><div class="day-number">${i}</div>`;
                        days += renderEventsForDate(dateStr);
                        days += `</div>`;
                    }

                    // Next month days
                    const nextMonth = new Date(year, month + 1, 1);
                    for (let j = 1; j <= nextDays; j++) {
                        const dateStr = `${nextMonth.getFullYear()}-${(nextMonth.getMonth() + 1).toString().padStart(2, '0')}-${j.toString().padStart(2, '0')}`;

                        days += `<div class="day other-month"><div class="day-number">${j}</div>`;
                        days += renderEventsForDate(dateStr);
                        days += `</div>`;
                    }

                    calendarDays.innerHTML = days;

                    // Add event listeners to events
                    document.querySelectorAll('.event').forEach(event => {
                        event.addEventListener('click', function () {
                            const visitId = this.getAttribute('data-id');
                            showEventDetails(visitId);
                        });
                    });

                    // Add click listener for "more events"
                    document.querySelectorAll('.more-events').forEach(moreEvents => {
                        moreEvents.addEventListener('click', function () {
                            const dateStr = this.getAttribute('data-date');
                            showAllEventsForDate(dateStr);
                        });
                    });
                } catch (error) {
                    console.error('Error rendering calendar:', error);
                    calendarDays.innerHTML = `
                                <div class="col-12 text-center p-4">
                                    <i class="fas fa-exclamation-triangle text-warning fa-2x mb-2"></i>
                                    <p>Error loading calendar. Please refresh the page.</p>
                                    <button class="btn btn-primary" onclick="location.reload()">
                                        <i class="fas fa-redo me-2"></i>Refresh Page
                                    </button>
                                </div>
                            `;
                }
            }

            function renderEventsForDate(dateStr) {
                try {
                    const visits = fridgeVisits.filter(visit => {
                        if (!visit.date) return false;
                        const visitDateStr = visit.date.toISOString().split('T')[0];
                        return visitDateStr === dateStr;
                    });

                    let eventsHtml = '';
                    const maxEvents = 2;

                    if (visits.length > 0) {
                        for (let i = 0; i < Math.min(visits.length, maxEvents); i++) {
                            const visit = visits[i];
                            // Determine event type based on status
                            let eventType = 'event-type-1'; // Default blue
                            if (visit.status === 'Completed') eventType = 'event-type-2'; // Green
                            if (visit.status === 'In Progress') eventType = 'event-type-4'; // Orange
                            if (visit.status === 'Scrapped') eventType = 'event-type-3'; // Red

                            eventsHtml += `
                                        <div class="event ${eventType}" data-id="${visit.id}" title="${visit.technician} - ${visit.status}">
                                            <span class="event-dot"></span>
                                            ${visit.technician} - ${visit.status}
                                        </div>
                                    `;
                        }

                        if (visits.length > maxEvents) {
                            eventsHtml += `<div class="more-events" data-date="${dateStr}" title="Show all ${visits.length} events">+${visits.length - maxEvents} more</div>`;
                        }
                    }

                    return eventsHtml;
                } catch (error) {
                    console.error('Error rendering events:', error);
                    return '';
                }
            }

            function showEventDetails(visitId) {
                try {
                    const visit = fridgeVisits.find(v => v.id == visitId);

                    if (visit) {
                        const eventDetails = document.getElementById('eventDetails');
                        eventDetails.innerHTML = `
                                    <div class="mb-3">
                                        <h6>Repair Visit Details</h6>
                                        <div class="row">
                                            <div class="col-6">
                                                <p><strong>Technician:</strong></p>
                                                <p><strong>Status:</strong></p>
                                                <p><strong>Customer:</strong></p>
                                                <p><strong>Fridge Model:</strong></p>
                                                <p><strong>Date:</strong></p>
                                            </div>
                                            <div class="col-6">
                                                <p>${visit.technician}</p>
                                                <p><span class="badge ${getStatusBadgeClass(visit.status)}">${visit.status}</span></p>
                                                <p>${visit.customerName}</p>
                                                <p>${visit.fridgeModel}</p>
                                                <p>${visit.date.toLocaleDateString('en-US', {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        })}</p>
                                            </div>
                                        </div>
                                        ${visit.notes && visit.notes !== 'No notes available' ? `
                                            <p><strong>Notes:</strong></p>
                                            <p class="border p-2 rounded bg-light">${visit.notes}</p>
                                        ` : ''}
                                        ${visit.partsUsed && visit.partsUsed !== 'No parts listed' ? `
                                            <p><strong>Parts Used:</strong></p>
                                            <p>${visit.partsUsed}</p>
                                        ` : ''}
                                        ${visit.repairCost !== "0.00" ? `
                                            <p><strong>Repair Cost:</strong> $${visit.repairCost}</p>
                                        ` : ''}
                                    </div>
                                `;

                        // Configure the edit link
                        const editLink = document.getElementById('editVisitLink');
                        editLink.style.display = 'block';
                        editLink.href = '@Url.Action("BookFaultVisit", "FaultTechnician")' + `?RequestedFaultId=${visit.visitId}&visitId=${visit.id}`;

                        const modal = new bootstrap.Modal(document.getElementById('eventModal'));
                        modal.show();
                    } else {
                        alert('Visit details not found.');
                    }
                } catch (error) {
                    console.error('Error showing event details:', error);
                    alert('Error loading visit details.');
                }
            }

            function showAllEventsForDate(dateStr) {
                try {
                    const visits = fridgeVisits.filter(visit => {
                        if (!visit.date) return false;
                        const visitDateStr = visit.date.toISOString().split('T')[0];
                        return visitDateStr === dateStr;
                    });

                    const eventDetails = document.getElementById('eventDetails');
                    let eventsHtml = '<h6>All Repair Visits on ' + new Date(dateStr).toLocaleDateString('en-US', {
                        weekday: 'long',
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                    }) + '</h6>';

                    if (visits.length === 0) {
                        eventsHtml += '<p class="text-muted">No visits scheduled for this date.</p>';
                    } else {
                        visits.forEach((visit, index) => {
                            eventsHtml += `
                                        <div class="border-bottom pb-2 mb-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <strong>${visit.technician}</strong><br>
                                                    <small class="text-muted">${visit.customerName} • ${visit.fridgeModel}</small><br>
                                                    <span class="badge ${getStatusBadgeClass(visit.status)}">${visit.status}</span>
                                                </div>
                                                <button class="btn btn-sm btn-outline-primary view-visit-btn" data-id="${visit.id}">
                                                    View Details
                                                </button>
                                            </div>
                                        </div>
                                    `;
                        });
                    }

                    eventDetails.innerHTML = eventsHtml;

                    // Add event listeners to view buttons
                    document.querySelectorAll('.view-visit-btn').forEach(btn => {
                        btn.addEventListener('click', function () {
                            const visitId = this.getAttribute('data-id');
                            showEventDetails(visitId);
                        });
                    });

                    const editLink = document.getElementById('editVisitLink');
                    editLink.style.display = 'none';

                    const modal = new bootstrap.Modal(document.getElementById('eventModal'));
                    modal.show();
                } catch (error) {
                    console.error('Error showing all events:', error);
                    alert('Error loading events for this date.');
                }
            }

            function getStatusBadgeClass(status) {
                switch (status) {
                    case 'Completed': return 'bg-success';
                    case 'In Progress': return 'bg-warning';
                    case 'Scrapped': return 'bg-danger';
                    case 'Not Started': return 'bg-secondary';
                    default: return 'bg-info';
                }
            }

            // Reset edit link when modal is hidden
            document.getElementById('eventModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('editVisitLink').style.display = 'none';
            });

            // Handle page refresh after booking
            if (performance.navigation.type === 1 || performance.getEntriesByType("navigation")[0].type === 'reload') {
                console.log('Page was reloaded');
            }
        });
    </script>
}