@model IEnumerable<Project.Models.FaultTechnician>
@{
    ViewData["Title"] = "Repair Schedule Calendar";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Calculate statistics for the cards
    var totalScheduled = Model.Count();
    var completedCount = Model.Count(v => v.RepairStatus?.ToLower() == "completed" || v.RepairStatus?.ToLower() == "resolved");
    var inProgressCount = Model.Count(v => v.RepairStatus?.ToLower() == "in progress");
    var pendingCount = Model.Count(v => v.RepairStatus?.ToLower() == "not started" || string.IsNullOrEmpty(v.RepairStatus));

    // Today's repairs
    var todayRepairs = Model.Where(v => v.Bookingate?.Date == DateTime.Today).OrderBy(v => v.Bookingate).Take(5).ToList();

    // Weekly repairs
    var weekStart = DateTime.Today;
    var weekEnd = DateTime.Today.AddDays(7);
    var weeklyRepairs = Model.Where(v => v.Bookingate >= weekStart && v.Bookingate <= weekEnd)
                            .GroupBy(v => v.Bookingate?.Date)
                            .OrderBy(g => g.Key)
                            .Take(5)
                            .ToList();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Repair Schedule Calendar</h1>
            <p class="text-muted mb-0">Manage and track all scheduled repair appointments</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="@Url.Action("Index")" class="btn btn-primary">
                <i class="fas fa-list"></i> View All Faults
            </a>
            <button class="btn btn-success" onclick="exportSchedule()">
                <i class="fas fa-download"></i> Export
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Scheduled
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@totalScheduled</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Completed
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@completedCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                In Progress
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@inProgressCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tools fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Pending
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@pendingCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Schedule -->
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Scheduled Repairs</h6>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                        <button type="button" class="btn btn-outline-success" data-filter="completed">Completed</button>
                        <button type="button" class="btn btn-outline-info" data-filter="in-progress">In Progress</button>
                        <button type="button" class="btn btn-outline-warning" data-filter="not-started">Pending</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any(v => v.Bookingate.HasValue))
                    {
                        <div class="schedule-container">
                            @foreach (var visit in Model.Where(v => v.Bookingate.HasValue).OrderBy(v => v.Bookingate))
                            {
                                <div class="schedule-item mb-3" data-status="@GetStatusFilterClass(visit.RepairStatus)">
                                    <div class="card schedule-card border-left-@GetStatusBorderClass(visit.RepairStatus)">
                                        <div class="card-body">
                                            <div class="row align-items-center">
                                                <div class="col-md-2">
                                                    <div class="schedule-date text-center">
                                                        <div class="date-day">@visit.Bookingate?.ToString("dd")</div>
                                                        <div class="date-month">@visit.Bookingate?.ToString("MMM")</div>
                                                        <div class="date-year">@visit.Bookingate?.ToString("yyyy")</div>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <h6 class="customer-name mb-1">
                                                        @GetCustomerName(visit)
                                                    </h6>
                                                    <p class="mb-1 text-muted">
                                                        <i class="fas fa-refrigerator me-1"></i>
                                                        @GetFridgeModel(visit)
                                                    </p>
                                                    <p class="mb-1 small">
                                                        <i class="fas fa-sticky-note me-1"></i>
                                                        @GetFaultDescription(visit)
                                                    </p>
                                                    @if (!string.IsNullOrEmpty(GetTechnicianNotes(visit)))
                                                    {
                                                        <p class="mb-0 small text-info">
                                                            <i class="fas fa-clipboard me-1"></i>
                                                            @GetTechnicianNotes(visit)
                                                        </p>
                                                    }
                                                </div>
                                                <div class="col-md-2 text-center">
                                                    <span class="badge bg-@GetStatusBadgeClass(visit.RepairStatus) mb-2">
                                                        @(visit.RepairStatus ?? "Not Started")
                                                    </span>
                                                    <br>
                                                    <small class="text-muted">
                                                        <i class="fas fa-user-cog me-1"></i>
                                                        @(visit.TechnicianAssigned ?? "Unassigned")
                                                    </small>
                                                    @if (visit.Bookingate?.TimeOfDay > TimeSpan.Zero)
                                                    {
                                                        <br>
                                                        <small class="text-muted">
                                                            <i class="fas fa-clock me-1"></i>
                                                            @visit.Bookingate?.ToString("hh:mm tt")
                                                        </small>
                                                    }
                                                </div>
                                                <div class="col-md-2 text-end">
                                                    <div class="btn-group-vertical btn-group-sm">
                                                        @if (!string.IsNullOrEmpty(visit.VisitId?.ToString()) && !string.IsNullOrEmpty(visit.FaultId.ToString()))
                                                        {
                                                            <a href="@Url.Action("BookFaultVisit", new { requestedFaultId = visit.VisitId, visitId = visit.FaultId })"
                                                               class="btn btn-outline-primary mb-1" title="Edit Schedule">
                                                                <i class="fas fa-edit"></i> Edit
                                                            </a>
                                                        }
                                                        @if (!string.IsNullOrEmpty(visit.FaultId.ToString()))
                                                        {
                                                            <a href="@Url.Action("ProcessFault", new { id = visit.FaultId })"
                                                               class="btn btn-outline-success mb-1" title="Process Repair">
                                                                <i class="fas fa-tools"></i> Process
                                                            </a>
                                                        }
                                                        <button class="btn btn-outline-info" title="View Details"
                                                                onclick="viewScheduleDetails('@visit.FaultId', '@visit.VisitId')">
                                                            <i class="fas fa-eye"></i> Details
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Scheduled Repairs</h4>
                            <p class="text-muted mb-4">There are no repair appointments scheduled for the upcoming period.</p>
                            <a href="@Url.Action("Index")" class="btn btn-primary btn-lg">
                                <i class="fas fa-plus me-2"></i>Schedule New Repair
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar - Quick Stats & Actions -->
        <div class="col-lg-4">
            <!-- Today's Repairs -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">Today's Repairs</h6>
                </div>
                <div class="card-body">
                    @if (todayRepairs.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var visit in todayRepairs)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <strong>@GetCustomerName(visit)</strong>
                                        <br>
                                        <small class="text-muted">@GetFridgeModel(visit)</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@GetStatusBadgeClass(visit.RepairStatus) d-block mb-1">
                                            @(visit.RepairStatus ?? "Not Started")
                                        </span>
                                        <small class="text-muted">
                                            @visit.Bookingate?.ToString("hh:mm tt")
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <p class="text-muted mb-0">No repairs scheduled for today</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Upcoming Schedule -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Upcoming This Week</h6>
                </div>
                <div class="card-body">
                    @if (weeklyRepairs.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var dayGroup in weeklyRepairs)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <strong>@dayGroup.Key?.ToString("ddd, MMM dd")</strong>
                                        <br>
                                        <small class="text-muted">@dayGroup.Count() repair(s) scheduled</small>
                                    </div>
                                    <span class="badge bg-primary">@dayGroup.Count()</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="fas fa-calendar fa-2x text-muted mb-2"></i>
                            <p class="text-muted mb-0">No repairs this week</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Schedule New Repair
                        </a>
                        <a href="@Url.Action("Dashboard")" class="btn btn-outline-secondary">
                            <i class="fas fa-tachometer-alt me-2"></i>View Dashboard
                        </a>
                        <button class="btn btn-outline-info" onclick="printSchedule()">
                            <i class="fas fa-print me-2"></i>Print Schedule
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Schedule Details Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Repair Schedule Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="scheduleModalContent">
                <!-- Details loaded via AJAX -->
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .schedule-date {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
            border-left: 4px solid #007bff;
        }

        .date-day {
            font-size: 24px;
            font-weight: bold;
            color: #2e59d9;
            line-height: 1;
        }

        .date-month {
            font-size: 14px;
            font-weight: 600;
            color: #6c757d;
            text-transform: uppercase;
        }

        .date-year {
            font-size: 12px;
            color: #6c757d;
        }

        .schedule-card {
            transition: all 0.3s ease;
            border-left-width: 4px !important;
        }

            .schedule-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .customer-name {
            color: #2e59d9;
            font-weight: 600;
        }

        .border-left-primary {
            border-left-color: #4e73df !important;
        }

        .border-left-success {
            border-left-color: #1cc88a !important;
        }

        .border-left-info {
            border-left-color: #36b9cc !important;
        }

        .border-left-warning {
            border-left-color: #f6c23e !important;
        }

        .border-left-secondary {
            border-left-color: #858796 !important;
        }

        .schedule-item[data-status="completed"] {
            opacity: 0.8;
        }
    </style>
}

@section Scripts {
    <script>
        // Filter functionality
        document.addEventListener('DOMContentLoaded', function () {
            const filterButtons = document.querySelectorAll('[data-filter]');
            const scheduleItems = document.querySelectorAll('.schedule-item');

            filterButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const filter = this.getAttribute('data-filter');

                    // Update active button
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    // Filter items
                    scheduleItems.forEach(item => {
                        if (filter === 'all' || item.getAttribute('data-status') === filter) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
        });

        function exportSchedule() {
            // Implement export functionality using real data
            const exportUrl = '@Url.Action("ExportSchedule", "Fault")';
            window.location.href = exportUrl;
        }

        function printSchedule() {
            window.print();
        }

        function viewScheduleDetails(faultId, visitId) {
            // Show loading indicator
            document.getElementById('scheduleModalContent').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading schedule details...</p>
                </div>
            `;

            // AJAX call to load actual schedule details from database
            fetch('@Url.Action("GetScheduleDetails", "Fault")?faultId=' + faultId + '&visitId=' + visitId)
                .then(response => response.text())
                .then(data => {
                    document.getElementById('scheduleModalContent').innerHTML = data;
                    new bootstrap.Modal(document.getElementById('scheduleModal')).show();
                })
                .catch(error => {
                    document.getElementById('scheduleModalContent').innerHTML = `
                        <div class="text-center py-4">
                            <i class="fas fa-exclamation-triangle fa-3x text-danger mb-3"></i>
                            <h5>Error Loading Details</h5>
                            <p class="text-muted">Unable to load schedule details. Please try again.</p>
                            <button class="btn btn-primary" onclick="viewScheduleDetails('${faultId}', '${visitId}')">
                                <i class="fas fa-redo me-2"></i>Retry
                            </button>
                        </div>
                    `;
                    new bootstrap.Modal(document.getElementById('scheduleModal')).show();
                });
        }
    </script>
}

@functions {
    public string GetStatusBorderClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "success",
            "in progress" => "info",
            "not started" => "warning",
            "scrapped" => "secondary",
            _ => "primary"
        };
    }

    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "success",
            "in progress" => "info",
            "not started" => "warning",
            "scrapped" => "secondary",
            _ => "secondary"
        };
    }

    public string GetStatusFilterClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "completed",
            "in progress" => "in-progress",
            "not started" => "not-started",
            _ => "not-started"
        };
    }

    public string GetCustomerName(Project.Models.FaultTechnician visit)
    {
        if (visit.FridgeVisit?.RequestHeader != null)
        {
            return $"{visit.FridgeVisit.RequestHeader.FirstName} {visit.FridgeVisit.RequestHeader.LastName}";
        }
        return "Customer Information Not Available";
    }

    public string GetFridgeModel(Project.Models.FaultTechnician visit)
    {
        return visit.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model
               ?? visit.FaultDescription
               ?? "Model Not Specified";
    }

    public string GetFaultDescription(Project.Models.FaultTechnician visit)
    {
        var description = visit.FaultDescription ?? "No description provided";
        return description.Length > 80 ? description.Substring(0, 80) + "..." : description;
    }

    public string GetTechnicianNotes(Project.Models.FaultTechnician visit)
    {
        // Assuming there's a property for technician notes
        // Replace with actual property name from your model
        return visit.ResolutionNotes ?? string.Empty;
    }
}