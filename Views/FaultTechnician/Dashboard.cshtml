@model IEnumerable<dynamic>
@{
    ViewData["Title"] = ViewBag.Source + " Faults";
    var source = ViewBag.Source as string ?? "Faults";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@source Faults</h1>
        <div>
            <a asp-action="Dashboard" class="btn btn-secondary">
                <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Dashboard
            </a>
            <a asp-action="ViewFaults" class="btn btn-primary">
                <i class="fas fa-list fa-sm text-white-50"></i> View All Faults
            </a>
        </div>
    </div>

    <!-- Faults Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">@source Faults List</h6>
            <span class="badge badge-primary">@Model.Count() Faults</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            @if (source == "Maintenance")
                            {
                                <th>Visit ID</th>
                            }
                            else
                            {
                                <th>Report ID</th>
                            }
                            <th>Customer Name</th>
                            <th>Fridge Model</th>
                            <th>Description</th>
                            <th>Reported Date</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model)
                        {
                            <tr>
                                @if (source == "Maintenance")
                                {
                                    <td>@fault.VisitId</td>
                                }
                                else
                                {
                                    <td>@fault.FaultReportId</td>
                                }
                                <td>@fault.CustomerName</td>
                                <td>@fault.FridgeModel</td>
                                <td>
                                    <div class="text-truncate" style="max-width: 200px;" 
                                         title="@fault.Description">
                                        @fault.Description
                                    </div>
                                </td>
                                <td>@fault.ReportedDate?.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge badge-@GetStatusBadgeClass(fault.Status)">
                                        @fault.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-@GetPriorityBadgeClass(fault.Priority)">
                                        @fault.Priority
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="ViewFaultDetails" 
                                           asp-route-id="@(source == "Maintenance" ? fault.VisitId : fault.FaultReportId)" 
                                           asp-route-source="@source"
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="ScheduleRepair" 
                                           asp-route-id="@(source == "Maintenance" ? fault.VisitId : fault.FaultReportId)" 
                                           asp-route-source="@source"
                                           class="btn btn-sm btn-warning">
                                            <i class="fas fa-calendar"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dataTable').DataTable({
                "order": [[4, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": -1 }
                ]
            });
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" or "repaired" => "success",
            "in progress" => "warning",
            "failed checkup" => "danger",
            "scheduled" => "info",
            _ => "secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "danger",
            "medium" => "warning",
            "low" => "info",
            _ => "secondary"
        };
    }
}