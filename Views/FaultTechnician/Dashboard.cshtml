@{
    ViewData["Title"] = "Fault Technician Dashboard";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">Fault Technician Dashboard</h1>
        <div class="btn-group">
            <a href="@Url.Action("ViewMaintenanceFaults")" class="btn btn-outline-primary">
                <i class="fas fa-tools"></i> Maintenance Faults
            </a>
            <a href="@Url.Action("ViewCustomerFaults")" class="btn btn-outline-success">
                <i class="fas fa-users"></i> Customer Faults
            </a>
            <a href="@Url.Action("ViewFaults")" class="btn btn-outline-info">
                <i class="fas fa-list"></i> All Faults
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row">
        <!-- Total Faults -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Faults
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalFaults</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Maintenance Faults -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Maintenance Faults
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.MaintenanceFaults</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tools fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Faults -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Customer Faults
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.CustomerFaults</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- In Progress -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                In Progress
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.InProgress</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-spinner fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Recent Activities -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Activities</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="recentActivities" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Source</th>
                                    <th>Customer</th>
                                    <th>Fridge Model</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentActivities != null)
                                {
                                    foreach (var activity in ViewBag.RecentActivities)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge badge-primary">@activity.Type</span>
                                            </td>
                                            <td>
                                                <span class="badge @(activity.Source == "Maintenance" ? "badge-warning" : "badge-success")">
                                                    @activity.Source
                                                </span>
                                            </td>
                                            <td>@activity.CustomerName</td>
                                            <td>@activity.FridgeModel</td>
                                            <td>
                                                <small class="text-muted">
                                                    @activity.TimeAgo?.ToString("MMM dd, yyyy hh:mm tt")
                                                </small>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Stats</h6>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <div class="mb-4">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <div class="h5 font-weight-bold text-gray-800">@ViewBag.Completed</div>
                            <div class="text-xs font-weight-bold text-success text-uppercase">Completed</div>
                        </div>
                        <hr>
                        <div class="mb-4">
                            <i class="fas fa-calendar-day fa-2x text-info mb-2"></i>
                            <div class="h5 font-weight-bold text-gray-800">@ViewBag.TodaysBookings</div>
                            <div class="text-xs font-weight-bold text-info text-uppercase">Today's Bookings</div>
                        </div>
                        <hr>
                        <div class="mb-4">
                            <i class="fas fa-calendar-alt fa-2x text-warning mb-2"></i>
                            <div class="h5 font-weight-bold text-gray-800">@ViewBag.UpcomingBookings</div>
                            <div class="text-xs font-weight-bold text-warning text-uppercase">Upcoming Bookings</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#recentActivities').DataTable({
                "order": [[4, "desc"]],
                "pageLength": 5,
                "searching": false,
                "lengthChange": false,
                "info": false
            });
        });
    </script>
}