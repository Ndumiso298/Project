@model IEnumerable<Project.Models.ViewModel.FaultViewModel>
@{
    ViewData["Title"] = "All Faults - Maintenance & Customer Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">All Faults</h1>
        <div>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <div class="btn-group">
                <a href="@Url.Action("ViewMaintenanceFaults")" class="btn btn-info">
                    <i class="fas fa-tools"></i> Maintenance
                </a>
                <a href="@Url.Action("ViewCustomerFaults")" class="btn btn-warning">
                    <i class="fas fa-user"></i> Customer
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Faults from Maintenance & Customer Reports</h6>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-primary active" data-filter="all">All</button>
                <button type="button" class="btn btn-outline-info" data-filter="maintenance">Maintenance</button>
                <button type="button" class="btn btn-outline-warning" data-filter="customer">Customer</button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Source</th>
                            <th>Reported Date</th>
                            <th>Customer</th>
                            <th>Fridge Model</th>
                            <th>Description</th>
                            <th>Type/Priority</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model)
                        {
                            <tr class="fault-row" data-source="@fault.Source?.ToLower().Replace(" ", "-")">
                                <td>
                                    <span class="badge @(fault.Source == "Maintenance" ? "bg-info" : "bg-warning")">
                                        @fault.Source
                                    </span>
                                </td>
                                <td>@fault.ReportedDate.ToString()</td>
                                <td>@fault.CustomerName</td>
                                <td>@fault.FridgeModel</td>
                                <td>
                                    <div class="fault-description">
                                        <strong>@fault.Description</strong>
                                        @if (!string.IsNullOrEmpty(fault.AdditionalNotes))
                                        {
                                            <br>
                                            <small class="text-muted">@fault.AdditionalNotes</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (fault.Source == "Customer Report")
                                    {
                                        <span class="badge bg-secondary">@fault.FaultType</span>
                                        <br>
                                    }
                                    <span class="badge @GetPriorityBadgeClass(fault.Priority) mt-1">@fault.Priority</span>
                                </td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(fault.Status)">@fault.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @if (fault.Source == "Maintenance")
                                        {
                                            <a href="@Url.Action("BookMaintenanceFault", new { visitId = fault.Id })"
                                               class="btn btn-primary btn-sm" title="Assign Technician">
                                                <i class="fas fa-user-plus"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("BookCustomerFault", new { faultReportId = fault.Id })"
                                               class="btn btn-primary btn-sm" title="Assign Technician">
                                                <i class="fas fa-user-plus"></i>
                                            </a>
                                        }
                                        <button class="btn btn-info btn-sm" title="View Details"
                                                onclick="showFaultDetails(@fault.Id, '@fault.Source')">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <h4>No Faults Found</h4>
                    <p class="text-muted">There are no active faults requiring attention.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Fault Details Modal -->
<div class="modal fade" id="faultDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fault Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="faultDetailsContent">
                <!-- Details will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter faults by source
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('[data-filter]');
            const faultRows = document.querySelectorAll('.fault-row');

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const filter = this.getAttribute('data-filter');

                    // Update active button
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    // Filter rows
                    faultRows.forEach(row => {
                        if (filter === 'all' || row.getAttribute('data-source') === filter) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            });
        });

        function showFaultDetails(id, source) {
            // You can implement AJAX call to get detailed fault information
            const content = `
                <div class="text-center">
                    <i class="fas fa-info-circle fa-3x text-primary mb-3"></i>
                    <h5>Fault Details</h5>
                    <p>Detailed view for ${source} fault #${id}</p>
                    <p class="text-muted">This would show complete fault information including customer details, history, and notes.</p>
                </div>
            `;
            document.getElementById('faultDetailsContent').innerHTML = content;
            new bootstrap.Modal(document.getElementById('faultDetailsModal')).show();
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "bg-success",
            "in progress" => "bg-info",
            "reported" or "failed checkup" => "bg-warning",
            "cancelled" or "scrapped" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "critical" or "high" => "bg-danger",
            "medium" => "bg-warning",
            "low" => "bg-info",
            _ => "bg-secondary"
        };
    }
}