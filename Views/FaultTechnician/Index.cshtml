@model IEnumerable<Project.Models.FridgeVisit>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Fault Reports & Replacement Requests";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Fault Reports & Replacement Requests
                    </h3>
                 
                </div>
                <div class="card-body">
                    <!-- Statistics Cards -->
                    <div class="row mb-4">
                        <div class="col-md-2 mb-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@Model.Count()</h4>
                                    <small>Total Faults</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="card bg-warning text-dark">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@Model.Count(v => !v.FaultTechnicians.Any())</h4>
                                    <small>Pending Repair</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@Model.Count(v => v.FaultTechnicians.Any(ft => ft.RepairStatus == "In Progress"))</h4>
                                    <small>In Progress</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@Model.Count(v => v.FaultTechnicians.Any(ft => ft.RepairStatus == "Resolved"))</h4>
                                    <small>Resolved</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="card bg-secondary text-white">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@Model.Count(v => v.FaultTechnicians.Any(ft => ft.RepairStatus == "Scrapped"))</h4>
                                    <small>Scrapped</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center p-3">
                                    <h4 class="mb-0">@ViewBag.PendingReplacements</h4>
                                    <small>Replacements</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Faults Table -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-striped" id="faultsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Visit ID</th>
                                    <th>Customer</th>
                                    <th>Fridge Details</th>
                                    <th>Visit Date</th>
                                    <th>Repair Status</th>
                                    <th>Technician</th>
                                    <th>Replacement Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var latestRepair = item.FaultTechnicians.OrderByDescending(ft => ft.Bookingate).FirstOrDefault();
                                    var replacementRequest = ViewData[$"Replacement_{item.VisitId}"] as Project.Models.FridgeReplacement;

                                    <tr>
                                        <td>@item.VisitId</td>
                                        <td>
                                            <strong>@item.RequestHeader?.FirstName @item.RequestHeader?.LastName</strong><br>
                                            <small class="text-muted">@item.RequestHeader?.CellNumber</small>
                                        </td>
                                        <td>
                                            @{
                                                var fridge = item.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge;
                                                var customerFridge = item.RequestHeader?.RequestFridges?.FirstOrDefault()?.CustomerFridges?.FirstOrDefault();
                                            }
                                            @if (fridge != null)
                                            {
                                                <strong>@fridge.Model</strong>
                                                <br>
                                                <small class="text-muted">Serial: @(customerFridge?.FridgeInStock?.FridgeNo ?? "N/A")</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td>@item.VisitDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (latestRepair != null)
                                            {
                                                <span class="badge badge-@GetRepairStatusBadge(latestRepair.RepairStatus)">
                                                    @latestRepair.RepairStatus
                                                </span>
                                                <br>
                                                <small class="text-muted">@latestRepair.Bookingate?.ToString("MMM dd")</small>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (latestRepair != null && !string.IsNullOrEmpty(latestRepair.TechnicianAssigned))
                                            {
                                                @latestRepair.TechnicianAssigned
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (replacementRequest != null)
                                            {
                                                <span class="badge badge-@GetReplacementStatusBadge(replacementRequest.ReplacementStatus)">
                                                    @replacementRequest.ReplacementStatus
                                                </span>
                                                <br>
                                                <small class="text-muted">@replacementRequest.RequestDate.ToString("MMM dd")</small>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light">No Request</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <!-- Repair Actions -->
                                                @if (latestRepair == null)
                                                {
                                                    <a asp-action="BookFaultVisit" asp-route-RequestedFaultId="@item.VisitId"
                                                       class="btn btn-primary btn-sm" title="Assign Technician">
                                                        <i class="bi bi-person-plus"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a asp-action="BookFaultVisit" asp-route-RequestedFaultId="@item.VisitId" asp-route-visitId="@latestRepair.FaultId"
                                                       class="btn btn-warning btn-sm" title="Update Repair">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                }

                                                <!-- Replacement Actions -->
                                                @if (replacementRequest == null && (latestRepair == null || latestRepair.RepairStatus == "Scrapped" || latestRepair.RepairStatus == "Beyond Repair"))
                                                {
                                                    <a asp-action="RequestReplacement" asp-controller="Replacement" asp-route-visitId="@item.VisitId"
                                                      
                                                       class="btn btn-danger btn-sm" title="Request Replacement">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </a>
                                                }
                                                else if (replacementRequest != null)
                                                {
                                                    <a asp-action="ReplacementDetails" asp-route-id="@replacementRequest.FridgeReplacementId"
                                                       class="btn btn-info btn-sm" title="View Replacement Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                }

                                                <!-- View Details -->
                                                <button type="button" class="btn btn-secondary btn-sm"
                                                        data-bs-toggle="modal" data-bs-target="#detailsModal@(item.VisitId)"
                                                        title="View Details">
                                                    <i class="bi bi-info-circle"></i>
                                                </button>
                                            </div>

                                            <!-- Details Modal -->
                                            <div class="modal fade" id="detailsModal@(item.VisitId)" tabindex="-1">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-primary text-white">
                                                            <h5 class="modal-title">Fault Details - Visit #@item.VisitId</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="row">
                                                                <div class="col-md-6">
                                                                    <h6>Customer Information</h6>
                                                                    <p><strong>Name:</strong> @item.RequestHeader?.FirstName @item.RequestHeader?.LastName</p>
                                                                    <p><strong>Phone:</strong> @item.RequestHeader?.CellNumber</p>
                                                                    <p><strong>Email:</strong> @item.RequestHeader?.Customer.ApplicationUser.Email</p>
                                                                </div>
                                                                <div class="col-md-6">
                                                                    <h6>Fridge Information</h6>
                                                                    @if (fridge != null)
                                                                    {
                                                                        <p><strong>Model:</strong> @fridge.Model</p>
                                                                        <p><strong>Serial:</strong> @(customerFridge?.FridgeInStock?.FridgeNo ?? "N/A")</p>
                                                                        <p><strong>Visit Date:</strong> @item.VisitDate.ToString("MMM dd, yyyy")</p>
                                                                    }
                                                                </div>
                                                            </div>

                                                            @if (latestRepair != null)
                                                            {
                                                                <hr>
                                                                <h6>Repair Information</h6>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <p><strong>Technician:</strong> @(latestRepair.TechnicianAssigned ?? "Not Assigned")</p>
                                                                        <p><strong>Status:</strong> <span class="badge badge-@GetRepairStatusBadge(latestRepair.RepairStatus)">@latestRepair.RepairStatus</span></p>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <p><strong>Booking Date:</strong> @(latestRepair.Bookingate?.ToString("MMM dd, yyyy") ?? "N/A")</p>
                                                                        <p><strong>Notes:</strong> @(latestRepair.ResolutionNotes ?? "No notes")</p>
                                                                    </div>
                                                                </div>
                                                            }

                                                            @if (replacementRequest != null)
                                                            {
                                                                <hr>
                                                                <h6>Replacement Request</h6>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <p><strong>Status:</strong> <span class="badge badge-@GetReplacementStatusBadge(replacementRequest.ReplacementStatus)">@replacementRequest.ReplacementStatus</span></p>
                                                                        <p><strong>Reason:</strong> @replacementRequest.ReasonForReplacement</p>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <p><strong>Request Date:</strong> @replacementRequest.RequestDate.ToString("MMM dd, yyyy")</p>
                                                                        <p><strong>Old Fridge:</strong> @replacementRequest.OldFridgeNo</p>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 text-muted">No Faults Found</h4>
                            <p class="text-muted">There are currently no fridge faults reported.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        $(document).ready(function () {
            $('#faultsTable').DataTable({
                "pageLength": 10,
                "order": [[0, 'desc']],
                "language": {
                    "search": "Search faults:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ faults"
                }
            });

            // Auto-refresh every 30 seconds to get updated status
            setInterval(function () {
                location.reload();
            }, 30000);
        });

        // Tooltip initialization
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}

@functions {
    public string GetRepairStatusBadge(string status)
    {
        return status?.ToLower() switch
        {
            "resolved" => "success",
            "in progress" => "warning",
            "scrapped" => "secondary",
            "not started" => "info",
            _ => "danger"
        };
    }

    public string GetReplacementStatusBadge(string status)
    {
        return status?.ToLower() switch
        {
            "approved" => "success",
            "pending" => "warning",
            "completed" => "info",
            "rejected" => "danger",
            _ => "secondary"
        };
    }
}
