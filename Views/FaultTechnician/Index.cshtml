@model Project.Models.ViewModel.TechnicianFaultsViewModel
@using Project.Utility
@{
    ViewData["Title"] = "All Faults";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">All Fault Reports</h1>
                    <p class="text-muted mb-0">Manage both maintenance and customer-reported faults</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Status Filter -->
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button"
                                id="statusFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-filter me-2"></i>
                            @(string.IsNullOrEmpty(ViewBag.StatusFilter) || ViewBag.StatusFilter == "all" ? "All Statuses" :
                                                        ViewBag.StatusFilter == "active" ? "Active Only" :
                                                        ViewBag.StatusFilter == "resolved" ? "Resolved Only" :
                                                        ViewBag.StatusFilter == "closed" ? "Closed Only" : "All Statuses")
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="statusFilterDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { statusFilter = "all" })">All Statuses</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { statusFilter = "active" })">Active Only</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { statusFilter = "resolved" })">Resolved Only</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { statusFilter = "closed" })">Closed Only</a></li>
                        </ul>
                    </div>

                    <!-- Fault Type Filter -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                id="faultTypeFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-bars me-2"></i>
                            @(ViewBag.FaultTypeFilter == "all" ? "All Fault Types" :
                                                        ViewBag.FaultTypeFilter == "maintenance" ? "Maintenance Only" :
                                                        ViewBag.FaultTypeFilter == "customer" ? "Customer Only" : "All Fault Types")
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="faultTypeFilterDropdown">
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { faultTypeFilter = "all" })">All Fault Types</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { faultTypeFilter = "maintenance" })">Maintenance Only</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", new { faultTypeFilter = "customer" })">Customer Reported Only</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-primary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">Total Faults</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@(Model.MaintenanceFaults.Count + Model.CustomerReportedFaults.Count)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tools fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-warning shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-warning text-uppercase mb-1">Active</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">
                                @(Model.CustomerReportedFaults.Count(f => f.Status == SD.Reported || f.Status == SD.InProgress) +
                                                                Model.MaintenanceFaults.Count)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-info shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-info text-uppercase mb-1">In Progress</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.CustomerReportedFaults.Count(f => f.Status == SD.InProgress)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-tools fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-success shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-success text-uppercase mb-1">Resolved</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.CustomerReportedFaults.Count(f => f.Status == SD.FaultResolved)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-secondary shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-secondary text-uppercase mb-1">Closed</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.CustomerReportedFaults.Count(f => f.Status == SD.Closed)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-lock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-4">
            <div class="card border-start-4 border-start-danger shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-danger text-uppercase mb-1">Scrapped</div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.CustomerReportedFaults.Count(f => f.Status == SD.FaultScrapped)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-recycle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Reported Faults Section -->
    @if (Model.CustomerReportedFaults.Any() && ViewBag.FaultTypeFilter != "maintenance")
    {
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 fw-bold text-primary">
                    <i class="fas fa-user me-2"></i>Customer Reported Faults
                    <span class="badge bg-primary ms-2">@Model.CustomerReportedFaults.Count</span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 fw-semibold text-muted small text-uppercase">Customer & Fridge</th>
                                <th class="fw-semibold text-muted small text-uppercase">Fault Type</th>
                                <th class="fw-semibold text-muted small text-uppercase">Priority</th>
                                <th class="fw-semibold text-muted small text-uppercase">Status</th>
                                <th class="fw-semibold text-muted small text-uppercase">Reported Date</th>
                                <th class="fw-semibold text-muted small text-uppercase">Last Updated</th>
                                <th class="text-end pe-4 fw-semibold text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fault in Model.CustomerReportedFaults)
                            {
                                <tr class="@(fault.Status == SD.Closed ? "table-secondary" :
                                                                               fault.Status == SD.FaultResolved ? "table-success" :
                                                                               fault.Status == SD.FaultScrapped ? "table-warning" : "")">
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-2 p-2 me-3">
                                        <i class="fas fa-refrigerator text-primary fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-0">@fault.Customer?.ApplicationUser?.FirstName @fault.Customer?.ApplicationUser?.LastName</h6>
                                        <small class="text-muted">@fault.FridgeInStock?.Fridge?.Brand @fault.FridgeInStock?.Fridge?.Model</small>
                                        <br />
                                        <small class="text-muted">SN: @fault.FridgeInStock?.FridgeNo</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <h6 class="fw-semibold mb-0">@fault.FaultType</h6>
                                <small class="text-muted">@(fault.Description?.Length > 50 ? fault.Description.Substring(0, 50) + "..." : fault.Description)</small>
                            </td>
                            <td>
                                @if (fault.Priority == "High" || fault.Priority == "Urgent")
                                        {
                                            <span class="badge bg-danger">@fault.Priority</span>
                                        }
                                        else if (fault.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning">@fault.Priority</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@fault.Priority</span>
                                        }
                                    </td>
                                    <td>
                                        @if (fault.Status == SD.Reported)
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-clock me-1"></i>@SD.Reported
                                            </span>
                                        }
                                        else if (fault.Status == SD.InProgress)
                                        {
                                            <span class="badge bg-info">
                                                <i class="fas fa-tools me-1"></i>@SD.InProgress
                                            </span>
                                        }
                                        else if (fault.Status == SD.FaultResolved)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle me-1"></i>@SD.FaultResolved
                                            </span>
                                        }
                                        else if (fault.Status == SD.Closed)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fas fa-lock me-1"></i>@SD.Closed
                                            </span>
                                        }
                                        else if (fault.Status == SD.FaultScrapped)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-recycle me-1"></i>@SD.FaultScrapped
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@fault.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@fault.ReportedDate.ToString("MMM dd, yyyy")</span>
                                            <small class="text-muted">@fault.ReportedDate.ToString("hh:mm tt")</small>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var lastUpdateDate = fault.ResolvedDate ?? fault.InProgressDate ?? fault.ReportedDate;
                                        }
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@lastUpdateDate.ToString("MMM dd, yyyy")</span>
                                            <small class="text-muted">@lastUpdateDate.ToString("hh:mm tt")</small>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="ProcessFault" asp-route-id="@fault.FaultReportId"
                                               class="btn btn-sm @(fault.Status == SD.Closed ? "btn-outline-secondary" : "btn-outline-primary") rounded-3 px-3"
                                               title="View Fault Details">
                                                <i class="fas @(fault.Status == SD.Closed ? "fa-eye" : "fa-cogs") me-1"></i>
                                                @(fault.Status == SD.Closed ? "View" : "Process")
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Maintenance Faults Section -->
    @if (Model.MaintenanceFaults.Any() && ViewBag.FaultTypeFilter != "customer")
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3">
                <h5 class="m-0 fw-bold text-primary">
                    <i class="fas fa-wrench me-2"></i>Maintenance Faults (Failed Visits)
                    <span class="badge bg-primary ms-2">@Model.MaintenanceFaults.Count</span>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 fw-semibold text-muted small text-uppercase">Visit Details</th>
                                <th class="fw-semibold text-muted small text-uppercase">Customer</th>
                                <th class="fw-semibold text-muted small text-uppercase">Fridge</th>
                                <th class="fw-semibold text-muted small text-uppercase">Visit Date</th>
                                <th class="fw-semibold text-muted small text-uppercase">Status</th>
                                <th class="text-end pe-4 fw-semibold text-muted small text-uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visit in Model.MaintenanceFaults)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-2 p-2 me-3">
                                                <i class="fas fa-calendar-times text-danger fs-5"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold text-dark mb-0">Visit #@visit.VisitId</h6>
                                                <small class="text-muted">Failed Checkup</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <h6 class="fw-semibold mb-0">@visit.RequestHeader?.Customer?.ApplicationUser?.FirstName @visit.RequestHeader?.Customer?.ApplicationUser?.LastName</h6>
                                    </td>
                                    <td>
                                        <h6 class="fw-semibold mb-0">@visit.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Brand</h6>
                                        <small class="text-muted">@visit.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model</small>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@visit.VisitDate.ToString("MMM dd, yyyy")</span>
                                            <small class="text-muted">@visit.VisitDate.ToString("hh:mm tt")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times-circle me-1"></i>Failed
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="BookFaultVisit" asp-route-RequestedFaultId="@visit.VisitId"
                                           class="btn btn-sm btn-outline-primary rounded-3 px-3"
                                           title="Book Repair Visit">
                                            <i class="fas fa-tools me-1"></i> Repair
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (!Model.MaintenanceFaults.Any() && !Model.CustomerReportedFaults.Any())
    {
        <div class="text-center py-5">
            <div class="py-5">
                <i class="fas fa-tools display-1 text-muted opacity-50"></i>
                <h4 class="mt-4 text-muted fw-semibold">No Faults Found</h4>
                <p class="text-muted mb-4">There are currently no faults to display.</p>
            </div>
        </div>
    }
</div>

<style>
    .border-start-4 {
        border-left-width: 4px !important;
    }

    .card {
        border: none;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }

    .table > :not(caption) > * > * {
        padding: 1rem 0.75rem;
    }

    tr:hover {
        background-color: #f8f9fa;
        transform: translateY(-1px);
        transition: all 0.2s ease;
    }

    .badge {
        font-size: 0.75em;
    }

    /* Different background colors for different statuses */
    .table-success {
        background-color: rgba(25, 135, 84, 0.05) !important;
    }

    .table-secondary {
        background-color: rgba(108, 117, 125, 0.05) !important;
    }

    .table-warning {
        background-color: rgba(255, 193, 7, 0.05) !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips if Bootstrap is available
        if (typeof bootstrap !== 'undefined') {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        }

        // Add status filter functionality
        const statusFilter = '@ViewBag.StatusFilter';
        if (statusFilter && statusFilter !== 'all') {
            // You can add client-side filtering here if needed
            console.log('Status filter active:', statusFilter);
        }
    });
</script>