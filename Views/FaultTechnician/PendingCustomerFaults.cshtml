@model IEnumerable<Project.Models.FaultTechnician>
@{
    ViewData["Title"] = "Pending Customer Fault Reports";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Pending Customer Fault Reports
                    </h3>
                    <span class="badge bg-dark">@Model.Count() Pending</span>
                </div>
                <div class="card-body">

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 text-muted">No Pending Reports</h4>
                            <p class="text-muted">All customer fault reports have been assigned.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Report Date</th>
                                        <th>Customer</th>
                                        <th>Fridge Details</th>
                                        <th>Fault Type</th>
                                        <th>Description</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in Model)
                                    {
                                        <tr>
                                            <td>@report.ReportDate?.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <strong>@report.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.FirstName @report.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.LastName</strong><br>
                                                <small class="text-muted">@report.FridgeVisit?.RequestHeader?.CellNumber</small>
                                            </td>
                                            <td>
                                                <strong>@report.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model</strong><br>
                                                <small class="text-muted">Serial: @report.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.CustomerFridges?.FirstOrDefault()?.FridgeInStock?.FridgeNo</small>
                                            </td>
                                            <td>@report.FaultType</td>
                                            <td>
                                                <div class="text-truncate" style="max-width: 200px;" title="@report.FaultDescription">
                                                    @report.FaultDescription
                                                </div>
                                            </td>
                                            <td>
                                                <a asp-action="AssignToFault" asp-route-faultId="@report.FaultId"
                                                   class="btn btn-success btn-sm"
                                                   onclick="return confirm('Assign this fault report to yourself?')">
                                                    <i class="bi bi-person-check me-1"></i>Assign to Me
                                                </a>

                                                <button type="button" class="btn btn-sm btn-outline-info mt-1"
                                                        data-bs-toggle="modal" data-bs-target="#detailsModal@(report.FaultId)">
                                                    <i class="bi bi-eye"></i> Details
                                                </button>

                                                <!-- Details Modal -->
                                                <div class="modal fade" id="detailsModal@(report.FaultId)" tabindex="-1">
                                                    <div class="modal-dialog modal-lg">
                                                        <div class="modal-content">
                                                            <div class="modal-header bg-primary text-white">
                                                                <h5 class="modal-title">Customer Fault Report Details</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <h6>Customer Information</h6>
                                                                        <p><strong>Name:</strong> @report.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.FirstName @report.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.LastName</p>
                                                                        <p><strong>Phone:</strong> @report.FridgeVisit?.RequestHeader?.CellNumber</p>
                                                                        <p><strong>Email:</strong> @report.FridgeVisit?.RequestHeader?.Customer?.ApplicationUser?.Email</p>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <h6>Fridge Information</h6>
                                                                        <p><strong>Model:</strong> @report.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model</p>
                                                                        <p><strong>Serial:</strong> @report.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.CustomerFridges?.FirstOrDefault()?.FridgeInStock?.FridgeNo</p>
                                                                        <p><strong>Report Date:</strong> @report.ReportDate?.ToString("MMM dd, yyyy")</p>
                                                                    </div>
                                                                </div>

                                                                <div class="mt-3">
                                                                    <h6>Fault Details</h6>
                                                                    <p><strong>Type:</strong> @report.FaultType</p>
                                                                    <p><strong>Description:</strong> @report.FaultDescription</p>
                                                                    @if (!string.IsNullOrEmpty(report.ResolutionNotes))
                                                                    {
                                                                        <p><strong>Customer Notes:</strong> @report.ResolutionNotes</p>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <a asp-action="AssignToFault" asp-route-faultId="@report.FaultId"
                                                                   class="btn btn-success"
                                                                   onclick="return confirm('Assign this fault report to yourself?')">
                                                                    <i class="bi bi-person-check me-1"></i>Assign to Me
                                                                </a>
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tooltip initialization
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
}