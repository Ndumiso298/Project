@model Project.Models.ViewModel.CustomerFaultReportViewModel
@{
    ViewData["Title"] = "Report Fridge Fault";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-primary text-white text-center py-4">
                    <h2 class="fw-bold mb-0">Report Fridge Fault</h2>
                    <p class="mb-0 opacity-75">Tell us what’s wrong with your fridge</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    <!-- Back -->
                    <div class="mb-4">
                        <a asp-action="CustomerFaultReports" class="btn btn-outline-primary">
                            Back to My Reports
                        </a>
                    </div>

                    <!-- Fridge info -->
                    <div class="card mb-4 border-0 bg-light">
                        <div class="card-body">
                            <h5 class="text-primary mb-3">Fridge Information</h5>
                            <div class="row">
                                <div class="col-md-6 mb-2"><strong>Customer:</strong> @Model.CustomerName</div>
                                <div class="col-md-6 mb-2"><strong>Model:</strong> @Model.FridgeModel</div>
                                <div class="col-md-6 mb-2"><strong>Serial:</strong> @Model.FridgeNo</div>
                                <div class="col-md-6 mb-2"><strong>Date:</strong> @Model.ReportDate.ToString("MMM dd, yyyy")</div>
                            </div>
                        </div>
                    </div>

                    <!-- Form -->
                    <form asp-action="CustomerFaultReport" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="VisitId" />
                        <input type="hidden" asp-for="CustomerID" />
                        <input type="hidden" asp-for="CustomerName" />
                        <input type="hidden" asp-for="FridgeNo" />
                        <input type="hidden" asp-for="FridgeModel" />
                        <input type="hidden" asp-for="ReportDate" />

                        <div class="card border-0 shadow-sm">
                            <div class="card-body">

                                <div class="mb-3">
                                    <label asp-for="FaultType" class="form-label fw-bold required-field">Fault Type</label>
                                    <select asp-for="FaultType" class="form-select" asp-items="ViewBag.FaultTypes" required></select>
                                    <span asp-validation-for="FaultType" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="FaultDescription" class="form-label fw-bold required-field">Description</label>
                                    <textarea asp-for="FaultDescription" class="form-control" rows="4" required></textarea>
                                    <span asp-validation-for="FaultDescription" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="AdditionalNotes" class="form-label fw-bold">Additional Notes (optional)</label>
                                    <textarea asp-for="AdditionalNotes" class="form-control" rows="3"></textarea>
                                </div>

                                <div class="alert alert-info">
                                    Our technicians will review the report and contact you within 24 hours.
                                </div>

                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        Submit Report
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .required-field::after {
            content: " *";
            color: #dc3545;
        }
    </style>
    <script>
        (() => {
            'use strict';
            const f = document.querySelector('.needs-validation');
            f.addEventListener('submit', e => {
                if (!f.checkValidity()) { e.preventDefault(); e.stopPropagation(); }
                f.classList.add('was-validated');
            }, false);
        })();
    </script>
}