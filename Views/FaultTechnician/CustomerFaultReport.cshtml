@model Project.Models.ViewModel.CustomerFaultReportViewModel
@{
    ViewData["Title"] = "Report Fridge Fault";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <!-- Header Card -->
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-gradient-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>Report Fridge Fault
                            </h2>
                            <p class="mb-0 opacity-75">Let us know about any issues with your refrigerator</p>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-white text-primary fs-6">Request #@Model.RequestHeaderId</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Fridge Information -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-light py-3">
                            <h5 class="card-title mb-0 text-dark">
                                <i class="bi bi-info-circle me-2"></i>Fridge Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                                    <i class="bi bi-refrigerator text-primary fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@Model.FridgeModel</h6>
                                    <small class="text-muted">Serial: @Model.FridgeNo</small>
                                </div>
                            </div>

                            <div class="border-top pt-3">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <small class="text-muted">Customer</small>
                                        <p class="fw-semibold mb-0 text-dark">@Model.CustomerName</p>
                                    </div>
                                    <div class="col-12">
                                        <small class="text-muted">Report Date</small>
                                        <p class="fw-semibold mb-0 text-dark">@Model.ReportDate.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fault Report Form -->
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light py-3">
                            <h5 class="card-title mb-0 text-dark">
                                <i class="bi bi-tools me-2"></i>Fault Details
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="CustomerFaultReport" method="post" class="needs-validation" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="RequestHeaderId" />
                                <input type="hidden" asp-for="CustomerID" />
                                <input type="hidden" asp-for="CustomerName" />
                                <input type="hidden" asp-for="FridgeNo" />
                                <input type="hidden" asp-for="FridgeModel" />
                                <input type="hidden" asp-for="ReportDate" />

                                <div class="row g-3">
                                    <!-- Fault Type -->
                                    <div class="col-12">
                                        <label asp-for="FaultType" class="form-label fw-semibold required-field">
                                            <i class="bi bi-tag me-1"></i>Fault Type
                                        </label>
                                        <select asp-for="FaultType" class="form-select form-select-lg" required>
                                            <option value="">-- Select the type of fault --</option>
                                            @foreach (var faultType in ViewBag.FaultTypes)
                                            {
                                                <option value="@faultType.Value">@faultType.Text</option>
                                            }
                                        </select>
                                        <span asp-validation-for="FaultType" class="text-danger small"></span>
                                        <div class="form-text">Please select the category that best describes the issue</div>
                                    </div>

                                    <!-- Fault Description -->
                                    <div class="col-12">
                                        <label asp-for="FaultDescription" class="form-label fw-semibold required-field">
                                            <i class="bi bi-chat-left-text me-1"></i>Fault Description
                                        </label>
                                        <textarea asp-for="FaultDescription" class="form-control" rows="5"
                                                  placeholder="Please describe the issue in detail. Include when it started, any error messages, and how it affects the fridge's performance..."
                                                  required></textarea>
                                        <span asp-validation-for="FaultDescription" class="text-danger small"></span>
                                        <div class="form-text">Be as specific as possible to help us diagnose the problem quickly</div>
                                    </div>

                                    <!-- Additional Notes -->
                                    <div class="col-12">
                                        <label asp-for="AdditionalNotes" class="form-label fw-semibold">
                                            <i class="bi bi-sticky me-1"></i>Additional Notes
                                        </label>
                                        <textarea asp-for="AdditionalNotes" class="form-control" rows="3"
                                                  placeholder="Any additional information that might help our technicians (e.g., when the issue started, any patterns you've noticed, previous repairs...)"></textarea>
                                        <div class="form-text">Optional information that could assist our technicians</div>
                                    </div>

                                    <!-- Information Alert -->
                                    <div class="col-12">
                                        <div class="alert alert-info border-0">
                                            <div class="d-flex">
                                                <i class="bi bi-info-circle me-3 fs-5 text-info"></i>
                                                <div>
                                                    <h6 class="alert-heading mb-2">What happens next?</h6>
                                                    <ul class="mb-0 ps-3">
                                                        <li>Our technicians will review your report within 24 hours</li>
                                                        <li>You'll receive updates on the repair status</li>
                                                        <li>A technician may contact you for additional information</li>
                                                        <li>Repair scheduling will be coordinated based on urgency</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                            <a asp-controller="Request" asp-action="Index" class="btn btn-outline-secondary px-4">
                                                <i class="bi bi-arrow-left me-2"></i>Back to Requests
                                            </a>
                                            <button type="submit" class="btn btn-primary px-4">
                                                <i class="bi bi-send me-2"></i>Submit Fault Report
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .required-field::after {
            content: " *";
            color: #dc3545;
        }

        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
            }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Enhanced form validation
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.needs-validation');

            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Add shake animation to invalid fields
                    const invalidFields = form.querySelectorAll(':invalid');
                    invalidFields.forEach(field => {
                        field.classList.add('is-invalid');
                        field.parentElement.classList.add('was-validated');
                    });
                }

                form.classList.add('was-validated');
            });

            // Real-time validation
            const faultTypeSelect = document.querySelector('#FaultType');
            const faultDescription = document.querySelector('#FaultDescription');

            faultTypeSelect.addEventListener('change', function () {
                validateField(this);
            });

            faultDescription.addEventListener('input', function () {
                validateField(this);
            });

            function validateField(field) {
                if (field.checkValidity()) {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                } else {
                    field.classList.remove('is-valid');
                    field.classList.add('is-invalid');
                }
            }

            // Character counter for description
            const descriptionCounter = document.createElement('div');
            descriptionCounter.className = 'form-text text-end';
            faultDescription.parentElement.appendChild(descriptionCounter);

            faultDescription.addEventListener('input', function () {
                const length = this.value.length;
                descriptionCounter.textContent = `${length} characters`;

                if (length < 10) {
                    descriptionCounter.classList.add('text-danger');
                    descriptionCounter.classList.remove('text-success');
                } else if (length < 50) {
                    descriptionCounter.classList.remove('text-danger', 'text-success');
                } else {
                    descriptionCounter.classList.add('text-success');
                    descriptionCounter.classList.remove('text-danger');
                }
            });
        });
    </script>
}