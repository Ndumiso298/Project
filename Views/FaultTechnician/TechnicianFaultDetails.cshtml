@model Project.Models.ViewModel.FaultDetailsViewModel
@using Project.Utility
@{
    ViewData["Title"] = "Process Fault";
    Layout = "_Layout"; // Use technician layout
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-cogs me-2"></i>Process Fault Report
                            </h2>
                            <p class="mb-0 opacity-75">Manage and update fault report status</p>
                        </div>
                        <div class="col-auto">
                            <a asp-action="AllFaults" class="btn btn-light">
                                <i class="fas fa-arrow-left me-1"></i> Back to All Faults
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Left Column - Fault Information & Actions -->
                        <div class="col-lg-8">
                            <!-- Fault Information Card -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-refrigerator me-2"></i>Fault Information
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Customer Details</h6>
                                            <p><strong>Name:</strong> @Model.FaultReport.Customer?.ApplicationUser?.FirstName @Model.FaultReport.Customer?.ApplicationUser?.LastName</p>
                                            <p><strong>Email:</strong> @Model.FaultReport.Customer?.ApplicationUser?.Email</p>
                                            <p><strong>Phone:</strong> @Model.FaultReport.Customer?.ApplicationUser?.PhoneNumber</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Fridge Details</h6>
                                            <p><strong>Brand:</strong> @Model.FaultReport.FridgeInStock?.Fridge?.Brand</p>
                                            <p><strong>Model:</strong> @Model.FaultReport.FridgeInStock?.Fridge?.Model</p>
                                            <p><strong>Serial Number:</strong> @Model.FaultReport.FridgeInStock?.FridgeNo</p>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <h6>Fault Details</h6>
                                            <p>
                                                <strong>Fault Type:</strong>
                                                <span class="badge bg-info">@Model.FaultReport.FaultType</span>
                                            </p>
                                            <p>
                                                <strong>Priority:</strong>
                                                @{
                                                    var priorityClass = Model.FaultReport.Priority?.ToLower() switch
                                                    {
                                                        "urgent" => "danger",
                                                        "high" => "warning",
                                                        "medium" => "info",
                                                        "low" => "secondary",
                                                        _ => "secondary"
                                                    };
                                                }
                                                <span class="badge bg-@priorityClass">@Model.FaultReport.Priority</span>
                                            </p>
                                            <p>
                                                <strong>Status:</strong>
                                                @{
                                                    var statusClass = Model.FaultReport.Status?.ToLower() switch
                                                    {
                                                        "reported" => "warning",
                                                        "in progress" => "info",
                                                        "resolved" => "success",
                                                        "scrapped" => "danger",
                                                        _ => "secondary"
                                                    };
                                                }
                                                <span class="badge bg-@statusClass">@Model.FaultReport.Status</span>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Dates</h6>
                                            <p><strong>Reported:</strong> @Model.FaultReport.ReportedDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                                            @if (Model.FaultReport.InProgressDate.HasValue)
                                            {
                                                <p><strong>In Progress:</strong> @Model.FaultReport.InProgressDate.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                                            }
                                            @if (Model.FaultReport.ResolvedDate.HasValue)
                                            {
                                                <p><strong>Resolved:</strong> @Model.FaultReport.ResolvedDate.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                                            }
                                            @if (Model.FaultReport.ScrappedDate.HasValue)
                                            {
                                                <p><strong>Scrapped:</strong> @Model.FaultReport.ScrappedDate.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                                            }
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h6>Fault Description</h6>
                                            <div class="card bg-light">
                                                <div class="card-body">
                                                    @Model.FaultReport.Description
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Technician Notes Section -->
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h6>
                                                <i class="fas fa-clipboard-check me-2 text-info"></i>Technician Notes
                                            </h6>
                                            <form id="technicianNotesForm" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="faultReportId" value="@Model.FaultReport.FaultReportId" />
                                                <div class="mb-3">
                                                    <textarea class="form-control" id="technicianNotes" name="technicianNotes"
                                                              rows="4" placeholder="Add your assessment, findings, and technical notes...">@Model.FaultReport.TechnicianNotes</textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fas fa-save me-1"></i> Save Notes
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status Actions Card -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-tasks me-2"></i>Status Actions
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReport.FaultReportId" />
                                                <input type="hidden" name="status" value="@SD.InProgress" />
                                                <button type="submit" class="btn btn-info w-100 mb-2">
                                                    <i class="fas fa-play-circle me-1"></i> Mark In Progress
                                                </button>
                                            </form>
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReport.FaultReportId" />
                                                <input type="hidden" name="status" value="@SD.FaultResolved" />
                                                <button type="submit" class="btn btn-success w-100 mb-2">
                                                    <i class="fas fa-check-circle me-1"></i> Mark Resolved
                                                </button>
                                            </form>
                                        </div>
                                        <div class="col-md-6">
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReport.FaultReportId" />
                                                <input type="hidden" name="status" value="Scrapped" />
                                                <button type="submit" class="btn btn-danger w-100 mb-2" onclick="return confirm('Are you sure you want to mark this fridge as scrapped? This will automatically create a replacement request.')">
                                                    <i class="fas fa-recycle me-1"></i> Mark Scrapped
                                                </button>
                                            </form>
                                            @if (Model.FaultReport.Status == "Scrapped" && Model.FaultReport.ReplacementRequest != null)
                                            {
                                                <a asp-controller="Replacement" asp-action="ManageReplacements" class="btn btn-warning w-100">
                                                    <i class="fas fa-exchange-alt me-1"></i> View Replacement
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Timeline Card -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-stream me-2"></i>Fault Timeline
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="timeline">
                                        @foreach (var timelineEvent in Model.TimelineEvents.OrderByDescending(t => t.EventDate))
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker bg-@timelineEvent.Color">
                                                    <i class="@timelineEvent.Icon"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <div class="timeline-header">
                                                        <h6 class="mb-1">@timelineEvent.EventType</h6>
                                                        <small class="text-muted">@timelineEvent.EventDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                                    </div>
                                                    <p class="mb-0 text-muted">@timelineEvent.Description</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Comments Section -->
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-comments me-2"></i>Communication
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <!-- Comments List -->
                                    <div class="comments-section mb-4" style="max-height: 400px; overflow-y: auto;">
                                        @if (Model.Comments.Any())
                                        {
                                            foreach (var comment in Model.Comments.OrderByDescending(c => c.CommentDate))
                                            {
                                                <div class="comment-item mb-3 p-3 rounded @(comment.CommentBy == "Customer" ? "bg-light" : "bg-info bg-opacity-10")">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <strong class="@(comment.CommentBy == "Customer" ? "text-primary" : "text-info")">
                                                            @if (comment.CommentBy == "Customer")
                                                            {
                                                                <i class="fas fa-user me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-tools me-1"></i>
                                                            }
                                                            @comment.UserName
                                                        </strong>
                                                        <small class="text-muted">@comment.CommentDate.ToString("MMM dd, HH:mm")</small>
                                                    </div>
                                                    <p class="mb-0">@comment.Comment</p>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted py-4">
                                                <i class="fas fa-comments fa-2x mb-3"></i>
                                                <p>No comments yet.</p>
                                            </div>
                                        }
                                    </div>

                                    <!-- Add Technician Comment Form -->
                                    <div class="add-comment-section">
                                        <form id="addTechnicianCommentForm" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="faultReportId" value="@Model.FaultReport.FaultReportId" />
                                            <div class="mb-3">
                                                <label for="technicianComment" class="form-label">Add Update</label>
                                                <textarea class="form-control" id="technicianComment" name="comment"
                                                          rows="3" placeholder="Provide update to customer..." required></textarea>
                                                <div class="form-text">Your comments will be visible to the customer.</div>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fas fa-paper-plane me-1"></i> Send Update
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Technician Notes Form
            const technicianNotesForm = document.getElementById('technicianNotesForm');
            if (technicianNotesForm) {
                technicianNotesForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const formData = new FormData(this);

                    fetch('@Url.Action("UpdateFaultStatus")', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            showToast('Technician notes saved successfully!', 'success');
                        } else {
                            showToast('Error saving notes', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('Error saving notes', 'error');
                    });
                });
            }

            // Technician Comment Form
            const technicianCommentForm = document.getElementById('addTechnicianCommentForm');
            const commentsSection = document.querySelector('.comments-section');
            const technicianCommentTextarea = document.getElementById('technicianComment');

            if (technicianCommentForm) {
                technicianCommentForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const formData = new FormData(this);
                    const faultReportId = formData.get('faultReportId');
                    const comment = formData.get('comment');

                    if (!comment.trim()) {
                        alert('Please enter a comment');
                        return;
                    }

                    // Show loading state
                    const submitBtn = this.querySelector('button[type="submit"]');
                    const originalText = submitBtn.innerHTML;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Sending...';
                    submitBtn.disabled = true;

                    fetch('@Url.Action("AddTechnicianComment")', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Add new comment to the list
                            const commentHtml = `
                                <div class="comment-item mb-3 p-3 rounded bg-info bg-opacity-10">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <strong class="text-info">
                                            <i class="fas fa-tools me-1"></i>
                                            ${data.userName}
                                        </strong>
                                        <small class="text-muted">${data.commentDate}</small>
                                    </div>
                                    <p class="mb-0">${data.commentText}</p>
                                </div>
                            `;

                            // If no comments exist, replace the empty state
                            if (commentsSection.querySelector('.text-center')) {
                                commentsSection.innerHTML = commentHtml;
                            } else {
                                commentsSection.insertAdjacentHTML('afterbegin', commentHtml);
                            }

                            // Clear textarea
                            technicianCommentTextarea.value = '';

                            // Scroll to top to show new comment
                            commentsSection.scrollTop = 0;

                            // Show success message
                            showToast('Update sent successfully!', 'success');
                        } else {
                            showToast(data.message || 'Error sending update', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showToast('Error sending update', 'error');
                    })
                    .finally(() => {
                        // Reset button state
                        submitBtn.innerHTML = originalText;
                        submitBtn.disabled = false;
                    });
                });
            }

            function showToast(message, type) {
                // Simple toast notification
                const toast = document.createElement('div');
                toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
                toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                toast.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(toast);

                setTimeout(() => {
                    if (toast.parentNode) {
                        toast.remove();
                    }
                }, 5000);
            }

            // Auto-scroll comments to bottom on load
            if (commentsSection) {
                commentsSection.scrollTop = 0;
            }
        });
    </script>
}
