@model IEnumerable<dynamic>
@{
    ViewData["Title"] = ViewBag.Source + " Faults";
    var source = ViewBag.Source as string ?? "Faults";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-exclamation-triangle me-2"></i>@ViewData["Title"]
                </h1>
                <a href="@Url.Action("ViewFaults")" class="btn btn-secondary">
                    <i class="fas fa-list me-1"></i>View All Faults
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-table me-1"></i>Fault List</h6>
            <span class="badge bg-light text-dark">@Model.Count() faults</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="faultsTable">
                    <thead class="table-light">
                        <tr>
                            @if (source == "Maintenance")
                            {
                                <th>Visit ID</th>
                                <th>Customer Name</th>
                                <th>Fridge Model</th>
                                <th>Description</th>
                                <th>Visit Date</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Actions</th>
                            }
                            else
                            {
                                <th>Report ID</th>
                                <th>Customer Name</th>
                                <th>Fridge Model</th>
                                <th>Description</th>
                                <th>Reported Date</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Fault Type</th>
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model)
                        {
                            <tr>
                                @if (source == "Maintenance")
                                {
                                    var maintenanceFault = fault as Project.Models.ViewModel.MaintenanceFaultVM;
                                    <td>@maintenanceFault.VisitId</td>
                                    <td>@maintenanceFault.CustomerName</td>
                                    <td>@maintenanceFault.FridgeModel</td>
                                    <td>@maintenanceFault.Description</td>
                                    <td>@maintenanceFault.VisitDate?.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge status-@maintenanceFault.Status.ToLower().Replace(" ", "-")">@maintenanceFault.Status</span></td>
                                    <td><span class="badge priority-@maintenanceFault.Priority.ToLower()">@maintenanceFault.Priority</span></td>
                                    <td>
                                        <a href="@Url.Action("ViewFaultDetails", new { id = maintenanceFault.VisitId, source = "Maintenance" })"
                                           class="btn btn-sm btn-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("ScheduleRepair", new { id = maintenanceFault.VisitId, source = "Maintenance" })"
                                           class="btn btn-sm btn-success" title="Schedule Repair">
                                            <i class="fas fa-calendar-plus"></i>
                                        </a>
                                    </td>
                                }
                                else
                                {
                                    var customerFault = fault as Project.Models.ViewModel.CustomerFaultVM;
                                    <td>@customerFault.FaultReportId</td>
                                    <td>@customerFault.CustomerName</td>
                                    <td>@customerFault.FridgeModel</td>
                                    <td>@customerFault.Description</td>
                                    <td>@customerFault.ReportedDate?.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge status-@customerFault.Status.ToLower().Replace(" ", "-")">@customerFault.Status</span></td>
                                    <td><span class="badge priority-@customerFault.Priority.ToLower()">@customerFault.Priority</span></td>
                                    <td>@customerFault.FaultType</td>
                                    <td>
                                        <a href="@Url.Action("ViewFaultDetails", new { id = customerFault.FaultReportId, source = "Customer Report" })"
                                           class="btn btn-sm btn-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("ScheduleRepair", new { id = customerFault.FaultReportId, source = "Customer Report" })"
                                           class="btn btn-sm btn-success" title="Schedule Repair">
                                            <i class="fas fa-calendar-plus"></i>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#faultsTable').DataTable({
                pageLength: 10,
                ordering: true,
                searching: true,
                responsive: true
            });
        });
    </script>
}