@model Project.Models.FaultTechnician

@{
    ViewData["Title"] = "Book Fault Visit";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header bg-primary text-white text-center py-4">
            <h2 class="fw-bold mb-0">Book Fault Visit</h2>
            <p class="mb-0 opacity-75">Assign or update a customer fault visit</p>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Back button -->
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Back to Faults
                </a>
            </div>

            <!-- Fault Info -->
            @if (Model.FridgeVisit != null)
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="text-primary mb-3"><i class="bi bi-info-circle me-2"></i>Fault Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Fridge Model</label>
                                <p class="mb-0">@Model.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Fridge Name</label>
                                <p class="mb-0">@Model.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Brand</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Customer</label>
                                <p class="mb-0">@Model.FridgeVisit?.RequestHeader?.FirstName</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="fw-bold text-muted small">Customer Booking Status</label>
                                <p class="mb-0"><span class="badge bg-warning">@Model.CustomerBookingStatus</span></p>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Booking Form -->
            <form asp-action="BookFaultVisit" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FaultId" />
                <input type="hidden" asp-for="VisitId" />

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="text-dark mb-4"><i class="bi bi-calendar-check me-2"></i>Schedule Visit</h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Bookingate" class="form-label fw-bold">Booking Date</label>
                                <input asp-for="Bookingate" type="date" class="form-control" required />
                                <span asp-validation-for="Bookingate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Completion" class="form-label fw-bold">Completion Date</label>
                                <input asp-for="Completion" type="date" class="form-control" />
                                <span asp-validation-for="Completion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TechnicianAssigned" class="form-label fw-bold">Technician Assigned</label>
                                <input asp-for="TechnicianAssigned" class="form-control" placeholder="Enter technician name..." />
                                <span asp-validation-for="TechnicianAssigned" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="RepairStatus" class="form-label fw-bold">Repair Status</label>
                                <select asp-for="RepairStatus" class="form-select" asp-items="ViewBag.RepairStatusList" required>
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="RepairStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FaultDescription" class="form-label fw-bold">Fault Description</label>
                            <textarea asp-for="FaultDescription" class="form-control" rows="3" placeholder="Describe the fault..."></textarea>
                            <span asp-validation-for="FaultDescription" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ResolutionNotes" class="form-label fw-bold">Resolution Notes</label>
                            <textarea asp-for="ResolutionNotes" class="form-control" rows="3" placeholder="Enter any notes or resolutions..."></textarea>
                            <span asp-validation-for="ResolutionNotes" class="text-danger"></span>
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="bi bi-save me-2"></i> Save Booking
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.needs-validation');
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                } else {
                    const btn = form.querySelector('button[type="submit"]');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-arrow-repeat spin me-2"></i> Saving...';
                }
                form.classList.add('was-validated');
            });
        });

        // Spinner animation
        const style = document.createElement('style');
        style.textContent = `
                    .spin { animation: spin 1s linear infinite; }
        keyframes spin { 100% { transform: rotate(360deg); } }
                `;
        document.head.appendChild(style);
    </script>
}
