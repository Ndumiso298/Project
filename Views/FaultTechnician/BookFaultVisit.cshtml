@model Project.Models.ViewModel.BookRepairVisitViewModel
@using Project.Utility
@{
    ViewData["Title"] = "Book Repair Visit";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-tools me-2"></i>Book Repair Visit
                            </h2>
                            <p class="mb-0 opacity-75">Schedule a repair visit</p>
                        </div>
                        <div class="col-auto">
                            <a href="@ViewBag.ReturnUrl" class="btn btn-light">
                                <i class="fas fa-arrow-left me-1"></i> Back
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Visit Information -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-info-circle me-2"></i>Visit Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Customer:</strong> @Model.CustomerName</p>
                                    <p><strong>Fridge:</strong> @Model.FridgeDetails</p>
                                    <p><strong>Address:</strong> @Model.Address</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Report Date:</strong> @Model.OriginalVisitDate.ToString("MMM dd, yyyy")</p>
                                    @if (Model.VisitId.HasValue)
                                    {
                                        <p><strong>Visit ID:</strong> #@Model.VisitId</p>
                                    }
                                    @if (Model.FaultReportId.HasValue)
                                    {
                                        <p><strong>Fault ID:</strong> #@Model.FaultReportId</p>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="row mt-3">
                                    <div class="col-12">
                                        <strong>Notes:</strong>
                                        <div class="card bg-light mt-2">
                                            <div class="card-body py-2">
                                                <p class="mb-0">@Model.Notes</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Repair Booking Form -->
                    <form asp-action="@ViewBag.FormAction" method="post">
                        @Html.AntiForgeryToken()

                        @if (Model.VisitId.HasValue)
                        {
                            <input type="hidden" asp-for="VisitId" />
                        }
                        @if (Model.FaultReportId.HasValue)
                        {
                            <input type="hidden" asp-for="FaultReportId" />
                        }
                        <input type="hidden" asp-for="CustomerId" />

                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-calendar-plus me-2"></i>Schedule Repair
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="RepairDate" class="form-label">Repair Date *</label>
                                            <input asp-for="RepairDate" type="date" class="form-control" />
                                            <span asp-validation-for="RepairDate" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="TimeSlot" class="form-label">Time Slot *</label>
                                            <select asp-for="TimeSlot" class="form-select">
                                                <option value="">Select Time Slot</option>
                                                @foreach (var slot in SD.TimeSlots)
                                                {
                                                    <option value="@slot">@slot.Replace("-", " - ")</option>
                                                }
                                            </select>
                                            <span asp-validation-for="TimeSlot" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="AdditionalNotes" class="form-label">Additional Notes (Optional)</label>
                                    <textarea asp-for="AdditionalNotes" class="form-control" rows="4"
                                              placeholder="Add any additional notes or instructions for the repair visit..."></textarea>
                                    <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a href="@ViewBag.ReturnUrl" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-calendar-check me-1"></i> Book Repair Visit
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set date constraints
            const repairDateInput = document.getElementById('RepairDate');
            if (repairDateInput) {
                const today = new Date().toISOString().split('T')[0];
                const maxDate = new Date();
                maxDate.setMonth(maxDate.getMonth() + 1);
                const maxDateStr = maxDate.toISOString().split('T')[0];

                repairDateInput.min = today;
                repairDateInput.max = maxDateStr;
            }
        });
    </script>
}