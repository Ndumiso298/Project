@model Project.Models.ViewModel.FaultReportVM
@{
    ViewData["Title"] = "Report Fault";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <!-- Header Card -->
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>Report Fridge Fault
                            </h2>
                            <p class="mb-0 opacity-75">Report an issue with your allocated refrigerator</p>
                        </div>
                        <div class="col-auto">
                            @if (Model.FridgeInfo != null)
                            {
                                <span class="badge bg-white text-primary fs-6">
                                    @Model.FridgeInfo.Brand @Model.FridgeInfo.Model
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-6">
                                    Fridge Information Missing
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Error Alert if FridgeInfo is null -->
            @if (Model.FridgeInfo == null)
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                    <div>
                        <h5 class="alert-heading">Fridge Information Not Available</h5>
                        <p class="mb-0">We couldn't retrieve the fridge information. Please go back and select a fridge again.</p>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-action="CreateFaultSelection" class="btn btn-primary btn-lg">
                        <i class="fas fa-arrow-left me-2"></i>Back to Fridge Selection
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    <!-- Fridge Information -->
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-light py-3">
                                <h5 class="card-title mb-0 text-dark">
                                    <i class="fas fa-info-circle me-2"></i>Fridge Information
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                                        <i class="fas fa-refrigerator text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@Model.FridgeInfo.Brand</h6>
                                        <small class="text-muted">@Model.FridgeInfo.Model</small>
                                    </div>
                                </div>

                                <div class="border-top pt-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <small class="text-muted">Customer</small>
                                            <p class="fw-semibold mb-0 text-dark">@Model.CustomerName</p>
                                        </div>
                                        <div class="col-12">
                                            <small class="text-muted">Report Date</small>
                                            <p class="fw-semibold mb-0 text-dark">@DateTime.Now.ToString("MMM dd, yyyy")</p>
                                        </div>
                                        @if (Model.FridgeInfo.CapacityLiters > 0)
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">Capacity</small>
                                                <p class="fw-semibold mb-0 text-dark">@Model.FridgeInfo.CapacityLiters Liters</p>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.FridgeInfo.Type))
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">Type</small>
                                                <p class="fw-semibold mb-0 text-dark">@Model.FridgeInfo.Type</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Fault Report Form -->
                    <div class="col-12 col-lg-8">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light py-3">
                                <h5 class="card-title mb-0 text-dark">
                                    <i class="fas fa-tools me-2"></i>Fault Details
                                </h5>
                            </div>
                            <div class="card-body">
                                <form id="faultForm" asp-action="CreateFault" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" asp-for="CustomerID" />
                                    <input type="hidden" asp-for="CustomerName" />
                                    <input type="hidden" asp-for="FridgeInStockId" />

                                    <div class="row g-3">
                                        <!-- Fault Type -->
                                        <div class="col-12">
                                            <label asp-for="FaultType" class="form-label fw-semibold">
                                                Fault Type <span class="text-danger">*</span>
                                            </label>
                                            <select asp-for="FaultType" class="form-select" required>
                                                <option value="">-- Select the type of fault --</option>
                                                @if (ViewBag.FaultTypes != null)
                                                {
                                                    foreach (var item in ViewBag.FaultTypes)
                                                    {
                                                        if (item is SelectListItem selectItem && !selectItem.Disabled && !string.IsNullOrEmpty(selectItem.Value))
                                                        {
                                                            <option value="@selectItem.Value">@selectItem.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                            <span asp-validation-for="FaultType" class="text-danger small"></span>
                                        </div>

                                        <!-- Priority -->
                                        <div class="col-12">
                                            <label asp-for="Priority" class="form-label fw-semibold">
                                                Priority Level
                                            </label>
                                            <select asp-for="Priority" class="form-select">
                                                <option value="Low">Low - Minor issue</option>
                                                <option value="Medium" selected>Medium - Affects functionality</option>
                                                <option value="High">High - Significantly affects usage</option>
                                                <option value="Urgent">Urgent - Fridge is unusable</option>
                                            </select>
                                        </div>

                                        <!-- Fault Description -->
                                        <div class="col-12">
                                            <label asp-for="Description" class="form-label fw-semibold">
                                                Fault Description <span class="text-danger">*</span>
                                            </label>
                                            <textarea asp-for="Description" class="form-control" rows="4"
                                                      placeholder="Describe the issue in detail. Include when it started, what you observe, and how it affects the fridge's performance..."
                                                      required></textarea>
                                            <span asp-validation-for="Description" class="text-danger small"></span>
                                            <div class="form-text">Please provide detailed information to help us diagnose the issue quickly.</div>
                                        </div>

                                        <!-- Fault Images -->
                                        <div class="col-12">
                                            <label class="form-label fw-semibold">Upload Images (Optional)</label>
                                            <input type="file" name="FaultImages" class="form-control" multiple
                                                   accept="image/jpeg,image/png,image/gif" id="imageUpload" />

                                            <!-- Image Preview Container -->
                                            <div id="imagePreview" class="mt-3 row g-2 d-none">
                                                <!-- Preview images will be added here dynamically -->
                                            </div>
                                            <div class="form-text">
                                                Maximum 5MB per image. Supported formats: JPG, PNG, GIF
                                            </div>
                                        </div>

                                        <!-- Information Alert -->
                                        <div class="col-12">
                                            <div class="alert alert-info border-0">
                                                <div class="d-flex">
                                                    <i class="fas fa-info-circle me-3 fs-5 text-info"></i>
                                                    <div>
                                                        <h6 class="alert-heading mb-2">What happens next?</h6>
                                                        <ul class="mb-0 ps-3">
                                                            <li>Our technicians will review your report within 24 hours</li>
                                                            <li>You'll receive updates on the repair status</li>
                                                            <li>A technician may contact you for additional information</li>
                                                            <li>Repair scheduling will be coordinated based on urgency</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                                <a asp-action="CreateFaultSelection" class="btn btn-outline-secondary px-4">
                                                    <i class="fas fa-arrow-left me-2"></i>Back to Selection
                                                </a>
                                                <button type="submit" class="btn btn-primary px-5" id="submitBtn">
                                                    <i class="fas fa-paper-plane me-2"></i>Submit Fault Report
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .btn-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
            }

        .image-preview-container {
            position: relative;
            display: inline-block;
            margin: 5px;
        }

        .image-preview {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #dee2e6;
        }

        .remove-image {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .is-invalid {
            border-color: #dc3545;
        }

        .is-valid {
            border-color: #198754;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Only initialize if the form exists (when FridgeInfo is not null)
            const form = document.getElementById('faultForm');
            if (!form) return;

            const imageUpload = document.getElementById('imageUpload');
            const imagePreview = document.getElementById('imagePreview');
            const submitBtn = document.getElementById('submitBtn');

            // Image preview functionality
            imageUpload.addEventListener('change', function(event) {
                const files = event.target.files;
                imagePreview.innerHTML = '';

                if (files.length > 0) {
                    imagePreview.classList.remove('d-none');

                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];

                        if (file.type.startsWith('image/')) {
                            const reader = new FileReader();

                            reader.onload = function(e) {
                                const col = document.createElement('div');
                                col.className = 'col-auto';

                                const previewContainer = document.createElement('div');
                                previewContainer.className = 'image-preview-container';

                                const img = document.createElement('img');
                                img.src = e.target.result;
                                img.className = 'image-preview';
                                img.alt = 'Preview';

                                const removeBtn = document.createElement('button');
                                removeBtn.type = 'button';
                                removeBtn.className = 'remove-image';
                                removeBtn.innerHTML = '×';
                                removeBtn.title = 'Remove image';
                                removeBtn.onclick = function() {
                                    removeImagePreview(previewContainer, i);
                                };

                                previewContainer.appendChild(img);
                                previewContainer.appendChild(removeBtn);
                                col.appendChild(previewContainer);
                                imagePreview.appendChild(col);
                            };

                            reader.readAsDataURL(file);
                        }
                    }
                } else {
                    imagePreview.classList.add('d-none');
                }
            });

            function removeImagePreview(container, index) {
                container.remove();

                // Update the file input
                const dt = new DataTransfer();
                const files = imageUpload.files;

                for (let i = 0; i < files.length; i++) {
                    if (i !== index) {
                        dt.items.add(files[i]);
                    }
                }

                imageUpload.files = dt.files;

                // Hide preview if no images left
                if (dt.files.length === 0) {
                    imagePreview.classList.add('d-none');
                }
            }

            // Form submission
            form.addEventListener('submit', function(e) {
                e.preventDefault();

                // Basic validation
                const faultType = document.querySelector('#FaultType').value;
                const description = document.querySelector('#Description').value.trim();

                if (!faultType) {
                    alert('Please select a fault type.');
                    document.querySelector('#FaultType').focus();
                    return;
                }

                if (!description) {
                    alert('Please describe the fault.');
                    document.querySelector('#Description').focus();
                    return;
                }

                if (description.length < 10) {
                    alert('Please provide a more detailed description (at least 10 characters).');
                    document.querySelector('#Description').focus();
                    return;
                }

                // Show loading state
                submitBtn.innerHTML = `
                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                    Submitting Report...
                `;
                submitBtn.disabled = true;

                // Submit the form normally (not via AJAX)
                form.submit();
            });

            // Real-time validation
            const requiredFields = form.querySelectorAll('[required]');
            requiredFields.forEach(field => {
                field.addEventListener('blur', function() {
                    validateField(this);
                });

                field.addEventListener('input', function() {
                    validateField(this);
                });
            });

            function validateField(field) {
                if (field.value.trim() === '') {
                    field.classList.add('is-invalid');
                    field.classList.remove('is-valid');
                } else {
                    field.classList.remove('is-invalid');
                    field.classList.add('is-valid');
                }
            }

            // File size validation
            imageUpload.addEventListener('change', function() {
                const files = this.files;
                const maxSize = 5 * 1024 * 1024; // 5MB

                for (let i = 0; i < files.length; i++) {
                    if (files[i].size > maxSize) {
                        alert(`File "${files[i].name}" is too large. Maximum size is 5MB.`);
                        this.value = '';
                        imagePreview.classList.add('d-none');
                        imagePreview.innerHTML = '';
                        break;
                    }
                }
            });
        });
    </script>
}