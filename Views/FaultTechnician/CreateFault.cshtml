@model Project.Models.ViewModel.FaultReportVM
@{
    ViewData["Title"] = "Report Fault";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-10 col-xl-8">
            <!-- Header Card -->
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-gradient-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>Report Fridge Fault
                            </h2>
                            <p class="mb-0 opacity-75">Report an issue with your allocated refrigerator</p>
                        </div>
                        <div class="col-auto">
                            @if (Model.FridgeInfo != null)
                            {
                                <span class="badge bg-white text-primary fs-6">
                                    @Model.FridgeInfo.Brand @Model.FridgeInfo.Model
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Fridge Information -->
                @if (Model.FridgeInfo != null)
                {
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-light py-3">
                                <h5 class="card-title mb-0 text-dark">
                                    <i class="fas fa-info-circle me-2"></i>Fridge Information
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                                        <i class="fas fa-refrigerator text-primary fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@Model.FridgeInfo.Brand</h6>
                                        <small class="text-muted">@Model.FridgeInfo.Model</small>
                                    </div>
                                </div>

                                <div class="border-top pt-3">
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <small class="text-muted">Customer</small>
                                            <p class="fw-semibold mb-0 text-dark">@Model.CustomerName</p>
                                        </div>
                                        <div class="col-12">
                                            <small class="text-muted">Report Date</small>
                                            <p class="fw-semibold mb-0 text-dark">@DateTime.Now.ToString("MMM dd, yyyy")</p>
                                        </div>
                                        @if (Model.FridgeInfo.CapacityLiters > 0)
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">Capacity</small>
                                                <p class="fw-semibold mb-0 text-dark">@Model.FridgeInfo.CapacityLiters Liters</p>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.FridgeInfo.Type))
                                        {
                                            <div class="col-12">
                                                <small class="text-muted">Type</small>
                                                <p class="fw-semibold mb-0 text-dark">@Model.FridgeInfo.Type</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Fault Report Form -->
                <div class="col-12 @(Model.FridgeInfo != null ? "col-lg-8" : "col-lg-12")">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-light py-3">
                            <h5 class="card-title mb-0 text-dark">
                                <i class="fas fa-tools me-2"></i>Fault Details
                            </h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="CreateFault" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="FridgeInStockId" />
                                <input type="hidden" asp-for="CustomerID" />
                                <input type="hidden" asp-for="CustomerName" />

                                <div class="row g-3">
                                    <!-- Fault Type -->
                                    <div class="col-12">
                                        <label asp-for="FaultType" class="form-label fw-semibold required-field">
                                            <i class="fas fa-tag me-1"></i>Fault Type
                                        </label>
                                        <select asp-for="FaultType" class="form-select form-select-lg" required>
                                            <option value="">-- Select the type of fault --</option>
                                            @foreach (var faultType in ViewBag.FaultTypes)
                                            {
                                                <option value="@faultType.Value">@faultType.Text</option>
                                            }
                                        </select>
                                        <span asp-validation-for="FaultType" class="text-danger small"></span>
                                        <div class="form-text">Please select the category that best describes the issue</div>
                                    </div>

                                    <!-- Fault Description -->
                                    <div class="col-12">
                                        <label asp-for="Description" class="form-label fw-semibold required-field">
                                            <i class="fas fa-comment-alt me-1"></i>Fault Description
                                        </label>
                                        <textarea asp-for="Description" class="form-control" rows="5"
                                                  placeholder="Please describe the issue in detail. Include when it started, any error messages, and how it affects the fridge's performance..."
                                                  required></textarea>
                                        <span asp-validation-for="Description" class="text-danger small"></span>
                                        <div class="form-text">Be as specific as possible to help us diagnose the problem quickly</div>
                                    </div>

                                    <!-- Priority -->
                                    <div class="col-12 col-md-6">
                                        <label asp-for="Priority" class="form-label fw-semibold">
                                            <i class="fas fa-flag me-1"></i>Priority
                                        </label>
                                        <select asp-for="Priority" class="form-select">
                                            <option value="Low">Low</option>
                                            <option value="Medium" selected>Medium</option>
                                            <option value="High">High</option>
                                            <option value="Urgent">Urgent</option>
                                        </select>
                                        <div class="form-text">How urgent is this repair?</div>
                                    </div>

                                    <!-- Request Replacement -->
                                    <div class="col-12 col-md-6">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-exchange-alt me-1"></i>Replacement Request
                                        </label>
                                        <div class="form-check form-switch mt-2">
                                            <input asp-for="RequestReplacement" class="form-check-input" type="checkbox" role="switch">
                                            <label class="form-check-label" asp-for="RequestReplacement">
                                                Request fridge replacement
                                            </label>
                                        </div>
                                        <div class="form-text">Check if you need a replacement fridge</div>
                                    </div>

                                    <!-- Fault Images -->
                                    <div class="col-12">
                                        <label asp-for="FaultImages" class="form-label fw-semibold">
                                            <i class="fas fa-camera me-1"></i>Upload Images
                                        </label>
                                        <input asp-for="FaultImages" type="file" class="form-control" multiple
                                               accept="image/*" />
                                        <span asp-validation-for="FaultImages" class="text-danger small"></span>
                                        <div class="form-text">
                                            Upload images of the fault (optional). Maximum 5MB per image.
                                            Supported formats: JPG, PNG, GIF
                                        </div>
                                    </div>

                                    <!-- Information Alert -->
                                    <div class="col-12">
                                        <div class="alert alert-info border-0">
                                            <div class="d-flex">
                                                <i class="fas fa-info-circle me-3 fs-5 text-info"></i>
                                                <div>
                                                    <h6 class="alert-heading mb-2">What happens next?</h6>
                                                    <ul class="mb-0 ps-3">
                                                        <li>Our technicians will review your report within 24 hours</li>
                                                        <li>You'll receive updates on the repair status</li>
                                                        <li>A technician may contact you for additional information</li>
                                                        <li>Repair scheduling will be coordinated based on urgency</li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="col-12">
                                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                            <a asp-action="CreateFaultSelection" class="btn btn-outline-secondary px-4">
                                                <i class="fas fa-arrow-left me-2"></i>Back to Fridge Selection
                                            </a>
                                            <button type="submit" class="btn btn-primary px-4">
                                                <i class="fas fa-paper-plane me-2"></i>Submit Fault Report
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .required-field::after {
            content: " *";
            color: #dc3545;
        }

        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
        }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
            }

        .form-check-input:checked {
            background-color: #667eea;
            border-color: #667eea;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.needs-validation');
            const descriptionTextarea = document.querySelector('#Description');
            const fileInput = document.querySelector('#FaultImages');

            // Character counter for description
            const descriptionCounter = document.createElement('div');
            descriptionCounter.className = 'form-text text-end mt-1';
            descriptionTextarea.parentElement.appendChild(descriptionCounter);

            function updateCharacterCount() {
                const length = descriptionTextarea.value.length;
                descriptionCounter.textContent = `${length} characters`;

                if (length < 10) {
                    descriptionCounter.classList.add('text-danger');
                    descriptionCounter.classList.remove('text-success');
                } else if (length < 50) {
                    descriptionCounter.classList.remove('text-danger', 'text-success');
                } else {
                    descriptionCounter.classList.add('text-success');
                    descriptionCounter.classList.remove('text-danger');
                }
            }

            descriptionTextarea.addEventListener('input', updateCharacterCount);
            updateCharacterCount(); // Initial count

            // File input validation
            if (fileInput) {
                fileInput.addEventListener('change', function() {
                    const files = this.files;
                    const maxSize = 5 * 1024 * 1024; // 5MB
                    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];

                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];

                        if (file.size > maxSize) {
                            alert(`File "${file.name}" is too large. Maximum size is 5MB.`);
                            this.value = '';
                            return;
                        }

                        if (!allowedTypes.includes(file.type)) {
                            alert(`File "${file.name}" is not a supported image format. Please use JPG, PNG, or GIF.`);
                            this.value = '';
                            return;
                        }
                    }
                });
            }

            // Form validation
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Add shake animation to invalid fields
                    const invalidFields = form.querySelectorAll(':invalid');
                    invalidFields.forEach(field => {
                        field.classList.add('is-invalid');
                        field.parentElement.classList.add('was-validated');
                    });

                    // Scroll to first invalid field
                    const firstInvalid = form.querySelector(':invalid');
                    if (firstInvalid) {
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        firstInvalid.focus();
                    }
                }

                form.classList.add('was-validated');
            });

            // Real-time validation for required fields
            const requiredFields = form.querySelectorAll('[required]');
            requiredFields.forEach(field => {
                field.addEventListener('blur', function() {
                    if (this.checkValidity()) {
                        this.classList.remove('is-invalid');
                        this.classList.add('is-valid');
                    } else {
                        this.classList.remove('is-valid');
                        this.classList.add('is-invalid');
                    }
                });
            });

            // Loading state for submit button
            const submitButton = form.querySelector('button[type="submit"]');
            form.addEventListener('submit', function() {
                if (form.checkValidity()) {
                    submitButton.innerHTML = `
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Submitting...
                    `;
                    submitButton.disabled = true;
                }
            });
        });
    </script>
}