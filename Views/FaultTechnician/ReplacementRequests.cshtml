@model IEnumerable<Project.Models.FridgeReplacement>

@{
    ViewData["Title"] = "My Replacement Requests";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">My Fridge Replacement Requests</h3>
            </div>
            <div class="card-body">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <h5>No replacement requests found.</h5>
                        <p>You haven't submitted any fridge replacement requests yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Request ID</th>
                                    <th>Old Fridge No</th>
                                    <th>Reason</th>
                                    <th>Request Date</th>
                                    <th>Status</th>
                                    <th>New Fridge</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.FridgeReplacementId</td>
                                        <td>@item.OldFridgeNo</td>
                                        <td>@item.ReasonForReplacement</td>
                                        <td>@item.RequestDate.ToString("MM/dd/yyyy")</td>
                                        <td>
                                            <span class="badge badge-@GetStatusBadgeClass(item.ReplacementStatus)">
                                                @item.ReplacementStatus
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.NewFridgeInStock != null)
                                            {
                                                <span>@item.NewFridgeInStock.Fridge.Model - @item.NewFridgeInStock.FridgeNo</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="ReplacementDetails" asp-route-id="@item.FridgeReplacementId"
                                               class="btn btn-info btn-sm">View Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "warning",
            "Approved" => "success",
            "Rejected" => "danger",
            "Completed" => "info",
            _ => "secondary"
        };
    }
}