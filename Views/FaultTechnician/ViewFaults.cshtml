@model IEnumerable<Project.Models.FaultTechnician>
@{
    ViewData["Title"] = "All Assigned Faults";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">All Assigned Faults</h1>
        <div>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>
            <a href="@Url.Action("Index")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Assign New Fault
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">All Technician Assignments</h6>
        </div>
        <div class="card-body">
            <!-- Status Filter -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="btn-group" role="group">
                        <a href="@Url.Action("ViewFaults")" class="btn btn-outline-secondary">All</a>
                        <a href="@Url.Action("ViewFaults", new { status = "Not Started" })" class="btn btn-outline-warning">Not Started</a>
                        <a href="@Url.Action("ViewFaults", new { status = "In Progress" })" class="btn btn-outline-info">In Progress</a>
                        <a href="@Url.Action("ViewFaults", new { status = "Completed" })" class="btn btn-outline-success">Completed</a>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Fault ID</th>
                            <th>Customer</th>
                            <th>Fridge Model</th>
                            <th>Fault Description</th>
                            <th>Technician</th>
                            <th>Status</th>
                            <th>Scheduled Date</th>
                            <th>Priority</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model)
                        {
                            <tr>
                                <td>#@fault.FaultId</td>
                                <td>
                                    <strong>@fault.FridgeVisit?.RequestHeader?.FirstName @fault.FridgeVisit?.RequestHeader?.LastName</strong>
                                </td>
                                <td>
                                    @fault.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(fault.FaultDescription))
                                    {
                                        <span title="@fault.FaultDescription">
                                            @(fault.FaultDescription.Length > 50 ? fault.FaultDescription.Substring(0, 50) + "..." : fault.FaultDescription)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No description</span>
                                    }
                                </td>
                                <td>@fault.TechnicianAssigned</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(fault.RepairStatus)">
                                        @fault.RepairStatus
                                    </span>
                                </td>
                                <td>@fault.Bookingate?.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetPriorityBadgeClass(fault.Priority)">
                                        @fault.Priority
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("ProcessFault", new { id = fault.FaultId })"
                                           class="btn btn-success btn-sm" title="Process Fault">
                                            <i class="fas fa-tools"></i>
                                        </a>
                                        <a href="@Url.Action("BookFaultVisit", new { requestedFaultId = fault.VisitId, visitId = fault.FaultId })"
                                           class="btn btn-info btn-sm" title="Edit Assignment">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                    <h4>No Assigned Faults</h4>
                    <p class="text-muted">There are no fault assignments yet.</p>
                    <a href="@Url.Action("Index")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Assign New Fault
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "bg-success",
            "in progress" => "bg-info",
            "not started" => "bg-warning",
            "scrapped" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => "bg-danger",
            "high" => "bg-warning",
            "medium" => "bg-info",
            "low" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}