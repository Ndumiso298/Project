@model IEnumerable<Project.Models.FaultTechnician>
@{
    ViewData["Title"] = "All Fault Assignments";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3 mb-0 text-gray-800">
                    <i class="fas fa-tasks me-2"></i>@ViewData["Title"]
                </h1>
                <div class="btn-group">
                    <a href="@Url.Action("ViewMaintenanceFaults")" class="btn btn-outline-primary">
                        <i class="fas fa-tools me-1"></i>Maintenance Faults
                    </a>
                    <a href="@Url.Action("ViewCustomerFaults")" class="btn btn-outline-primary">
                        <i class="fas fa-users me-1"></i>Customer Faults
                    </a>
                    <a href="@Url.Action("ViewCalendar")" class="btn btn-outline-success">
                        <i class="fas fa-calendar-alt me-1"></i>View Calendar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-list me-1"></i>All Fault Assignments</h6>
            <span class="badge bg-light text-dark">@Model.Count() assignments</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="assignmentsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Fault ID</th>
                            <th>Customer Name</th>
                            <th>Fridge Model</th>
                            <th>Source</th>
                            <th>Booking Date</th>
                            <th>Technician</th>
                            <th>Repair Status</th>
                            <th>Customer Booking Status</th>
                            <th>Last Updated</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model)
                        {
                            <tr>
                                <td>@assignment.FaultId</td>
                                <td>
                                    @if (assignment.FridgeVisit?.RequestHeader != null)
                                    {
                                        @($"{assignment.FridgeVisit.RequestHeader.FirstName} {assignment.FridgeVisit.RequestHeader.LastName}")
                                    }
                                    else if (assignment.FaultReport?.Customer?.ApplicationUser != null)
                                    {
                                        @assignment.FaultReport.Customer.ApplicationUser.UserName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </td>
                                <td>
                                    @if (assignment.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge != null)
                                    {
                                        @assignment.FridgeVisit.RequestHeader.RequestFridges.First().Fridge.Model
                                    }
                                    else if (assignment.FaultReport?.FridgeInStock?.Fridge != null)
                                    {
                                        @assignment.FaultReport.FridgeInStock.Fridge.Model
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown</span>
                                    }
                                </td>
                                <td>
                                    @if (assignment.FridgeVisit != null)
                                    {
                                        <span class="badge bg-info">Maintenance</span>
                                    }
                                    else if (assignment.FaultReport != null)
                                    {
                                        <span class="badge bg-warning text-dark">Customer Report</span>
                                    }
                                </td>
                                <td>@(assignment.Bookingate?.ToString("MMM dd, yyyy HH:mm") ?? "Not scheduled")</td>
                                <td>@assignment.TechnicianAssigned</td>
                                <td>
                                    <span class="badge status-@assignment.RepairStatus.ToLower().Replace(" ", "-")">
                                        @assignment.RepairStatus
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(assignment.CustomerBookingStatus))
                                    {
                                        <span class="badge @(assignment.CustomerBookingStatus == "Approved" ? "bg-success" :
                                                                                                    assignment.CustomerBookingStatus == "Declined" ? "bg-danger" : "bg-warning text-dark")">
                                    @assignment.CustomerBookingStatus
                                </span>
                                                                }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not Scheduled</span>
                                    }
                                </td>
                                <td>@assignment.LastUpdated.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    @{
                                        var source = assignment.FridgeVisit != null ? "Maintenance" : "Customer Report";
                                        var id = assignment.FridgeVisit != null ? assignment.VisitId : assignment.FaultReportId;
                                    }
                                    <a href="@Url.Action("ViewFaultDetails", new { id = id, source = source })"
                                       class="btn btn-sm btn-primary" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    @if (assignment.RepairStatus != "Resolved" && assignment.RepairStatus != "Completed")
                                    {
                                        <a href="@Url.Action("ScheduleRepair", new { id = assignment.FaultId, source = source })"
                                           class="btn btn-sm btn-success" title="Schedule Repair">
                                            <i class="fas fa-calendar-plus"></i>
                                        </a>
                                    }
                                    @if (assignment.RepairStatus == "Resolved" || assignment.RepairStatus == "Completed")
                                    {
                                        <span class="badge bg-success">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#assignmentsTable').DataTable({
                pageLength: 10,
                ordering: true,
                searching: true,
                responsive: true,
                order: [[4, 'desc']] // Sort by booking date descending
            });
        });
    </script>
}