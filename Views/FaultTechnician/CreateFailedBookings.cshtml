@model IEnumerable<Project.Models.FridgeVisit>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Create Maintenance Bookings";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h4 fw-bold mb-1">
                                <i class="bi bi-tools me-2"></i>Create Maintenance Bookings
                            </h2>
                            <p class="mb-0">Create maintenance bookings for failed fridge checkups</p>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <a asp-action="FailedFridges" class="btn btn-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>View Bookings
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Information Alert -->
                    <div class="alert alert-info">
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="bi bi-info-circle fs-4"></i>
                            </div>
                            <div>
                                <h5 class="alert-heading">How it works</h5>
                                <p class="mb-2">
                                    This will automatically create maintenance booking records for all fridge visits
                                    that have a "Failed" checkup status but don't have an existing maintenance booking.
                                </p>
                                <p class="mb-0">
                                    <strong>Note:</strong> Each failed checkup will create one maintenance booking record
                                    in the FaultTechnician table with default values that can be customized later.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Failed Checkups List -->
                    <div class="mb-4">
                        <h5 class="text-primary mb-3">
                            <i class="bi bi-list-check me-2"></i>
                            Failed Checkups Ready for Booking Creation
                        </h5>

                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-sm">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Visit Date</th>
                                            <th>Customer</th>
                                            <th>Fridge Details</th>
                                            <th>Technician</th>
                                            <th>Checkup Notes</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var visit in Model.OrderByDescending(v => v.VisitDate))
                                        {
                                            var fridge = visit.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge;
                                            var customer = visit.RequestHeader?.Customer?.ApplicationUser;
                                            var hasExistingBooking = ViewBag.ExistingBookingIds?.Contains(visit.VisitId) ?? false;

                                            <tr class="@(hasExistingBooking ? "table-warning" : "")">
                                                <td>
                                                    <small>@visit.VisitDate.ToString("MMM dd, yyyy")</small>
                                                </td>
                                                <td>
                                                    <strong>@customer?.FirstName @customer?.LastName</strong>
                                                    <br>
                                                    <small class="text-muted">@customer?.Email</small>
                                                </td>
                                                <td>
                                                    @if (fridge != null)
                                                    {
                                                        <div>
                                                            <strong>@fridge.Brand @fridge.Model</strong>
                                                            <br>
@*                                                             <small class="text-muted">Serial: @fridge.SerialNumber</small>
 *@                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No fridge details</span>
                                                    }
                                                </td>
                                                <td>@visit.TechnicianName</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(visit.Notes))
                                                    {
                                                        <span class="d-inline-block text-truncate" style="max-width: 200px;"
                                                              title="@visit.Notes">
                                                            @visit.Notes
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">No notes</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (hasExistingBooking)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-exclamation-triangle me-1"></i>Booking Exists
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-plus-circle me-1"></i>Ready to Create
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="alert alert-warning mt-3">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle me-2 fs-5"></i>
                                    <div>
                                        <strong>Note:</strong> Checkups marked with "Booking Exists" already have maintenance
                                        bookings and won't be created again.
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-check-circle display-4 text-success mb-3"></i>
                                <h4 class="text-muted">No Failed Checkups Found</h4>
                                <p class="text-muted">All failed checkups already have maintenance bookings or there are no failed checkups.</p>
                            </div>
                        }
                    </div>

                    <!-- Action Section -->
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h5 class="text-primary mb-2">Create Maintenance Bookings</h5>
                                    <p class="mb-0 text-muted">
                                        This will create @(Model?.Count(v => !(ViewBag.ExistingBookingIds?.Contains(v.VisitId) ?? false)) ?? 0)
                                        new maintenance booking(s) for failed checkups.
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    @if (Model != null && Model.Any(v => !(ViewBag.ExistingBookingIds?.Contains(v.VisitId) ?? false)))
                                    {
                                        <form asp-action="CreateFailedBookings" method="post" id="createBookingsForm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-lg">
                                                <i class="bi bi-plus-circle me-2"></i>Create Bookings
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary btn-lg" disabled>
                                            <i class="bi bi-check-circle me-2"></i>No New Bookings to Create
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- What will be created -->
                    @if (Model != null && Model.Any(v => !(ViewBag.ExistingBookingIds?.Contains(v.VisitId) ?? false)))
                    {
                        <div class="mt-4">
                            <h6 class="text-primary mb-3">What will be created:</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <ul class="list-group">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            Fault Technician Records
                                            <span class="badge bg-primary rounded-pill">@(Model.Count(v => !(ViewBag.ExistingBookingIds?.Contains(v.VisitId) ?? false)))</span>
                                        </li>
                                        <li class="list-group-item">
                                            <i class="bi bi-check text-success me-2"></i>Repair Status: <strong>Pending</strong>
                                        </li>
                                        <li class="list-group-item">
                                            <i class="bi bi-check text-success me-2"></i>Customer Booking Status: <strong>Pending</strong>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <ul class="list-group">
                                        <li class="list-group-item">
                                            <i class="bi bi-check text-success me-2"></i>Automatic Fault Descriptions
                                        </li>
                                        <li class="list-group-item">
                                            <i class="bi bi-check text-success me-2"></i>Checkup Notes Copied
                                        </li>
                                        <li class="list-group-item">
                                            <i class="bi bi-check text-success me-2"></i>Linked to Original Visit
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('createBookingsForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    const count = @(Model?.Count(v => !(ViewBag.ExistingBookingIds?.Contains(v.VisitId) ?? false)) ?? 0);
                    if (count > 0) {
                        if (!confirm(`Are you sure you want to create ${count} maintenance booking(s)? This action cannot be undone.`)) {
                            e.preventDefault();
                        }
                    }
                });
            }
        });
    </script>
}