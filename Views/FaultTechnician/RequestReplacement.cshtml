@model Project.Models.ViewModel.FridgeReplacementViewModel

@{
    ViewData["Title"] = "Request Fridge Replacement";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Request Fridge Replacement</h3>
            </div>
            <div class="card-body">
                <form asp-action="RequestReplacement" method="post">
                    <input asp-for="VisitId" type="hidden" />
                    <input asp-for="CustomerID" type="hidden" />


                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CustomerName" class="control-label">Customer Name</label>
                                <input asp-for="CustomerName" class="form-control" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="OldFridgeNo" class="control-label">Current Fridge Serial No</label>
                                <input asp-for="OldFridgeNo" class="form-control" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="FridgeModel" class="control-label">Fridge Model</label>
                        <input asp-for="FridgeModel" class="form-control" readonly />
                    </div>

                    <div class="form-group">
                        <label asp-for="ReasonForReplacement" class="control-label">Reason for Replacement *</label>
                        <select asp-for="ReasonForReplacement" class="form-control" required>
                            <option value="">Select Reason</option>
                            @foreach (var item in (List<SelectListItem>)ViewBag.ReplacementReasons)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="ReasonForReplacement" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="AdditionalNotes" class="control-label">Additional Notes</label>
                        <textarea asp-for="AdditionalNotes" class="form-control" rows="4"
                                  placeholder="Please provide any additional details about why the fridge needs replacement..."></textarea>
                        <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
                    </div>

                    <input type="hidden" asp-for="VisitId" />
                    <input type="hidden" asp-for="CustomerID" />

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Submit Replacement Request</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}