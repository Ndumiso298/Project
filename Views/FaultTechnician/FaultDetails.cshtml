@model Project.Models.FaultReport
@{
    ViewData["Title"] = "Process Fault";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-cogs me-2"></i>Process Fault Report
                            </h2>
                            <p class="mb-0 opacity-75">Manage and process customer fault report</p>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Index" class="btn btn-light">
                                <i class="fas fa-arrow-left me-1"></i> Back to Faults
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Fault Information -->
                        <div class="col-lg-8">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-info-circle me-2"></i>Fault Details
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Customer Information</h6>
                                            <p><strong>Name:</strong> @Model.Customer?.ApplicationUser?.FirstName @Model.Customer?.ApplicationUser?.LastName</p>
                                            <p><strong>Email:</strong> @Model.Customer?.ApplicationUser?.Email</p>
                                            <p><strong>Phone:</strong> @Model.Customer?.ApplicationUser?.PhoneNumber</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Fridge Information</h6>
                                            <p><strong>Brand:</strong> @Model.FridgeInStock?.Fridge?.Brand</p>
                                            <p><strong>Model:</strong> @Model.FridgeInStock?.Fridge?.Model</p>
                                            <p><strong>Fridge #:</strong> @Model.FridgeInStock?.FridgeNo</p>
                                            <p><strong>Capacity:</strong> @Model.FridgeInStock?.Fridge?.CapacityLiters L</p>
                                        </div>
                                    </div>
                                    <hr>
                                    <div class="row">
                                        <div class="col-12">
                                            <h6>Fault Details</h6>
                                            <div class="row mb-3">
                                                <div class="col-md-4">
                                                    <strong>Fault Type:</strong>
                                                    <span class="badge bg-info ms-2">@Model.FaultType</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <strong>Priority:</strong>
                                                    @{
                                                        var priorityClass = Model.Priority?.ToLower() switch
                                                        {
                                                            "urgent" => "danger",
                                                            "high" => "warning",
                                                            "medium" => "info",
                                                            "low" => "secondary",
                                                            _ => "secondary"
                                                        };
                                                    }
                                                    <span class="badge bg-@priorityClass ms-2">@Model.Priority</span>
                                                </div>
                                                <div class="col-md-4">
                                                    <strong>Status:</strong>
                                                    @{
                                                        var statusClass = Model.Status?.ToLower() switch
                                                        {
                                                            "reported" => "warning",
                                                            "in progress" => "info",
                                                            "resolved" => "success",
                                                            "declined" => "danger",
                                                            _ => "secondary"
                                                        };
                                                    }
                                                    <span class="badge bg-@statusClass ms-2">@Model.Status</span>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Description:</strong>
                                                <div class="card bg-light mt-2">
                                                    <div class="card-body">
                                                        @Model.Description
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Reported Date:</strong>
                                                <span class="text-muted">@Model.ReportedDate.ToString("MMMM dd, yyyy 'at' hh:mm tt")</span>
                                            </div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <hr>
                                        <div class="row">
                                            <div class="col-12">
                                                <h6>Attached Images</h6>
                                                <div class="row g-2">
                                                    @foreach (var imageUrl in Model.ImageUrl.Split(','))
                                                    {
                                                        <div class="col-auto">
                                                            <img src="@imageUrl" class="img-thumbnail" style="width: 200px; height: 150px; object-fit: cover;" alt="Fault image" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Action Panel -->
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-tasks me-2"></i>Fault Actions
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <!-- Status Update -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">Update Status</h6>
                                        <div class="d-grid gap-2">
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReportId" />
                                                <input type="hidden" name="status" value="In Progress" />
                                                <button type="submit" class="btn btn-info w-100 mb-2">
                                                    <i class="fas fa-play-circle me-1"></i> Mark In Progress
                                                </button>
                                            </form>
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReportId" />
                                                <input type="hidden" name="status" value="Resolved" />
                                                <button type="submit" class="btn btn-success w-100 mb-2">
                                                    <i class="fas fa-check-circle me-1"></i> Mark Resolved
                                                </button>
                                            </form>
                                            <form method="post" asp-action="UpdateFaultStatus" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.FaultReportId" />
                                                <input type="hidden" name="status" value="Declined" />
                                                <button type="submit" class="btn btn-danger w-100 mb-2">
                                                    <i class="fas fa-times-circle me-1"></i> Mark Declined
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Technician Notes -->
                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">Technician Notes</h6>
                                        <form method="post" asp-action="UpdateFaultNotes" id="notesForm">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@Model.FaultReportId" />
                                            <div class="mb-3">
                                                <textarea name="technicianNotes" class="form-control" rows="4"
                                                          placeholder="Add your assessment, findings, and resolution notes...">@Model.TechnicianNotes</textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fas fa-save me-1"></i> Save Notes
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Quick Actions -->
                                    <div>
                                        <h6 class="fw-bold mb-3">Quick Actions</h6>
                                        <div class="d-grid gap-2">
                                            @if (Model.FridgeInStockId.HasValue)
                                            {
                                                <a asp-controller="Replacement" asp-action="RequestReplacement"
                                                   asp-route-fridgeInStockId="@Model.FridgeInStockId"
                                                   class="btn btn-warning">
                                                    <i class="fas fa-exchange-alt me-1"></i> Request Replacement
                                                </a>
                                            }
                                            <button type="button" class="btn btn-outline-secondary" onclick="printFaultDetails()">
                                                <i class="fas fa-print me-1"></i> Print Report
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }

    .badge {
        font-size: 0.75em;
    }

    .img-thumbnail {
        transition: transform 0.2s ease;
    }

        .img-thumbnail:hover {
            transform: scale(1.05);
        }

    .btn {
        transition: all 0.2s ease;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Add confirmation for status changes
        const statusForms = document.querySelectorAll('form[action*="UpdateFaultStatus"]');
        statusForms.forEach(form => {
            form.addEventListener('submit', function (e) {
                const status = this.querySelector('input[name="status"]').value;
                if (!confirm(`Are you sure you want to change the status to "${status}"?`)) {
                    e.preventDefault();
                }
            });
        });

        // Auto-save notes with debounce
        const notesTextarea = document.querySelector('textarea[name="technicianNotes"]');
        const notesForm = document.getElementById('notesForm');
        let notesTimeout;

        notesTextarea.addEventListener('input', function () {
            clearTimeout(notesTimeout);
            notesTimeout = setTimeout(() => {
                notesForm.dispatchEvent(new Event('submit', { bubbles: true }));
            }, 2000);
        });

        // Show success message on notes save
        notesForm.addEventListener('submit', function (e) {
            e.preventDefault();

            const formData = new FormData(this);

            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) {
                    showToast('Notes saved successfully!', 'success');
                } else {
                    showToast('Error saving notes', 'error');
                }
            })
            .catch(error => {
                showToast('Error saving notes', 'error');
            });
        });
    });

    function printFaultDetails() {
        window.print();
    }

    function showToast(message, type) {
        // Simple toast notification
        const toast = document.createElement('div');
        toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
        toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
        toast.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 3000);
    }
</script>