@model Project.Models.FaultReport
@using Project.Utility
@{
    ViewData["Title"] = "Fault Report Details";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">Fault Report Details</h1>
                    <p class="text-muted mb-0">Complete information about your reported fault</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a asp-action="CustomerFaultReports" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Reports
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Fault Information -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 text-dark">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>Fault Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- Fault Type -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-muted">Fault Type</label>
                            <p class="fw-bold text-dark fs-6">@Model.FaultType</p>
                        </div>

                        <!-- Priority -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-muted">Priority</label>
                            <div>
                                @if (Model.Priority == "High" || Model.Priority == "Urgent")
                                {
                                    <span class="badge bg-danger fs-6">
                                        <i class="fas fa-flag me-1"></i>@Model.Priority
                                    </span>
                                }
                                else if (Model.Priority == "Medium")
                                {
                                    <span class="badge bg-warning fs-6">
                                        <i class="fas fa-flag me-1"></i>@Model.Priority
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">
                                        <i class="fas fa-flag me-1"></i>@Model.Priority
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-muted">Status</label>
                            <div>
                                @if (Model.Status == SD.Reported)
                                {
                                    <span class="badge bg-warning fs-6">
                                        <i class="fas fa-clock me-1"></i>Reported
                                    </span>
                                }
                                else if (Model.Status == SD.InProgress)
                                {
                                    <span class="badge bg-info fs-6">
                                        <i class="fas fa-tools me-1"></i>In Progress
                                    </span>
                                }
                                else if (Model.Status == SD.FaultResolved)
                                {
                                    <span class="badge bg-success fs-6">
                                        <i class="fas fa-check-circle me-1"></i>Resolved
                                    </span>
                                }
                                else if (Model.Status == SD.Declined)
                                {
                                    <span class="badge bg-danger fs-6">
                                        <i class="fas fa-times-circle me-1"></i>Declined
                                    </span>
                                }
                                else if (Model.Status == "Replacement Approved")
                                {
                                    <span class="badge bg-success fs-6">
                                        <i class="fas fa-exchange-alt me-1"></i>Replacement Approved
                                    </span>
                                }
                                else if (Model.Status == "Replacement Declined")
                                {
                                    <span class="badge bg-danger fs-6">
                                        <i class="fas fa-times-circle me-1"></i>Replacement Declined
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">
                                        <i class="fas fa-question-circle me-1"></i>@Model.Status
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Replacement Request -->
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-muted">Replacement Requested</label>
                            <div>
                                @if (Model.RequestReplacement)
                                {
                                    <span class="badge bg-primary fs-6">
                                        <i class="fas fa-check me-1"></i>Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">
                                        <i class="fas fa-times me-1"></i>No
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted">Fault Description</label>
                            <div class="card bg-light border-0">
                                <div class="card-body">
                                    <p class="mb-0 text-dark">@Model.Description</p>
                                </div>
                            </div>
                        </div>

                        <!-- Decline Reason (if declined) -->
                        @if (Model.Status == SD.Declined && !string.IsNullOrEmpty(Model.DeclineReason))
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold text-muted text-danger">Decline Reason</label>
                                <div class="card bg-light border-danger">
                                    <div class="card-body">
                                        <p class="mb-0 text-dark">@Model.DeclineReason</p>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Images -->
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold text-muted">Fault Images</label>
                                <div class="row g-2">
                                    @foreach (var imageUrl in Model.ImageUrl.Split(','))
                                    {
                                        <div class="col-6 col-md-4 col-lg-3">
                                            <div class="card border-0 shadow-sm">
                                                <img src="@imageUrl" class="card-img-top" alt="Fault image"
                                                     style="height: 150px; object-fit: cover; cursor: pointer;"
                                                     onclick="openImageModal('@imageUrl')">
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-12 col-lg-4">
            <!-- Fridge Information -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 text-dark">
                        <i class="fas fa-refrigerator text-primary me-2"></i>Fridge Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="fas fa-refrigerator text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">@Model.FridgeInStock?.Fridge?.Brand</h6>
                            <small class="text-muted">@Model.FridgeInStock?.Fridge?.Model</small>
                        </div>
                    </div>

                    <div class="border-top pt-3">
                        <div class="row g-2">
                            <div class="col-12">
                                <small class="text-muted">Serial Number</small>
                                <p class="fw-semibold mb-0 text-dark">@Model.FridgeInStock?.FridgeNo</p>
                            </div>
                            @if (Model.FridgeInStock?.Fridge?.CapacityLiters > 0)
                            {
                                <div class="col-12">
                                    <small class="text-muted">Capacity</small>
                                    <p class="fw-semibold mb-0 text-dark">@Model.FridgeInStock.Fridge.CapacityLiters Liters</p>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.FridgeInStock?.Fridge?.Type))
                            {
                                <div class="col-12">
                                    <small class="text-muted">Type</small>
                                    <p class="fw-semibold mb-0 text-dark">@Model.FridgeInStock.Fridge.Type</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Timeline Information -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 text-dark">
                        <i class="fas fa-history text-info me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <!-- Reported -->
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="fw-bold text-dark mb-1">Reported</h6>
                                <p class="text-muted mb-0 small">@Model.ReportedDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                            </div>
                        </div>

                        <!-- Status Updates -->
                        @if (Model.Status == SD.InProgress)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold text-dark mb-1">In Progress</h6>
                                    <p class="text-muted mb-0 small">Technician assigned and working on the issue</p>
                                </div>
                            </div>
                        }
                        else if (Model.Status == SD.FaultResolved)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold text-dark mb-1">Resolved</h6>
                                    <p class="text-muted mb-0 small">Fault has been resolved</p>
                                </div>
                            </div>
                        }
                        else if (Model.Status == SD.Declined)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-danger"></div>
                                <div class="timeline-content">
                                    <h6 class="fw-bold text-dark mb-1">Declined</h6>
                                    <p class="text-muted mb-0 small">Request was declined</p>
                                </div>
                            </div>
                        }

                        <!-- Next Steps -->
                        <div class="timeline-item">
                            <div class="timeline-marker bg-secondary"></div>
                            <div class="timeline-content">
                                <h6 class="fw-bold text-dark mb-1">Next Steps</h6>
                                @if (Model.Status == SD.Reported)
                                {
                                    <p class="text-muted mb-0 small">Our team will review your report within 24 hours</p>
                                }
                                else if (Model.Status == SD.InProgress)
                                {
                                    <p class="text-muted mb-0 small">Technician is working on your fridge</p>
                                }
                                else if (Model.Status == SD.FaultResolved)
                                {
                                    <p class="text-muted mb-0 small">Issue has been resolved. Thank you for your patience</p>
                                }
                                else if (Model.Status == SD.Declined)
                                {
                                    <p class="text-muted mb-0 small">You can relaunch this request with additional information</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions Card -->
            @if (Model.Status == SD.Declined)
            {
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 text-dark">
                            <i class="fas fa-redo text-info me-2"></i>Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <button type="button" class="btn btn-info w-100"
                                data-bs-toggle="modal" data-bs-target="#relaunchModal">
                            <i class="fas fa-redo me-2"></i>Relaunch Request
                        </button>
                        <div class="text-center mt-2">
                            <small class="text-muted">
                                Add more information and resubmit your request
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Fault Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" alt="Fault image" style="max-height: 70vh;">
            </div>
        </div>
    </div>
</div>

<!-- Relaunch Modal -->
<div class="modal fade" id="relaunchModal" tabindex="-1" aria-labelledby="relaunchModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="relaunchModalLabel">Relaunch Fault Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RelaunchFault" method="post">
                <div class="modal-body">
                    <input type="hidden" name="faultReportId" value="@Model.FaultReportId" />
                    <div class="mb-3">
                        <label for="additionalInfo" class="form-label">Additional Information</label>
                        <textarea class="form-control" id="additionalInfo" name="additionalInfo" rows="4"
                                  placeholder="Please provide any additional information that might help with your relaunched request..."></textarea>
                        <div class="form-text">Explain why you're relaunching this request or provide new information.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Relaunch Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        .badge {
            font-size: 0.75em;
            padding: 0.5em 0.75em;
        }

        /* Timeline Styles */
        .timeline {
            position: relative;
            padding-left: 2rem;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 1.5rem;
        }

        .timeline-marker {
            position: absolute;
            left: -2rem;
            top: 0.25rem;
            width: 1rem;
            height: 1rem;
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: 0 0 0 3px var(--bs-primary);
        }

        .timeline-content {
            margin-left: 0;
        }

        .timeline-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: -1.5rem;
            top: 1.25rem;
            bottom: -0.5rem;
            width: 2px;
            background-color: #e9ecef;
        }

        .bg-primary {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-primary-rgb), var(--bs-bg-opacity)) !important;
        }

        .bg-info {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-info-rgb), var(--bs-bg-opacity)) !important;
        }

        .bg-success {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-success-rgb), var(--bs-bg-opacity)) !important;
        }

        .bg-danger {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-danger-rgb), var(--bs-bg-opacity)) !important;
        }

        .bg-secondary {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-secondary-rgb), var(--bs-bg-opacity)) !important;
        }

        .bg-warning {
            --bs-bg-opacity: 1;
            background-color: rgba(var(--bs-warning-rgb), var(--bs-bg-opacity)) !important;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Image modal functionality
            function openImageModal(imageUrl) {
                const modalImage = document.getElementById('modalImage');
                if (modalImage) {
                    modalImage.src = imageUrl;
                    const imageModal = new bootstrap.Modal(document.getElementById('imageModal'));
                    imageModal.show();
                }
            }

            // Make openImageModal function globally available
            window.openImageModal = openImageModal;

            // Relaunch form validation
            const relaunchForm = document.querySelector('#relaunchModal form');
            if (relaunchForm) {
                relaunchForm.addEventListener('submit', function(e) {
                    const additionalInfo = document.getElementById('additionalInfo').value.trim();
                    if (!additionalInfo) {
                        e.preventDefault();
                        alert('Please provide additional information for relaunching the request.');
                        document.getElementById('additionalInfo').focus();
                    }
                });
            }

            // Auto-dismiss alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    if (alert) {
                        const bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    }
                }, 5000);
            });
        });
    </script>
}