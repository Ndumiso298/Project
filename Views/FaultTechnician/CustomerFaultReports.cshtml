@model IEnumerable<Project.Models.FaultTechnician>
@{
    ViewData["Title"] = "My Fault Reports";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">My Fault Reports</h3>

                    @if (ViewBag.HasActiveFridge)
                    {
                        <a asp-action="CustomerFaultReport"
                           asp-route-visitId="@ViewBag.ActiveVisitId"
                           class="btn btn-light btn-sm">
                            Report Issue
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" disabled>No Active Fridge</button>
                    }
                </div>

                <div class="card-body">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                            <h4 class="mt-3 text-muted">No Fault Reports</h4>
                            <p class="text-muted">You haven’t submitted any fault reports yet.</p>

                            @if (ViewBag.HasActiveFridge)
                            {
                                <a asp-action="CustomerFaultReport"
                                   asp-route-visitId="@ViewBag.ActiveVisitId"
                                   class="btn btn-primary mt-3">
                                    Report Your First Issue
                                </a>
                            }
                            else
                            {
                                <p class="text-muted mt-3"><small>You need an active fridge booking to report a fault.</small></p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover table-striped">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Report Date</th>
                                        <th>Fridge</th>
                                        <th>Fault Type</th>
                                        <th>Description</th>
                                        <th>Status</th>
                                        <th>Technician</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model)
                                    {
                                        var fridge = r.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault();
                                        var serial = fridge?.CustomerFridges?.FirstOrDefault()?.FridgeInStock?.FridgeNo;

                                        <tr>
                                            <td>@r.ReportDate?.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <strong>@fridge?.Fridge?.Model</strong><br>
                                                <small class="text-muted">Serial: @serial</small>
                                            </td>
                                            <td>@r.FaultType</td>
                                            <td>
                                                <div class="text-truncate" style="max-width:200px;" title="@r.FaultDescription">
                                                    @r.FaultDescription
                                                </div>
                                            </td>
                                            <td>
                                                @if (string.IsNullOrEmpty(r.TechnicianAssigned))
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">Assigned</span>
                                                }
                                            </td>
                                            <td>@(string.IsNullOrEmpty(r.TechnicianAssigned) ? "—" : r.TechnicianAssigned)</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        data-bs-toggle="modal" data-bs-target="#modal@(r.FaultId)">
                                                    View
                                                </button>

                                                <!-- Modal (same as you already have) -->
                                                <div class="modal fade" id="modal@(r.FaultId)" tabindex="-1">
                                                    <div class="modal-dialog modal-lg">
                                                        <div class="modal-content">
                                                            <div class="modal-header bg-primary text-white">
                                                                <h5 class="modal-title">Fault Details</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p><strong>Date:</strong> @r.ReportDate?.ToString("MMM dd, yyyy")</p>
                                                                <p><strong>Type:</strong> @r.FaultType</p>
                                                                <p><strong>Description:</strong> @r.FaultDescription</p>
                                                                @if (!string.IsNullOrEmpty(r.ResolutionNotes))
                                                                {
                                                                    <p><strong>Technician notes:</strong> @r.ResolutionNotes</p>
                                                                }
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap tooltips (optional)
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
        tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
    </script>
}