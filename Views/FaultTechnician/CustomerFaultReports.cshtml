@model IEnumerable<Project.Models.FaultReport>
@using Project.Utility
@{
    ViewData["Title"] = "My Fault Reports";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 fw-bold text-primary mb-2">My Fault Reports</h1>
                    <p class="text-muted mb-0">Track the status of your reported fridge faults</p>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="CreateFaultSelection" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Report New Fault
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Summary -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col">
                            <span class="fw-bold text-primary">Total: @Model.Count()</span>
                        </div>
                        <div class="col">
                            <span class="fw-bold text-warning">Reported: @Model.Count(r => r.Status == SD.Reported)</span>
                        </div>
                        <div class="col">
                            <span class="fw-bold text-info">In Progress: @Model.Count(r => r.Status == SD.InProgress)</span>
                        </div>
                        <div class="col">
                            <span class="fw-bold text-success">Resolved: @Model.Count(r => r.Status == SD.FaultResolved)</span>
                        </div>
                        <div class="col">
                            <span class="fw-bold text-danger">Declined: @Model.Count(r => r.Status == SD.Declined)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fault Reports Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 fw-bold text-primary">
                <i class="fas fa-list-ul me-2"></i>Fault Reports
            </h5>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 300px;">
                    <span class="input-group-text bg-transparent">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="faultSearch" class="form-control border-start-0"
                           placeholder="Search faults by type, status...">
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="faultTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 fw-semibold text-muted small text-uppercase">Fridge Details</th>
                            <th class="fw-semibold text-muted small text-uppercase">Fault Type</th>
                            <th class="fw-semibold text-muted small text-uppercase">Priority</th>
                            <th class="fw-semibold text-muted small text-uppercase">Status</th>
                            <th class="fw-semibold text-muted small text-uppercase">Reported Date</th>
                            <th class="text-end pe-4 fw-semibold text-muted small text-uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.OrderByDescending(r => r.ReportedDate))
                        {
                            <tr class="fault-row">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-2 p-2 me-3">
                                            <i class="fas fa-refrigerator text-primary fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">
                                                @report.FridgeInStock?.Fridge?.Brand @report.FridgeInStock?.Fridge?.Model
                                            </h6>
                                            <small class="text-muted">Serial: @report.FridgeInStock?.FridgeNo</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <h6 class="fw-semibold mb-0">@report.FaultType</h6>
                                        <small class="text-muted">@(report.Description?.Length > 50 ? report.Description?.Substring(0, 50) + "..." : report.Description)</small>
                                    </div>
                                </td>
                                <td>
                                    @if (report.Priority == "High" || report.Priority == "Urgent")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-flag me-1"></i>@report.Priority
                                        </span>
                                    }
                                    else if (report.Priority == "Medium")
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-flag me-1"></i>@report.Priority
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-flag me-1"></i>@report.Priority
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (report.Status == SD.Reported)
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock me-1"></i>Reported
                                        </span>
                                    }
                                    else if (report.Status == SD.InProgress)
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-tools me-1"></i>In Progress
                                        </span>
                                    }
                                    else if (report.Status == SD.FaultResolved)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i>Resolved
                                        </span>
                                    }
                                    else if (report.Status == SD.Declined)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times-circle me-1"></i>Declined
                                        </span>
                                    }
                                    else if (report.Status == "Replacement Approved")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-exchange-alt me-1"></i>Replacement Approved
                                        </span>
                                    }
                                    else if (report.Status == "Replacement Declined")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-times-circle me-1"></i>Replacement Declined
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-question-circle me-1"></i>@report.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-semibold text-dark">@report.ReportedDate.ToString("MMM dd, yyyy")</span>
                                        <small class="text-muted">@report.ReportedDate.ToString("hh:mm tt")</small>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="FaultDetails" asp-route-id="@report.FaultReportId"
                                           class="btn btn-sm btn-outline-primary rounded-3 me-2 px-3"
                                           data-bs-toggle="tooltip" data-bs-title="View Fault Details">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </a>

                                        <!-- Relaunch Button for Declined Requests -->
                                        @if (report.Status == SD.Declined)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-3 px-3"
                                                    data-bs-toggle="modal" data-bs-target="#relaunchModal"
                                                    data-fault-id="@report.FaultReportId">
                                                <i class="fas fa-redo me-1"></i> Relaunch
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="py-5">
                            <i class="fas fa-clipboard-list display-1 text-muted opacity-50"></i>
                            <h4 class="mt-4 text-muted fw-semibold">No Fault Reports Found</h4>
                            <p class="text-muted mb-4">Your fault reports will appear here once submitted</p>
                            <a asp-action="CreateFaultSelection" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Report Your First Fault
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Relaunch Modal -->
<div class="modal fade" id="relaunchModal" tabindex="-1" aria-labelledby="relaunchModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="relaunchModalLabel">Relaunch Fault Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="relaunchForm" method="post">
                <div class="modal-body">
                    <input type="hidden" id="relaunchFaultId" name="faultReportId" />
                    <div class="mb-3">
                        <label for="additionalInfo" class="form-label">Additional Information</label>
                        <textarea class="form-control" id="additionalInfo" name="additionalInfo" rows="4"
                                  placeholder="Please provide any additional information that might help with your relaunched request..."></textarea>
                        <div class="form-text">Explain why you're relaunching this request or provide new information.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Relaunch Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        .table > :not(caption) > * > * {
            padding: 1rem 0.75rem;
        }

        .fault-row:hover {
            background-color: #f8f9fa;
            transform: translateY(-1px);
            transition: all 0.2s ease;
        }

        .badge {
            font-size: 0.75em;
            padding: 0.5em 0.75em;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search functionality
            const searchInput = document.getElementById('faultSearch');
            const faultRows = document.querySelectorAll('.fault-row');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();

                    faultRows.forEach(row => {
                        const text = row.textContent.toLowerCase();
                        if (text.includes(searchTerm)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }

            // Relaunch modal functionality
            const relaunchModal = document.getElementById('relaunchModal');
            if (relaunchModal) {
                relaunchModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const faultId = button.getAttribute('data-fault-id');
                    const modal = this;
                    modal.querySelector('#relaunchFaultId').value = faultId;
                });

                // Set form action
                const relaunchForm = document.getElementById('relaunchForm');
                if (relaunchForm) {
                    relaunchForm.action = '@Url.Action("RelaunchFault")';
                }
            }

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Auto-dismiss alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    if (alert) {
                        const bsAlert = new bootstrap.Alert(alert);
                        bsAlert.close();
                    }
                }, 5000);
            });
        });
    </script>
}