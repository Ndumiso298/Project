@model Project.Models.ViewModel.FaultDetailsViewModel
@using Project.Utility
@{
    ViewData["Title"] = "Fault Details";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-4 rounded-top-4">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0">
                                <i class="fas fa-info-circle me-2"></i>Fault Report Details
                            </h2>
                            <p class="mb-0 opacity-75">Track your fault report status and communicate with technicians</p>
                        </div>
                        <div class="col-auto">
                            <a asp-action="CustomerFaultReports" class="btn btn-light">
                                <i class="fas fa-arrow-left me-1"></i> Back to My Reports
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Left Column - Fault Information & Timeline -->
                        <div class="col-lg-8">
                            <!-- Fault Information Card -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-refrigerator me-2"></i>Fault Information
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Fridge Details</h6>
                                            <p><strong>Brand:</strong> @Model.FaultReport.FridgeInStock?.Fridge?.Brand</p>
                                            <p><strong>Model:</strong> @Model.FaultReport.FridgeInStock?.Fridge?.Model</p>
                                            <p><strong>Serial Number:</strong> @Model.FaultReport.FridgeInStock?.FridgeNo</p>
                                        </div>
                                        <div class="col-md-6">
                                            <h6>Fault Details</h6>
                                            <p>
                                                <strong>Fault Type:</strong>
                                                <span class="badge bg-info">@Model.FaultReport.FaultType</span>
                                            </p>
                                            <p>
                                                <strong>Priority:</strong>
                                                @{
                                                    var priorityClass = Model.FaultReport.Priority?.ToLower() switch
                                                    {
                                                        "urgent" => "danger",
                                                        "high" => "warning",
                                                        "medium" => "info",
                                                        "low" => "secondary",
                                                        _ => "secondary"
                                                    };
                                                }
                                                <span class="badge bg-@priorityClass">@Model.FaultReport.Priority</span>
                                            </p>
                                            <p>
                                                <strong>Status:</strong>
                                                @{
                                                    var statusClass = Model.FaultReport.Status?.ToLower() switch
                                                    {
                                                        "reported" => "warning",
                                                        "in progress" => "info",
                                                        "resolved" => "success",
                                                        "scrapped" => "danger",
                                                        _ => "secondary"
                                                    };
                                                }
                                                <span class="badge bg-@statusClass">@Model.FaultReport.Status</span>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-12">
                                            <h6>Fault Description</h6>
                                            <div class="card bg-light">
                                                <div class="card-body">
                                                    @Model.FaultReport.Description
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Technician Notes (Visible to Customer) -->
                                    @if (!string.IsNullOrEmpty(Model.FaultReport.TechnicianNotes))
                                    {
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <h6>
                                                    <i class="fas fa-clipboard-check me-2 text-info"></i>Technician Notes
                                                </h6>
                                                <div class="card border-info">
                                                    <div class="card-body">
                                                        <p class="mb-0">@Model.FaultReport.TechnicianNotes</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Replacement Information if Scrapped -->
                                    @if (Model.FaultReport.Status == "Scrapped" && Model.FaultReport.ReplacementRequest != null)
                                    {
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <h6>
                                                    <i class="fas fa-exchange-alt me-2 text-warning"></i>Replacement Information
                                                </h6>
                                                <div class="card border-warning">
                                                    <div class="card-body">
                                                        <p><strong>Reason:</strong> @Model.FaultReport.ReplacementRequest.ReasonForReplacement</p>
                                                        <p>
                                                            <strong>Status:</strong>
                                                            <span class="badge bg-@(Model.FaultReport.ReplacementRequest.ReplacementStatus == "Approved" ? "success" : "warning")">
                                                                @Model.FaultReport.ReplacementRequest.ReplacementStatus
                                                            </span>
                                                        </p>
                                                        @if (Model.FaultReport.ReplacementRequest.ReplacementStatus == "Approved")
                                                        {
                                                            <p><strong>New Fridge:</strong> @Model.FaultReport.ReplacementRequest.NewFridgeInStock?.FridgeNo</p>
                                                            <p><strong>Expected Replacement:</strong> @Model.FaultReport.ReplacementRequest.ReplacementDate.ToString("MMM dd, yyyy")</p>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Timeline Card -->
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-stream me-2"></i>Fault Timeline
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="timeline">
                                        @foreach (var timelineEvent in Model.TimelineEvents.OrderByDescending(t => t.EventDate))
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker bg-@timelineEvent.Color">
                                                    <i class="@timelineEvent.Icon"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <div class="timeline-header">
                                                        <h6 class="mb-1">@timelineEvent.EventType</h6>
                                                        <small class="text-muted">@timelineEvent.EventDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                                                    </div>
                                                    <p class="mb-0 text-muted">@timelineEvent.Description</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Comments Section -->
                        <div class="col-lg-4">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">
                                        <i class="fas fa-comments me-2"></i>Communication
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <!-- Comments List -->
                                    <div class="comments-section mb-4" style="max-height: 400px; overflow-y: auto;">
                                        @if (Model.Comments.Any())
                                        {
                                            foreach (var comment in Model.Comments.OrderByDescending(c => c.CommentDate))
                                            {
                                                <div class="comment-item mb-3 p-3 rounded @(comment.CommentBy == "Customer" ? "bg-light" : "bg-info bg-opacity-10")">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <strong class="@(comment.CommentBy == "Customer" ? "text-primary" : "text-info")">
                                                            @if (comment.CommentBy == "Customer")
                                                            {
                                                                <i class="fas fa-user me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="fas fa-tools me-1"></i>
                                                            }
                                                            @comment.UserName
                                                        </strong>
                                                        <small class="text-muted">@comment.CommentDate.ToString("MMM dd, HH:mm")</small>
                                                    </div>
                                                    <p class="mb-0">@comment.Comment</p>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-center text-muted py-4">
                                                <i class="fas fa-comments fa-2x mb-3"></i>
                                                <p>No comments yet. Start the conversation!</p>
                                            </div>
                                        }
                                    </div>

                                    <!-- Add Comment Form -->
                                    <div class="add-comment-section">
                                        <form id="addCommentForm" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="faultReportId" value="@Model.FaultReport.FaultReportId" />
                                            <div class="mb-3">
                                                <label for="newComment" class="form-label">Add Comment</label>
                                                <textarea class="form-control" id="newComment" name="newComment"
                                                          rows="3" placeholder="Type your message here..." required></textarea>
                                                <div class="form-text">Your comments will be visible to the assigned technician.</div>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100">
                                                <i class="fas fa-paper-plane me-1"></i> Send Comment
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
        }

        .timeline-item {
            position: relative;
            padding-bottom: 2rem;
        }

        .timeline-marker {
            position: absolute;
            left: -2rem;
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

        .timeline-content {
            padding-left: 1rem;
        }

        .timeline-header {
            display: flex;
            justify-content: between;
            align-items: flex-start;
            margin-bottom: 0.5rem;
        }

        .comment-item {
            border-left: 4px solid;
        }

            .comment-item.bg-light {
                border-left-color: #0d6efd;
            }

            .comment-item.bg-info.bg-opacity-10 {
                border-left-color: #0dcaf0;
            }

        .comments-section::-webkit-scrollbar {
            width: 6px;
        }

        .comments-section::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .comments-section::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

            .comments-section::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const commentForm = document.getElementById('addCommentForm');
            const commentsSection = document.querySelector('.comments-section');
            const newCommentTextarea = document.getElementById('newComment');

            commentForm.addEventListener('submit', function (e) {
                e.preventDefault();

                const formData = new FormData(this);
                const faultReportId = formData.get('faultReportId');
                const newComment = formData.get('newComment');

                if (!newComment.trim()) {
                    alert('Please enter a comment');
                    return;
                }

                // Show loading state
                const submitBtn = this.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Sending...';
                submitBtn.disabled = true;

                fetch('@Url.Action("AddComment")', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Add new comment to the list
                        const commentHtml = `
                            <div class="comment-item mb-3 p-3 rounded bg-light">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <strong class="text-primary">
                                        <i class="fas fa-user me-1"></i>
                                        ${data.userName}
                                    </strong>
                                    <small class="text-muted">${data.commentDate}</small>
                                </div>
                                <p class="mb-0">${data.commentText}</p>
                            </div>
                        `;

                        // If no comments exist, replace the empty state
                        if (commentsSection.querySelector('.text-center')) {
                            commentsSection.innerHTML = commentHtml;
                        } else {
                            commentsSection.insertAdjacentHTML('afterbegin', commentHtml);
                        }

                        // Clear textarea
                        newCommentTextarea.value = '';

                        // Scroll to top to show new comment
                        commentsSection.scrollTop = 0;

                        // Show success message
                        showToast('Comment added successfully!', 'success');
                    } else {
                        showToast(data.message || 'Error adding comment', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Error adding comment', 'error');
                })
                .finally(() => {
                    // Reset button state
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                });
            });

            function showToast(message, type) {
                // Simple toast notification
                const toast = document.createElement('div');
                toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
                toast.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
                toast.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(toast);

                setTimeout(() => {
                    if (toast.parentNode) {
                        toast.remove();
                    }
                }, 5000);
            }

            // Auto-scroll comments to bottom on load
            commentsSection.scrollTop = 0;
        });
    </script>
}