@model IEnumerable<Project.Models.FaultTechnician>

@{
    ViewData["Title"] = "All Fault Assignments";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 text-gray-800">@ViewData["Title"]</h1>
        <div>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Dashboard
            </a>
            <a href="@Url.Action("ViewMaintenanceFaults")" class="btn btn-outline-warning">
                <i class="fas fa-tools"></i> Maintenance
            </a>
            <a href="@Url.Action("ViewCustomerFaults")" class="btn btn-outline-primary">
                <i class="fas fa-users"></i> Customer
            </a>
        </div>
    </div>

    <!-- Faults Table -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">All Fault Assignments</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="allFaultsTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th>Type</th>
                            <th>Customer</th>
                            <th>Fridge Model</th>
                            <th>Technician</th>
                            <th>Booking Date</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Completion</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fault in Model)
                        {
                            <tr>
                                <td>
                                    @if (fault.FridgeVisit != null)
                                    {
                                        <span class="badge badge-warning">Maintenance</span>
                                    }
                                    else if (fault.FaultReport != null)
                                    {
                                        <span class="badge badge-primary">Customer</span>
                                    }
                                </td>
                                <td>
                                    @if (fault.FridgeVisit != null)
                                    {
                                        @($"{fault.FridgeVisit.RequestHeader?.FirstName} {fault.FridgeVisit.RequestHeader?.LastName}")
                                    }
                                    else if (fault.FaultReport != null)
                                    {
                                        @fault.FaultReport.Customer?.ApplicationUser?.UserName
                                    }
                                </td>
                                <td>
                                    @if (fault.FridgeVisit != null)
                                    {
                                        @fault.FridgeVisit.RequestHeader?.RequestFridges.FirstOrDefault()?.Fridge.Model
                                    }
                                    else if (fault.FaultReport != null)
                                    {
                                        @fault.FaultReport.FridgeInStock?.Fridge.Model
                                    }
                                </td>
                                <td>@fault.TechnicianAssigned</td>
                                <td>@fault.Bookingate?.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(fault.RepairStatus)">@fault.RepairStatus</span>
                                </td>
                                <td>
                                    <span class="badge @GetPriorityBadgeClass(fault.Priority)">@fault.Priority</span>
                                </td>
                                <td>
                                    @if (fault.Completion.HasValue)
                                    {
                                        <span class="text-success">@fault.Completion?.ToString("MMM dd, yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("ProcessFault", new { id = fault.FaultId })"
                                           class="btn btn-primary" title="Process Fault">
                                            <i class="fas fa-cogs"></i>
                                        </a>
                                        @if (fault.RepairStatus != "Completed" && fault.RepairStatus != "Resolved")
                                        {
                                            <a href="@Url.Action("UpdateFaultStatus", new { id = fault.FaultId, status = "Completed" })"
                                               class="btn btn-success" title="Mark Complete"
                                               onclick="return confirm('Mark this repair as completed?')">
                                                <i class="fas fa-check"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "not started" => "badge-secondary",
            "in progress" => "badge-warning",
            "completed" => "badge-success",
            "resolved" => "badge-primary",
            "scrapped" => "badge-danger",
            _ => "badge-secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "badge-danger",
            "medium" => "badge-warning",
            "low" => "badge-info",
            "critical" => "badge-dark",
            _ => "badge-secondary"
        };
    }
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#allFaultsTable').DataTable({
                "order": [[4, "desc"]],
                "pageLength": 10,
                "language": {
                    "emptyTable": "No fault assignments found",
                    "info": "Showing _START_ to _END_ of _TOTAL_ faults",
                    "infoEmpty": "Showing 0 to 0 of 0 faults",
                    "infoFiltered": "(filtered from _MAX_ total faults)"
                }
            });
        });
    </script>
}