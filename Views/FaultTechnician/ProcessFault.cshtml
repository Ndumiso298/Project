@model Project.Models.FaultTechnician
@{
    ViewData["Title"] = "Process Fault Repair";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Process Fault Repair</h1>
        <a href="@Url.Action("ViewFaults")" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm text-white-50"></i> Back to Faults
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Fault Repair Details</h6>
                    <span class="badge bg-@GetStatusBadgeClass(Model.RepairStatus)">@Model.RepairStatus</span>
                </div>
                <div class="card-body">
                    <form asp-action="ProcessFault" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="FaultId" />

                        <!-- Customer & Fault Information -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <h6 class="text-primary">Customer Information</h6>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <p class="mb-1">
                                            <strong>Name:</strong>
                                            @Model.FridgeVisit?.RequestHeader?.FirstName @Model.FridgeVisit?.RequestHeader?.LastName
                                        </p>
                                        <p class="mb-1">
                                            <strong>Fridge Model:</strong>
                                            @Model.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model
                                        </p>
                                        <p class="mb-0">
                                            <strong>Visit Date:</strong>
                                            @Model.FridgeVisit?.VisitDate.ToString("MMM dd, yyyy")
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-primary">Assignment Details</h6>
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <p class="mb-1">
                                            <strong>Technician:</strong>
                                            @Model.TechnicianAssigned
                                        </p>
                                        <p class="mb-1">
                                            <strong>Scheduled:</strong>
                                            @Model.Bookingate?.ToString("MMM dd, yyyy hh:mm tt")
                                        </p>
                                        <p class="mb-0">
                                            <strong>Priority:</strong>
                                            <span class="badge bg-@GetPriorityBadgeClass(Model.Priority)">@Model.Priority</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fault Description -->
                        <div class="form-group mb-3">
                            <label class="form-label"><strong>Original Fault Description</strong></label>
                            <div class="card">
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(Model.FaultDescription))
                                    {
                                        @Model.FaultDescription
                                    }
                                    else
                                    {
                                        <span class="text-muted">No fault description provided</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Repair Processing -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="RepairStatus" class="form-label">Repair Status *</label>
                                    <select asp-for="RepairStatus" class="form-control">
                                        <option value="Not Started">Not Started</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>
                                        <option value="Resolved">Resolved</option>
                                        <option value="Scrapped">Scrapped</option>
                                    </select>
                                    <span asp-validation-for="RepairStatus" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="TechnicianAssigned" class="form-label">Technician Assigned</label>
                                    <input asp-for="TechnicianAssigned" class="form-control"
                                           placeholder="Technician responsible...">
                                    <span asp-validation-for="TechnicianAssigned" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ActualRepairTime" class="form-label">Actual Repair Time (hours)</label>
                                    <input asp-for="ActualRepairTime" class="form-control" type="number" min="0" max="24"
                                           placeholder="Actual hours spent...">
                                    <span asp-validation-for="ActualRepairTime" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="RepairCost" class="form-label">Repair Cost (if any)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="RepairCost" class="form-control" type="number" step="0.01" min="0"
                                               placeholder="0.00">
                                    </div>
                                    <span asp-validation-for="RepairCost" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ResolutionNotes" class="form-label">Resolution Notes *</label>
                            <textarea asp-for="ResolutionNotes" class="form-control" rows="4"
                                      placeholder="Describe the repair work done, parts replaced, and final resolution..."></textarea>
                            <span asp-validation-for="ResolutionNotes" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Provide detailed notes about the repair process, including any challenges faced and solutions applied.
                            </small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("ViewFaults")" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Repair Status
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Information -->
        <div class="col-lg-4">
            <!-- Status Guide -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Status Instructions</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <span class="badge bg-warning">Not Started</span>
                        <small class="text-muted">- Assignment created but work not started</small>
                    </div>
                    <div class="mb-3">
                        <span class="badge bg-info">In Progress</span>
                        <small class="text-muted">- Currently working on the repair</small>
                    </div>
                    <div class="mb-3">
                        <span class="badge bg-success">Completed/Resolved</span>
                        <small class="text-muted">- Fault has been successfully repaired</small>
                    </div>
                    <div class="mb-3">
                        <span class="badge bg-secondary">Scrapped</span>
                        <small class="text-muted">- Fridge cannot be repaired (beyond economical repair)</small>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="@Url.Action("BookFaultVisit", new { requestedFaultId = Model.VisitId, visitId = Model.FaultId })"
                           class="btn btn-outline-primary">
                            <i class="fas fa-edit"></i> Edit Assignment
                        </a>
                        <a href="@Url.Action("Index")" class="btn btn-outline-info">
                            <i class="fas fa-list"></i> View All Failed Visits
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-set completion date when status is set to Completed
            const statusSelect = document.getElementById('RepairStatus');
            statusSelect.addEventListener('change', function() {
                if (this.value === 'Completed' || this.value === 'Resolved') {
                    // You could auto-populate completion date here if needed
                    console.log('Repair completed - consider adding completion timestamp');
                }
            });
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "success",
            "in progress" => "info",
            "not started" => "warning",
            "scrapped" => "secondary",
            _ => "secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "secondary",
            _ => "secondary"
        };
    }
}