@model FaultRecord
@{
    ViewData["Title"] = "Fault Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-ticket-alt text-primary me-2"></i>Fault Details
        </h1>
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
            <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-outline-info">
                <i class="fas fa-print me-1"></i>Print
            </a>
            @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.FaultTechnicianRole))
            {
                <a asp-action="Process" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-cogs me-1"></i>Process Fault
                </a>
            }
        </div>
    </div>

    <div class="row">
        <!-- Main Information -->
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Fault Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Fault Code</label>
                            <p class="form-control-plaintext">@Model.FaultCode</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Title</label>
                            <p class="form-control-plaintext">@Model.Title</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Description</label>
                            <div class="border rounded p-3 bg-light">
                                @Model.Description
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Status</label>
                            <div>
                                <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Priority</label>
                            <div>
                                <span class="badge @GetPriorityBadgeClass(Model.Priority) fs-6">
                                    @Model.Priority
                                </span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Category</label>
                            <p class="form-control-plaintext">@Model.Category</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resolution Details -->
            @if (Model.Status == FaultStatus.Resolved || Model.Status == FaultStatus.Closed)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-check-circle me-2"></i>Resolution Details
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Resolved Date</label>
                                <p class="form-control-plaintext">
                                    @Model.ResolvedDate?.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Resolution Time</label>
                                <p class="form-control-plaintext">
                                    @if (Model.ResolvedDate.HasValue)
                                    {
                                        var resolutionTime = Model.ResolvedDate.Value - Model.ReportedDate;
                                        <span>@resolutionTime.Days days, @resolutionTime.Hours hours</span>
                                    }
                                </p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
                        {
                            <div class="mt-3">
                                <label class="form-label fw-bold">Resolution Notes</label>
                                <div class="border rounded p-3 bg-light">
                                    @Model.ResolutionNotes
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Information -->
        <div class="col-lg-4">
            <!-- Related Entities -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>Related Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fridge</label>
                        <p class="form-control-plaintext">
                            <i class="fas fa-refrigerator me-2"></i>
                            @Model.Fridge?.SerialNumber - @Model.Fridge?.FridgeModel?.ModelName
                        </p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Customer</label>
                        <p class="form-control-plaintext">
                            <i class="fas fa-user me-2"></i>
                            @Model.ReportedBy?.FullName
                        </p>
                        <small class="text-muted">@Model.ReportedBy?.Email</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Assigned Technician</label>
                        <p class="form-control-plaintext">
                            <i class="fas fa-tools me-2"></i>
                            @(Model.AssignedTechnician?.FullName ?? "Not Assigned")
                        </p>
                    </div>
                </div>
            </div>

            <!-- Timeline -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="mb-1">Fault Reported</h6>
                                <small class="text-muted">@Model.ReportedDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>

                        @if (Model.AssignedTechnicianId.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-warning"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Assigned to Technician</h6>
                                    <small class="text-muted">@Model.AssignedTechnician?.FullName</small>
                                </div>
                            </div>
                        }

                        @if (Model.ResolvedDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Fault Resolved</h6>
                                    <small class="text-muted">@Model.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

    .timeline-marker {
        position: absolute;
        left: -30px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        top: 5px;
    }

    .timeline-content {
        padding-bottom: 10px;
        border-left: 2px solid #dee2e6;
        padding-left: 15px;
    }

    .timeline-item:last-child .timeline-content {
        border-left: 2px solid transparent;
    }
</style>

@functions {
    public string GetStatusBadgeClass(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "bg-secondary",
            FaultStatus.Assigned => "bg-info",
            FaultStatus.InProgress => "bg-warning",
            FaultStatus.PartsRequired => "bg-primary",
            FaultStatus.Resolved => "bg-success",
            FaultStatus.Reopened => "bg-danger",
            FaultStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(FaultPriority priority)
    {
        return priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-warning",
            FaultPriority.Medium => "bg-info",
            FaultPriority.Low => "bg-success",
            _ => "bg-secondary"
        };
    }
}