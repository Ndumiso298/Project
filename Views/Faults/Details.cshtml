<!-- Views/Faults/Details.cshtml -->
@model FaultRecord
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = $"Fault Details #{Model.Id}";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isCustomer = User.IsInRole(SD.CustomerRole);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>@ViewData["Title"]
                    </h3>
                    <div>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Action Buttons -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                @if (Model.Status == FaultStatus.Reported &&
                                (User.IsInRole(SD.AdminRole) || isCustomer))
                                {
                                    <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning">
                                        <i class="fas fa-edit me-1"></i>Edit Fault
                                    </a>
                                }
                                @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.FaultTechnicianRole))
                                {
                                    <a asp-action="Process" asp-route-id="@Model.Id" class="btn btn-info">
                                        <i class="fas fa-cogs me-1"></i>Process Fault
                                    </a>
                                }
                                <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-secondary" target="_blank">
                                    <i class="fas fa-print me-1"></i>Print Report
                                </a>
                                @if (User.IsInRole(SD.AdminRole))
                                {
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Fault Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Fault Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Fault #:</strong></td>
                                            <td>#@Model.Id</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>@GetStatusBadge(Model.Status)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Priority:</strong></td>
                                            <td>@GetPriorityBadge(Model.Priority)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Reported Date:</strong></td>
                                            <td>@Model.ReportedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                        @if (Model.ResolvedDate.HasValue)
                                        {
                                            <tr>
                                                <td><strong>Resolved Date:</strong></td>
                                                <td>@Model.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td><strong>Description:</strong></td>
                                            <td>@Model.Description</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Equipment Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Equipment Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Fridge:</strong></td>
                                            <td>
                                                @if (Model.Fridge != null)
                                                {
                                                    <div>
                                                        <strong>@Model.Fridge.SerialNumber</strong>
                                                        <br />
                                                        <small class="text-muted">
                                                            @Model.Fridge.FridgeModel?.Manufacturer @Model.Fridge.FridgeModel?.ModelName
                                                        </small>
                                                        <br />
                                                        <small class="text-muted">@Model.Fridge.FridgeModel?.CapacityLiters L</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Location:</strong></td>
                                            <td>
                                                @if (Model.RelatedAllocation?.DeliveryLocation != null)
                                                {
                                                    @Model.RelatedAllocation.DeliveryLocation.ToString()
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Customer Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Customer Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Reported By:</strong></td>
                                            <td>
                                                @if (Model.ReportedBy != null)
                                                {
                                                    <div>
                                                        <strong>@Model.ReportedBy.FirstName @Model.ReportedBy.LastName</strong>
                                                        <br />
                                                        <small class="text-muted">@Model.ReportedBy.Email</small>
                                                        <br />
                                                        <small class="text-muted">@Model.ReportedBy.PhoneNumber</small>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Technician Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Technician Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Assigned To:</strong></td>
                                            <td>
                                                @if (Model.AssignedTechnician != null)
                                                {
                                                    <div>
                                                        <strong>@Model.AssignedTechnician.UserAccount?.FirstName @Model.AssignedTechnician.UserAccount?.LastName</strong>
                                                        <br />
                                                        <small class="text-muted">@Model.AssignedTechnician.EmployeeType</small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unassigned</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Resolution Details -->
                    @if (!string.IsNullOrEmpty(Model.TechnicianNotes) || !string.IsNullOrEmpty(Model.PartsReplaced) || Model.TotalCost > 0)
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Resolution Details</h5>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
                                {
                                    <div class="mb-3">
                                        <strong>Technician Notes:</strong>
                                        <p class="mb-0">@Model.TechnicianNotes</p>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.PartsReplaced))
                                {
                                    <div class="mb-3">
                                        <strong>Parts Replaced:</strong>
                                        <p class="mb-0">@Model.PartsReplaced</p>
                                    </div>
                                }
                                @if (Model.TotalCost > 0)
                                {
                                    <div>
                                        <strong>Repair Cost:</strong>
                                        <span class="fw-bold">R @Model.TotalCost.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Maintenance Visits -->
                    @if (Model.MaintenanceVisits?.Any() == true)
                    {
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Related Maintenance Visits</h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Visit #</th>
                                                <th>Scheduled Date</th>
                                                <th>Status</th>
                                                <th>Technician</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var visit in Model.MaintenanceVisits)
                                            {
                                                <tr>
                                                    <td>#@visit.Id</td>
                                                    <td>@visit.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@GetServiceStatusBadge(visit.Status)</td>
                                                    <td>
                                                        @if (visit.Technician != null)
                                                        {
                                                            @visit.Technician.UserAccount?.FirstName @visit.Technician.UserAccount?.LastName
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
@if (User.IsInRole(SD.AdminRole))
{
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Fault Record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p>Are you sure you want to delete fault record <strong>#@Model.Id</strong>?</p>
                        <p class="text-muted">This action will close the fault record and it will no longer appear in active lists.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete Fault</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@functions {
    private IHtmlContent GetStatusBadge(FaultStatus status)
    {
        var badgeClass = status switch
        {
            FaultStatus.Reported => "bg-secondary",
            FaultStatus.InProgress => "bg-info",
            FaultStatus.Resolved => "bg-success",
            FaultStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetPriorityBadge(FaultPriority priority)
    {
        var badgeClass = priority switch
        {
            FaultPriority.Low => "bg-success",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.High => "bg-danger",
            FaultPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{priority}</span>");
    }

    private IHtmlContent GetServiceStatusBadge(ServicingStatus status)
    {
        var badgeClass = status switch
        {
            ServicingStatus.Scheduled => "bg-info",
            ServicingStatus.InProgress => "bg-warning",
            ServicingStatus.Completed => "bg-success",
            ServicingStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }
}