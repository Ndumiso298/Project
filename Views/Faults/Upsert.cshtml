@model FaultRecordVM
@{
    ViewData["Title"] = Model.Id == 0 ? "Report New Fault" : "Edit Fault";
    var isEdit = Model.Id != 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas @(isEdit ? "fa-edit" : "fa-plus") text-primary me-2"></i>
            @ViewData["Title"]
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-info-circle me-2"></i>Fault Information
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Upsert" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                @if (isEdit)
                {
                    <input type="hidden" asp-for="Id" />
                }

                <!-- Basic Information -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FridgeId" class="form-label required"></label>
                            <select asp-for="FridgeId" asp-items="Model.FridgeList" class="form-select">
                                <option value="">-- Select Fridge --</option>
                            </select>
                            <span asp-validation-for="FridgeId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ReportedById" class="form-label required"></label>
                            <select asp-for="ReportedById" asp-items="Model.UserList" class="form-select">
                                <option value="">-- Select Reporter --</option>
                            </select>
                            <span asp-validation-for="ReportedById" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Fault Details -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label required"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter fault title..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label required"></label>
                            <select asp-for="Category" asp-items="Model.CategoryList" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label required"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Provide detailed description of the fault..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                            <div class="form-text">
                                <small>Please include as much detail as possible about the fault condition.</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status & Priority -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label required"></label>
                            <select asp-for="Status" asp-items="Model.StatusList" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label required"></label>
                            <select asp-for="Priority" asp-items="Model.PriorityList" class="form-select"></select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FaultLocationId" class="form-label"></label>
                            <select asp-for="FaultLocationId" asp-items="Model.LocationList" class="form-select">
                                <option value="">-- Select Location --</option>
                            </select>
                            <span asp-validation-for="FaultLocationId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Technician Assignment -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="AssignedTechnicianId" class="form-label"></label>
                            <select asp-for="AssignedTechnicianId" asp-items="Model.TechnicianList" class="form-select">
                                <option value="">-- Assign Technician --</option>
                            </select>
                            <span asp-validation-for="AssignedTechnicianId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ReportedDate" class="form-label required"></label>
                            <input asp-for="ReportedDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="ReportedDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>
                                @(isEdit ? "Update Fault" : "Report Fault")
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            @if (isEdit)
                            {
                                <button type="button" class="btn btn-outline-danger ms-auto"
                                        onclick="confirmDelete(@Model.Id)">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this fault record?')) {
                $.post('@Url.Action("Delete")/' + id, function () {
                    window.location.href = '@Url.Action("Index")';
                });
            }
        }

        // Initialize date picker
        $(document).ready(function () {
            $('#ReportedDate').flatpickr({
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                time_24hr: true
            });
        });
    </script>
}