@model ProcessFaultVM
@{
    ViewData["Title"] = "Process Fault";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-cogs text-warning me-2"></i>Process Fault
        </h1>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Details
        </a>
    </div>

    <div class="row">
        <!-- Fault Information -->
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Fault Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Fridge</label>
                            <p class="form-control-plaintext bg-light p-2 rounded">@Model.FridgeInfo</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Customer</label>
                            <p class="form-control-plaintext bg-light p-2 rounded">@Model.CustomerInfo</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Fault Description</label>
                            <div class="border rounded p-3 bg-light">
                                @Model.FaultDescription
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <label class="form-label fw-bold">Reported Date</label>
                            <p class="form-control-plaintext bg-light p-2 rounded">
                                @Model.ReportedDate.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Processing Form -->
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Processing Form
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Process" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="AssignedTechnicianId" class="form-label required"></label>
                            <select asp-for="AssignedTechnicianId" asp-items="Model.TechnicianList" class="form-select">
                                <option value="">-- Select Technician --</option>
                            </select>
                            <span asp-validation-for="AssignedTechnicianId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FaultStatus" class="form-label required"></label>
                            <select asp-for="FaultStatus" asp-items="Model.StatusList" class="form-select"></select>
                            <span asp-validation-for="FaultStatus" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Priority" class="form-label required"></label>
                            <select asp-for="Priority" asp-items="Model.PriorityList" class="form-select"></select>
                            <span asp-validation-for="Priority" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TechnicianNotes" class="form-label"></label>
                            <textarea asp-for="TechnicianNotes" class="form-control" rows="3"
                                      placeholder="Enter technician notes and observations..."></textarea>
                            <span asp-validation-for="TechnicianNotes" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PartsReplaced" class="form-label"></label>
                            <textarea asp-for="PartsReplaced" class="form-control" rows="2"
                                      placeholder="List any parts that were replaced..."></textarea>
                            <span asp-validation-for="PartsReplaced" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RepairCost" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="RepairCost" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="RepairCost" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ResolutionNotes" class="form-label"></label>
                            <textarea asp-for="ResolutionNotes" class="form-control" rows="3"
                                      placeholder="Enter resolution details and final notes..."></textarea>
                            <span asp-validation-for="ResolutionNotes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check-circle me-1"></i>Update Fault
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}