@model IEnumerable<FaultRecord>
@{
    ViewData["Title"] = "Fault Management";
    var statusList = ViewBag.StatusList as IEnumerable<SelectListItem>;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-exclamation-triangle text-warning me-2"></i>Fault Management
        </h1>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Report New Fault
        </a>
    </div>

    <!-- Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-filter me-2"></i>Filters & Search
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" asp-items="statusList">
                        <option value="All">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Customer Name</label>
                    <input type="text" name="customerName" class="form-control" value="@ViewBag.CustomerName" placeholder="Search customer...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Location</label>
                    <input type="text" name="location" class="form-control" value="@ViewBag.Location" placeholder="Enter location...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" name="searchString" class="form-control" value="@ViewBag.SearchString" placeholder="Search faults...">
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search me-1"></i>Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-undo me-1"></i>Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Faults Grid -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>Fault Records
                <span class="badge bg-secondary ms-2">@Model.Count()</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Fault Code</th>
                                <th>Description</th>
                                <th>Fridge</th>
                                <th>Customer</th>
                                <th>Status</th>
                                <th>Priority</th>
                                <th>Reported Date</th>
                                <th>Technician</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var fault in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@fault.FaultCode</strong>
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@fault.Description">
                                        @fault.Description
                                    </td>
                                    <td>@fault.Fridge?.SerialNumber</td>
                                    <td>@fault.ReportedBy?.FullName</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(fault.Status)">
                                            @fault.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetPriorityBadgeClass(fault.Priority)">
                                            @fault.Priority
                                        </span>
                                    </td>
                                    <td>@fault.ReportedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(fault.AssignedTechnician?.FullName ?? "Unassigned")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@fault.Id"
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.FaultTechnicianRole))
                                            {
                                                <a asp-action="Process" asp-route-id="@fault.Id"
                                                   class="btn btn-outline-warning" title="Process Fault">
                                                    <i class="fas fa-cogs"></i>
                                                </a>
                                            }
                                            <a asp-action="Print" asp-route-id="@fault.Id"
                                               class="btn btn-outline-info" title="Print Report">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                    <h4>No Faults Found</h4>
                    <p class="text-muted">No fault records match your current filters.</p>
                    <a asp-action="Index" class="btn btn-primary me-2">Clear Filters</a>
                    <a asp-action="Upsert" class="btn btn-outline-primary">Report New Fault</a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(FaultStatus status)
    {
        return status switch
        {
            FaultStatus.Reported => "bg-secondary",
            FaultStatus.Assigned => "bg-info",
            FaultStatus.InProgress => "bg-warning",
            FaultStatus.PartsRequired => "bg-primary",
            FaultStatus.Resolved => "bg-success",
            FaultStatus.Reopened => "bg-danger",
            FaultStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public string GetPriorityBadgeClass(FaultPriority priority)
    {
        return priority switch
        {
            FaultPriority.Critical => "bg-danger",
            FaultPriority.High => "bg-warning",
            FaultPriority.Medium => "bg-info",
            FaultPriority.Low => "bg-success",
            _ => "bg-secondary"
        };
    }
}