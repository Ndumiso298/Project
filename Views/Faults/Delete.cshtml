<!-- Views/Faults/Delete.cshtml -->
@model FaultRecord
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "Delete Fault Record";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-trash me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Index" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Warning!
                        </h4>
                        <p class="mb-0">
                            You are about to close fault record <strong>#@Model.Id</strong>.
                            This action will mark the fault as closed and it will no longer appear in active fault lists.
                        </p>
                    </div>

                    <!-- Fault Summary -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Fault Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Fault #:</strong></td>
                                            <td>#@Model.Id</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>@GetStatusBadge(Model.Status)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Priority:</strong></td>
                                            <td>@GetPriorityBadge(Model.Priority)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Reported Date:</strong></td>
                                            <td>@Model.ReportedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                        @if (Model.ResolvedDate.HasValue)
                                        {
                                            <tr>
                                                <td><strong>Resolved Date:</strong></td>
                                                <td>@Model.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm")</td>
                                            </tr>
                                        }
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Fridge:</strong></td>
                                            <td>
                                                @if (Model.Fridge != null)
                                                {
                                                    @Model.Fridge.SerialNumber
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not specified</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Reported By:</strong></td>
                                            <td>
                                                @if (Model.ReportedBy != null)
                                                {
                                                    @Model.ReportedBy.FirstName @Model.ReportedBy.LastName
                                                }
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Assigned To:</strong></td>
                                            <td>
                                                @if (Model.AssignedTechnician != null)
                                                {
                                                    @Model.AssignedTechnician.UserAccount?.FirstName @Model.AssignedTechnician.UserAccount?.LastName
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unassigned</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="mt-3">
                                <strong>Description:</strong>
                                <p class="mb-0">@Model.Description</p>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
                            {
                                <div class="mt-3">
                                    <strong>Technician Notes:</strong>
                                    <p class="mb-0">@Model.TechnicianNotes</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Delete Confirmation -->
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="card-title mb-0">Confirm Closure</h5>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label for="closureReason" class="form-label required">Reason for Closure</label>
                                    <textarea class="form-control" id="closureReason" name="closureReason"
                                              rows="3" required placeholder="Please provide a reason for closing this fault record..."></textarea>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        I understand that this action will close the fault record and it will be moved to closed faults.
                                    </label>
                                </div>

                                <div class="text-end">
                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary me-2">Cancel</a>
                                    <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                        <i class="fas fa-trash me-1"></i>Close Fault Record
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmDelete').addEventListener('change', function() {
            document.getElementById('deleteButton').disabled = !this.checked;
        });
    </script>
}

@functions {
    private IHtmlContent GetStatusBadge(FaultStatus status)
    {
        var badgeClass = status switch
        {
            FaultStatus.Reported => "bg-secondary",
            FaultStatus.InProgress => "bg-info",
            FaultStatus.Resolved => "bg-success",
            FaultStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetPriorityBadge(FaultPriority priority)
    {
        var badgeClass = priority switch
        {
            FaultPriority.Low => "bg-success",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.High => "bg-danger",
            FaultPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{priority}</span>");
    }
}