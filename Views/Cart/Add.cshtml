@model FridgeAllocation

@{
    ViewData["Title"] = "Add Fridge to Cart";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="card-title mb-0">
                        <i class="bi bi-cart-plus"></i> @ViewData["Title"]
                    </h2>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Fridge Details -->
                        <div class="col-md-6">
                            <div class="text-center mb-4">
                                <i class="bi bi-refrigerator display-1 text-primary"></i>
                                <h4>@Model.Fridge?.Model</h4>
                                <p class="text-muted">Serial: @Model.Fridge?.SerialNumber</p>
                            </div>

                            <div class="mb-3">
                                <h5>Specifications</h5>
                                <ul class="list-unstyled">
                                    <li><i class="bi bi-arrows-angle-expand me-2"></i>Capacity: @Model.Fridge?.CapacityLiters liters</li>
                                    <li><i class="bi bi-thermometer me-2"></i>Temperature Range: -5°C to 5°C</li>
                                    <li><i class="bi bi-lightning me-2"></i>Energy Rating: A++</li>
                                    <li><i class="bi bi-ruler me-2"></i>Dimensions: 180cm x 70cm x 70cm</li>
                                </ul>
                            </div>

                            <div class="alert alert-info">
                                <h6><i class="bi bi-info-circle"></i> Included Services</h6>
                                <ul class="small mb-0">
                                    <li>Free delivery and installation</li>
                                    <li>24/7 maintenance support</li>
                                    <li>Monthly performance checks</li>
                                    <li>Emergency replacement service</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Add to Cart Form -->
                        <div class="col-md-6">
                            <form asp-action="Add" method="post" id="addToCartForm">
                                @Html.AntiForgeryToken()

                                <input type="hidden" asp-for="FridgeId" />

                                <div class="mb-4">
                                    <h3 class="text-success">@((Model.Fridge?.RentalPricePerMonth ?? 0).ToString("C")) <small class="text-muted">/month</small></h3>
                                    <p class="text-muted">Minimum rental period: 12 months</p>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Quantity" class="form-label fw-bold">Quantity</label>
                                    <div class="input-group input-group-lg">
                                        <button type="button" class="btn btn-outline-secondary" id="decreaseQty">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input asp-for="Quantity" class="form-control text-center" min="1" max="10" value="1" id="quantityInput">
                                        <button type="button" class="btn btn-outline-secondary" id="increaseQty">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>

                                <!-- Total Calculation -->
                                <div class="card bg-light mb-4">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong>Monthly Total:</strong>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span id="monthlyTotal" class="fw-bold">@((Model.Fridge?.RentalPricePerMonth ?? 0).ToString("C"))</span>
                                            </div>
                                        </div>
                                        <div class="row mt-2">
                                            <div class="col-6">
                                                <strong>Annual Total:</strong>
                                            </div>
                                            <div class="col-6 text-end">
                                                <span id="annualTotal" class="fw-bold text-success">@((Model.Fridge?.RentalPricePerMonth ?? 0 * 12).ToString("C"))</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-cart-check"></i> Add to Cart
                                    </button>
                                    <a asp-controller="Fridges" asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-arrow-left"></i> Continue Shopping
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Fridges -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-lightbulb"></i> You Might Also Like
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- This would typically be populated with related fridges from the database -->
                        <div class="col-md-4 text-center">
                            <i class="bi bi-refrigerator display-6 text-muted"></i>
                            <h6>Commercial Fridge XL</h6>
                            <p class="text-muted">R 450/month</p>
                            <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="bi bi-refrigerator display-6 text-muted"></i>
                            <h6>Energy Saver Pro</h6>
                            <p class="text-muted">R 380/month</p>
                            <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                        </div>
                        <div class="col-md-4 text-center">
                            <i class="bi bi-refrigerator display-6 text-muted"></i>
                            <h6>Compact Mini Fridge</h6>
                            <p class="text-muted">R 220/month</p>
                            <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            const monthlyPrice = @(Model.Fridge?.RentalPricePerMonth ?? 0);

            // Update totals when quantity changes
            function updateTotals() {
                const quantity = parseInt($('#quantityInput').val());
                const monthlyTotal = monthlyPrice * quantity;
                const annualTotal = monthlyTotal * 12;

                $('#monthlyTotal').text('R ' + monthlyTotal.toFixed(2));
                $('#annualTotal').text('R ' + annualTotal.toFixed(2));
            }

            // Increase quantity
            $('#increaseQty').click(function () {
                const currentVal = parseInt($('#quantityInput').val());
                if (currentVal < 10) {
                    $('#quantityInput').val(currentVal + 1);
                    updateTotals();
                }
            });

            // Decrease quantity
            $('#decreaseQty').click(function () {
                const currentVal = parseInt($('#quantityInput').val());
                if (currentVal > 1) {
                    $('#quantityInput').val(currentVal - 1);
                    updateTotals();
                }
            });

            // Manual input change
            $('#quantityInput').on('change', function () {
                let value = parseInt($(this).val());
                if (value < 1) value = 1;
                if (value > 10) value = 10;
                $(this).val(value);
                updateTotals();
            });

            // Initial calculation
            updateTotals();

            // Form submission
            $('#addToCartForm').submit(function () {
                const quantity = parseInt($('#quantityInput').val());
                if (quantity < 1 || quantity > 10) {
                    alert('Please enter a quantity between 1 and 10');
                    return false;
                }
                return true;
            });
        });
    </script>
}