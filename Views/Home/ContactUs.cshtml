@{
    ViewData["Title"] = "Our Products - SmartChill Solutions";
}

<div class="container my-5">
    <h1 class="display-4 text-center text-primary mb-4">Our Products</h1>
    <p class="lead text-center mb-5">Innovative fridge management solutions designed for the South African market</p>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="https://placehold.co/400x300/007bff/white?text=Standard+Fridge" class="card-img-top" alt="Standard Commercial Fridge">
                <div class="card-body">
                    <h3 class="card-title text-primary">Standard Commercial Fridge</h3>
                    <p class="card-text">Our most popular model, perfect for spaza shops and small retailers.</p>
                    <ul>
                        <li>Capacity: 500L</li>
                        <li>Energy Rating: A+</li>
                        <li>Temperature Range: 2°C to 8°C</li>
                        <li>Warranty: 2 years</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h4 mb-0 text-primary">R8,999</span>
                        <a href="#contact" class="btn btn-primary">Inquire Now</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="https://placehold.co/400x300/007bff/white?text=Premium+Fridge" class="card-img-top" alt="Premium Commercial Fridge">
                <div class="card-body">
                    <h3 class="card-title text-primary">Premium Commercial Fridge</h3>
                    <p class="card-text">Advanced features for high-volume businesses and shebeens.</p>
                    <ul>
                        <li>Capacity: 800L</li>
                        <li>Energy Rating: A++</li>
                        <li>Temperature Range: 1°C to 10°C</li>
                        <li>Warranty: 3 years</li>
                        <li>Digital temperature control</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h4 mb-0 text-primary">R14,499</span>
                        <a href="#contact" class="btn btn-primary">Inquire Now</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="https://placehold.co/400x300/007bff/white?text=Energy+Saver" class="card-img-top" alt="Energy Saver Fridge">
                <div class="card-body">
                    <h3 class="card-title text-primary">Energy Saver Fridge</h3>
                    <p class="card-text">Designed for areas with unreliable power supply or high electricity costs.</p>
                    <ul>
                        <li>Capacity: 400L</li>
                        <li>Energy Rating: A+++</li>
                        <li>Backup battery option</li>
                        <li>Warranty: 2 years</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h4 mb-0 text-primary">R10,999</span>
                        <a href="#contact" class="btn btn-primary">Inquire Now</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="https://placehold.co/400x300/007bff/white?text=Compact+Fridge" class="card-img-top" alt="Compact Fridge">
                <div class="card-body">
                    <h3 class="card-title text-primary">Compact Fridge</h3>
                    <p class="card-text">Space-saving solution for small businesses with limited floor space.</p>
                    <ul>
                        <li>Capacity: 250L</li>
                        <li>Energy Rating: A+</li>
                        <li>Glass door option available</li>
                        <li>Warranty: 1 year</li>
                    </ul>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h4 mb-0 text-primary">R6,499</span>
                        <a href="#contact" class="btn btn-primary">Inquire Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <div class="card bg-light border-0 shadow-sm">
            <div class="card-body p-5">
                <h2 class="text-primary mb-3">Can't find what you're looking for?</h2>
                <p class="lead mb-4">We offer custom solutions tailored to your specific business needs.</p>
                <a href="#contact" class="btn btn-primary btn-lg">Contact Our Sales Team</a>
            </div>
        </div>
    </div>
</div>