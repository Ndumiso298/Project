@{
    ViewData["Title"] = "Our Services - SmartChill Solutions";
}

<!-- Page Header -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-5 fw-bold">Our Comprehensive Services</h1>
                <p class="lead">End-to-end fridge management solutions tailored for the beverage industry</p>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <!-- Fridge Management -->
            <div class="col-lg-6">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-primary rounded-circle p-3 me-3">
                                <i class="fas fa-refrigerator fa-2x text-white"></i>
                            </div>
                            <h4 class="fw-bold mb-0">Fridge Inventory Management</h4>
                        </div>
                        <p class="text-muted mb-4">Complete tracking and management of your fridge inventory with real-time status updates and allocation history.</p>
                        <ul class="list-unstyled text-muted">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Real-time inventory tracking</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Automated allocation to customers</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Condition and status monitoring</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Purchase and warranty tracking</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Maintenance -->
            <div class="col-lg-6">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-success rounded-circle p-3 me-3">
                                <i class="fas fa-tools fa-2x text-white"></i>
                            </div>
                            <h4 class="fw-bold mb-0">Preventive Maintenance</h4>
                        </div>
                        <p class="text-muted mb-4">Scheduled maintenance programs to ensure optimal fridge performance and prevent unexpected breakdowns.</p>
                        <ul class="list-unstyled text-muted">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Automated service scheduling</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Maintenance history tracking</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Service interval management</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Technician dispatch automation</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Fault Management -->
            <div class="col-lg-6">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-warning rounded-circle p-3 me-3">
                                <i class="fas fa-exclamation-triangle fa-2x text-white"></i>
                            </div>
                            <h4 class="fw-bold mb-0">Fault Reporting & Resolution</h4>
                        </div>
                        <p class="text-muted mb-4">Streamlined fault reporting system with automatic technician assignment and real-time status updates.</p>
                        <ul class="list-unstyled text-muted">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Customer self-service portal</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Automatic technician dispatch</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Real-time fault status tracking</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Resolution time analytics</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Purchasing -->
            <div class="col-lg-6">
                <div class="card service-card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-info rounded-circle p-3 me-3">
                                <i class="fas fa-shopping-cart fa-2x text-white"></i>
                            </div>
                            <h4 class="fw-bold mb-0">Procurement Management</h4>
                        </div>
                        <p class="text-muted mb-4">Complete procurement workflow from purchase requests to supplier management and delivery tracking.</p>
                        <ul class="list-unstyled text-muted">
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Automated purchase requests</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Supplier relationship management</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Quotation and order processing</li>
                            <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Delivery and inventory integration</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Process Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="fw-bold mb-3">How It Works</h2>
                <p class="text-muted">Simple, efficient process for managing your fridge ecosystem</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <span class="h4 mb-0">1</span>
                </div>
                <h5>Setup & Onboarding</h5>
                <p class="text-muted">We integrate with your existing systems and set up your fridge inventory in our platform.</p>
            </div>

            <div class="col-md-4 text-center">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <span class="h4 mb-0">2</span>
                </div>
                <h5>Daily Operations</h5>
                <p class="text-muted">Manage allocations, track maintenance, and handle fault reports through our intuitive interface.</p>
            </div>

            <div class="col-md-4 text-center">
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <span class="h4 mb-0">3</span>
                </div>
                <h5>Optimization & Reporting</h5>
                <p class="text-muted">Access detailed analytics and reports to optimize your fridge management strategy.</p>
            </div>
        </div>
    </div>
</section>