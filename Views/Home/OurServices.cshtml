﻿@{
    ViewData["Title"] = "Our OurServices";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="display-4 text-center text-primary mb-4">Our Services</h1>
            <p class="lead text-center mb-5">Comprehensive fridge management solutions tailored for South African businesses</p>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-primary">Fridge Inventory Management</h3>
                    <p>Our advanced inventory management system helps you track all your fridges in real-time. Know exactly where each unit is located, its condition, and allocation status.</p>
                    <ul>
                        <li>Real-time tracking of fridge inventory levels</li>
                        <li>Automated stock alerts and reporting</li>
                        <li>Allocation management for customers</li>
                        <li>Scrapping process for end-of-life units</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-primary">Fault Reporting System</h3>
                    <p>Streamline communication between customers and technicians for efficient fault resolution.</p>
                    <ul>
                        <li>Customer-friendly fault reporting portal</li>
                        <li>Automated technician assignment</li>
                        <li>Real-time status updates</li>
                        <li>Repair history tracking</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-primary">Maintenance Scheduling</h3>
                    <p>Proactive maintenance planning to ensure your fridges are always in optimal condition.</p>
                    <ul>
                        <li>Automated maintenance reminders</li>
                        <li>Service history tracking</li>
                        <li>Technician scheduling system</li>
                        <li>Preventative maintenance plans</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="card-title text-primary">Procurement Management</h3>
                    <p>Streamlined procurement operations between purchasing managers and suppliers.</p>
                    <ul>
                        <li>Automated purchase request system</li>
                        <li>Supplier management portal</li>
                        <li>Quotation request processing</li>
                        <li>Purchase order generation</li>
                    </ul>
                </div>
            </div>

            <div class="text-center mt-5">
                <a href="#contact" class="btn btn-primary btn-lg">Get Started with Our Services</a>
            </div>
        </div>
    </div>
</div>