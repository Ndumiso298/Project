@{
    ViewData["Title"] = "Fridge Management System";
}

<!-- Hero Section (Teljoy-style) -->
<section class="hero-section bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary">Smart Fridge Management</h1>
                <p class="lead">Professional refrigeration solutions for businesses of all sizes</p>
                <div class="d-flex gap-2 mt-4">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Dashboard", "Customer")" class="btn btn-primary btn-lg">Go to Dashboard</a>
                    }
                    else
                    {
                        <a href="@Url.Action("CustomerPortal", "Home")" class="btn btn-primary btn-lg">Customer Login</a>
                        <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-primary btn-lg">Contact Sales</a>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <img src="~/images/fridge-hero.png" alt="Fridge Management" class="img-fluid" />
            </div>
        </div>
    </div>
</section>

<!-- Features Section (Your functionality, Teljoy's presentation) -->
<section class="features-section py-5">
    <div class="container">
        <h2 class="text-center mb-5">Why Choose Our Fridge Management System?</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3">
                            <i class="fas fa-tools text-white fa-2x"></i>
                        </div>
                        <h5>Maintenance Tracking</h5>
                        <p>Schedule and track all fridge maintenance in one place</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3">
                            <i class="fas fa-exclamation-triangle text-white fa-2x"></i>
                        </div>
                        <h5>Fault Reporting</h5>
                        <p>Quickly report and track fridge issues</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3">
                            <i class="fas fa-chart-line text-white fa-2x"></i>
                        </div>
                        <h5>Inventory Management</h5>
                        <p>Track your fridge inventory and allocations</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section bg-primary text-white py-5">
    <div class="container text-center">
        <h2>Ready to Get Started?</h2>
        <p class="lead">Join hundreds of businesses using our fridge management system</p>
        <a href="@Url.Action("Contact", "Home")" class="btn btn-light btn-lg">Contact Us Today</a>
    </div>
</section>