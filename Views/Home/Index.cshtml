@{
    ViewData["Title"] = "Home Page";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-80">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary mb-4">SmartChill Solutions</h1>
                <p class="lead mb-4">Optimize your beverage refrigeration with our advanced management system designed for spaza shops, shebeens, and retail businesses.</p>
                <div class="d-flex gap-3">
                    <a href="#services" class="btn btn-primary btn-lg px-4">Our Services</a>
                    <a href="#contact" class="btn btn-outline-primary btn-lg px-4">Contact Us</a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://placehold.co/600x400/007bff/white?text=Smart+Fridge" alt="Smart Fridge Management System" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section id="services" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Our Services</h2>
            <p class="lead">Comprehensive solutions for your fridge management needs</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="service-icon mb-3">
                            <i class="bi bi-clipboard-data display-4 text-primary"></i>
                        </div>
                        <h5 class="card-title">Inventory Management</h5>
                        <p class="card-text">Real-time tracking of fridge inventory levels with automated stock alerts and reporting.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="service-icon mb-3">
                            <i class="bi bi-tools display-4 text-primary"></i>
                        </div>
                        <h5 class="card-title">Fault Reporting</h5>
                        <p class="card-text">Instant fault detection and reporting system with automated technician dispatch.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm service-card">
                    <div class="card-body text-center p-4">
                        <div class="service-icon mb-3">
                            <i class="bi bi-calendar-check display-4 text-primary"></i>
                        </div>
                        <h5 class="card-title">Maintenance Scheduling</h5>
                        <p class="card-text">Proactive maintenance planning with automated reminders and service history tracking.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Us Section -->
<section id="about" class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="section-title mb-4">About SmartChill Solutions</h2>
                <p class="lead">We're revolutionizing fridge management for beverage distributors and retailers across South Africa.</p>
                <p>Founded in 2020, SmartChill Solutions was created to address the unique challenges faced by spaza shops, shebeens, and other small businesses in managing their refrigeration assets.</p>
                <p>Our comprehensive system helps businesses reduce costs, improve efficiency, and ensure their beverages are always perfectly chilled for customers.</p>
                <a href="/About" class="btn btn-outline-primary mt-3">Learn More About Us</a>
            </div>
            <div class="col-lg-6">
                <img src="https://placehold.co/500x350/6c757d/white?text=Our+Team" alt="SmartChill Team" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Products Section -->
<section id="products" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Our Products</h2>
            <p class="lead">Innovative solutions designed for the South African market</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="card-title">Fridge Management System</h4>
                        <p class="card-text">Our flagship product provides complete oversight of your refrigeration assets with real-time monitoring and reporting.</p>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item border-0 ps-0">✓ Real-time temperature monitoring</li>
                            <li class="list-group-item border-0 ps-0">✓ Inventory tracking</li>
                            <li class="list-group-item border-0 ps-0">✓ Fault detection system</li>
                            <li class="list-group-item border-0 ps-0">✓ Maintenance scheduling</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="card-title">Mobile Technician App</h4>
                        <p class="card-text">Empower your technicians with our mobile application for efficient fault resolution and maintenance tasks.</p>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item border-0 ps-0">✓ Offline capability</li>
                            <li class="list-group-item border-0 ps-0">✓ Real-time job assignment</li>
                            <li class="list-group-item border-0 ps-0">✓ Parts inventory management</li>
                            <li class="list-group-item border-0 ps-0">✓ Customer signature capture</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">Contact Us</h2>
            <p class="lead">Get in touch with our team</p>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4">Send us a message</h4>
                        <form>
                            <div class="mb-3">
                                <label for="name" class="form-label">Your Name</label>
                                <input type="text" class="form-control" id="name" required>
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="email" required>
                            </div>
                            <div class="mb-3">
                                <label for="message" class="form-label">Message</label>
                                <textarea class="form-control" id="message" rows="4" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4">Contact Information</h4>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-geo-alt-fill text-primary me-3"></i>
                            <div>123 Business Street, Industrial Area, Cape Town, 8001</div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-telephone-fill text-primary me-3"></i>
                            <div>+27 21 123 4567</div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-envelope-fill text-primary me-3"></i>
                            <div>info@smartchill.co.za</div>
                        </div>
                        <div class="mt-4">
                            <h5 class="mb-3">Business Hours</h5>
                            <p class="mb-1">Monday - Friday: 8:00 AM - 5:00 PM</p>
                            <p class="mb-1">Saturday: 9:00 AM - 1:00 PM</p>
                            <p>Sunday: Closed</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Privacy Section -->
<section id="privacy" class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="section-title text-center mb-4">Privacy Policy</h2>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <p class="lead">At SmartChill Solutions, we take your privacy seriously.</p>
                        <p>We collect only the essential information needed to provide our services and improve your experience. Your data is securely stored and never shared with third parties without your explicit consent.</p>
                        <p>Our comprehensive privacy policy outlines how we collect, use, and protect your information.</p>
                        <div class="text-center mt-4">
                            <a href="/Privacy" class="btn btn-outline-primary">View Full Privacy Policy</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
