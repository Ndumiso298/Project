@{
    ViewData["Title"] = "Fridge Management System";
}

<!-- Hero Section -->
<section class="hero-section bg-gradient-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Smart Fridge Management Solutions</h1>
                <p class="lead mb-4">Professional refrigeration management for businesses of all sizes. Streamline your operations with our comprehensive fridge management system.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Index", "Home")" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-tachometer-alt me-2"></i>Home
                        </a>
                        <a href="@Url.Action("OurServices", "Home")" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-concierge-bell me-2"></i>Our Services
                        </a>
                        <a href="@Url.Action("AboutUs", "Home")" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-concierge-bell me-2"></i>About Us
                        </a>
                        <a href="@Url.Action("ContactUs", "Home")" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-concierge-bell me-2"></i>Contact Us
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")" class="btn btn-light btn-lg px-4">
                            <i class="fas fa-sign-in-alt me-2"></i>Customer Login
                        </a>
                        <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-light btn-lg px-4">
                            <i class="fas fa-phone me-2"></i>Contact Sales
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="~/images/fridge-management-hero.png" alt="Fridge Management System" class="img-fluid rounded-3 shadow-lg" style="max-height: 400px;" />
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold text-primary mb-3">Why Choose Our Fridge Management System?</h2>
            <p class="lead">Comprehensive solutions designed to streamline your refrigeration management</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-tools text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Maintenance Tracking</h5>
                        <p class="card-text">Schedule, track, and manage all fridge maintenance activities with automated reminders and service history.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-exclamation-triangle text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Fault Reporting</h5>
                        <p class="card-text">Quickly report and track fridge issues with real-time status updates and automated technician assignments.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-chart-line text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Inventory Management</h5>
                        <p class="card-text">Track your fridge inventory, allocations, and stock levels with comprehensive reporting and analytics.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-users text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Customer Management</h5>
                        <p class="card-text">Manage customer relationships, allocations, and service history with our comprehensive CRM features.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-shipping-fast text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Purchase Management</h5>
                        <p class="card-text">Streamline fridge procurement with supplier management, purchase orders, and delivery tracking.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm hover-shadow">
                    <div class="card-body text-center p-4">
                        <div class="feature-icon bg-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="fas fa-mobile-alt text-white fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Mobile Ready</h5>
                        <p class="card-text">Access your fridge management system from any device with our responsive, mobile-friendly design.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="stats-section py-5 bg-white">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-3">
                <div class="stat-item">
                    <h3 class="display-4 fw-bold text-primary">500+</h3>
                    <p class="text-muted">Fridges Managed</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3 class="display-4 fw-bold text-primary">100+</h3>
                    <p class="text-muted">Happy Customers</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3 class="display-4 fw-bold text-primary">24/7</h3>
                    <p class="text-muted">Support Available</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-item">
                    <h3 class="display-4 fw-bold text-primary">99%</h3>
                    <p class="text-muted">Uptime Guarantee</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta-section bg-primary text-white py-5">
    <div class="container text-center">
        <h2 class="display-5 fw-bold mb-3">Ready to Transform Your Fridge Management?</h2>
        <p class="lead mb-4">Join hundreds of businesses using our comprehensive fridge management system</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="@Url.Action("Contact", "Home")" class="btn btn-light btn-lg px-4">
                <i class="fas fa-phone me-2"></i>Contact Us Today
            </a>
            <a href="@Url.Action("OurServices", "Home")" class="btn btn-outline-light btn-lg px-4">
                <i class="fas fa-concierge-bell me-2"></i>View Our Services
            </a>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        }

        .hover-shadow {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .hover-shadow:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
            }

        .feature-icon {
            transition: transform 0.3s ease;
        }

        .card:hover .feature-icon {
            transform: scale(1.1);
        }

        .stat-item {
            padding: 20px 0;
        }
    </style>
}