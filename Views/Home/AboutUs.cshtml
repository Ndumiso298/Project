@{
    ViewData["Title"] = "About Us - SmartChill Solutions";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <h1 class="display-4 text-center text-primary mb-4">About SmartChill Solutions</h1>
            <p class="lead text-center mb-5">Revolutionizing fridge management for beverage businesses across South Africa</p>

            <div class="row mb-5">
                <div class="col-md-6">
                    <img src="https://placehold.co/600x400/007bff/white?text=Our+Team" alt="SmartChill Team" class="img-fluid rounded shadow">
                </div>
                <div class="col-md-6">
                    <h2 class="text-primary">Our Story</h2>
                    <p>Founded in 2020, SmartChill Solutions was created to address the unique challenges faced by beverage manufacturers and distributors in managing their fridge assets. We noticed that many businesses, especially spaza shops and shebeens, struggled with manual tracking systems that led to inefficiencies and lost revenue.</p>
                    <p>Our team of experienced developers and industry experts came together to create a comprehensive solution that streamlines fridge management from allocation to maintenance.</p>
                </div>
            </div>

            <div class="card bg-light border-0 shadow-sm mb-5">
                <div class="card-body p-5">
                    <h2 class="text-center text-primary mb-4">Our Mission</h2>
                    <p class="text-center lead">To empower beverage businesses with innovative technology solutions that optimize fridge management, reduce operational costs, and enhance customer satisfaction.</p>
                </div>
            </div>

            <h2 class="text-primary mb-4">Our Values</h2>
            <div class="row">
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-lightbulb display-4 text-primary"></i>
                            </div>
                            <h4>Innovation</h4>
                            <p>We continuously seek new ways to improve our systems and services.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-people display-4 text-primary"></i>
                            </div>
                            <h4>Customer Focus</h4>
                            <p>Our customers' success is our top priority in everything we do.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4">
                            <div class="mb-3">
                                <i class="bi bi-shield-check display-4 text-primary"></i>
                            </div>
                            <h4>Reliability</h4>
                            <p>We deliver consistent, dependable service you can count on.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">