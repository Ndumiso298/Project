@{
    ViewData["Title"] = "About Us - SmartChill Solutions";
}

<!-- Page Header -->
<section class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold">About SmartChill Solutions</h1>
                <p class="lead">Pioneering fridge management solutions for the modern beverage industry</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <i class="fas fa-snowflake fa-5x opacity-50"></i>
            </div>
        </div>
    </div>
</section>

<!-- Company Story -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="fw-bold mb-4">Our Story</h2>
                <p class="text-muted mb-4">
                    Founded in 2020, SmartChill Solutions emerged from a simple observation: beverage manufacturers were struggling with manual,
                    inefficient fridge management systems that led to operational inefficiencies and customer dissatisfaction.
                </p>
                <p class="text-muted mb-4">
                    We set out to revolutionize this space by creating a comprehensive, web-based fridge management system that automates
                    inventory tracking, maintenance scheduling, fault reporting, and procurement processes.
                </p>
                <p class="text-muted">
                    Today, we serve leading beverage manufacturers across South Africa, helping them optimize their fridge ecosystems
                    and deliver exceptional customer experiences.
                </p>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                     alt="Our Team" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Mission & Vision -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="text-center p-4">
                    <div class="bg-primary rounded-circle p-4 d-inline-flex mb-4">
                        <i class="fas fa-bullseye fa-3x text-white"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Our Mission</h3>
                    <p class="text-muted">
                        To empower beverage manufacturers with intelligent fridge management solutions that drive operational excellence,
                        reduce costs, and enhance customer satisfaction through innovative technology and exceptional service.
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="text-center p-4">
                    <div class="bg-success rounded-circle p-4 d-inline-flex mb-4">
                        <i class="fas fa-eye fa-3x text-white"></i>
                    </div>
                    <h3 class="fw-bold mb-3">Our Vision</h3>
                    <p class="text-muted">
                        To become Africa's leading fridge management platform, setting the standard for innovation, reliability, and
                        customer-centric solutions in the beverage refrigeration industry.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values -->
<section class="py-5">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="fw-bold mb-3">Our Values</h2>
                <p class="text-muted">The principles that guide everything we do</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="bg-light rounded-circle p-4 d-inline-flex mb-3">
                    <i class="fas fa-lightbulb fa-2x text-primary"></i>
                </div>
                <h5>Innovation</h5>
                <p class="text-muted">Continuously pushing boundaries to deliver cutting-edge solutions that solve real business challenges.</p>
            </div>

            <div class="col-md-4 text-center">
                <div class="bg-light rounded-circle p-4 d-inline-flex mb-3">
                    <i class="fas fa-shield-alt fa-2x text-primary"></i>
                </div>
                <h5>Reliability</h5>
                <p class="text-muted">Building systems you can count on, with 99.9% uptime and robust, secure infrastructure.</p>
            </div>

            <div class="col-md-4 text-center">
                <div class="bg-light rounded-circle p-4 d-inline-flex mb-3">
                    <i class="fas fa-hands-helping fa-2x text-primary"></i>
                </div>
                <h5>Partnership</h5>
                <p class="text-muted">Working collaboratively with our clients to understand their needs and deliver tailored solutions.</p>
            </div>
        </div>
    </div>
</section>