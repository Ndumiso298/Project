@model IEnumerable<Project.Models.ApplicationUser>

@{
    ViewData["Title"] = "Pending User Approvals";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Uploaded Document</th>
            <th>Approve / Decline</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.CellNumber</td>
                <td>
                    @user.StreetAddress <br />
                    @user.City, @user.Province, @user.PostalCode
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(user.BusinessDocumentPath))
                    {
                        <a href="@Url.Content(user.BusinessDocumentPath)" target="_blank">View Document</a>
                    }
                    else
                    {
                        <span>No Document</span>
                    }
                </td>
                <td>
                    <div class="d-flex flex-column gap-2">
                        <form asp-action="ApproveUser" asp-controller="User" method="post">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-success btn-sm">Approve</button>
                        </form>

                        <form asp-action="DeclineUser" asp-controller="User" method="post">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <div class="mb-1">
                                <input type="text" name="DeclineReason" placeholder="Reason for decline" class="form-control form-control-sm" required />
                            </div>
                            <button type="submit" class="btn btn-danger btn-sm">Decline</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
