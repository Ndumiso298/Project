@model IEnumerable<Project.Models.Customer>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Customer Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Customer Management</h2>
                    <p class="text-muted">Manage all customer accounts</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i> All Users
                    </a>
                    <a asp-action="EmployeeList" class="btn btn-outline-secondary">
                        <i class="bi bi-person-badge me-2"></i> Employee List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="m-0 fw-bold text-primary">Customer Accounts</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="customerTable">
                        <thead class="table-light">
                            <tr>
                                <th>Customer Name</th>
                                <th>Email</th>
                                <th>Customer Number</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                var user = customer.ApplicationUser;
                                <tr>
                                    <td>@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>@customer.CustomerNumber</td>
                                    <td>
                                        @if (user.IsApproved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (!string.IsNullOrEmpty(user.RejectionReason))
                                        {
                                            <span class="badge bg-danger">Declined</span>
                                        }
                                        else if (user.LockoutEnd > DateTime.Now)
                                        {
                                            <span class="badge bg-warning">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <!-- Approve/Decline Details -->
                                            <a asp-action="ApproveDeclineUser" asp-route-userId="@user.Id"
                                               class="btn btn-sm btn-info" title="Review Customer">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Approve Button -->
                                            @if (!user.IsApproved && string.IsNullOrEmpty(user.RejectionReason))
                                            {
                                                <form asp-action="ApproveUser" method="post" class="d-inline">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve Customer">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                            }

                                            <!-- Decline Button -->
                                            @if (!user.IsApproved && string.IsNullOrEmpty(user.RejectionReason))
                                            {
                                                <form asp-action="DeclineUser" method="post" class="d-inline">
                                                    <input type="hidden" name="userId" value="@user.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Decline Customer">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            }

                                            <!-- Business Document -->
                                            @if (!string.IsNullOrEmpty(customer.BusinessDocumentPath))
                                            {
                                                <a asp-action="ViewBusinessDocument" asp-route-userId="@user.Id"
                                                   class="btn btn-sm btn-primary" title="View Business Document">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                            }

                                            <!-- Lock/Unlock -->
                                            <form asp-action="LockUnlock" asp-route-userId="@user.Id" method="post" class="d-inline">
                                                @if (user.LockoutEnd == null || user.LockoutEnd < DateTime.Now)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-warning" title="Lock Customer">
                                                        <i class="bi bi-lock"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success" title="Unlock Customer">
                                                        <i class="bi bi-unlock"></i>
                                                    </button>
                                                }
                                            </form>

                                            <!-- Delete -->
                                            <form asp-action="DeleteUser" asp-route-userId="@user.Id" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this customer?')" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Customer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Customers Found</h4>
                </div>
            }
        </div>
    </div>
</div>