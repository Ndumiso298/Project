@model Project.Models.ViewModel.RolesViewModel

@{
    
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Manage User Roles";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="ManagerRole" method="post">
    <!-- Hidden field for User Id -->
    <input asp-for="User.Id" type="hidden" />

    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-primary text-white text-center">
            <h3>Manage Roles for @Model.User.Email</h3>
        </div>
        <div class="card-body">
            <!-- Display User Email -->
            <div class="form-group mb-3">
                <label>User Email</label>
                <input asp-for="User.Email" class="form-control" disabled />
            </div>

            <!-- Role selection checkboxes -->
            <div class="form-group border p-3 rounded">
                <h5>Role Assignment</h5>
                @for (int i = 0; i < Model.RoleList.Count; i++)
                {
                    <div class="form-check">
                        <input asp-for="RoleList[i].RoleName" type="hidden" />
                        <input asp-for="RoleList[i].IsSelected" class="form-check-input" />
                        <label class="form-check-label" asp-for="RoleList[i].IsSelected">
                            @Model.RoleList[i].RoleName
                        </label>
                    </div>
                }
            </div>

            <!-- Buttons -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <a asp-action="Index" class="btn btn-secondary w-100">Back to List</a>
                </div>
                <div class="col-md-6">
                    <button type="submit" class="btn btn-primary w-100">Update Roles</button>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}