@model IEnumerable<Project.Models.Employee>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Employee Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Employee Management</h2>
                    <p class="text-muted">Manage all employee accounts</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i> All Users
                    </a>
                    <a asp-action="CustomerList" class="btn btn-outline-secondary">
                        <i class="bi bi-people me-2"></i> Customer List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="m-0 fw-bold text-primary">Employee Accounts</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="employeeTable">
                        <thead class="table-light">
                            <tr>
                                <th>Employee Name</th>
                                <th>Email</th>
                                <th>Employee Number</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model)
                            {
                                var user = employee.ApplicationUser;
                                <tr>
                                    <td>@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>@employee.EmployeeNumber</td>
                                    <td>
                                        @if (user.LockoutEnd > DateTime.Now)
                                        {
                                            <span class="badge bg-warning">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <!-- Role Management -->
                                            <a asp-action="ManagerRole" asp-route-userId="@user.Id"
                                               class="btn btn-sm btn-primary" title="Manage Roles">
                                                <i class="bi bi-person-gear"></i>
                                            </a>

                                            <!-- View Details -->
                                            <a asp-action="ApproveDeclineUser" asp-route-userId="@user.Id"
                                               class="btn btn-sm btn-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <!-- Lock/Unlock -->
                                            <form asp-action="LockUnlock" asp-route-userId="@user.Id" method="post" class="d-inline">
                                                @if (user.LockoutEnd == null || user.LockoutEnd < DateTime.Now)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-warning" title="Lock Employee">
                                                        <i class="bi bi-lock"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success" title="Unlock Employee">
                                                        <i class="bi bi-unlock"></i>
                                                    </button>
                                                }
                                            </form>

                                            <!-- Delete -->
                                            <form asp-action="DeleteUser" asp-route-userId="@user.Id" method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this employee?')" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" title="Delete Employee">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-badge display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Employees Found</h4>
                </div>
            }
        </div>
    </div>
</div>