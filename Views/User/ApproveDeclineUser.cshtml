@model Project.Models.ViewModel.UserVM

@{
    ViewData["Title"] = "Review User - Approve/Decline";
    Layout = "_CustomerLayout";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header bg-primary text-light py-4">
            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <h2 class="fw-bold text-white mb-0">User Verification</h2>
                    <p class="opacity-75 mb-0">Review the user’s submitted business document</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <!-- Back Button -->
            <div class="row mb-4">
                <div class="col-12 col-md-3">
                    <a asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <div class="container py-4">
                <!-- Header Section -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="text-primary mb-1">User Review & Approval</h2>
                        <p class="text-muted">Review user details and business documentation before making a decision</p>
                    </div>
                </div>

                <!-- Alert Messages -->
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="row">
                    <!-- User Information Card -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-primary text-white">
                                <h5 class="card-title mb-0"><i class="bi bi-person-badge me-2"></i>User Information</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-sm-6 mb-3">
                                        <label class="form-label fw-bold text-muted small">Full Name</label>
                                        <p class="mb-0 fs-6">@Model.FirstName @Model.LastName</p>
                                    </div>
                                    <div class="col-sm-6 mb-3">
                                        <label class="form-label fw-bold text-muted small">Email Address</label>
                                        <p class="mb-0 fs-6">@Model.Email</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6 mb-3">
                                        <label class="form-label fw-bold text-muted small">Phone Number</label>
                                        <p class="mb-0 fs-6">@(string.IsNullOrEmpty(Model.CellNumber) ? "Not provided" : Model.CellNumber)</p>
                                    </div>
                                    <div class="col-sm-6 mb-3">
                                        <label class="form-label fw-bold text-muted small">User Role</label>
                                        <p class="mb-0 fs-6">@Model.Role</p>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6 mb-3">
                                        @if (Model.Role != null && Model.Role.Contains("Customer"))
                                        {
                                            <label class="form-label fw-bold text-muted small">Customer Number</label>
                                            <p class="mb-0 fs-6">@Model.CustomerNumber</p>
                                        }
                                        else
                                        {
                                            <label class="form-label fw-bold text-muted small">Employee Number</label>
                                            <p class="mb-0 fs-6">@Model.EmployeeNumber</p>
                                        }
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <label class="form-label fw-bold text-muted small">Complete Address</label>
                                    <p class="mb-0 fs-6">@Model.StreetAddress, @Model.City, @Model.Province, @Model.PostalCode</p>
                                </div>

                                <!-- Account Status -->
                                <div class="mt-3 pt-3 border-top">
                                    <label class="form-label fw-bold text-muted small">Account Status</label>
                                    <div>
                                        @if (Model.IsApproved)
                                        {
                                            <span class="badge bg-success fs-6">Approved</span>
                                        }
                                        else if (!string.IsNullOrEmpty(Model.RejectionReason))
                                        {
                                            <span class="badge bg-danger fs-6">Declined</span>
                                            <small class="text-muted d-block mt-1">Reason: @Model.RejectionReason</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning fs-6">Pending Approval</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Business Document Card -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0"><i class="bi bi-file-earmark-text me-2"></i>Business Documentation</h5>
                            </div>
                            <div class="card-body">
                                @if (Model.Role != null && Model.Role.Contains("Customer") && !string.IsNullOrEmpty(Model.BusinessDocumentPath))
                                {
                                    <div class="text-center">
                                        @{
                                            var fileExtension = System.IO.Path.GetExtension(Model.BusinessDocumentPath)?.ToLower();
                                            var fileUrl = Url.Content("~" + Model.BusinessDocumentPath);
                                            var fileName = System.IO.Path.GetFileName(Model.BusinessDocumentPath);
                                        }

                                        @if (fileExtension == ".pdf")
                                        {
                                            <div class="mb-3">
                                                <i class="bi bi-file-earmark-pdf display-1 text-danger"></i>
                                                <p class="text-muted">PDF Document Ready for Review</p>
                                            </div>
                                        }
                                        else if (fileExtension == ".jpg" || fileExtension == ".jpeg" || fileExtension == ".png")
                                        {
                                            <div class="mb-3">
                                                <i class="bi bi-file-earmark-image display-1 text-success"></i>
                                                <p class="text-muted">Image Document Ready for Review</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mb-3">
                                                <i class="bi bi-file-earmark-binary display-1 text-secondary"></i>
                                                <p class="text-muted">Document Ready for Download</p>
                                            </div>
                                        }

                                        <!-- Document Display Area -->
                                        @if (fileExtension == ".pdf")
                                        {
                                            <div class="mt-2 border rounded bg-light">
                                                <iframe src="@fileUrl" width="100%" height="300px" class="border-0" title="Business Document PDF"></iframe>
                                            </div>
                                        }
                                        else if (fileExtension == ".jpg" || fileExtension == ".jpeg" || fileExtension == ".png")
                                        {
                                            <div class="mt-2 text-center border rounded bg-light p-3">
                                                <img src="@fileUrl" alt="Uploaded Business Document" class="img-fluid rounded shadow-sm" style="max-height: 300px; max-width: 100%;" onerror="this.style.display='none'; document.getElementById('fileError').style.display='block';" />
                                                <div id="fileError" class="alert alert-warning mt-2" style="display: none;">
                                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                                    Could not load document. Please use the download button below.
                                                </div>
                                            </div>
                                        }

                                        <!-- Document Actions -->
                                        <div class="btn-group w-100 mt-3" role="group">
                                            <a href="@fileUrl" target="_blank" class="btn btn-outline-primary">
                                                <i class="bi bi-eye me-2"></i> View
                                            </a>
                                            <a href="@fileUrl" download class="btn btn-outline-success">
                                                <i class="bi bi-download me-2"></i> Download
                                            </a>
                                        </div>

                                        <!-- File Information -->
                                        <div class="mt-2">
                                            <small class="text-muted">
                                                <i class="bi bi-info-circle me-1"></i>
                                                File: @fileName
                                            </small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="bi bi-file-earmark-x display-1 text-muted"></i>
                                        <p class="text-muted mt-3"><em>No business document uploaded by user.</em></p>
                                        @if (Model.Role != null && Model.Role.Contains("Customer"))
                                        {
                                            <small class="text-warning">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Customer account requires business documentation
                                            </small>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Approval Actions Card -->
                <div class="card shadow-sm border-0 mt-2">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title text-dark mb-4">Account Decision</h5>
                        <p class="text-muted mb-4">Please review all user information and documentation before making your decision.</p>

                        <div class="row justify-content-center">
                            <!-- Approve Button -->
                            <div class="col-md-4 mb-3">
                                <form asp-action="ApproveUser" method="post" class="d-grid">
                                    <input type="hidden" name="userId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success btn-lg py-3">
                                        <i class="bi bi-check-circle-fill me-2"></i> Approve User
                                    </button>
                                    <small class="form-text text-muted mt-2">
                                        User will gain full system access and be marked as approved.
                                    </small>
                                </form>
                            </div>

                            <!-- Decline Button -->
                            <div class="col-md-4 mb-3">
                                <form asp-action="DeclineUser" method="post" class="d-grid" id="declineForm">
                                    <input type="hidden" name="userId" value="@Model.Id" />
                                    <input type="hidden" name="rejectionReason" id="rejectionReason" value="Your account was declined due to failing verification requirements." />
                                    <button type="button" class="btn btn-outline-danger btn-lg py-3" onclick="showDeclineConfirmation()">
                                        <i class="bi bi-x-circle me-2"></i> Decline User
                                    </button>
                                    <small class="form-text text-muted mt-2">
                                        User account will be rejected and marked as declined.
                                    </small>
                                </form>
                            </div>
                        </div>

                        <!-- Additional Actions -->
                        <div class="mt-4 pt-3 border-top">
                            <div class="row">
                                <div class="col-md-4 mb-2">
                                    <a asp-action="ManagerRole" asp-route-userId="@Model.Id" class="btn btn-outline-info w-100">
                                        <i class="bi bi-person-gear me-2"></i> Manage Roles
                                    </a>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <a asp-action="ManagerUserClaim" asp-route-userId="@Model.Id" class="btn btn-outline-info w-100">
                                        <i class="bi bi-shield-check me-2"></i> Manage Claims
                                    </a>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <a asp-action="Index" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-list-ul me-2"></i> User List
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    .card {
        border: none;
        border-radius: 10px;
    }

    .card-header {
        border-radius: 10px 10px 0 0 !important;
    }

    .btn {
        border-radius: 6px;
        font-weight: 500;
    }

    .badge {
        font-size: 0.75em;
    }
</style>

@section Scripts {
    <script>
        function showDeclineConfirmation() {
            if (confirm('Are you sure you want to decline this user? This action cannot be undone.')) {
                document.getElementById('declineForm').submit();
            }
        }

        // Auto-hide alerts after 5 seconds
        setTimeout(function () {
            var alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
                var bsAlert = new bootstrap.Alert(alert);
                bsAlert.close();
            });
        }, 5000);

        // Handle document loading errors
        document.addEventListener('DOMContentLoaded', function () {
            var images = document.querySelectorAll('img');
            images.forEach(function (img) {
                img.addEventListener('error', function () {
                    this.style.display = 'none';
                    var errorDiv = this.parentNode.querySelector('#fileError');
                    if (errorDiv) {
                        errorDiv.style.display = 'block';
                    }
                });
            });
        });
    </script>
}
