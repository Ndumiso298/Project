@model IEnumerable<Project.Models.ViewModel.UserVM>

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">User Management</h2>
                    <p class="text-muted">Manage all system users</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="CustomerList" class="btn btn-outline-primary">
                        <i class="bi bi-people me-2"></i> Customer List
                    </a>
                    <a asp-action="EmployeeList" class="btn btn-outline-secondary">
                        <i class="bi bi-person-badge me-2"></i> Employee List
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i> Add New User
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Card Section -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 fw-bold text-primary">All Users</h5>
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="searchInput" placeholder="Search users..." class="form-control form-control-sm w-auto">
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="userTable">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>User Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FirstName @user.LastName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-info">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsCustomer)
                                        {
                                            <span class="badge bg-primary">Customer</span>
                                        }
                                        else if (user.IsEmployee)
                                        {
                                            <span class="badge bg-secondary">Employee</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Unknown</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsApproved)
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (!string.IsNullOrEmpty(user.RejectionReason))
                                        {
                                            <span class="badge bg-danger">Declined</span>
                                        }
                                        else if (user.LockoutEnd > DateTime.Now)
                                        {
                                            <span class="badge bg-warning">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Users Found</h4>
                    <p class="text-muted">Registered users will appear here once created</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const rows = document.querySelectorAll('#userTable tbody tr');

            searchInput.addEventListener('keyup', function () {
                const searchText = this.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });

            // Auto-hide alerts
            setTimeout(function () {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}