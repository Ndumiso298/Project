<div class="card-body p-4">
    @{
        Layout = "_CustomerLayout";
    }
    @if (Model.Count > 0)
    {
        <table class="table table-bordered table-striped">
            <tr class="table-secondary">
                <th>Email</th>
                <th>Name</th>
                <th>Roles</th>
              
                <th>Status</th> 
                <th>Actions</th> 
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Email</td>
                    <td>@item.FirstName</td>
                    <td>@item.Role</td>
                  
                    <td>
                        @if (item.IsApproved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (!string.IsNullOrEmpty(item.RejectionReason))
                        {
                            <span class="badge bg-danger">Declined</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <div class="row">
                            <div class="col-2">
                                <a asp-action="ManagerRole" asp-route-userId="@item.Id" class="btn btn-primary w-100">
                                    Roles
                                </a>
                            </div>
                          
                            <div class="col-2">
                                @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                {
                                    <form asp-action="LockUnlock" asp-route-userId="@item.Id">
                                        <input type="submit" class="btn btn-success w-100" value="Lock" />
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="LockUnlock" asp-route-userId="@item.Id">
                                        <input type="submit" class="btn btn-warning w-100" value="Unlock" />
                                    </form>
                                }
                            </div>
                            <div class="col-2">
                                <form asp-action="DeleteUser" asp-route-userId="@item.Id">
                                    <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Are you sure you want to delete this user?')">
                                        Delete
                                    </button>
                                </form>
                            </div>
                            <div class="col-2">
                                <a asp-action="ApproveDeclineUser" asp-route-userId="@item.Id" class="btn btn-warning w-100">
                                    Details
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </table>
    }
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}