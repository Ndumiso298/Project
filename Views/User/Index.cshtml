<div class="card-body p-4">
    @{
        Layout = "_CustomerLayout";
    }
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="h3 fw-bold text-primary mb-1">Fridge Management</h2>
            <p class="text-muted">Manage and monitor all refrigeration units</p>
        </div>
        <a asp-area="Identity" asp-page="/Account/Register"
           class="btn btn-primary d-flex align-items-center">
            <i class="bi bi-plus-circle me-2"></i> Add New User
        </a>
    </div>
    @if (Model.Count > 0)
    {
        <table class="table table-bordered table-striped">
            <tr class="table-secondary">
                <th>Email</th>
                <th>Name</th>
                <th>Roles</th>
              
                <th>Status</th> 
                <th>Actions</th> 
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Email</td>
                    <td>@item.FirstName</td>
                    <td>@item.Role</td>
                  
                    <td>
                        @if (item.IsApproved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (!string.IsNullOrEmpty(item.RejectionReason))
                        {
                            <span class="badge bg-danger">Declined</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <div class="row">
                            @* <div class="col-2"> 
                                <a asp-action="ManagerRole" asp-route-userId="@item.Id" class="btn btn-primary w-100" title="Manage Roles">
                                    <i class="fas fa-user-shield"></i>
                                </a>
                            </div> *@

                            <div class="d-flex gap-2">
                                @* Lock/Unlock Button *@
                                @if (item.LockoutEnd == null || item.LockoutEnd < DateTime.Now)
                                {
                                    <form asp-action="LockUnlock" asp-route-userId="@item.Id" class="flex-grow-1">
                                        <button type="submit" class="btn btn-success w-100" title="Lock User">
                                            <i class="fas fa-lock"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="LockUnlock" asp-route-userId="@item.Id" class="flex-grow-1">
                                        <button type="submit" class="btn btn-warning w-100" title="Unlock User">
                                            <i class="fas fa-lock-open"></i>
                                        </button>
                                    </form>
                                }

                                @* Delete Button *@
                                <form asp-action="DeleteUser" asp-route-userId="@item.Id" class="flex-grow-1">
                                    <button type="submit" class="btn btn-danger w-100" title="Delete User"
                                            onclick="return confirm('Are you sure you want to delete this user?')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>

                                @* Details Button *@
                                <form asp-action="ApproveDeclineUser" asp-route-userId="@item.Id" class="flex-grow-1">
                                    <button type="submit" class="btn btn-info w-100" title="View Details">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                </form>
                            </div>



                    </td>
                </tr>
            }
        </table>
    }
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}