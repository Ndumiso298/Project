@model Project.Models.BusinessInfo

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Business Details";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Business Details</h4>
        </div>

        <div class="card-body">
            <div class="text-center mb-4">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" class="rounded-circle border" width="120" height="120" />
                }
                else
                {
                    <i class="bi bi-building display-1 text-muted"></i>
                }
                <h3 class="mt-3">@Model.BusinessName</h3>
                <p class="text-muted">@Model.Industry</p>
            </div>

            <dl class="row">
                <dt class="col-sm-3">Registration No.</dt>
                <dd class="col-sm-9">@Model.RegistrationNumber</dd>

                <dt class="col-sm-3">Business Type</dt>
                <dd class="col-sm-9">@Model.BusinessType</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.PhoneNumber</dd>

                <dt class="col-sm-3">Website</dt>
                <dd class="col-sm-9">@Model.Website</dd>

                <dt class="col-sm-3">Address</dt>
                <dd class="col-sm-9">@Model.Address</dd>

                <dt class="col-sm-3">City</dt>
                <dd class="col-sm-9">@Model.City</dd>

                <dt class="col-sm-3">Country</dt>
                <dd class="col-sm-9">@Model.Country</dd>
            </dl>

            <div class="d-flex justify-content-end mt-4">
                <a asp-action="Edit" asp-route-id="@Model.BusinessID" class="btn btn-warning me-2">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>
