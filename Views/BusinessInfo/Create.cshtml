@model Project.Models.BusinessInfo

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Add New Business";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Add New Business</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="BusinessName" class="form-label"></label>
                        <input asp-for="BusinessName" class="form-control" />
                        <span asp-validation-for="BusinessName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RegistrationNumber" class="form-label"></label>
                        <input asp-for="RegistrationNumber" class="form-control" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BusinessType" class="form-label"></label>
                        <input asp-for="BusinessType" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Industry" class="form-label"></label>
                        <input asp-for="Industry" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Website" class="form-label"></label>
                        <input asp-for="Website" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label"></label>
                        <input asp-for="PostalCode" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <label asp-for="BusinessLogo" class="form-label"></label>
                        <input asp-for="BusinessLogo" type="file" class="form-control" />
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Business</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
