@model Project.Models.BusinessInfo

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Delete Business";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Business</h4>
        </div>

        <div class="card-body text-center">
            <i class="bi bi-exclamation-triangle display-1 text-danger mb-3"></i>
            <h5>Are you sure you want to delete this business?</h5>
            <p class="text-muted">@Model.BusinessName</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="BusinessID" />
                <div class="mt-4">
                    <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
