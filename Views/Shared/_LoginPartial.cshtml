@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<style>
    .user-details {
        position: relative;
        display: inline-block;
    }

    .user-summary {
        list-style: none;
        border: none;
        background: transparent;
        color: white;
        cursor: pointer;
        padding: 0.375rem 0.75rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

        .user-summary:hover,
        .user-summary:focus {
            color: #f8f9fa;
            outline: none;
        }

    .user-panel {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        min-width: 200px;
        background: white;
        border: 1px solid rgba(0,0,0,0.15);
        box-shadow: 0 6px 18px rgba(0,0,0,0.2);
        border-radius: 6px;
        padding: 6px 0;
        z-index: 2000;
    }

    details:not([open]) .user-panel {
        display: none;
    }

    .user-panel a,
    .user-panel button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 8px 14px;
        border: none;
        background: transparent;
        color: black;
        text-decoration: none;
        font-size: .95rem;
    }

        .user-panel a:hover,
        .user-panel button:hover {
            background-color: rgba(0,0,0,0.05);
        }

    .caret {
        border-top: 5px solid white;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        display: inline-block;
        margin-left: 6px;
        transform: translateY(1px);
    }

    .nav-item-details {
        margin-left: .5rem;
    }
</style>

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        List<string> roles = new List<string>();
        string role = "";

        if (user != null)
        {
            roles = (await UserManager.GetRolesAsync(user)).ToList();
            role = roles.FirstOrDefault() ?? "";
        }

        <li class="nav-item nav-item-details">
            <details class="user-details" role="menu">
                <summary class="user-summary" role="button" aria-haspopup="true" aria-expanded="false">
                    <span>
                        <strong>@User.Identity?.Name</strong><br />
                        <small style="color: #d1d1d1;">@role</small>
                    </span>
                    <span class="caret" aria-hidden="true"></span>
                </summary>

                <div class="user-panel" role="menu">
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index" role="menuitem">
                        Manage Account
                    </a>

                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index","Home", new { area = "" })">
                        <button type="submit" class="dropdown-item" role="menuitem">Logout</button>
                    </form>
                </div>
            </details>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-circle"></i> Register
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
        </li>
    }
</ul>
