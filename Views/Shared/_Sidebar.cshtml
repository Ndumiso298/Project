<ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link active" asp-controller="Home" asp-action="Index">
            <i class="fas fa-home"></i> Dashboard
        </a>
    </li>

    @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupportRole))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="FridgeAllocations" asp-action="Index">
                <i class="fas fa-truck-loading"></i> Allocations
            </a>
        </li>
    }

    <li class="nav-item">
        <a class="nav-link" asp-controller="AllocationRequests" asp-action="Index">
            <i class="fas fa-clipboard-list"></i> Allocation Requests
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link" asp-controller="Carts" asp-action="Index">
            <i class="fas fa-shopping-cart"></i> My Cart
            <span id="cartBadge" class="badge bg-primary rounded-pill ms-1">0</span>
        </a>
    </li>

    @if (User.IsInRole(SD.CustomerRole))
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="FridgeAllocations" asp-action="CustomerAllocations">
                <i class="fas fa-list"></i> My Allocations
            </a>
        </li>
    }

    @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.CustomerSupportRole))
    {
        <li class="nav-divider my-2"></li>
        <li class="nav-item">
            <span class="nav-link text-muted small">ADMINISTRATION</span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Customers" asp-action="Index">
                <i class="fas fa-users"></i> Customers
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Fridges" asp-action="Index">
                <i class="fas fa-refrigerator"></i> Fridges
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Employees" asp-action="Index">
                <i class="fas fa-user-tie"></i> Employees
            </a>
        </li>
    }

    @if (User.IsInRole(SD.AdminRole) || User.IsInRole(SD.MaintenanceTechnicianRole) || User.IsInRole(SD.CustomerSupportRole))
    {
        <li class="nav-divider my-2"></li>
        <li class="nav-item">
            <span class="nav-link text-muted small">MAINTENANCE</span>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="MaintenanceVisits" asp-action="Dashboard">
                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="MaintenanceVisits" asp-action="Index">
                <i class="fas fa-calendar-alt me-2"></i>Maintenance Visits
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="MaintenanceRecords" asp-action="Index">
                <i class="fas fa-clipboard-list me-2"></i>Maintenance Records
            </a>
        </li>
    }
</ul>

<script>
    // Update cart badge
    $(document).ready(function() {
        updateCartBadge();
    });

    function updateCartBadge() {
        $.get('@Url.Action("GetSummary", "Carts")', function(data) {
            if (data.success) {
                $('#cartBadge').text(data.summary.itemCount || 0);
            }
        });
    }
</script>