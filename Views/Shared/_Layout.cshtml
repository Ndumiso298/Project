@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data
@{
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var hasRequestedItems = _db.AllocationRequestHeaders.Any(r => r.Customer.UserId == userId);
    var cartCount = _db.FridgeAllocations.Count(a => a.Customer.UserId == userId);
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartChill Solutions</title>
    <link rel="icon" href="~/Images/Logo/SmartChill Solutions_Logo.svg" type="image/svg+xml">
    <link rel="alternate icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/Logo/SmartChill Solutions_Logo.png" alt="GRP-03-11" style="height: 40px; width: auto;" />
                    SmartChill Solutions(GRP-03-11)
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @*                         <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="OurServices">Our Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li> *@
                        @if (User.IsInRole(SD.AdminRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Users" asp-action="Index">Customers</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Users" asp-action="Index">Employees</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Locations" asp-action="Index">Locations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Fridges" asp-action="Index">Inventory Management</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Suppliers" asp-action="UpdateRequestDetail">Suppliers</a>
                            </li>
                            @*                             <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Fridge" asp-action="Index">Fridge</a>
                            </li> *@
@*                             <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="AllocationRequests" asp-action="Index">Requests</a>
                            </li> *@
                        }
                        else if (User.IsInRole(SD.StockControllerRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Fridges" asp-action="Index">Inventory Management</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="AllocationRequests" asp-action="Allocate">Fridge Allocations</a>
                            </li>
                        }
                        else if (User.IsInRole(SD.CustomerRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="AllocationRequests" asp-action="Index">Allocation Requests</a>
                            </li>
                            
                            @if (hasRequestedItems)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="FridgeAllocations" asp-action="Index">My Orders</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Carts" asp-action="Index">
                                    <i class="bi bi-cart4">&nbsp;(@cartCount)</i>
                                </a>
                            </li>
                        }
                        else if (User.IsInRole(SD.CustomerSupportRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="AllocationRequests" asp-action="Index">Allocation Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Customers" asp-action="Index">Customer Data</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="FridgeAllocations" asp-action="Index">Fridge Allocations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="ReplacementRequests" asp-action="Index">Replacement Requests</a>
                            </li>
                        }
                        else if (User.IsInRole(SD.MaintenanceTechnicianRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="MaintenanceVisits" asp-action="Index">Maintenance Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="MaintenanceRecords" asp-action="Index">Maintenance Records</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Faults" asp-action="Index">Fault Management</a>
                            </li>
                        }
                        else if (User.IsInRole(SD.FaultTechnicianRole))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="FridgeFaults" asp-action="Index">Fault Management</a>
                            </li>
                        }


                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white text-center bg-primary">
        <div class="container">
            Peace<i class="bi bi-peace"></i>Love
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
