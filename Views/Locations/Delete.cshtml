@model Location
@{
    ViewData["Title"] = "Delete Location";
    var canDelete = ViewBag.CanDelete as bool? ?? false;
}
@{
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title text-danger">
                    <i class="fas fa-trash-alt me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Locations</a></li>
                        <li class="breadcrumb-item active">Delete</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    @if (!canDelete)
                    {
                        <div class="alert alert-danger">
                            <h5><i class="fas fa-exclamation-triangle me-2"></i>Cannot Delete Location</h5>
                            <p class="mb-0">This location cannot be deleted because it has active references:</p>
                            <ul class="mb-0 mt-2">
                                @if (Model.Employees.Any(e => e.IsActive))
                                {
                                    <li><strong>@Model.Employees.Count(e => e.IsActive) active employees</strong> are assigned to this location</li>
                                }
                                @if (Model.Customers.Any(c => c.IsActive))
                                {
                                    <li><strong>@Model.Customers.Count(c => c.IsActive) active customers</strong> are associated with this location</li>
                                }
                                @if (Model.Fridges.Any(f => f.IsActive))
                                {
                                    <li><strong>@Model.Fridges.Count(f => f.IsActive) active fridges</strong> are located here</li>
                                }
                            </ul>
                        </div>

                        <div class="alert alert-info">
                            <h6><i class="fas fa-info-circle me-2"></i>Recommended Action</h6>
                            <p class="mb-0">Instead of deleting, you can deactivate the location to hide it from dropdowns while preserving historical data.</p>
                        </div>

                        <div class="text-center mt-4">
                            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-1"></i> Edit Location
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Back to List
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <h5><i class="fas fa-exclamation-triangle me-2"></i>Warning</h5>
                            <p class="mb-0">You are about to permanently delete this location. This action cannot be undone.</p>
                        </div>

                        <div class="row">
                            <div class="col-md-8">
                                <dl class="row">
                                    <dt class="col-sm-4">Location Name:</dt>
                                    <dd class="col-sm-8">@Model.Name</dd>

                                    <dt class="col-sm-4">Address:</dt>
                                    <dd class="col-sm-8">
                                        @Model.AddressLine1<br>
                                        @if (!string.IsNullOrEmpty(Model.AddressLine2))
                                        {
                                            @Model.AddressLine2

                                            <br>
                                        }
                                        @Model.Suburb, @Model.City<br>
                                        @Model.Province, @Model.PostalCode
                                    </dd>

                                    <dt class="col-sm-4">Status:</dt>
                                    <dd class="col-sm-8">
                                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                            @(Model.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </dd>
                                </dl>
                            </div>
                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">
                                <label for="confirmationText" class="form-label">
                                    Type "DELETE" to confirm:
                                </label>
                                <input type="text" id="confirmationText" class="form-control"
                                       placeholder="Type DELETE here" required
                                       oninput="toggleDeleteButton(this.value)" />
                            </div>

                            <div class="form-group mt-4">
                                <div class="btn-group" role="group">
                                    <button type="submit" id="deleteButton" class="btn btn-danger" disabled>
                                        <i class="fas fa-trash-alt me-1"></i> Confirm Delete
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-times me-1"></i> Cancel
                                    </a>
                                </div>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDeleteButton(input) {
            const deleteButton = document.getElementById('deleteButton');
            if (deleteButton) {
                deleteButton.disabled = input.toUpperCase() !== 'DELETE';
            }
        }

        // Prevent form submission if not confirmed
        document.querySelector('form')?.addEventListener('submit', function (e) {
            const confirmationText = document.getElementById('confirmationText')?.value;
            if (confirmationText && confirmationText.toUpperCase() !== 'DELETE') {
                e.preventDefault();
                alert('Please type "DELETE" to confirm deletion.');
            }
        });
    </script>
}