@model LocationVM
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Delete Location";
    var canDelete = ViewBag.CanDelete ?? false;
    var dependencyMessage = ViewBag.DependencyMessage ?? "";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Location Management</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Location Details</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Location
                </h1>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Details
                </a>
            </div>
        </div>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger border-0 shadow-sm">
        <div class="d-flex">
            <div class="flex-shrink-0">
                <i class="fas fa-exclamation-circle fa-2x"></i>
            </div>
            <div class="flex-grow-1 ms-3">
                <h4 class="alert-heading mb-2">Warning: Critical Action</h4>
                <p class="mb-2">
                    <strong>This action will deactivate the location and make it unavailable for new assignments.</strong>
                    Existing records will be preserved but the location will be marked as inactive in the system.
                </p>
                <hr>
                <p class="mb-0 small">
                    <i class="fas fa-info-circle me-1"></i>
                    This is a soft delete operation. Location data will be retained for audit purposes but hidden from active operations.
                </p>
            </div>
        </div>
    </div>

    <!-- Location Details Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-map-marker-alt me-2"></i>Location Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">
                            <strong class="text-primary">@Model.StreetAddress</strong>
                            <br>@Model.Suburb, @Model.City
                            <br>@Model.Province, @Model.PostalCode
                            <br>@Model.Country
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Location ID</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">#@Model.Id</span>
                        </dd>

                        <dt class="col-sm-4">Full Address</dt>
                        <dd class="col-sm-8">
                            <code class="text-muted">@Model.CompleteAddress</code>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (!Model.IsDeleted)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times-circle me-1"></i>Inactive
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            <i class="fas fa-calendar-plus me-1 text-muted"></i>
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="row mt-3 pt-3 border-top">
                <div class="col-12">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-chart-bar me-2"></i>Current Usage Summary
                    </h6>
                    <div class="row text-center">
                        <div class="col-3">
                            <div class="border rounded p-2 bg-light">
                                <i class="fas fa-user-tie fa-lg text-primary mb-2"></i>
                                <div class="fw-bold fs-5">@Model.TotalEmployees</div>
                                <small class="text-muted">Employees</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2 bg-light">
                                <i class="fas fa-users fa-lg text-success mb-2"></i>
                                <div class="fw-bold fs-5">@Model.TotalCustomers</div>
                                <small class="text-muted">Customers</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2 bg-light">
                                <i class="fas fa-refrigerator fa-lg text-warning mb-2"></i>
                                <div class="fw-bold fs-5">@Model.TotalFridges</div>
                                <small class="text-muted">Fridges</small>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="border rounded p-2 bg-light">
                                <i class="fas fa-truck-loading fa-lg text-info mb-2"></i>
                                <div class="fw-bold fs-5">@Model.AllocatedFridges</div>
                                <small class="text-muted">Allocations</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dependencies Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header @(canDelete ? "bg-warning" : "bg-danger") text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-shield-alt me-2"></i>System Dependency Analysis
            </h5>
        </div>
        <div class="card-body">
            @if (canDelete)
            {
                <div class="alert alert-success border-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle fa-2x me-3"></i>
                        <div>
                            <h5 class="alert-heading mb-1">Safe to Deactivate</h5>
                            <p class="mb-0">No active dependencies were found that would prevent deactivation. This location can be safely removed from active operations.</p>
                        </div>
                    </div>
                </div>

                <div class="row text-center">
                    <div class="col-3">
                        <div class="border rounded p-3 bg-success text-white">
                            <i class="fas fa-user-tie fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalEmployees</h4>
                            <small>Employees</small>
                            <div class="mt-2">
                                <i class="fas fa-check-circle"></i>
                                <small>No Conflicts</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-success text-white">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalCustomers</h4>
                            <small>Customers</small>
                            <div class="mt-2">
                                <i class="fas fa-check-circle"></i>
                                <small>No Conflicts</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-success text-white">
                            <i class="fas fa-refrigerator fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalFridges</h4>
                            <small>Fridges</small>
                            <div class="mt-2">
                                <i class="fas fa-check-circle"></i>
                                <small>No Conflicts</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-success text-white">
                            <i class="fas fa-lock-open fa-2x mb-2"></i>
                            <h4 class="mb-1">Ready</h4>
                            <small>For Deactivation</small>
                            <div class="mt-2">
                                <i class="fas fa-thumbs-up"></i>
                                <small>Approved</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger border-0">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-times-circle fa-2x me-3"></i>
                        <div>
                            <h5 class="alert-heading mb-1">Deactivation Blocked</h5>
                            <p class="mb-0">@dependencyMessage</p>
                        </div>
                    </div>
                </div>

                <div class="row text-center">
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalEmployees > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-user-tie fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalEmployees</h4>
                            <small>Active Employees</small>
                            @if (Model.TotalEmployees > 0)
                            {
                                <div class="mt-2">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <small>Conflict Found</small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalCustomers > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalCustomers</h4>
                            <small>Active Customers</small>
                            @if (Model.TotalCustomers > 0)
                            {
                                <div class="mt-2">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <small>Conflict Found</small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalFridges > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-refrigerator fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalFridges</h4>
                            <small>Active Fridges</small>
                            @if (Model.TotalFridges > 0)
                            {
                                <div class="mt-2">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    <small>Conflict Found</small>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-danger text-white">
                            <i class="fas fa-lock fa-2x mb-2"></i>
                            <h4 class="mb-1">Blocked</h4>
                            <small>Cannot Deactivate</small>
                            <div class="mt-2">
                                <i class="fas fa-ban"></i>
                                <small>Restricted</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <h5 class="border-bottom pb-2">
                        <i class="fas fa-tasks me-2"></i>Required Resolution Steps
                    </h5>
                    <div class="list-group">
                        @if (Model.TotalEmployees > 0)
                        {
                            <div class="list-group-item list-group-item-danger">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-user-tie me-2"></i>
                                        <strong>@Model.TotalEmployees Active Employee(s)</strong> assigned to this location
                                    </div>
                                    <a href="@Url.Action("Index", "Employees", new { locationId = Model.Id })"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-external-link-alt me-1"></i>Manage Employees
                                    </a>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    Reassign or deactivate employees before deactivating this location.
                                </small>
                            </div>
                        }
                        @if (Model.TotalCustomers > 0)
                        {
                            <div class="list-group-item list-group-item-danger">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-users me-2"></i>
                                        <strong>@Model.TotalCustomers Active Customer(s)</strong> registered at this location
                                    </div>
                                    <a href="@Url.Action("Index", "Customers", new { locationId = Model.Id })"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-external-link-alt me-1"></i>Manage Customers
                                    </a>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    Reassign customers to different locations or deactivate them first.
                                </small>
                            </div>
                        }
                        @if (Model.TotalFridges > 0)
                        {
                            <div class="list-group-item list-group-item-danger">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-refrigerator me-2"></i>
                                        <strong>@Model.TotalFridges Active Fridge(s)</strong> stationed at this location
                                    </div>
                                    <a href="@Url.Action("Index", "Fridges", new { locationId = Model.Id })"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-external-link-alt me-1"></i>Manage Fridges
                                    </a>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    Reassign fridges to different locations or mark them as inactive.
                                </small>
                            </div>
                        }
                        @if (Model.AllocatedFridges > 0)
                        {
                            <div class="list-group-item list-group-item-warning">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-truck-loading me-2"></i>
                                        <strong>@Model.AllocatedFridges Active Allocation(s)</strong> linked to this location
                                    </div>
                                    <a href="@Url.Action("Index", "FridgeAllocations", new { locationId = Model.Id })"
                                       class="btn btn-outline-warning btn-sm">
                                        <i class="fas fa-external-link-alt me-1"></i>View Allocations
                                    </a>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    Complete or cancel active allocations before deactivation.
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Confirmation Card -->
    <div class="card shadow-sm">
        <div class="card-header @(canDelete ? "bg-danger" : "bg-secondary") text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-user-shield me-2"></i>Administrative Confirmation
            </h5>
        </div>
        <div class="card-body">
            @if (canDelete)
            {
                <div class="alert alert-warning border-0">
                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="fas fa-exclamation-triangle fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h5 class="alert-heading">Final Verification Required</h5>
                            <p class="mb-2">
                                You are about to deactivate location <strong>#@Model.Id</strong>. This action will:
                            </p>
                            <ul class="mb-2">
                                <li>Remove this location from active selection lists</li>
                                <li>Prevent new assignments to this location</li>
                                <li>Preserve all historical data for reporting</li>
                                <li>Be reversible by system administrators only</li>
                            </ul>
                            <p class="mb-0 small text-muted">
                                <i class="fas fa-clock me-1"></i>
                                This operation was initiated by <strong>@User.Identity?.Name</strong> on @DateTime.Now.ToString("dd/MM/yyyy 'at' HH:mm")
                            </p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" asp-for="Id" />
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label for="confirmationText" class="form-label fw-bold">
                            <i class="fas fa-keyboard me-2"></i>
                            Type the location name to confirm deactivation:
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <i class="fas fa-map-marker-alt text-muted"></i>
                            </span>
                            <input type="text" class="form-control" id="confirmationText"
                                   placeholder="Type &quot;@Model.Suburb, @Model.City&quot; to confirm"
                                   required
                                   oninput="validateConfirmation(this.value)">
                        </div>
                        <div class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            For security, please type the location name exactly as shown: <code>@Model.Suburb, @Model.City</code>
                        </div>
                        <div class="invalid-feedback fw-bold" id="confirmationFeedback">
                            <i class="fas fa-times-circle me-1"></i>
                            Location name does not match. Please type &quot;@Model.Suburb, @Model.City&quot; exactly.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel & Return
                            </a>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-warning" onclick="showDeactivationDetails()">
                                <i class="fas fa-info-circle me-1"></i>Review Details
                            </button>
                            <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                <i class="fas fa-trash-alt me-1"></i>Confirm Deactivation
                            </button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-lock fa-4x text-muted mb-4"></i>
                    <h3 class="text-muted mb-3">Deactivation Not Available</h3>
                    <p class="text-muted mb-4">
                        This location cannot be deactivated due to active system dependencies.<br>
                        Please resolve all conflicts listed above before attempting to deactivate.
                    </p>
                    <div class="btn-group">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-eye me-1"></i>View Location Details
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-1"></i>Back to Locations
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Deactivation Details Modal -->
<div class="modal fade" id="deactivationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fas fa-clipboard-list me-2"></i>Deactivation Impact Analysis
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h6 class="text-primary mb-3">What will happen when this location is deactivated:</h6>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card border-0 bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title text-success">
                                    <i class="fas fa-check-circle me-2"></i>Immediate Changes
                                </h6>
                                <ul class="small">
                                    <li>Location removed from active dropdowns</li>
                                    <li>No new assignments possible</li>
                                    <li>Status changed to "Inactive"</li>
                                    <li>Hidden from main location lists</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title text-info">
                                    <i class="fas fa-database me-2"></i>Data Preservation
                                </h6>
                                <ul class="small">
                                    <li>All historical records kept</li>
                                    <li>Reports remain accurate</li>
                                    <li>Audit trail maintained</li>
                                    <li>Recovery possible by admin</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-history me-2"></i>
                    <strong>Note:</strong> This is a soft delete operation. The location can be restored by administrators if needed.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Close
                </button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    <i class="fas fa-check me-1"></i>Understood
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Enhanced confirmation text validation
        function validateConfirmation(input) {
            const deleteButton = document.getElementById('deleteButton');
            const expectedText = '@Model.Suburb, @Model.City';
            const confirmationText = input.trim();

            if (confirmationText === expectedText) {
                deleteButton.disabled = false;
                document.getElementById('confirmationText').classList.remove('is-invalid');
                document.getElementById('confirmationText').classList.add('is-valid');
            } else {
                deleteButton.disabled = true;
                document.getElementById('confirmationText').classList.remove('is-valid');
                document.getElementById('confirmationText').classList.add('is-invalid');
            }
        }

        // Show deactivation details modal
        function showDeactivationDetails() {
            const modal = new bootstrap.Modal(document.getElementById('deactivationModal'));
            modal.show();
        }

        // Enhanced form submission handler
        document.getElementById('deleteForm')?.addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('#deleteButton');
            const originalText = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing Deactivation...';

            // Add delay to show processing state
            setTimeout(() => {
                if (submitBtn.disabled) {
                    submitBtn.innerHTML = '<i class="fas fa-sync fa-spin me-1"></i>Still Processing...';
                }
            }, 3000);
        });

        // Enhanced page load actions
        document.addEventListener('DOMContentLoaded', function() {
            // Focus on confirmation input when ready to delete
            if (@Json.Serialize(canDelete)) {
                const confirmationInput = document.getElementById('confirmationText');
                if (confirmationInput) {
                    setTimeout(() => {
                        confirmationInput.focus();
                    }, 500);
                }
            }

            // Add keyboard shortcut for cancellation (Escape)
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    window.location.href = '@Url.Action("Details", new { id = Model.Id })';
                }
            });

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // Auto-save confirmation text (in case of accidental refresh)
        let confirmationText = '';
        document.getElementById('confirmationText')?.addEventListener('input', function(e) {
            confirmationText = e.target.value;
            localStorage.setItem('locationDeleteConfirmation', confirmationText);
        });

        // Restore confirmation text on page load
        const savedConfirmation = localStorage.getItem('locationDeleteConfirmation');
        if (savedConfirmation && @Json.Serialize(canDelete)) {
            document.getElementById('confirmationText').value = savedConfirmation;
            validateConfirmation(savedConfirmation);
        }

        // Clear saved confirmation when leaving page
        window.addEventListener('beforeunload', function() {
            localStorage.removeItem('locationDeleteConfirmation');
        });
    </script>

    <style>
        .card-header.bg-warning {
            background: linear-gradient(135deg, #ffc107 0%, #ffb300 100%) !important;
            color: #000 !important;
        }

        .list-group-item-danger {
            border-left: 4px solid #dc3545;
            background-color: #f8d7da;
        }

        .list-group-item-warning {
            border-left: 4px solid #ffc107;
            background-color: #fff3cd;
        }

        .is-valid {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25);
        }

        .is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }

        .alert-border {
            border-left: 4px solid;
        }

        code {
            background-color: #f8f9fa;
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-size: 0.875em;
        }

        .btn-group .btn {
