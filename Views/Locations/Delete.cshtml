@model LocationVM
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Delete Location";
    var canDelete = ViewBag.CanDelete ?? false;
    var dependencyMessage = ViewBag.DependencyMessage ?? "";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Location Management</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Location Details</a></li>
                    <li class="breadcrumb-item active">Delete</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Delete Location
                </h1>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Details
                </a>
            </div>
        </div>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger">
        <h4 class="alert-heading">
            <i class="fas fa-exclamation-circle me-2"></i>Warning: Irreversible Action
        </h4>
        <p class="mb-0">
            This action will deactivate the location and make it unavailable for new assignments.
            Existing records will be preserved but the location will be marked as inactive.
        </p>
    </div>

    <!-- Location Details Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-info-circle me-2"></i>Location to be Deactivated
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">
                            <strong>@Model.StreetAddress</strong><br>
                            @Model.Suburb, @Model.City<br>
                            @Model.Province, @Model.PostalCode<br>
                            @Model.Country
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Location ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Full Address</dt>
                        <dd class="col-sm-8">@Model.FullAddress</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Dependencies Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header @(canDelete ? "bg-warning" : "bg-danger") text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-link me-2"></i>Dependency Check
            </h5>
        </div>
        <div class="card-body">
            @if (canDelete)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>This location can be safely deactivated.</strong><br>
                    No active dependencies were found that would prevent deactivation.
                </div>

                <div class="row text-center">
                    <div class="col-3">
                        <div class="border rounded p-3">
                            <i class="fas fa-user-tie fa-2x text-muted mb-2"></i>
                            <h4 class="mb-1">@Model.TotalEmployees</h4>
                            <small class="text-muted">Employees</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3">
                            <i class="fas fa-users fa-2x text-muted mb-2"></i>
                            <h4 class="mb-1">@Model.TotalCustomers</h4>
                            <small class="text-muted">Customers</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3">
                            <i class="fas fa-refrigerator fa-2x text-muted mb-2"></i>
                            <h4 class="mb-1">@Model.TotalFridges</h4>
                            <small class="text-muted">Fridges</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-success text-white">
                            <i class="fas fa-lock-open fa-2x mb-2"></i>
                            <h4 class="mb-1">Ready</h4>
                            <small>For Deactivation</small>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger">
                    <i class="fas fa-times-circle me-2"></i>
                    <strong>This location cannot be deactivated at this time.</strong><br>
                    @dependencyMessage
                </div>

                <div class="row text-center">
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalEmployees > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-user-tie fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalEmployees</h4>
                            <small>Active Employees</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalCustomers > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalCustomers</h4>
                            <small>Active Customers</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 @(Model.TotalFridges > 0 ? "bg-danger text-white" : "bg-light")">
                            <i class="fas fa-refrigerator fa-2x mb-2"></i>
                            <h4 class="mb-1">@Model.TotalFridges</h4>
                            <small>Active Fridges</small>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="border rounded p-3 bg-danger text-white">
                            <i class="fas fa-lock fa-2x mb-2"></i>
                            <h4 class="mb-1">Blocked</h4>
                            <small>Cannot Deactivate</small>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <h6>Required Actions:</h6>
                    <ul class="list-group">
                        @if (Model.TotalEmployees > 0)
                        {
                            <li class="list-group-item">
                                <i class="fas fa-user-tie text-danger me-2"></i>
                                Reassign or deactivate <strong>@Model.TotalEmployees employee(s)</strong> from this location
                            </li>
                        }
                        @if (Model.TotalCustomers > 0)
                        {
                            <li class="list-group-item">
                                <i class="fas fa-users text-danger me-2"></i>
                                Reassign or deactivate <strong>@Model.TotalCustomers customer(s)</strong> from this location
                            </li>
                        }
                        @if (Model.TotalFridges > 0)
                        {
                            <li class="list-group-item">
                                <i class="fas fa-refrigerator text-danger me-2"></i>
                                Reassign or deactivate <strong>@Model.TotalFridges fridge(s)</strong> from this location
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Confirmation Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-shield-alt me-2"></i>Confirmation
            </h5>
        </div>
        <div class="card-body">
            @if (canDelete)
            {
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Please confirm this action:</strong><br>
                    Deactivating this location will make it unavailable for new assignments.
                    This action can be reversed by an administrator.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="confirmationText" class="form-label">
                            Type <strong>"DEACTIVATE"</strong> to confirm:
                        </label>
                        <input type="text" class="form-control" id="confirmationText"
                               placeholder="Enter DEACTIVATE to confirm" required
                               oninput="validateConfirmation(this.value)">
                        <div class="invalid-feedback" id="confirmationFeedback">
                            Please type "DEACTIVATE" to confirm the deactivation.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                            <i class="fas fa-trash me-1"></i>Deactivate Location
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-lock fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">Deactivation Blocked</h4>
                    <p class="text-muted">This location cannot be deactivated due to active dependencies.</p>
                    <div class="btn-group">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-eye me-1"></i>View Details
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirmation text validation
        function validateConfirmation(input) {
            const deleteButton = document.getElementById('deleteButton');
            const confirmationText = input.trim().toUpperCase();

            if (confirmationText === 'DEACTIVATE') {
                deleteButton.disabled = false;
                document.getElementById('confirmationText').classList.remove('is-invalid');
                document.getElementById('confirmationText').classList.add('is-valid');
            } else {
                deleteButton.disabled = true;
                document.getElementById('confirmationText').classList.remove('is-valid');
                document.getElementById('confirmationText').classList.add('is-invalid');
            }
        }

        // Form submission handler
        document.querySelector('form')?.addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Deactivating...';
        });

        // Focus on confirmation input when page loads
        document.addEventListener('DOMContentLoaded', function() {
            const confirmationInput = document.getElementById('confirmationText');
            if (confirmationInput) {
                confirmationInput.focus();
            }
        });
    </script>

    <style>
        .card-header.bg-warning {
            background-color: #ffc107 !important;
            color: #000 !important;
        }

        .list-group-item {
            border-left: 4px solid #dc3545;
        }

        .is-valid {
            border-color: #198754;
        }

        .is-invalid {
            border-color: #dc3545;
        }
    </style>
}