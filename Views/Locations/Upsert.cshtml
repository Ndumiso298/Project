@model LocationVM
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? "Add New Location" : "Edit Location";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Location Management</a></li>
                    <li class="breadcrumb-item active">@(isCreate ? "Add New" : "Edit")</li>
                </ol>
            </nav>
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2 text-primary">
                    <i class="fas fa-map-marker-alt me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="card-title mb-0">
                <i class="fas @(isCreate ? "fa-plus" : "fa-edit") me-2"></i>
                @(isCreate ? "Add a new location" : "Edit location details")
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Upsert" method="post" id="locationForm">
                @if (!isCreate)
                {
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="CreatedBy" />
                }

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <!-- Address Information Column -->
                    <div class="col-lg-6">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-home me-2"></i>Address Information
                        </h5>

                        <!-- Street Address (Required) -->
                        <div class="mb-3">
                            <label asp-for="StreetAddress" class="form-label required"></label>
                            <input asp-for="StreetAddress" class="form-control"
                                   placeholder="Enter street address, building name, etc."
                                   required />
                            <span asp-validation-for="StreetAddress" class="text-danger"></span>
                        </div>

                        <!-- Suburb -->
                        <div class="mb-3">
                            <label asp-for="Suburb" class="form-label required"></label>
                            <input asp-for="Suburb" class="form-control"
                                   placeholder="Enter suburb name"
                                   id="suburbInput"
                                   required />
                            <span asp-validation-for="Suburb" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label asp-for="City" class="form-label required"></label>
                            <input asp-for="City" class="form-control"
                                   placeholder="Enter city name"
                                   id="cityInput"
                                   list="citiesList"
                                   required />
                            <datalist id="citiesList"></datalist>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Location Details Column -->
                    <div class="col-lg-6">
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-info-circle me-2"></i>Location Details
                        </h5>

                        <!-- Province -->
                        <div class="mb-3">
                            <label asp-for="Province" class="form-label required"></label>
                            <select asp-for="Province" class="form-select" id="provinceSelect" required>
                                <option value="">-- Select Province --</option>
                                @if (ViewBag.ProvinceList != null)
                                {
                                    foreach (var province in ViewBag.ProvinceList)
                                    {
                                        <option value="@province">@province</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>

                        <!-- Postal Code -->
                        <div class="mb-3">
                            <label asp-for="PostalCode" class="form-label required"></label>
                            <input asp-for="PostalCode" class="form-control"
                                   placeholder="Enter 4-digit postal code"
                                   maxlength="4"
                                   pattern="[0-9]{4}"
                                   title="Please enter a valid 4-digit postal code"
                                   required />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <!-- Country -->
                        <div class="mb-3">
                            <label asp-for="Country" class="form-label required"></label>
                            <input asp-for="Country" class="form-control"
                                   value="@(string.IsNullOrEmpty(Model.Country) ? "South Africa" : Model.Country)"
                                   required /> 
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <!-- Status Section -->
                        <div class="mb-3">
                            <h6 class="border-bottom pb-2 mb-3">Status</h6>

                            <!-- Active Status -->
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsDeleted" class="form-check-input" type="checkbox">
                                <label asp-for="IsDeleted" class="form-check-label fw-bold"></label>
                                <div class="form-text">Active locations are available for new allocations and operations.</div>
                            </div>

                            <!-- Deleted Status (Only show for editing, read-only) -->
                            @if (!isCreate)
                            {
                                <div class="form-check form-switch">
                                    <input asp-for="IsDeleted" class="form-check-input" type="checkbox" disabled>
                                    <label asp-for="IsDeleted" class="form-check-label text-muted"></label>
                                    <div class="form-text text-muted">Soft delete status - managed by system.</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Address Preview -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-eye me-2"></i>Address Preview
                                </h6>
                                <p class="card-text" id="addressPreview">
                                    @Model.CompleteAddress
                                </p>
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    This is how the address will appear throughout the system.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistics Preview (Only for editing) -->
                @if (!isCreate)
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <i class="fas fa-chart-bar me-2"></i>Current Location Statistics
                                    </h6>
                                    <div class="row text-center">
                                        <div class="col-3">
                                            <h4 class="mb-0">@Model.TotalFridges</h4>
                                            <small>Total Fridges</small>
                                        </div>
                                        <div class="col-3">
                                            <h4 class="mb-0">@Model.AvailableFridges</h4>
                                            <small>Available</small>
                                        </div>
                                        <div class="col-3">
                                            <h4 class="mb-0">@Model.TotalCustomers</h4>
                                            <small>Customers</small>
                                        </div>
                                        <div class="col-3">
                                            <h4 class="mb-0">@Model.TotalEmployees</h4>
                                            <small>Employees</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Form Actions -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            <div class="btn-group">
                                @if (!isCreate)
                                {
                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                        <i class="fas fa-eye me-1"></i>View Details
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </a>
                                }
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <i class="fas fa-save me-1"></i>@(isCreate ? "Create Location" : "Update Location")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Enhanced address preview update
        function updateAddressPreview() {
            const addressLine1 = document.getElementById('AddressLine1').value;
            const addressLine2 = document.getElementById('AddressLine2').value;
            const suburb = document.getElementById('Suburb').value;
            const city = document.getElementById('City').value;
            const province = document.getElementById('Province').value;
            const postalCode = document.getElementById('PostalCode').value;
            const country = document.getElementById('Country').value;

            let address = addressLine1;
            if (addressLine2 && addressLine2.trim() !== '') {
                address += ', ' + addressLine2;
            }
            if (suburb) address += ', ' + suburb;
            if (city) address += ', ' + city;
            if (province) address += ', ' + province;
            if (postalCode) address += ', ' + postalCode;
            if (country) address += ', ' + country;

            const previewElement = document.getElementById('addressPreview');
            previewElement.textContent = address || 'Enter address details to see preview...';

            // Add visual feedback for empty required fields
            previewElement.className = address ? 'card-text text-success' : 'card-text text-muted';
        }

        // Attach event listeners to all address fields
        const addressFields = ['AddressLine1', 'AddressLine2', 'Suburb', 'City', 'Province', 'PostalCode', 'Country'];
        addressFields.forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.addEventListener('input', updateAddressPreview);
                element.addEventListener('change', updateAddressPreview);
                element.addEventListener('blur', updateAddressPreview);
            }
        });

        // Enhanced dynamic city loading based on province
        document.getElementById('Province').addEventListener('change', function() {
            const province = this.value;
            const cityInput = document.getElementById('City');
            const citiesList = document.getElementById('citiesList');

            if (!province) {
                citiesList.innerHTML = '';
                cityInput.value = '';
                updateAddressPreview();
                return;
            }

            // Show loading state
            cityInput.disabled = true;
            cityInput.placeholder = 'Loading cities...';

            fetch(`/Locations/GetCities?province=${encodeURIComponent(province)}`)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(data => {
                    citiesList.innerHTML = '';
                    if (data.success && data.data && data.data.length > 0) {
                        data.data.forEach(city => {
                            const option = document.createElement('option');
                            option.value = city;
                            citiesList.appendChild(option);
                        });
                    }
                })
                .catch(error => {
                    console.error('Error loading cities:', error);
                    // Fallback to manual input
                })
                .finally(() => {
                    cityInput.disabled = false;
                    cityInput.placeholder = 'Enter city name';
                    updateAddressPreview();
                });
        });

        // Enhanced location uniqueness check
        function checkLocationUniqueness() {
            const suburb = document.getElementById('Suburb').value;
            const city = document.getElementById('City').value;
            const province = document.getElementById('Province').value;
            const locationId = @Model.Id;

            if (!suburb || !city || !province) return;

            fetch(`/Locations/CheckLocationExists?suburb=${encodeURIComponent(suburb)}&city=${encodeURIComponent(city)}&province=${encodeURIComponent(province)}&id=${locationId}`)
                .then(response => response.json())
                .then(data => {
                    const suburbInput = document.getElementById('Suburb');
                    let feedback = document.getElementById('locationExistsFeedback');

                    if (!feedback) {
                        feedback = document.createElement('div');
                        feedback.id = 'locationExistsFeedback';
                        suburbInput.parentNode.appendChild(feedback);
                    }

                    if (data.exists) {
                        feedback.className = 'invalid-feedback d-block';
                        feedback.innerHTML = `<i class="fas fa-exclamation-triangle me-1"></i>${data.message}`;
                        suburbInput.classList.add('is-invalid');
                        suburbInput.classList.remove('is-valid');
                    } else {
                        feedback.className = 'valid-feedback d-block';
                        feedback.innerHTML = `<i class="fas fa-check-circle me-1"></i>Location is available`;
                        suburbInput.classList.add('is-valid');
                        suburbInput.classList.remove('is-invalid');
                    }
                })
                .catch(error => {
                    console.error('Error checking location uniqueness:', error);
                });
        }

        // Attach uniqueness check to relevant fields
        ['Suburb', 'City', 'Province'].forEach(id => {
            const element = document.getElementById(id);
            if (element) {
                element.addEventListener('blur', checkLocationUniqueness);
                element.addEventListener('change', checkLocationUniqueness);
            }
        });

        // Enhanced form submission handler
        document.getElementById('locationForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';

            // Re-enable button after 5 seconds in case submission fails
            setTimeout(() => {
                if (submitBtn.disabled) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalText;
                }
            }, 5000);
        });

        // Postal code validation
        document.getElementById('PostalCode').addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 4) {
                this.value = this.value.slice(0, 4);
            }
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            updateAddressPreview();

            // Set default country if empty
            const countryField = document.getElementById('Country');
            if (countryField && !countryField.value) {
                countryField.value = 'South Africa';
            }

            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // Auto-save draft functionality (optional)
        let autoSaveTimeout;
        function autoSaveDraft() {
            clearTimeout(autoSaveTimeout);
            autoSaveTimeout = setTimeout(() => {
                const formData = new FormData(document.getElementById('locationForm'));
                // Could implement local storage auto-save here
                console.log('Auto-save triggered');
            }, 2000);
        }

        // Attach auto-save to form fields
        document.querySelectorAll('#locationForm input, #locationForm select').forEach(element => {
            element.addEventListener('input', autoSaveDraft);
        });
    </script>

    <style>
        .required::after {
            content: " *";
            color: #dc3545;
        }

        .form-label {
            font-weight: 500;
            color: #495057;
        }

        #addressPreview {
            min-height: 24px;
            font-style: italic;
            transition: all 0.3s ease;
        }

        .card-header {
            border-bottom: none;
        }

        .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .btn-group .btn {
            margin-left: 0.5rem;
        }

        /* Enhanced focus styles */
        .form-control:focus, .form-select:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        /* Status section styling */
        .form-switch .form-check-input {
            width: 3em;
            height: 1.5em;
        }
    </style>
}