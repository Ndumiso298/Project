@model IEnumerable<Fridge>
@{
    ViewData["Title"] = "Fridge Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">
                    <i class="fas fa-refrigerator me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item active">Fridges</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Fridge Inventory</h5>
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> Add New Fridge
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="fridgesTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Image</th>
                                        <th>Serial Number</th>
                                        <th>Model</th>
                                        <th>Capacity (L)</th>
                                        <th>Status</th>
                                        <th>Monthly Rental</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fridge in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(fridge.ImageUrl))
                                                {
                                                    <img src="@fridge.ImageUrl" alt="Fridge Image"
                                                         class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;"
                                                         onerror="this.src='https://via.placeholder.com/60x60?text=No+Image'">
                                                }
                                                else
                                                {
                                                    <div class="text-center text-muted">
                                                        <i class="fas fa-refrigerator fa-2x"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>@fridge.SerialNumber</td>
                                            <td>@fridge.Model</td>
                                            <td>@fridge.CapacityLiters</td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(fridge.Status)">
                                                    @fridge.Status
                                                </span>
                                            </td>
                                            <td>@fridge.RentalPricePerMonth.ToString("C")</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Upsert" asp-route-id="@fridge.Id"
                                                       class="btn btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@fridge.Id"
                                                       class="btn btn-danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-refrigerator fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Fridges Found</h4>
                            <p class="text-muted">Get started by adding your first fridge to the inventory.</p>
                            <a asp-action="Upsert" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Add New Fridge
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#fridgesTable').DataTable({
                "order": [[1, "asc"]],
                "responsive": true,
                "columnDefs": [
                    { "orderable": false, "targets": [0, 6] } // Disable sorting for image and actions columns
                ]
            });
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(FridgeStatus status)
    {
        return status switch
        {
            FridgeStatus.Available => "bg-success",
            FridgeStatus.Allocated => "bg-primary",
            FridgeStatus.InRepair => "bg-warning",
            FridgeStatus.Scrapped => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
