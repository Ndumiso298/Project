                            <tr>
                                <td class="ps-4 fw-semibold align-middle">@obj.Manufacturer</td>
                                <td class="align-middle">@obj.Model</td>
                                <td class="align-middle">
                                    <span class="badge bg-light text-dark">@obj.SerialNumber</span>
                                </td>
                                <td class="align-middle">@obj.Type</td>
                                <td class="align-middle">
                                    <div class="text-truncate" style="max-width: 200px;"
                                         data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="@obj.Description">
                                        @obj.Description
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (obj.Status == FridgeStatus.Available)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> @obj.Status
                                        </span>
                                    }
                                    else if (obj.Status == FridgeStatus.Quarantined)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> @obj.Status
                                        </span>
                                    }
                                    else if (obj.Status == FridgeStatus.UnderMaintenance)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-tools me-1"></i> @obj.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                            <i class="bi bi-question-circle me-1"></i> @obj.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Fridge" asp-action="Upsert" asp-route-id="@obj.Id"
                                           class="btn btn-sm btn-outline-primary rounded me-2 d-flex align-items-center">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-controller="Fridge" asp-action="Delete" asp-route-id="@obj.Id"
                                           class="btn btn-sm btn-outline-danger rounded d-flex align-items-center">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

