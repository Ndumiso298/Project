@model List<Fridge>
@{
    Layout = "_CustomerLayout";
  
}
<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Fridge Management</h2>
                    <p class="text-muted">Manage and monitor all refrigeration units</p>
                </div>
                <a asp-controller="Fridge" asp-action="Upsert"
                   class="btn btn-primary d-flex align-items-center">
                    <i class="bi bi-plus-circle me-2"></i> Add New Fridge
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Fridges
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-refrigerator fa-2x text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Available
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(f => f.AvailabilityStatus == "Available")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-check-circle fa-2x text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Maintenance
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(f => f.AvailabilityStatus == "Maintenance")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-tools fa-2x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Unavailable
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(f => f.AvailabilityStatus == "Unavailable")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-x-circle fa-2x text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridge List Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 font-weight-bold text-primary">Fridge Inventory</h5>
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                        id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-filter me-1"></i> Filter
                </button>
                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                    <li><a class="dropdown-item" href="#">All Fridges</a></li>
                    <li><a class="dropdown-item" href="#">Available</a></li>
                    <li><a class="dropdown-item" href="#">Unavailable</a></li>
                    <li><a class="dropdown-item" href="#">Maintenance</a></li>
                </ul>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="fridgeTable">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Brand</th>
                            <th scope="col">Model</th>
                            <th scope="col">Number</th>
                            <th scope="col">Type</th>
                            <th scope="col">Description</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var obj in Model.OrderBy(u => u.FridgeId))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold align-middle">@obj.Brand</td>
                                <td class="align-middle">@obj.Model</td>
                                <td class="align-middle">
                                    <span class="badge bg-light text-dark">@obj.FridgeNo</span>
                                </td>
                                <td class="align-middle">@obj.Type</td>
                                <td class="align-middle">
                                    <div class="text-truncate" style="max-width: 200px;"
                                         data-bs-toggle="tooltip" data-bs-placement="top"
                                         title="@obj.Description">
                                        @obj.Description
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (obj.AvailabilityStatus == "Available")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-check-circle-fill me-1"></i> @obj.AvailabilityStatus
                                        </span>
                                    }
                                    else if (obj.AvailabilityStatus == "Unavailable")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-x-circle-fill me-1"></i> @obj.AvailabilityStatus
                                        </span>
                                    }
                                    else if (obj.AvailabilityStatus == "Maintenance")
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning">
                                            <i class="bi bi-tools me-1"></i> @obj.AvailabilityStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                            <i class="bi bi-question-circle me-1"></i> @obj.AvailabilityStatus
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4 align-middle">
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Fridge" asp-action="Upsert" asp-route-id="@obj.FridgeId"
                                           class="btn btn-sm btn-outline-primary rounded me-2 d-flex align-items-center">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <a asp-controller="Fridge" asp-action="Delete" asp-route-id="@obj.FridgeId"
                                           class="btn btn-sm btn-outline-danger rounded d-flex align-items-center">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-refrigerator display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No Fridges Found</h4>
                        <p class="text-muted">Get started by adding your first fridge</p>
                        <a asp-controller="Fridge" asp-action="Upsert" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle me-2"></i> Add Fridge
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        // Simple search functionality
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.placeholder = 'Search fridges...';
            searchInput.className = 'form-control form-control-sm w-25 ms-auto';

            const cardHeader = document.querySelector('.card-header');
            cardHeader.appendChild(searchInput);

            searchInput.addEventListener('keyup', function() {
                const searchText = this.value.toLowerCase();
                const rows = document.querySelectorAll('#fridgeTable tbody tr');

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });
    </script>
}