@model DashboardVM
@{
    ViewData["Title"] = "Fridge Dashboard";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">

    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="h3 fw-bold text-primary mb-1">Fridge Inventory Dashboard</h1>
                    <p class="text-muted mb-0">Monitor, manage, and analyze your fridge inventory performance</p>
                </div>
                <div class="d-flex gap-2">
                    <!-- Search Box -->
                    <div class="position-relative">
                        <input type="text" id="searchInput" class="form-control rounded-pill ps-4" placeholder="Search fridge models..." style="width: 280px;">
                        <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                    </div>
                    <button class="btn btn-outline-primary rounded-pill">
                        <i class="bi bi-filter me-1"></i> Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 rental-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1">Fridge Models</h6>
                        <h3 class="fw-bold text-primary">@Model.TotalFridgeModels</h3>
                        <small class="text-muted">Unique models in stock</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="bi bi-collection text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 rental-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1">Total Fridges</h6>
                        <h3 class="fw-bold text-info">@Model.TotalFridgeInstances</h3>
                        <small class="text-muted">All individual units</small>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded">
                        <i class="bi bi-box text-info fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 rental-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1">Available</h6>
                        <h3 class="fw-bold text-success">@Model.TotalAvailableInstances</h3>
                        <small class="text-muted">Ready for rental</small>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="bi bi-check-circle text-success fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 rental-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted mb-1">Rented</h6>
                        <h3 class="fw-bold text-warning">@Model.TotalRentedInstances</h3>
                        <small class="text-muted">Currently on lease</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="bi bi-clock text-warning fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridge Models Grid -->
    <div class="row g-4" id="fridgeGrid">
        @foreach (var stock in Model.FridgeStock)
        {
            var availablePercent = stock.TotalInstances > 0 ? (double)stock.AvailableInstances / stock.TotalInstances * 100 : 0;
            var rentedPercent = stock.TotalInstances > 0 ? (double)stock.RentedInstances / stock.TotalInstances * 100 : 0;

            <div class="col-xl-3 col-lg-4 col-md-6 fridge-item" data-search="@stock.FridgeModel.Brand.ToLower() @stock.FridgeModel.Model.ToLower()">
                <div class="card border-0 shadow-sm rental-card h-100">
                    <div class="rental-image-container">
                        <img src="@stock.FridgeModel.ImageUrl" class="card-img-top rental-image" alt="@stock.FridgeModel.Brand @stock.FridgeModel.Model" />
                        <div class="image-overlay"></div>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <div class="mb-2 d-flex justify-content-between align-items-center">
                            <h5 class="card-title text-dark mb-0">@stock.FridgeModel.Brand @stock.FridgeModel.Model</h5>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="@Url.Action("Manage", "FridgeInStock", new { id = stock.FridgeModel.FridgeId })">Manage Stock</a></li>
                                    <li><a class="dropdown-item" href="#">View Details</a></li>
                                    <li><a class="dropdown-item" href="#">Edit Model</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary">@stock.FridgeModel.Type</span>
                            <span class="badge bg-light text-dark ms-1">@stock.FridgeModel.CapacityLiters L</span>
                        </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <small class="text-muted">Capacity</small>
                                <p class="mb-0 fw-semibold">@stock.FridgeModel.CapacityLiters L</p>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Price</small>
                                <p class="mb-0 fw-semibold">$@stock.FridgeModel.RentalPricePerMonth/month</p>
                            </div>
                        </div>

                        <p class="text-muted small mb-3">@stock.FridgeModel.Description</p>

                        <div class="mt-auto">
                            <!-- Availability Progress -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Availability</span>
                                    <span>@stock.AvailableInstances of @stock.TotalInstances available</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @availablePercent%"></div>
                                    <div class="progress-bar bg-warning" style="width: @rentedPercent%"></div>
                                </div>
                            </div>

                        <!-- Quick Stats -->
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="border-end">
                                    <h6 class="mb-0 fw-bold">@stock.TotalInstances</h6>
                                    <small class="text-muted">Total</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border-end">
                                    <h6 class="mb-0 fw-bold text-success">@stock.AvailableInstances</h6>
                                    <small class="text-muted">Available</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <h6 class="mb-0 fw-bold text-warning">@stock.RentedInstances</h6>
                                <small class="text-muted">Rented</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                            <div class="d-grid">
                                <a href="@Url.Action("Manage", "FridgeInStock", new { id = stock.FridgeModel.FridgeId })"
                                   class="btn btn-outline-primary rounded-pill">
                                    <i class="bi bi-box-arrow-up-right me-2"></i> Manage Stock
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- No Results Message -->
    <div id="noResults" class="text-center py-5" style="display:none;">
        <i class="bi bi-search display-1 text-muted"></i>
        <h4 class="text-muted mt-3">No matching fridge models found</h4>
        <p class="text-muted">Try adjusting your search terms</p>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('input', function () {
                const term = $(this).val().toLowerCase().trim();
                let visible = 0;
                $('.fridge-item').each(function () {
                    const data = $(this).data('search');
                    if (data.includes(term) || term === '') {
                        $(this).show();
                        visible++;
                    } else {
                        $(this).hide();
                    }
                });
                $('#noResults').toggle(visible === 0 && term !== '');
            });

            // Hover animation for cards
            $('.rental-card').hover(
                function () { $(this).addClass('shadow-lg').css('transform', 'translateY(-5px)'); },
                function () { $(this).removeClass('shadow-lg').css('transform', 'translateY(0)'); }
            );
        });
    </script>

    <style>
        .rental-card {
            transition: all 0.3s ease;
            border-radius: 12px;
            overflow: hidden;
        }
        .rental-image-container {
            position: relative;
            height: 180px;
            overflow: hidden;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }
        .rental-image {
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        .rental-card:hover .rental-image {
            transform: scale(1.05);
        }
        .image-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.1));
        }
        .badge {
            font-size: 0.75rem;
            font-weight: 500;
        }
        .btn-outline-primary {
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .btn-outline-primary:hover {
            transform: translateY(-2px);
        }
        #searchInput {
            border: 1px solid #dee2e6;
            transition: all 0.2s ease;
        }

        #searchInput:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 0.15rem rgba(67, 97, 238, 0.25);
        }
        .progress {
            border-radius: 6px;
            background-color: #f1f3f5;
        }
        media (max-width: 768px) {
            .rental-image-container { height: 150px; }
        }
    </style>
}
