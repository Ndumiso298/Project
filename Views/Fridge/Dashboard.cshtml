@model Project.Models.ViewModel.DashboardVM
@{
    ViewData["Title"] = "Fridge Dashboard";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1">Fridge Inventory Dashboard</h2>
            <p class="text-muted mb-0">Manage your fridge inventory and track availability</p>
        </div>
        <div class="d-flex gap-2">
            <!-- Search Box -->
            <div class="position-relative">
                <input type="text" id="searchInput" class="form-control" placeholder="Search fridge models..." style="width: 300px;">
                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
            </div>
            <button class="btn btn-outline-primary">
                <i class="bi bi-filter"></i> Filters
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Fridge Models</h6>
                            <h3 class="fw-bold text-primary">@Model.TotalFridgeModels</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded">
                            <i class="bi bi-collection text-primary fs-4"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Total models in inventory</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Total Fridges</h6>
                            <h3 class="fw-bold text-info">@Model.TotalFridgeInstances</h3>
                        </div>
                        <div class="bg-info bg-opacity-10 p-3 rounded">
                            <i class="bi bi-box text-info fs-4"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">All fridge instances</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Available</h6>
                            <h3 class="fw-bold text-success">@Model.TotalAvailableInstances</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Ready for rental</p>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title text-muted mb-2">Rented</h6>
                            <h3 class="fw-bold text-warning">@Model.TotalRentedInstances</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded">
                            <i class="bi bi-clock text-warning fs-4"></i>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">Currently rented out</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridge Models Grid -->
    <div class="row" id="fridgeGrid">
        @foreach (var stock in Model.FridgeStock)
        {
            <div class="col-xl-4 col-lg-6 mb-4 fridge-item" data-search="@stock.FridgeModel.Brand.ToLower() @stock.FridgeModel.Model.ToLower()">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-transparent border-0 pb-0">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h5 class="card-title mb-1">@stock.FridgeModel.Brand @stock.FridgeModel.Model</h5>
                                <span class="badge bg-light text-dark">@stock.FridgeModel.Type</span>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="@Url.Action("Manage", "FridgeInStock", new { id = stock.FridgeModel.FridgeId })">Manage Stock</a></li>
                                    <li><a class="dropdown-item" href="#">View Details</a></li>
                                    <li><a class="dropdown-item" href="#">Edit Model</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <small class="text-muted">Capacity</small>
                                <p class="mb-0 fw-semibold">@stock.FridgeModel.CapacityLiters L</p>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Price</small>
                                <p class="mb-0 fw-semibold">$@stock.FridgeModel.RentalPricePerMonth/month</p>
                            </div>
                        </div>

                        <!-- Availability Progress -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted">Availability</small>
                                <small class="text-muted">@stock.AvailableInstances of @stock.TotalInstances available</small>
                            </div>
                            <div class="progress" style="height: 8px;">
                                @{
                                    var availablePercent = stock.TotalInstances > 0 ? (double)stock.AvailableInstances / stock.TotalInstances * 100 : 0;
                                    var rentedPercent = stock.TotalInstances > 0 ? (double)stock.RentedInstances / stock.TotalInstances * 100 : 0;
                                }
                                <div class="progress-bar bg-success" style="width: @availablePercent%"
                                     title="Available: @stock.AvailableInstances"></div>
                                <div class="progress-bar bg-warning" style="width: @rentedPercent%"
                                     title="Rented: @stock.RentedInstances"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-success">
                                    <i class="bi bi-check-circle-fill"></i> Available
                                </small>
                                <small class="text-warning">
                                    <i class="bi bi-clock-fill"></i> Rented
                                </small>
                            </div>
                        </div>

                        <!-- Quick Stats -->
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="border-end">
                                    <h6 class="mb-0 fw-bold">@stock.TotalInstances</h6>
                                    <small class="text-muted">Total</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border-end">
                                    <h6 class="mb-0 fw-bold text-success">@stock.AvailableInstances</h6>
                                    <small class="text-muted">Available</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <h6 class="mb-0 fw-bold text-warning">@stock.RentedInstances</h6>
                                <small class="text-muted">Rented</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <div class="d-grid">
                            <a href="@Url.Action("Manage", "FridgeInStock", new { id = stock.FridgeModel.FridgeId })"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Manage Stock
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- No Results Message (Hidden by default) -->
    <div id="noResults" class="text-center py-5" style="display: none;">
        <i class="bi bi-search display-1 text-muted"></i>
        <h4 class="text-muted mt-3">No matching fridge models found</h4>
        <p class="text-muted">Try adjusting your search terms</p>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Search functionality
            $('#searchInput').on('input', function () {
                const searchTerm = $(this).val().toLowerCase().trim();
                let visibleItems = 0;

                $('.fridge-item').each(function () {
                    const searchData = $(this).data('search');
                    if (searchData.includes(searchTerm) || searchTerm === '') {
                        $(this).show();
                        visibleItems++;
                    } else {
                        $(this).hide();
                    }
                });

                // Show/hide no results message
                if (visibleItems === 0 && searchTerm !== '') {
                    $('#noResults').show();
                } else {
                    $('#noResults').hide();
                }
            });

            // Add slight animation to cards on hover
            $('.card').hover(
                function () {
                    $(this).addClass('shadow-lg').css('transform', 'translateY(-2px)');
                },
                function () {
                    $(this).removeClass('shadow-lg').css('transform', 'translateY(0)');
                }
            );
        });
    </script>

    <style>
        .card {
            transition: all 0.3s ease;
            border-radius: 12px;
        }

        .progress {
            border-radius: 6px;
        }

        .progress-bar {
            transition: width 0.6s ease;
        }

        .fridge-item {
            transition: all 0.3s ease;
        }

        #searchInput {
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            padding: 0.5rem 1rem;
        }

            #searchInput:focus {
                border-color: #4361ee;
                box-shadow: 0 0 0 0.2rem rgba(67, 97, 238, 0.15);
            }

        .dropdown-toggle::after {
            display: none;
        }
    </style>
}