@model Fridge


<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm border-0 overflow-hidden">
                <!-- Card Header -->
                <div class="card-header bg-gradient-primary bg-opacity-10 py-4 border-bottom">
                    <div class="row align-items-center">
                        <div class="col">
                            <h2 class="h4 mb-0 text-primary">
                                <i class="bi bi-refrigerator me-2"></i>
                                @(Model.FridgeId != 0 ? "Update Fridge Details" : "Add New Fridge")
                            </h2>
                        </div>
                        <div class="col-auto">
                            <a asp-controller="Fridge" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-left me-1"></i> Back to List
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">
                    <form method="post" class="row g-4" enctype="multipart/form-data">
                        <input asp-for="FridgeId" type="hidden" />
                        <input asp-for="ImageUrl" type="hidden" />

                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        </div>

                        <div class="col-md-8">
                            <div class="row g-4">
                                <!-- Basic Information Card -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-none">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0 text-primary">Basic Information</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label asp-for="Brand" class="form-label fw-semibold"></label>
                                                    <select asp-for="Brand" class="form-select">
                                                        <option value="">-- Select Brand --</option>
                                                        <option value="Samsung">Samsung</option>
                                                        <option value="LG">LG</option>
                                                        <option value="Whirlpool">Whirlpool</option>
                                                        <option value="Bosch">Bosch</option>
                                                        <option value="Defy">Defy</option>
                                                    </select>
                                                    <span asp-validation-for="Brand" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="Model" class="form-label fw-semibold"></label>
                                                    <select asp-for="Model" class="form-select">
                                                        <option value="">-- Select Model --</option>
                                                        <option value="EcoCool 200">EcoCool 200</option>
                                                        <option value="FrostFree X">FrostFree X</option>
                                                        <option value="ChillMaster Pro">ChillMaster Pro</option>
                                                        <option value="IceBox Ultra">IceBox Ultra</option>
                                                        <option value="FreshKeeper Max">FreshKeeper Max</option>
                                                    </select>
                                                    <span asp-validation-for="Model" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="FridgeNo" class="form-label fw-semibold"></label>
                                                    <input asp-for="FridgeNo" class="form-control" />
                                                    <span asp-validation-for="FridgeNo" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="Type" class="form-label fw-semibold"></label>
                                                    <select asp-for="Type" class="form-select">
                                                        <option value="">-- Select Fridge Type --</option>
                                                        <option value="Top Freezer">Top Freezer</option>
                                                        <option value="Bottom Freezer">Bottom Freezer</option>
                                                        <option value="Side-by-Side">Side-by-Side</option>
                                                        <option value="French Door">French Door</option>
                                                        <option value="Mini Fridge">Mini Fridge</option>
                                                    </select>
                                                    <span asp-validation-for="Type" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="CapacityLiters" class="form-label fw-semibold"></label>
                                                    <div class="input-group">
                                                        <input asp-for="CapacityLiters" class="form-control" />
                                                        <span class="input-group-text">Liters</span>
                                                    </div>
                                                    <span asp-validation-for="CapacityLiters" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="Condition" class="form-label fw-semibold"></label>
                                                    <select asp-for="Condition" class="form-select">
                                                        <option value="">-- Select Condition --</option>
                                                        <option value="New">New</option>
                                                        <option value="Like New">Like New</option>
                                                        <option value="Good">Good</option>
                                                        <option value="Fair">Fair</option>
                                                        <option value="Poor">Poor</option>
                                                    </select>
                                                    <span asp-validation-for="Condition" class="text-danger small"></span>
                                                </div>

                                                <div class="col-12">
                                                    <label asp-for="Description" class="form-label fw-semibold"></label>
                                                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Rental Information Card -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-none">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0 text-primary">Rental Information</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label asp-for="RentalPricePerMonth" class="form-label fw-semibold"></label>
                                                    <div class="input-group">
                                                        <span class="input-group-text">R</span>
                                                        <input asp-for="RentalPricePerMonth" class="form-control" />
                                                        <span class="input-group-text">/month</span>
                                                    </div>
                                                    <span asp-validation-for="RentalPricePerMonth" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="AvailabilityStatus" class="form-label fw-semibold"></label>
                                                    <select asp-for="AvailabilityStatus" class="form-select">
                                                        <option value="">-- Select Availability Status --</option>
                                                        <option value="Available">Available</option>
                                                        <option value="Unavailable">Unavailable</option>
                                                        <option value="Maintenance">Under Maintenance</option>
                                                        <option value="Out of Order">Out of Order</option>
                                                    </select>
                                                    <span asp-validation-for="AvailabilityStatus" class="text-danger small"></span>
                                                </div>

                                             @*    <div class="col-md-6">
                                                    <label asp-for="RentedFromDate" class="form-label fw-semibold"></label>
                                                    <input asp-for="RentedFromDate" type="date" class="form-control" />
                                                    <span asp-validation-for="RentedFromDate" class="text-danger small"></span>
                                                </div>

                                                <div class="col-md-6">
                                                    <label asp-for="RentedToDate" class="form-label fw-semibold"></label>
                                                    <input asp-for="RentedToDate" type="date" class="form-control" />
                                                    <span asp-validation-for="RentedToDate" class="text-danger small"></span>
                                                </div>
                                            </div> *@
                                        </div>
                                    </div>
                                </div>

                                <!-- Maintenance Information Card -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-none">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0 text-primary">Maintenance Information</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label asp-for="LastMaintenanceDate" class="form-label fw-semibold"></label>
                                                    <input asp-for="LastMaintenanceDate" type="date" class="form-control" />
                                                    <span asp-validation-for="LastMaintenanceDate" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Image Upload Card -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-none">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0 text-primary">Fridge Image</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <label asp-for="ImageUrl" class="form-label fw-semibold">Upload Fridge Image</label>
                                                <input asp-for="ImageUrl" type="file" name="file" class="form-control" accept="image/*" />
                                                <div class="form-text">Upload a clear image of the fridge (JPG, PNG, or GIF)</div>
                                                <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Image Preview and Action Buttons -->
                        <div class="col-md-4">
                            <div class="sticky-top" style="top: 20px;">
                                <!-- Image Preview -->
                                <div class="card border-0 shadow-none mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0 text-primary">Image Preview</h5>
                                    </div>
                                    <div class="card-body text-center">
                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="Fridge image" style="max-height: 250px;" />
                                            <div class="mt-2">
                                                <a href="@Model.ImageUrl" target="_blank" class="btn btn-sm btn-outline-primary mt-2">View Full Image</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-5 bg-light rounded">
                                                <i class="bi bi-camera display-4 text-muted"></i>
                                                <p class="text-muted mt-2">No image uploaded</p>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    @if (Model.FridgeId != 0)
                                    {
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="bi bi-check-circle me-2"></i> Update Fridge
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="bi bi-plus-circle me-2"></i> Create Fridge
                                        </button>
                                    }
                                    <a asp-controller="Fridge" asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-2"></i> Cancel
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Initialize TinyMCE
        tinymce.init({
            selector: 'textarea',
            plugins: 'anchor autolink charmap codesample emoticons lists table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | align lineheight | numlist bullist indent outdent',
            menubar: false,
            statusbar: false,
            height: 200
        });

        // Preview image before upload
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.querySelector('.card-body.text-center img');
                    if (preview) {
                        preview.src = event.target.result;
                    } else {
                        const previewContainer = document.querySelector('.card-body.text-center');
                        previewContainer.innerHTML = `
                            <img src="${event.target.result}" class="img-fluid rounded shadow-sm" alt="Fridge image" style="max-height: 250px;" />
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="this.parentElement.previousElementSibling.src=''">Remove</button>
                            </div>
                        `;
                    }
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}