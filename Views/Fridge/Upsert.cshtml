@section Scripts {
    <script>
        // Initialize TinyMCE
        tinymce.init({
            selector: 'textarea',
            plugins: 'anchor autolink charmap codesample emoticons lists table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | align lineheight | numlist bullist indent outdent',
            menubar: false,
            statusbar: false,
            height: 200
        });

        // Preview image before upload
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const preview = document.querySelector('.card-body.text-center img');
                    if (preview) {
                        preview.src = event.target.result;
                    } else {
                        const previewContainer = document.querySelector('.card-body.text-center');
                        previewContainer.innerHTML = `
                            <img src="${event.target.result}" class="img-fluid rounded shadow-sm" alt="Fridge image" style="max-height: 250px;" />
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="this.parentElement.previousElementSibling.src=''">Remove</button>
                            </div>
                        `;
                    }
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

    @{
        <partial name="_ValidationScriptsPartial" />
    }
} *@