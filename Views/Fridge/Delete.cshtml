@model Project.Models.Fridge
@{
    ViewData["Title"] = "Delete Fridge Model";
    Layout = "_CustomerLayout";
}

<div class="container py-4">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-danger text-white">
            <h4>Delete Confirmation</h4>
        </div>

        <div class="card-body">
            <h5>Are you sure you want to delete this fridge model?</h5>

            <dl class="row mt-3">
                <dt class="col-sm-3">Brand</dt>
                <dd class="col-sm-9">@Model.Brand</dd>

                <dt class="col-sm-3">Model</dt>
                <dd class="col-sm-9">@Model.Model</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="FridgeId" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>