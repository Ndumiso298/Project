@model Fridge

<div class="card shadow border-0 my-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2"> Delete Fridge Permanent</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post">
            <input asp-for="FridgeId" type="hidden" />
            <div class="row">
                <div class="col-10">
                    <div class="border p-3">
                        <div asp-validation-summary="ModelOnly"></div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Brand" class="form-control border-0 shadow" disabled/>
                            <label asp-for="Brand" class="ms-2"></label>
                            <span asp-validation-for="Brand" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="FridgeNo" class="form-control border-0 shadow" disabled />
                            <label asp-for="FridgeNo" class="ms-2"></label>
                            <span asp-validation-for="FridgeNo" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Model" class="form-control border-0 shadow" disabled />
                            <label asp-for="Model" class="ms-2"></label>
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="form-floating py-2 col-12">
                            <input asp-for="CapacityLiters" class="form-control border-0 shadow" disabled />
                            <label asp-for="CapacityLiters" class="ms-2"></label>
                            <span asp-validation-for="CapacityLiters" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Type" class="form-control border-0 shadow" disabled />
                            <label asp-for="Type" class="ms-2"></label>
                            <span asp-validation-for="Type" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <textarea asp-for="Description" class="form-control border-0 shadow" disabled></textarea>
                            <label asp-for="Description" class="ms-2"></label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="RentalPricePerMonth" class="form-control border-0 shadow" disabled />
                            <label asp-for="RentalPricePerMonth" class="ms-2"></label>
                            <span asp-validation-for="RentalPricePerMonth" class="text-danger"></span>
                        </div>
                        @* <div class="form-floating py-2 col-12">
                            <input asp-for="RentedFromDate" class="form-control border-0 shadow" disabled />
                            <label asp-for="RentedFromDate" class="ms-2"></label>
                            <span asp-validation-for="RentedFromDate" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="RentedToDate" class="form-control border-0 shadow" disabled />
                            <label asp-for="RentedToDate" class="ms-2"></label>
                            <span asp-validation-for="RentedToDate" class="text-danger"></span>
                        </div> *@
                        <div class="form-floating py-2 col-12">
                            <input asp-for="LastMaintenanceDate" class="form-control border-0 shadow" disabled />
                            <label asp-for="LastMaintenanceDate" class="ms-2"></label>
                            <span asp-validation-for="LastMaintenanceDate" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="Condition" class="form-control border-0 shadow" disabled />
                            <label asp-for="Condition" class="ms-2"></label>
                            <span asp-validation-for="Condition" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="ImageUrl" class="form-control border-0 shadow" disabled />
                            <label asp-for="ImageUrl" class="ms-2"></label>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input asp-for="AvailabilityStatus" class="form-control border-0 shadow" disabled />
                            <label asp-for="AvailabilityStatus" class="ms-2"></label>
                            <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                        </div>


                        <div class="row pt-2">

                            <div class="col-6 col-md-3">
                                <button type="submit" class="btn btn-danger form-control">Delete</button>
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Fridge" asp-action="Index" class="btn btn-outline-primary border  form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>

                    </div>
                    <div class="col-2">
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>




@section Scripts {
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: 'anchor autolink charmap codesample emoticons  lists   table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough |  align lineheight | numlist bullist indent outdent',
        });
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

