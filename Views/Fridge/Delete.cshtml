@using Project.Utilities.Enums
@model Fridge
@{
    ViewData["Title"] = "Delete Fridge";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title text-danger">
                    <i class="fas fa-trash-alt me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Fridges</a></li>
                        <li class="breadcrumb-item active">Delete</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-exclamation-triangle me-2"></i>Warning</h5>
                        <p class="mb-0">You are about to permanently delete this fridge. This action cannot be undone.</p>
                    </div>

                    <div class="row">
                        <div class="col-md-4 text-center">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="Fridge Image" class="img-fluid rounded" 
                                     style="max-height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="text-muted">
                                    <i class="fas fa-refrigerator fa-4x"></i>
                                    <p class="mt-2">No Image</p>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4">Serial Number:</dt>
                                <dd class="col-sm-8">@Model.SerialNumber</dd>

                                <dt class="col-sm-4">Model:</dt>
                                <dd class="col-sm-8">@Model.Model</dd>

                                <dt class="col-sm-4">Capacity:</dt>
                                <dd class="col-sm-8">@Model.CapacityLiters L</dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @GetStatusBadgeClass(Model.Status)">
                                        @Model.Status
                                    </span>
                                </dd>
@*                                 <dt class="col-sm-4">Monthly Rental:</dt>
                                <dd class="col-sm-8">
                                    @(Model.RentalPricePerMonth.HasValue
                                        ? Model.RentalPricePerMonth.Value.ToString("C")
                                        : "N/A")
                                </dd>
                                <dt class="col-sm-4">Purchase Date:</dt>
                                <dd class="col-sm-8">
                                    @(Model.PurchaseDate.HasValue
                                        ? Model.PurchaseDate.Value.ToString("dd/MM/yyyy")
                                        : "N/A")
                                </dd> *@
                            </dl>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h6>Associated Data That Will Be Affected:</h6>
                        <ul class="text-muted">
                            <li>All allocation records for this fridge</li>
                            <li>Maintenance history</li>
                            <li>Fault reports</li>
                            <li>Customer assignments</li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label for="confirmationText" class="form-label">
                                Type "DELETE" to confirm:
                            </label>
                            <input type="text" id="confirmationText" class="form-control" 
                                   placeholder="Type DELETE here" required 
                                   oninput="toggleDeleteButton(this.value)" />
                        </div>

                        <div class="form-group mt-4">
                            <div class="btn-group" role="group">
                                <button type="submit" id="deleteButton" class="btn btn-danger" disabled>
                                    <i class="fas fa-trash-alt me-1"></i> Confirm Delete
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-times me-1"></i> Cancel
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDeleteButton(input) {
            const deleteButton = document.getElementById('deleteButton');
            deleteButton.disabled = input.toUpperCase() !== 'DELETE';
        }

        // Prevent form submission if not confirmed
        document.querySelector('form').addEventListener('submit', function (e) {
            const confirmationText = document.getElementById('confirmationText').value;
            if (confirmationText.toUpperCase() !== 'DELETE') {
                e.preventDefault();
                alert('Please type "DELETE" to confirm deletion.');
            }
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(FridgeStatus status)
    {
        return status switch
        {
            FridgeStatus.Available => "bg-success",
            FridgeStatus.Allocated => "bg-primary",
            FridgeStatus.InRepair => "bg-warning",
            FridgeStatus.Scrapped => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

