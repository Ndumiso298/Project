@model RequestHeader
@{
    ViewData["Title"] = "Request Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Request Details - #@Model.RequestHeaderId</h6>
                    <div>
                        <a asp-action="BookVisit" asp-route-requestId="@Model.RequestHeaderId"
                           class="btn btn-primary btn-sm">
                            <i class="fas fa-calendar-plus"></i> Schedule Visit
                        </a>
                        <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-primary">Customer Information</h6>
                            <p><strong>Name:</strong> @Model.Customer?.ApplicationUser?.FirstName @Model.Customer?.ApplicationUser?.LastName</p>
                            <p><strong>Contact:</strong> @Model.CellNumber</p>
                            <p><strong>Email:</strong> @Model.Customer?.ApplicationUser?.Email</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary">Request Information</h6>
                            <p><strong>Request Date:</strong> @Model.RequestDate.ToString("MMM dd, yyyy")</p>
                            <p><strong>Status:</strong> <span class="badge badge-success">@Model.Status</span></p>
                            <p><strong>Total Amount:</strong> <span class="h5 text-success">R @Model.RequestTotal.ToString("F2")</span></p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <h6 class="text-primary">Delivery Address</h6>
                            <div class="card">
                                <div class="card-body">
                                    <p class="mb-1">@Model.StreetAddress</p>
                                    <p class="mb-1">@Model.City, @Model.State</p>
                                    <p class="mb-0">@Model.PostalCode</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <h6 class="text-primary">Requested Fridges</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Fridge Model</th>
                                            <th>Brand</th>
                                            <th>Type</th>
                                            <th>Capacity</th>
                                            <th>Quantity</th>
                                            <th>Monthly Price</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var fridgeDetail in Model.RequestFridges)
                                        {
                                            <tr>
                                                <td>@fridgeDetail.Fridge.Model</td>
                                                <td>@fridgeDetail.Fridge.Brand</td>
                                                <td>@fridgeDetail.Fridge.Type</td>
                                                <td>@fridgeDetail.Fridge.CapacityLiters L</td>
                                                <td>@fridgeDetail.Count</td>
                                                <td>R @fridgeDetail.Fridge.RentalPricePerMonth.ToString("F2")</td>
                                                <td>R @((fridgeDetail.Count * fridgeDetail.Fridge.RentalPricePerMonth).ToString("F2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @if (Model.FridgeVisits.Any())
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <h6 class="text-primary">Maintenance History</h6>
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Visit Date</th>
                                                <th>Technician</th>
                                                <th>Status</th>
                                                <th>Customer Approval</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var visit in Model.FridgeVisits)
                                            {
                                                <tr>
                                                    <td>@visit.VisitDate.ToString("MMM dd, yyyy HH:mm")</td>
                                                    <td>@visit.TechnicianName</td>
                                                    <td>
                                                        <span class="badge badge-@(visit.CheckupStatus == "Passed" ? "success" : visit.CheckupStatus == "Failed" ? "danger" : "warning")">
                                                            @visit.CheckupStatus
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge badge-@(visit.CustomerApproval == SD.Approved ? "success" : visit.CustomerApproval == SD.Declined ? "danger" : "warning")">
                                                            @visit.CustomerApproval
                                                        </span>
                                                    </td>
                                                    <td>@visit.Notes</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>