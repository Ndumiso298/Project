@model IEnumerable<Project.Models.RequestHeader>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 text-primary fw-bold mb-2">My Maintenance Bookings</h1>
                    <p class="text-muted mb-0">Manage and track your scheduled refrigerator maintenance appointments</p>
                </div>
                <div class="text-end">
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <div class="fw-semibold text-dark">Total Bookings</div>
                            <span class="badge bg-primary fs-6 p-2">
                                <i class="fas fa-calendar-check me-2"></i>@Model.Count() Active
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Overview -->
    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body">
                        <div class="row text-center">
                            @{
                                var totalVisits = Model.Sum(r => r.FridgeVisits?.Count ?? 0);
                                var approvedVisits = Model.Sum(r => r.FridgeVisits?.Count(v => v.CustomerApproval == SD.Approved) ?? 0);
                                var pendingVisits = Model.Sum(r => r.FridgeVisits?.Count(v => v.CustomerApproval == SD.Pending) ?? 0);
                                var totalFridges = Model.Sum(r => r.RequestFridges.Sum(rf => rf.Count));
                            }
                            <div class="col-md-3 mb-3 mb-md-0">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-refrigerator fa-2x text-primary"></i>
                                    </div>
                                    <div class="text-start">
                                        <h4 class="fw-bold text-dark mb-0">@totalFridges</h4>
                                        <small class="text-muted">Total Fridges</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3 mb-md-0">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="bg-success bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-check-circle fa-2x text-success"></i>
                                    </div>
                                    <div class="text-start">
                                        <h4 class="fw-bold text-dark mb-0">@approvedVisits</h4>
                                        <small class="text-muted">Approved Visits</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3 mb-md-0">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="bg-warning bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-clock fa-2x text-warning"></i>
                                    </div>
                                    <div class="text-start">
                                        <h4 class="fw-bold text-dark mb-0">@pendingVisits</h4>
                                        <small class="text-muted">Pending Approval</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="d-flex align-items-center justify-content-center">
                                    <div class="bg-info bg-opacity-10 rounded p-3 me-3">
                                        <i class="fas fa-calendar-alt fa-2x text-info"></i>
                                    </div>
                                    <div class="text-start">
                                        <h4 class="fw-bold text-dark mb-0">@totalVisits</h4>
                                        <small class="text-muted">Scheduled Visits</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content -->
    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-calendar-plus fa-4x text-primary opacity-25"></i>
                        </div>
                        <h3 class="h5 text-muted mb-3">No Maintenance Bookings</h3>
                        <p class="text-muted mb-4">You haven't scheduled any refrigerator maintenance appointments yet.</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="@Url.Action("Index", "Customer")" class="btn btn-primary px-4">
                                <i class="fas fa-plus me-2"></i>Schedule Service
                            </a>
                            <a href="@Url.Action("Dashboard", "Customer")" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-home me-2"></i>Return to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Bookings List -->
        <div class="row">
            @foreach (var request in Model.OrderByDescending(r => r.RequestDate))
            {
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <!-- Request Header -->
                        <div class="card-header bg-gradient-primary text-white py-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <div class="mb-2 mb-md-0">
                                    <h5 class="card-title mb-1 fw-bold">
                                        <i class="fas fa-clipboard-list me-2"></i>Service Request #@request.RequestHeaderId
                                    </h5>
                                    <small class="opacity-85">
                                        <i class="fas fa-calendar me-1"></i>Created on @request.RequestDate.ToString("MMMM dd, yyyy")
                                        <i class="fas fa-clock ms-3 me-1"></i>@request.RequestDate.ToString("hh:mm tt")
                                    </small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-white text-primary fs-6 p-2">
                                        <i class="fas fa-refrigerator me-1"></i>@request.RequestFridges.Sum(rf => rf.Count) Units
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Equipment Information -->
                            <div class="row mb-4">
                                <div class="col-lg-8">
                                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="fas fa-equipment me-2"></i>Equipment Details
                                    </h6>
                                    <div class="row g-3">
                                        @foreach (var rf in request.RequestFridges)
                                        {
                                            <div class="col-xl-6 col-lg-12">
                                                <div class="card border h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-start">
                                                            <div class="flex-shrink-0">
                                                                <div class="bg-light rounded p-2 me-3" style="width: 60px; height: 60px;">
                                                                    <img src="@(rf.Fridge.ImageUrl ?? "/images/default-fridge.png")"
                                                                         alt="@rf.Fridge.Brand @rf.Fridge.Model"
                                                                         class="img-fluid rounded"
                                                                         onerror="this.src='/images/default-fridge.png'">
                                                                </div>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="fw-bold text-dark mb-1">@rf.Fridge.Brand @rf.Fridge.Model</h6>
                                                                <div class="row small text-muted g-2">
                                                                    <div class="col-12">
                                                                        <i class="fas fa-tag me-1"></i>Type: @rf.Fridge.Type
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <i class="fas fa-layer-group me-1"></i>Quantity: @rf.Count units
                                                                    </div>
                                                                    <div class="col-12">
                                                                        <i class="fas fa-arrows-alt-v me-1"></i>Capacity: @rf.Fridge.CapacityLiters Liters
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Request Summary -->
                                <div class="col-lg-4 mt-4 mt-lg-0">
                                    <div class="card bg-light border-0 h-100">
                                        <div class="card-body">
                                            <h6 class="text-primary mb-3 fw-bold text-center">
                                                <i class="fas fa-chart-pie me-2"></i>Visit Summary
                                            </h6>
                                            <div class="text-center mb-4">
                                                <div class="position-relative d-inline-block">
                                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                                                         style="width: 80px; height: 80px;">
                                                        <i class="fas fa-calendar-check fa-2x text-primary"></i>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row text-center">
                                                <div class="col-6 mb-3">
                                                    <div class="text-success">
                                                        <div class="fw-bold fs-4">@request.FridgeVisits?.Count(v => v.CustomerApproval == SD.Approved)</div>
                                                        <small class="text-muted">Confirmed</small>
                                                    </div>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <div class="text-warning">
                                                        <div class="fw-bold fs-4">@request.FridgeVisits?.Count(v => v.CustomerApproval == SD.Pending)</div>
                                                        <small class="text-muted">Pending</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="text-center mt-3">
                                                <small class="text-muted">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Total visits: @request.FridgeVisits?.Count
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Maintenance Schedule -->
                            <div class="mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold text-primary mb-0">
                                        <i class="fas fa-calendar-alt me-2"></i>Scheduled Maintenance Visits
                                    </h6>
                                    <small class="text-muted">
                                        @request.FridgeVisits?.Count(v => v.CustomerApproval == SD.Pending) awaiting your approval
                                    </small>
                                </div>

                                @if (request.FridgeVisits != null && request.FridgeVisits.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var visit in request.FridgeVisits.OrderBy(v => v.VisitDate))
                                        {
                                            <div class="col-12">
                                                <div class="card border">
                                                    <div class="card-body">
                                                        <div class="row align-items-center">
                                                            <!-- Visit Date -->
                                                            <div class="col-md-3 mb-3 mb-md-0">
                                                                <div class="text-center text-md-start">
                                                                    <div class="d-flex align-items-center justify-content-center justify-content-md-start">
                                                                        <div class="bg-primary bg-opacity-10 rounded p-2 me-3">
                                                                            <i class="fas fa-calendar-day fa-xl text-primary"></i>
                                                                        </div>
                                                                        <div>
                                                                            <h6 class="fw-bold text-dark mb-1">@visit.VisitDate.ToString("MMMM dd, yyyy")</h6>
                                                                            <small class="text-muted">
                                                                                <i class="fas fa-clock me-1"></i>@visit.VisitDate.ToString("hh:mm tt")
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Status -->
                                                            <div class="col-md-3 mb-3 mb-md-0">
                                                                <div class="d-flex align-items-center justify-content-center justify-content-md-start h-100">
                                                                    <div class="flex-shrink-0">
                                                                        <div class="@GetStatusIconContainerClass(visit.CustomerApproval) rounded-circle d-flex align-items-center justify-content-center me-3"
                                                                             style="width: 50px; height: 50px;">
                                                                            <i class="@GetApprovalIcon(visit.CustomerApproval) fa-lg"></i>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="fw-bold mb-1">Visit Status</h6>
                                                                        <span class="badge @GetApprovalBadgeClass(visit.CustomerApproval) py-2 px-3">
                                                                            @visit.CustomerApproval
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Actions -->
                                                            <div class="col-md-6">
                                                                @if (visit.CustomerApproval == SD.Pending)
                                                                {
                                                                    <div class="text-center text-md-end">
                                                                        <h6 class="fw-bold text-warning mb-3">Confirmation Required</h6>
                                                                        <div class="d-flex justify-content-center justify-content-md-end gap-2 flex-wrap">
                                                                            <form asp-action="ApproveVisit" method="post" class="d-inline">
                                                                                <input type="hidden" name="visitId" value="@visit.VisitId" />
                                                                                <button type="submit"
                                                                                        class="btn btn-success px-4"
                                                                                        onclick="return confirm('Are you sure you want to approve this maintenance visit?')">
                                                                                    <i class="fas fa-check me-2"></i>Confirm Visit
                                                                                </button>
                                                                            </form>
                                                                            <form asp-action="DeclineVisit" method="post" class="d-inline">
                                                                                <input type="hidden" name="visitId" value="@visit.VisitId" />
                                                                                <button type="submit"
                                                                                        class="btn btn-outline-danger px-4"
                                                                                        onclick="return confirm('Are you sure you want to decline this maintenance visit?')">
                                                                                    <i class="fas fa-times me-2"></i>Decline Visit
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                        <small class="text-muted mt-2 d-block">
                                                                            Please respond within 24 hours
                                                                        </small>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-center">
                                                                        <div class="bg-light rounded p-3">
                                                                            <i class="@GetApprovalIcon(visit.CustomerApproval) fa-2x @GetStatusTextClass(visit.CustomerApproval) mb-2"></i>
                                                                            <h6 class="fw-bold mb-1 @GetStatusTextClass(visit.CustomerApproval)">@visit.CustomerApproval</h6>
                                                                            <small class="text-muted">
                                                                                @(visit.CustomerApproval == SD.Approved ? "Visit confirmed and scheduled" : "Visit has been declined")
                                                                            </small>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                        <h6 class="text-muted mb-2">No Visits Scheduled</h6>
                                        <p class="text-muted small">Maintenance visits will be scheduled by our service team shortly.</p>
                                        <a href="@Url.Action("Contact", "Customer")" class="btn btn-outline-primary btn-sm mt-2">
                                            <i class="fas fa-phone me-2"></i>Contact Support
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="card-footer bg-light py-3">
                            <div class="row align-items-center">
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Request ID: @request.RequestHeaderId • Created: @request.RequestDate.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <small class="text-muted">
                                        Last updated: @DateTime.Now.ToString("MMM dd, yyyy hh:mm tt")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    public string GetApprovalBadgeClass(string approvalStatus)
    {
        return approvalStatus switch
        {
            SD.Approved => "bg-success text-white",
            SD.Pending => "bg-warning text-dark",
            SD.Declined => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    public string GetApprovalIcon(string approvalStatus)
    {
        return approvalStatus switch
        {
            SD.Approved => "fas fa-check-circle text-success",
            SD.Pending => "fas fa-clock text-warning",
            SD.Declined => "fas fa-times-circle text-danger",
            _ => "fas fa-question-circle text-secondary"
        };
    }

    public string GetStatusIconContainerClass(string approvalStatus)
    {
        return approvalStatus switch
        {
            SD.Approved => "bg-success bg-opacity-10",
            SD.Pending => "bg-warning bg-opacity-10",
            SD.Declined => "bg-danger bg-opacity-10",
            _ => "bg-secondary bg-opacity-10"
        };
    }

    public string GetStatusTextClass(string approvalStatus)
    {
        return approvalStatus switch
        {
            SD.Approved => "text-success",
            SD.Pending => "text-warning",
            SD.Declined => "text-danger",
            _ => "text-secondary"
        };
    }
}

@section Styles {
    <style>
        .bg-gradient-primary {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        }

        .card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            border: 1px solid #e3e6f0;
        }

            .card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
            }

        .border {
            border: 1px solid #e3e6f0 !important;
        }

        .bg-light {
            background-color: #f8f9fc !important;
        }

        .text-primary {
            color: #007bff !important;
        }

        .btn {
            border-radius: 0.375rem;
            font-weight: 500;
        }

        .badge {
            font-weight: 600;
            border-radius: 0.375rem;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling for better UX
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });

            // Enhance form submissions with loading states
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function() {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
                        submitBtn.disabled = true;
                    }
                });
            });

            // Add animation to cards on scroll
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.card').forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                observer.observe(card);
            });
        });
    </script>
}