@model IEnumerable<Project.Models.RequestHeader>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 text-primary fw-bold mb-2">My Allocated Fridge Bookings</h1>
                    <p class="text-muted mb-0">Manage and track your scheduled refrigerator maintenance visits</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary-subtle text-primary fs-6 p-2">
                        <i class="fas fa-refrigerator me-2"></i>@Model.Count() Bookings
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="fas fa-snowflake fa-4x text-info opacity-25"></i>
                        </div>
                        <h3 class="h5 text-muted mb-3">No Allocated Bookings</h3>
                        <p class="text-muted mb-4">You don't have any allocated fridge bookings at the moment.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a href="@Url.Action("Index", "Customer")" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i>Request Service
                            </a>
                            <a href="@Url.Action("Dashboard", "Customer")" class="btn btn-outline-secondary">
                                <i class="fas fa-home me-2"></i>Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var request in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-header bg-gradient-primary text-white py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="card-title mb-0 fw-bold">
                                        <i class="fas fa-clipboard-list me-2"></i>Request #@request.RequestHeaderId
                                    </h5>
                                    <small class="opacity-75">
                                        <i class="fas fa-calendar me-1"></i>Created @request.RequestDate.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <span class="badge bg-white text-primary fs-6 p-2">
                                    <i class="fas fa-clock me-1"></i>@request.RequestFridges.Sum(rf => rf.Count) Fridges
                                </span>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- Fridge Details Section -->
                            <div class="row mb-4">
                                <div class="col-md-8">
                                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                        <i class="fas fa-refrigerator me-2"></i>Fridge Details
                                    </h6>
                                    <div class="row g-3">
                                        @foreach (var rf in request.RequestFridges)
                                        {
                                            <div class="col-lg-6">
                                                <div class="card border h-100">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-start">
                                                            <div class="flex-shrink-0">
                                                                <div class="bg-light rounded p-2 me-3" style="width: 50px; height: 50px;">
                                                                    <img src="@(rf.Fridge.ImageUrl ?? "/images/default-fridge.png")"
                                                                         alt="@rf.Fridge.Brand"
                                                                         class="img-fluid"
                                                                         onerror="this.src='/images/default-fridge.png'">
                                                                </div>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <h6 class="fw-bold text-dark mb-1">@rf.Fridge.Brand @rf.Fridge.Model</h6>
                                                                <p class="text-muted small mb-1">
                                                                    <i class="fas fa-tag me-1"></i>@rf.Fridge.Type
                                                                </p>
                                                                <p class="text-muted small mb-0">
                                                                    <i class="fas fa-layer-group me-1"></i>Quantity: @rf.Count
                                                                </p>
                                                              @*   @if (!string.IsNullOrEmpty(rf.Fridge.Capacity))
                                                                {
                                                                    <p class="text-muted small mb-0">
                                                                        <i class="fas fa-arrows-alt-v me-1"></i>Capacity: @rf.Fridge.Capacity
                                                                    </p>
                                                                } *@
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card bg-light border-0 h-100">
                                        <div class="card-body text-center">
                                            <h6 class="text-primary mb-3 fw-bold">Request Overview</h6>
                                            <div class="mb-3">
                                                <i class="fas fa-calendar-check fa-2x text-success mb-2"></i>
                                                <h5 class="fw-bold text-dark">@request.FridgeVisits?.Count(v => v.CustomerApproval == SD.Approved) Approved</h5>
                                                <small class="text-muted">Confirmed Visits</small>
                                            </div>
                                            <div class="mb-3">
                                                <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                                                <h5 class="fw-bold text-dark">@request.FridgeVisits?.Count(v => v.CustomerApproval == SD.Pending) Pending</h5>
                                                <small class="text-muted">Awaiting Approval</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Booked Visits Section -->
                            <div class="mt-4">
                                <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">
                                    <i class="fas fa-calendar-alt me-2"></i>Scheduled Maintenance Visits
                                </h6>

                                @if (request.FridgeVisits != null && request.FridgeVisits.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var visit in request.FridgeVisits)
                                        {
                                            <div class="col-12">
                                                <div class="card border">
                                                    <div class="card-body">
                                                        <div class="row align-items-center">
                                                            <div class="col-md-3">
                                                                <div class="text-center">
                                                                    <div class="bg-primary bg-opacity-10 rounded p-3 mb-2">
                                                                        <i class="fas fa-calendar-day fa-2x text-primary"></i>
                                                                    </div>
                                                                    <h6 class="fw-bold text-primary mb-1">@visit.VisitDate.ToString("MMM dd, yyyy")</h6>
                                                                    <small class="text-muted">@visit.VisitDate.ToString("hh:mm tt")</small>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-4">
                                                                <div class="d-flex align-items-center h-100">
                                                                    <div class="flex-shrink-0">
                                                                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3"
                                                                             style="width: 50px; height: 50px;">
                                                                            <i class="fas fa-user-cog text-success"></i>
                                                                        </div>
                                                                    </div>
                                                                    <div class="flex-grow-1">
                                                                        <h6 class="fw-bold mb-1">Booking Status</h6>
                                                                        <span class="badge @GetApprovalBadgeClass(visit.CustomerApproval) py-2 px-3">
                                                                            <i class="@GetApprovalIcon(visit.CustomerApproval) me-1"></i>@visit.CustomerApproval
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <div class="col-md-5">
                                                                @if (visit.CustomerApproval == SD.Pending)
                                                                {
                                                                    <div class="text-end">
                                                                        <h6 class="fw-bold text-warning mb-2">Action Required</h6>
                                                                        <div class="btn-group" role="group">
                                                                            <form asp-action="ApproveVisit" method="post" class="d-inline">
                                                                                <input type="hidden" name="visitId" value="@visit.VisitId" />
                                                                                <button type="submit"
                                                                                        class="btn btn-success px-4"
                                                                                        onclick="return confirm('Are you sure you want to approve this visit?')">
                                                                                    <i class="fas fa-check me-2"></i>Approve
                                                                                </button>
                                                                            </form>
                                                                            <form asp-action="DeclineVisit" method="post" class="d-inline">
                                                                                <input type="hidden" name="visitId" value="@visit.VisitId" />
                                                                                <button type="submit"
                                                                                        class="btn btn-outline-danger px-4 ms-2"
                                                                                        onclick="return confirm('Are you sure you want to decline this visit?')">
                                                                                    <i class="fas fa-times me-2"></i>Decline
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-center">
                                                                        <div class="bg-light rounded p-3">
                                                                            <i class="fas @(visit.CustomerApproval == SD.Approved ? "fa-check-circle text-success" : "fa-times-circle text-danger") fa-2x mb-2"></i>
                                                                            <h6 class="fw-bold mb-1">@visit.CustomerApproval</h6>
                                                                            <small class="text-muted">@(visit.CustomerApproval == SD.Approved ? "Visit confirmed" : "Visit declined")</small>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-4">
                                        <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                        <h6 class="text-muted mb-2">No Visits Scheduled</h6>
                                        <p class="text-muted small">Maintenance visits will be scheduled soon by our team.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    public string GetApprovalBadgeClass(string approvalStatus)
    {
        return approvalStatus switch
        {
            "Approved" => "bg-success text-white",
            "Pending" => "bg-warning text-dark",
            "Declined" => "bg-danger text-white",
            _ => "bg-secondary text-white"
        };
    }

    public string GetApprovalIcon(string approvalStatus)
    {
        return approvalStatus switch
        {
            "Approved" => "fas fa-check-circle",
            "Pending" => "fas fa-clock",
            "Declined" => "fas fa-times-circle",
            _ => "fas fa-question-circle"
        };
    }
}

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
    }

    .card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
        }

    .border {
        border: 1px solid #e3e6f0 !important;
    }
</style>