@model IEnumerable<Project.Models.RequestHeader>

@{
    ViewData["Title"] = "My Bookings";
    Layout = "_CustomerLayout";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary fw-bold">My Allocated Fridge Bookings</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> You don’t have any allocated fridge bookings yet.
        </div>
    }
    else
    {
        foreach (var request in Model)
        {
            <div class="card mb-4 shadow-sm rounded-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    Fridge Checkups
                </div>
                <div class="card-body">
                    <h6 class="fw-bold">Fridges</h6>
                    <ul>
                        @foreach (var rf in request.RequestFridges)
                        {
                            <li>
                                <i class="fas fa-snowflake text-info"></i>
                                @rf.Fridge.Brand - @rf.Fridge.Type (@rf.Fridge.Brand)
                            </li>
                        }
                    </ul>

                    <h6 class="fw-bold mt-3">Booked Visits</h6>
                    @if (request.FridgeVisits != null && request.FridgeVisits.Any())
                    {
                        <ul>
                            @foreach (var visit in request.FridgeVisits)
                            {
                                <li class="mb-3">
                                    <i class="fas fa-calendar-check text-success"></i>
                                    Visit on <strong>@visit.VisitDate.ToString("dd MMM yyyy HH:mm")</strong>
                                    <br />
                                    <strong>Please Confirm Booking:</strong> @visit.CustomerApproval
                                    

                                    @* Approve/Decline buttons for Pending customer approval *@
                                    @if (visit.CustomerApproval == SD.Pending)
                                    {
                                        <form asp-action="ApproveVisit" method="post" style="display:inline">
                                            <input type="hidden" name="visitId" value="@visit.VisitId" />
                                            <button type="submit" class="btn btn-success btn-sm ms-2">Approve</button>
                                        </form>

                                        <form asp-action="DeclineVisit" method="post" style="display:inline">
                                            <input type="hidden" name="visitId" value="@visit.VisitId" />
                                            <button type="submit" class="btn btn-danger btn-sm ms-1">Decline</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted"><i class="fas fa-calendar-times"></i> No visits booked yet.</p>
                    }
                </div>
            </div>
        }
    }
</div>
