@model IEnumerable<Project.Models.AllocationRequestHeader>
@{
    Layout = "_CustomerLayout";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">Allocated Fridges</h2>
                    <p class="text-muted">View all fridges that have been allocated to customers</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 font-weight-bold text-primary">Allocated Request List</h5>

            <!-- Search Box -->
            <input type="text" id="allocatedSearch" class="form-control form-control-sm w-25 ms-auto"
                   placeholder="Search requests...">
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="allocatedTable">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Customer Name</th>
                            <th scope="col">Customer Surname</th>
                            <th scope="col">Request Date</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                        {
                            <tr>
                                <td class="ps-4 fw-semibold align-middle">@item.Customer.UserAccount?.FirstName</td>
                                <td class="align-middle">@item.Customer.UserAccount?.LastName</td>
                                <td class="align-middle">@item.RequestDate.ToString("yyyy-MM-dd")</td>
                                <t class="align-middle">
                                    @* Show allocated fridge details *@
                                    @if (item.Allocations != null && item.Allocations.Any())
                                    {
                                        @foreach (var allocation in item.Allocations)
                                        {
                                            <div class="mb-1 p-1 border rounded bg-light">
                                                <strong>Fridge No:</strong> @allocation.Fridge.SerialNumber <br />
                                                <strong>Type:</strong> @allocation.Fridge.Type<br />
                                                <strong>Brand:</strong> @allocation.Fridge.Manufacturer<br />
                                            </div>
                                        }
                                    }
                                </t>
                                <td class="text-end pe-4 align-middle">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary rounded d-flex align-items-center">
                                        <i class="bi bi-eye me-1"></i> View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-refrigerator display-1 text-muted"></i>
                        <h4 class="mt-3 text-muted">No Allocated Requests</h4>
                        <p class="text-muted">Allocated fridges will appear here once assigned to customers</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('allocatedSearch');
            const rows = document.querySelectorAll('#allocatedTable tbody tr');

            searchInput.addEventListener('keyup', function () {
                const searchText = this.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });
    </script>
}
