@model IEnumerable<Project.Models.RequestHeader>
@{
    Layout = "_CustomerLayout";
}

 
 
        <!-- Main Card -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
                <h5 class="m-0 text-primary">
                    <i class="fas fa-list me-2"></i>Allocated Request List
                </h5>

                <!-- Search Box -->
                <div class="input-group search-container" style="max-width: 300px;">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="allocatedSearch" class="form-control search-box border-start-0"
                           placeholder="Search requests...">
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="allocatedTable">
                        <thead>
                            <tr>
                                <th scope="col" class="ps-4">Customer</th>
                                <th scope="col">Request Date</th>
                                <th scope="col">Visit Status</th>
                                <th scope="col">Allocated Fridges</th>
                                <th scope="col" class="text-end pe-4 action-cell">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                            {
                                <tr>
                                    <td class="ps-4 align-middle">
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold">@item.Customer.ApplicationUser?.FirstName @item.Customer.ApplicationUser?.LastName</span>
                                            <small class="text-muted">@item.Customer.ApplicationUser?.Email</small>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <span class="fw-medium">@item.RequestDate.ToString("yyyy-MM-dd")</span>
                                    </td>

                                    <!-- Visit Status -->
                                    <td class="align-middle">
                                        @if (item.FridgeVisits != null && item.FridgeVisits.Any())
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var visit in item.FridgeVisits.OrderBy(v => v.VisitDate))
                                                {
                                                    <div class="d-flex align-items-center">
                                                        <span class="badge bg-success status-badge me-2">
                                                            <i class="fas fa-calendar me-1"></i> @visit.VisitDate.ToString("yyyy-MM-dd")
                                                        </span>
                                                        <a asp-action="BookVisit"
                                                           asp-route-requestId="@item.RequestHeaderId"
                                                           asp-route-visitId="@visit.VisitId"
                                                           class="btn btn-sm btn-outline-warning rounded-pill d-inline-flex align-items-center">
                                                            <i class="fas fa-edit me-1"></i> Edit
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark status-badge">
                                                <i class="fas fa-clock me-1"></i> No Visit Booked
                                            </span>
                                        }
                                    </td>

                                   
                                    <!-- Actions -->
                                    <td class="text-end pe-4 align-middle">
                                        <div class="d-flex flex-column gap-2">
                                    <a asp-action="DetailsFoRProcessing" asp-route-id="@item.RequestHeaderId"
                                       class="btn btn-sm btn-outline-primary rounded-pill d-flex align-items-center justify-content-center">
                                        <i class="fas fa-snowflake me-1"></i>
                                        Fridge Details
                                    </a>


                                            <!-- Add new visit button -->
                                            <a asp-action="BookVisit" asp-route-requestId="@item.RequestHeaderId"
                                               class="btn btn-sm btn-outline-success rounded-pill d-flex align-items-center justify-content-center">
                                                <i class="fas fa-calendar-plus me-1"></i> Book Visit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (!Model.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-refrigerator"></i>
                            <h4 class="mt-3">No Allocated Requests</h4>
                            <p>Allocated fridges will appear here once assigned to customers</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('allocatedSearch');
            const rows = document.querySelectorAll('#allocatedTable tbody tr');

            searchInput.addEventListener('keyup', function () {
                const searchText = this.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchText) ? '' : 'none';
                });
            });
        });
    </script>
