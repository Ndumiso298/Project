@model List<RequestHeader>
@{
    ViewData["Title"] = "Allocated Fridges";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Allocated Fridges Management</h6>
                    <div>
                        <a asp-action="Calendar" class="btn btn-info btn-sm">
                            <i class="fas fa-calendar"></i> View Calendar
                        </a>
                        <a asp-action="Completed" class="btn btn-success btn-sm">
                            <i class="fas fa-check-circle"></i> Completed Visits
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Request ID</th>
                                        <th>Customer</th>
                                        <th>Request Date</th>
                                        <th>Fridges</th>
                                        <th>Total Amount</th>
                                        <th>Visits Scheduled</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model)
                                    {
                                        <tr>
                                            <td>@request.RequestHeaderId</td>
                                            <td>@request.Customer?.ApplicationUser?.FirstName @request.Customer?.ApplicationUser?.LastName</td>
                                            <td>@request.RequestDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                @foreach (var fridge in request.RequestFridges)
                                                {
                                                    <span class="badge badge-primary">@fridge.Fridge.Model (x@(fridge.Count))</span>
                                                }
                                            </td>
                                            <td>R @request.RequestTotal.ToString("F2")</td>
                                            <td>
                                                <span class="badge badge-@(request.FridgeVisits.Any() ? "success" : "warning")">
                                                    @request.FridgeVisits.Count visits
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="DetailsFoRProcessing" asp-route-id="@request.RequestHeaderId"
                                                       class="btn btn-info btn-sm" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="BookVisit" asp-route-requestId="@request.RequestHeaderId"
                                                       class="btn btn-primary btn-sm" title="Schedule Visit">
                                                        <i class="fas fa-calendar-plus"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-refrigerator fa-3x text-gray-300 mb-3"></i>
                            <p class="text-muted">No allocated fridges found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>