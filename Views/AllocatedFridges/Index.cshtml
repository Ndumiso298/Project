@model IEnumerable<Project.Models.RequestHeader>

@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-primary text-light py-4 text-center">
                <h2 class="fw-bold text-white mb-0">Allocated Requests</h2>
                <p class="opacity-75 mb-0">Manage customer fridge allocations and service visits</p>
            </div>

            <div class="card-body p-4 p-md-5">

                <!-- Search Bar -->
                <div class="row mb-4 justify-content-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="allocatedSearch"
                                   class="form-control border-start-0 rounded-pill"
                                   placeholder="Search customers, fridges...">
                        </div>
                    </div>
                </div>

                <div id="requestsContainer">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model.OrderByDescending(r => r.RequestDate))
                        {
                            <div class="bg-primary text-white rounded-top-4 px-4 py-3 shadow-sm">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0">
                                        <i class="bi bi-person-circle me-2"></i>
                                        @item.Customer.ApplicationUser?.FirstName @item.Customer.ApplicationUser?.LastName
                                    </h5>
                                </div>
                            </div>

                            <div class="border-bottom pb-4 mb-5 request-card bg-white rounded-bottom-4 shadow-sm"
                                 data-searchable="@($"{item.Customer.ApplicationUser?.FirstName} {item.Customer.ApplicationUser?.LastName} {item.Customer.ApplicationUser?.Email} {item.RequestFridges?.FirstOrDefault()?.Fridge?.Brand} {item.RequestFridges?.FirstOrDefault()?.Fridge?.Model}")">

                                <!-- Request Info -->
                                <div class="row align-items-center mb-3 mt-3 px-3">
                                    <div class="col-md-8">
                                        <p class="text-muted small mb-0">
                                            <i class="bi bi-envelope"></i> @item.Customer.ApplicationUser?.Email &nbsp; | &nbsp;
                                            <i class="bi bi-telephone"></i> @item.Customer.ApplicationUser?.CellNumber
                                        </p>
                                    </div>
                                    <div class="col-md-4 text-md-end text-muted small">
                                        <div>@item.RequestDate.ToString("MMM dd, yyyy")</div>
                                        <div>@item.RequestDate.ToString("hh:mm tt")</div>
                                    </div>
                                </div>

                                <!-- Allocated Fridges -->
                                <div class="bg-light rounded-4 p-3 mb-3 mx-3">
                                    <h6 class="fw-semibold text-dark mb-3">
                                        <i class="bi bi-snow me-2"></i>Allocated Fridges
                                        <span class="badge bg-primary ms-2">@item.RequestFridges?.Count()</span>
                                    </h6>

                                    @if (item.RequestFridges != null && item.RequestFridges.Any())
                                    {
                                        <div class="row">
                                            @foreach (var fridge in item.RequestFridges)
                                            {
                                                <div class="col-md-4 mb-3">
                                                    <div class="card h-100 shadow-sm border-0 rounded-3">
                                                        <div class="card-body text-center">
                                                            <h6 class="fw-bold text-primary mb-1">@fridge.Fridge?.Brand</h6>
                                                            <p class="small text-muted mb-1">
                                                                Model: @fridge.Fridge?.Model<br />
                                                                Capacity: @fridge.Fridge?.CapacityLiters L
                                                            </p>

                                                            <!-- Fridge In Stock -->
                                                            @if (fridge.CustomerFridges != null && fridge.CustomerFridges.Any())
                                                            {
                                                                @foreach (var cf in fridge.CustomerFridges)
                                                                {
                                                                    <div class="mt-2">
                                                                        <span class="badge bg-success rounded-pill px-3 py-2">
                                                                            <i class="bi bi-upc-scan me-1"></i>
                                                                            Fridge No: @cf.FridgeInStock?.FridgeNo
                                                                        </span>
                                                                    </div>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <div class="mt-2">
                                                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                                                        No Fridge Number Assigned
                                                                    </span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info text-center rounded-pill py-2">
                                            <i class="bi bi-exclamation-triangle me-1"></i>No fridges allocated
                                        </div>
                                    }
                                </div>

                                <!-- Service Status -->
                                <div class="bg-light rounded-4 p-3 mb-3 mx-3">
                                    <h6 class="fw-semibold text-dark mb-3">
                                        <i class="bi bi-calendar-check me-2"></i>Service Status
                                    </h6>

                                    @if (item.FridgeVisits != null && item.FridgeVisits.Any())
                                    {
                                        var upcomingVisits = item.FridgeVisits
                                        .Where(v => v.VisitDate >= DateTime.Now)
                                        .OrderBy(v => v.VisitDate)
                                        .ToList();

                                        var pastVisits = item.FridgeVisits
                                        .Where(v => v.VisitDate < DateTime.Now)
                                        .ToList();

                                        foreach (var visit in upcomingVisits)
                                        {
                                            <div class="mb-3 p-2 border rounded-3">
                                                <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center">
                                                    <span class="badge bg-success rounded-pill px-3 py-2 me-md-3 mb-2 mb-md-0">
                                                        <i class="bi bi-calendar-event me-1"></i>Upcoming Visit
                                                    </span>
                                                    <span class="text-dark">@visit.VisitDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</span>
                                                </div>
                                                <div class="mt-1 small text-muted">
                                                    <i class="bi bi-person-fill text-primary me-1"></i>@visit.TechnicianName
                                                    @if (!string.IsNullOrEmpty(visit.Notes))
                                                    {
                                                        <div><i class="bi bi-journal-text me-1"></i>@visit.Notes</div>
                                                    }
                                                </div>
                                                <div class="mt-1">
                                                    <strong>Awaiting Confirmation:</strong> @visit.CustomerApproval
                                                </div>
                                            </div>
                                        }

                                        if (!upcomingVisits.Any() && pastVisits.Any())
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>Service Completed (@pastVisits.Count)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                            <i class="bi bi-clock me-1"></i>No Visit Scheduled
                                        </span>
                                    }
                                </div>

                                <!-- Actions -->
                                <div class="d-flex flex-wrap gap-2 justify-content-md-end mt-3 px-3">
                                    <a asp-action="DetailsFoRProcessing" asp-route-id="@item.RequestHeaderId"
                                       class="btn btn-outline-primary rounded-pill px-4">
                                        <i class="bi bi-snow"></i> Fridge Details
                                    </a>
                                    <a asp-action="BookVisit" asp-route-requestId="@item.RequestHeaderId"
                                       class="btn btn-outline-success rounded-pill px-4">
                                        <i class="bi bi-calendar-plus"></i> Book Visit
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center rounded-3 shadow-sm py-5">
                            <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
                            No allocated requests yet.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('allocatedSearch');
            const requestCards = document.querySelectorAll('.request-card');

            searchInput.addEventListener('keyup', function () {
                const searchText = this.value.toLowerCase();
                requestCards.forEach(card => {
                    const searchableText = card.getAttribute('data-searchable').toLowerCase();
                    card.style.display = searchableText.includes(searchText) ? 'block' : 'none';
                });
            });
        });
    </script>
}
