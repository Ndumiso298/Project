@model IEnumerable<Project.Models.FridgeVisit>
@{
    Layout = "_CustomerLayout";
}
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --success-color: #2ecc71;
            --warning-color: #f39c12;
            --light-bg: #f8f9fa;
            --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --border-radius: 10px;
        }
        
        body {
            background-color: #f5f7f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            padding-bottom: 2rem;
        }
        
        .header-container {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 1.5rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 var(--border-radius) var(--border-radius);
        }
        
        .calendar-container {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            overflow: hidden;
            margin-bottom: 2rem;
        }
        
        .calendar-header {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.2rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .calendar-nav-btn {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }
        
        .calendar-nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }
        
        .view-options {
            display: flex;
            gap: 0.5rem;
        }
        
        .view-option {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        
        .view-option.active {
            background: rgba(255, 255, 255, 0.4);
        }
        
        .view-option:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        .weekdays {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            background-color: #f0f3f5;
            font-weight: 600;
            color: var(--primary-color);
        }
        
        .weekdays div {
            padding: 1rem;
            text-align: center;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .days {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            grid-gap: 1px;
            background-color: #e0e0e0;
        }
        
        .day {
            min-height: 120px;
            background: white;
            padding: 0.5rem;
            position: relative;
            transition: all 0.3s;
        }
        
        .day:hover {
            background: #f9f9f9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
            z-index: 1;
        }
        
        .day-number {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #333;
        }
        
        .other-month {
            background-color: #f8f9fa;
            color: #adb5bd;
        }
        
        .today .day-number {
            background: var(--secondary-color);
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .event {
            background: #e8f4fc;
            border-left: 3px solid var(--secondary-color);
            padding: 0.4rem 0.6rem;
            margin-bottom: 0.4rem;
            border-radius: 4px;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .event:hover {
            background: #d4eafc;
            transform: translateX(2px);
        }
        
        .event-dot {
            height: 10px;
            width: 10px;
            background-color: var(--secondary-color);
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }
        
        .event-type-1 {
            border-left-color: #3498db;
            background: #e8f4fc;
        }
        
        .event-type-2 {
            border-left-color: #2ecc71;
            background: #eafaf1;
        }
        
        .event-type-3 {
            border-left-color: #e74c3c;
            background: #fdedec;
        }
        
        .event-type-4 {
            border-left-color: #f39c12;
            background: #fef5e7;
        }
        
        .more-events {
            font-size: 0.8rem;
            color: var(--secondary-color);
            cursor: pointer;
            margin-top: 0.2rem;
        }
        
        .legend {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .stat-card {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            padding: 1.5rem;
            text-align: center;
        }
        
        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }
        
        .stat-label {
            color: #6c757d;
            font-size: 0.9rem;
        }

    .day {
        min-height: 120px;
        background: white;
        padding: 0.5rem;
        position: relative;
        transition: all 0.3s;
    }

        .day:hover {
            background: #f9f9f9;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
            z-index: 1;
        }

    .day-number {
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .event {
        background: #e8f4fc;
        border-left: 3px solid var(--secondary-color);
        padding: 0.4rem 0.6rem;
        margin-bottom: 0.4rem;
        border-radius: 4px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .event:hover {
            background: #d4eafc;
            transform: translateX(2px);
        }

    .weekdays div {
        padding: 1rem;
        text-align: center;
        border-bottom: 1px solid #e0e0e0;
    }

    .calendar-header {
        background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
        color: white;
        padding: 1.2rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    </style>

    <div class="header-container">
        <div class="container">
            <div class="d-flex align-items-center">
                <div class="icon-container me-3 bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-calendar-alt fa-lg text-white"></i>
                </div>
                <div>
                    <h1 class="h3 mb-0">Fridge Visit Calendar</h1>
                    <p class="mb-0 opacity-75">View all scheduled fridge maintenance visits</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="stats-container">
            <div class="stat-card">
                <div class="stat-number">@Model.Count()</div>
                <div class="stat-label">Total Visits</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Count(v => v.VisitDate.Date == DateTime.Today)</div>
                <div class="stat-label">Visits Today</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.Count(v => v.VisitDate.Date > DateTime.Today)</div>
                <div class="stat-label">Upcoming Visits</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">@Model.GroupBy(v => v.TechnicianName).Count()</div>
                <div class="stat-label">Technicians</div>
            </div>
        </div>

        <div class="calendar-container">
            <div class="calendar-header">
                <button class="calendar-nav-btn" id="prevMonth">
                    <i class="fas fa-chevron-left"></i>
                </button>
                
                <div class="d-flex flex-column align-items-center">
                    <h4 class="mb-0" id="monthTitle"></h4>
                    <div class="view-options mt-2">
                        <button class="view-option active" data-view="month">Month</button>
                        <button class="view-option" data-view="week">Week</button>
                        <button class="view-option" data-view="day">Day</button>
                    </div>
                </div>
                
                <button class="calendar-nav-btn" id="nextMonth">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>

            <div class="weekdays">
                <div>Sun</div>
                <div>Mon</div>
                <div>Tue</div>
                <div>Wed</div>
                <div>Thu</div>
                <div>Fri</div>
                <div>Sat</div>
            </div>

            <div class="days" id="calendarDays">
            </div>
        </div>

        <!-- Legend -->
        <div class="legend">
            <h5 class="mb-3">Event Legend</h5>
            <div class="d-flex flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <span class="event-dot" style="background-color: #3498db;"></span>
                    <span class="ms-2">Installation Visits</span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="event-dot" style="background-color: #2ecc71;"></span>
                    <span class="ms-2">Maintenance Visits</span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="event-dot" style="background-color: #e74c3c;"></span>
                    <span class="ms-2">Repair Visits</span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="event-dot" style="background-color: #f39c12;"></span>
                    <span class="ms-2">Inspection Visits</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Modal -->
    <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Visit Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="eventDetails">
                    <!-- Event details will be populated by JavaScript -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Edit Visit</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sample data - in a real application, this would come from your server
        const fridgeVisits = [
            @foreach (var visit in Model)
            {
                <text>
                {
                    id: @visit.VisitId,
                    date: new Date('@visit.VisitDate.ToString("yyyy-MM-dd")'),
                    customer: '@visit.RequestHeader?.ApplicationUser?.FirstName @visit.RequestHeader?.ApplicationUser?.LastName',
                    technician: '@visit.TechnicianName',
                    fridge: '@visit.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Brand' || 'Unknown Brand',
                   
                    notes: '@Html.Raw(visit.Notes?.Replace("'", "\\'") ?? "")'
                },
                </text>
            }
        ];

        document.addEventListener('DOMContentLoaded', function() {
            const monthTitle = document.getElementById('monthTitle');
            const calendarDays = document.getElementById('calendarDays');
            const prevMonthBtn = document.getElementById('prevMonth');
            const nextMonthBtn = document.getElementById('nextMonth');
            const viewOptions = document.querySelectorAll('.view-option');
            
            let currentDate = new Date();
            let currentView = 'month';

            // Initialize the calendar
            renderCalendar();

            // Event listeners
            prevMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar();
            });

            nextMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar();
            });

            viewOptions.forEach(option => {
                option.addEventListener('click', function() {
                    viewOptions.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    currentView = this.getAttribute('data-view');
                    renderCalendar();
                });
            });

            function renderCalendar() {
                const year = currentDate.getFullYear();
                const month = currentDate.getMonth();

                const firstDay = new Date(year, month, 1);
                const lastDay = new Date(year, month + 1, 0);
                const prevLastDay = new Date(year, month, 0);

                const firstDayIndex = firstDay.getDay();
                const lastDayIndex = lastDay.getDay();
                const nextDays = 7 - lastDayIndex - 1;

                const options = { month: 'long', year: 'numeric' };
                monthTitle.textContent = currentDate.toLocaleDateString('en-US', options);

                let days = "";

                // Previous month days
                for (let x = firstDayIndex; x > 0; x--) {
                    const dayNum = prevLastDay.getDate() - x + 1;
                    const dateStr = `${prevLastDay.getFullYear()}-${(prevLastDay.getMonth() + 1).toString().padStart(2, '0')}-${dayNum.toString().padStart(2, '0')}`;
                    
                    days += `<div class="day other-month"><div class="day-number">${dayNum}</div>`;
                    days += renderEventsForDate(dateStr);
                    days += `</div>`;
                }

                // Current month days
                const today = new Date();
                for (let i = 1; i <= lastDay.getDate(); i++) {
                    const dateStr = `${year}-${(month + 1).toString().padStart(2, '0')}-${i.toString().padStart(2, '0')}`;
                    const isToday = today.getDate() === i && today.getMonth() === month && today.getFullYear() === year;
                    
                    days += `<div class="day ${isToday ? 'today' : ''}"><div class="day-number">${i}</div>`;
                    days += renderEventsForDate(dateStr);
                    days += `</div>`;
                }

                // Next month days
                const nextMonth = new Date(year, month + 1, 1);
                for (let j = 1; j <= nextDays; j++) {
                    const dateStr = `${nextMonth.getFullYear()}-${(nextMonth.getMonth() + 1).toString().padStart(2, '0')}-${j.toString().padStart(2, '0')}`;
                    
                    days += `<div class="day other-month"><div class="day-number">${j}</div>`;
                    days += renderEventsForDate(dateStr);
                    days += `</div>`;
                }

                calendarDays.innerHTML = days;

                // Add event listeners to events
                document.querySelectorAll('.event').forEach(event => {
                    event.addEventListener('click', function() {
                        const visitId = this.getAttribute('data-id');
                        showEventDetails(visitId);
                    });
                });
            }

            function renderEventsForDate(dateStr) {
                const visits = fridgeVisits.filter(visit => {
                    const visitDateStr = visit.date.toISOString().split('T')[0];
                    return visitDateStr === dateStr;
                });
                
                let eventsHtml = '';
                const maxEvents = 2;
                
                if (visits.length > 0) {
                    for (let i = 0; i < Math.min(visits.length, maxEvents); i++) {
                        const visit = visits[i];
                        const eventType = `event-type-${(i % 4) + 1}`;
                        
                        eventsHtml += `
                            <div class="event ${eventType}" data-id="${visit.id}">
                                <span class="event-dot"></span>
                                ${visit.customer} - ${visit.technician}
                            </div>
                        `;
                    }
                    
                    if (visits.length > maxEvents) {
                        eventsHtml += `<div class="more-events">+${visits.length - maxEvents} more</div>`;
                    }
                }
                
                return eventsHtml;
            }

            function showEventDetails(visitId) {
                const visit = fridgeVisits.find(v => v.id == visitId);
                
                if (visit) {
                    const eventDetails = document.getElementById('eventDetails');
                    eventDetails.innerHTML = `
                        <div class="mb-3">
                            <h6>Visit Details</h6>
                            <p><strong>Customer:</strong> ${visit.customer}</p>
                            <p><strong>Technician:</strong> ${visit.technician}</p>
                            <p><strong>Date:</strong> ${visit.date.toLocaleDateString()}</p>
                            <p><strong>Fridge:</strong> ${visit.fridge}</p>
                            <p><strong>Type:</strong> ${visit.type || 'General Visit'}</p>
                        </div>
                        <div>
                            <h6>Notes</h6>
                            <p class="text-muted">${visit.notes || 'No notes available.'}</p>
                        </div>
                    `;
                    
                    const modal = new bootstrap.Modal(document.getElementById('eventModal'));
                    modal.show();
                }
            }
        });
    </script>
