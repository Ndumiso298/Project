@model IEnumerable<MaintenanceRecord>
@{
    var fridgeId = ViewBag.FridgeId as int?;
}

<div class="card">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">
            <i class="fas fa-history me-2"></i>Maintenance History
        </h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Technician</th>
                            <th>Cost</th>
                            <th>Warranty</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>
                                    @(record.ServiceDate?.ToString("dd/MM/yyyy") ?? "-")
                                </td>
                                <td>
                                    <span class="badge bg-@GetServiceTypeBadge(record.ServiceType)">
                                        @record.ServiceType
                                    </span>
                                </td>
                                <td>@record.Technician?.UserAccount?.FirstName</td>
                                <td>
                                    @(record.Cost.HasValue
                                        ? $"R {record.Cost.Value.ToString("N2")}"
                                        : "<span class='text-muted'>-</span>")
                                </td>
                                <td>
                                    @if (record.IsWarrantyClaim)
                                    {
                                        <i class="fas fa-check text-success" title="Warranty Claim"></i>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="MaintenanceRecords" asp-action="Details" asp-route-id="@record.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (fridgeId.HasValue)
            {
                <div class="text-center mt-3">
                    <a asp-controller="MaintenanceRecords" asp-action="Index" asp-route-fridgeId="@fridgeId.Value"
                       class="btn btn-sm btn-outline-info">
                        View All Maintenance Records
                    </a>
                    <a asp-controller="MaintenanceRecords" asp-action="Upsert" asp-route-fridgeId="@fridgeId.Value"
                       class="btn btn-sm btn-primary ms-2">
                        <i class="fas fa-plus me-1"></i>New Record
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-3">
                <i class="fas fa-tools fa-2x text-muted mb-2"></i>
                <p class="text-muted mb-0">No maintenance history found</p>
                @if (fridgeId.HasValue)
                {
                    <a asp-controller="MaintenanceRecords" asp-action="Upsert" asp-route-fridgeId="@fridgeId.Value"
                       class="btn btn-sm btn-primary mt-2">
                        <i class="fas fa-plus me-1"></i>Add First Record
                    </a>
                }
            </div>
        }
    </div>
</div>

@functions {
    public string GetServiceTypeBadge(ServicingType serviceType)
    {
        return serviceType switch
        {
            ServicingType.Installation => "primary",
            ServicingType.PreventiveMaintenance => "warning",
            ServicingType.CorrectiveMaintenance => "danger",
            ServicingType.Inspection => "success",
            _ => "secondary"
        };
    }
}