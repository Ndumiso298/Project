@model MaintenanceRecordVM
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Maintenance Record" : "Edit Maintenance Record";
    var isEdit = Model.Id != 0;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">
                    <i class="fas fa-tools me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Maintenance Records</a></li>
                        <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Create")</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Upsert" method="post" id="maintenanceForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="FridgeId" class="form-label"></label>
                                    <select asp-for="FridgeId" asp-items="Model.FridgeList" class="form-select">
                                        <option value="">-- Select Fridge --</option>
                                    </select>
                                    <span asp-validation-for="FridgeId" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="TechnicianId" class="form-label"></label>
                                    <select asp-for="TechnicianId" asp-items="Model.TechnicianList" class="form-select">
                                        <option value="">-- Select Technician --</option>
                                    </select>
                                    <span asp-validation-for="TechnicianId" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="MaintenanceVisitId" class="form-label"></label>
                                    <select asp-for="MaintenanceVisitId" asp-items="Model.VisitList" class="form-select">
                                        <option value="">-- Select Maintenance Visit (Optional) --</option>
                                    </select>
                                    <span asp-validation-for="MaintenanceVisitId" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="ServiceType" class="form-label"></label>
                                    <select asp-for="ServiceType" asp-items="Model.ServiceTypeList" class="form-select">
                                        <option value="">-- Select Service Type --</option>
                                    </select>
                                    <span asp-validation-for="ServiceType" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ServiceDate" class="form-label"></label>
                                    <input asp-for="ServiceDate" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="ServiceDate" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="StartTime" class="form-label"></label>
                                            <input asp-for="StartTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="StartTime" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            <label asp-for="EndTime" class="form-label"></label>
                                            <input asp-for="EndTime" type="datetime-local" class="form-control" />
                                            <span asp-validation-for="EndTime" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="ServiceCost" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R</span>
                                        <input asp-for="ServiceCost" type="number" step="0.01" class="form-control" />
                                    </div>
                                    <span asp-validation-for="ServiceCost" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="WorkHours" class="form-label"></label>
                                    <input asp-for="WorkHours" type="number" step="0.1" class="form-control" />
                                    <span asp-validation-for="WorkHours" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group mb-3">
                                    <label asp-for="Description" class="form-label"></label>
                                    <textarea asp-for="Description" class="form-control" rows="3" 
                                              placeholder="Describe the maintenance work performed..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ServiceNotes" class="form-label"></label>
                                    <textarea asp-for="ServiceNotes" class="form-control" rows="3" 
                                              placeholder="Additional service notes..."></textarea>
                                    <span asp-validation-for="ServiceNotes" class="text-danger"></span>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="PartsUsed" class="form-label"></label>
                                    <textarea asp-for="PartsUsed" class="form-control" rows="2" 
                                              placeholder="List parts used or replaced..."></textarea>
                                    <span asp-validation-for="PartsUsed" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Warranty Information</h6>
                                        
                                        <div class="form-check form-switch mb-3">
                                            <input asp-for="IsWarrantyClaim" class="form-check-input" type="checkbox" 
                                                   id="warrantySwitch" onchange="toggleWarrantyFields()">
                                            <label asp-for="IsWarrantyClaim" class="form-check-label" for="warrantySwitch"></label>
                                        </div>

                                        <div id="warrantyFields" style="@(Model.IsWarrantyClaim ? "display: block;" : "display: none;")">
                                            <div class="form-group mb-3">
                                                <label asp-for="WarrantyReference" class="form-label"></label>
                                                <input asp-for="WarrantyReference" class="form-control" 
                                                       placeholder="Warranty reference number..." />
                                                <span asp-validation-for="WarrantyReference" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <div class="btn-group" role="group">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-save me-1"></i> @(isEdit ? "Update" : "Create") Record
                                </button>

                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Back to List
                                    </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleWarrantyFields() {
            const warrantyFields = document.getElementById('warrantyFields');
            const warrantySwitch = document.getElementById('warrantySwitch');
            
            if (warrantySwitch.checked) {
                warrantyFields.style.display = 'block';
            } else {
                warrantyFields.style.display = 'none';
                document.getElementById('WarrantyReference').value = '';
            }
        }

        // Set default dates
        document.addEventListener('DOMContentLoaded', function() {
            const serviceDate = document.getElementById('ServiceDate');
            if (!serviceDate.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                serviceDate.value = now.toISOString().slice(0, 16);
            }
        });

        // Auto-calculate duration if both start and end times are provided
        document.getElementById('StartTime').addEventListener('change', calculateDuration);
        document.getElementById('EndTime').addEventListener('change', calculateDuration);

        function calculateDuration() {
            const startTime = document.getElementById('StartTime').value;
            const endTime = document.getElementById('EndTime').value;
            
            if (startTime && endTime) {
                const start = new Date(startTime);
                const end = new Date(endTime);
                const durationHours = (end - start) / (1000 * 60 * 60); // Convert to hours
                
                if (durationHours > 0) {
                    document.getElementById('WorkHours').value = durationHours.toFixed(1);
                }
            }
        }
    </script>
}