@model MaintenanceRecordVM
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Maintenance Record" : "Edit Maintenance Record";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-tools me-2"></i>@ViewData["Title"]
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <form asp-action="Upsert" method="post" id="maintenanceForm">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input asp-for="Id" type="hidden" />

                <!-- Basic Information -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FridgeId" class="form-label"></label> *
                            <select asp-for="FridgeId" asp-items="Model.FridgeList" class="form-select">
                                <option value="">-- Select Fridge --</option>
                            </select>
                            <span asp-validation-for="FridgeId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TechnicianId" class="form-label"></label> *
                            <select asp-for="TechnicianId" asp-items="Model.TechnicianList" class="form-select">
                                <option value="">-- Select Technician --</option>
                            </select>
                            <span asp-validation-for="TechnicianId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MaintenanceVisitId" class="form-label"></label>
                            <select asp-for="MaintenanceVisitId" asp-items="Model.VisitList" class="form-select">
                                <option value="">-- Select Maintenance Visit --</option>
                            </select>
                            <span asp-validation-for="MaintenanceVisitId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ServiceDate" class="form-label"></label> *
                            <input asp-for="ServiceDate" type="date" class="form-control" />
                            <span asp-validation-for="ServiceDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ServiceType" class="form-label"></label> *
                            <select asp-for="ServiceType" asp-items="Model.ServiceTypeList" class="form-select"></select>
                            <span asp-validation-for="ServiceType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cost" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="Cost" class="form-control" />
                            </div>
                            <span asp-validation-for="Cost" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Time Tracking -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" type="time" class="form-control" />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" type="time" class="form-control" />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Warranty Information -->
                <div class="row">
                    <div class="col-12">
                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="IsWarrantyClaim" />
                                    <label class="form-check-label fw-bold" asp-for="IsWarrantyClaim"></label>
                                </div>

                                <div id="warrantyFields" style="@(Model.IsWarrantyClaim ? "display:block;" : "display:none;")">
                                    <div class="mb-3">
                                        <label asp-for="WarrantyReference" class="form-label"></label>
                                        <input asp-for="WarrantyReference" class="form-control" placeholder="Enter warranty reference number" />
                                        <span asp-validation-for="WarrantyReference" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description & Notes -->
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Brief description of the maintenance work performed"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Service Notes -->
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="ServiceNotes" class="form-label"></label>
                            <textarea asp-for="ServiceNotes" class="form-control" rows="5"
                                      placeholder="Detailed service notes, observations, and findings"></textarea>
                            <span asp-validation-for="ServiceNotes" class="text-danger"></span>
                            <div class="form-text">Include any specific issues found, repairs made, and recommendations.</div>
                        </div>
                    </div>
                </div>

                <!-- Parts Used -->
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <label asp-for="PartsUsed" class="form-label"></label>
                            <textarea asp-for="PartsUsed" class="form-control" rows="3"
                                      placeholder="List of parts used in this maintenance (one per line)"></textarea>
                            <span asp-validation-for="PartsUsed" class="text-danger"></span>
                            <div class="form-text">Enter each part on a new line. Format: Part Name - Quantity - Serial Number (if applicable)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row">
                    <div class="col-6">
                        @if (Model.Id != 0)
                        {
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        }
                    </div>
                    <div class="col-6 text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>
                            @(Model.Id == 0 ? "Create Record" : "Update Record")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Toggle warranty fields
            $('#IsWarrantyClaim').change(function () {
                if ($(this).is(':checked')) {
                    $('#warrantyFields').show();
                    $('#WarrantyReference').prop('required', true);
                } else {
                    $('#warrantyFields').hide();
                    $('#WarrantyReference').prop('required', false);
                }
            });

            // Time validation
            $('#StartTime, #EndTime').change(function () {
                const startTime = $('#StartTime').val();
                const endTime = $('#EndTime').val();

                if (startTime && endTime && startTime >= endTime) {
                    $('#EndTime').addClass('is-invalid');
                    $('<div class="invalid-feedback">End time must be after start time</div>').insertAfter('#EndTime');
                } else {
                    $('#EndTime').removeClass('is-invalid');
                    $('.invalid-feedback').remove();
                }
            });

            // Auto-populate current date if creating new record
        @if (Model.Id == 0 && !Model.ServiceDate.HasValue)
        {
            <text>
                    $('#ServiceDate').val(new Date().toISOString().split('T')[0]);
            </text>
        }
        });
    </script>
}