@model IEnumerable<MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance Records";
}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">
                    <i class="fas fa-tools me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item active">Maintenance Records</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Maintenance History</h5>
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i> New Record
                    </a>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <label class="form-label">Fridge Filter</label>
                            <select id="fridgeFilter" class="form-select">
                                <option value="">All Fridges</option>
                                @foreach (var item in ViewBag.FridgeList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@(ViewBag.SelectedFridgeId?.ToString() == item.Value ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">From Date</label>
                            <input type="date" id="fromDateFilter" class="form-control" value="@ViewBag.FromDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">To Date</label>
                            <input type="date" id="toDateFilter" class="form-control" value="@ViewBag.ToDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">&nbsp;</label>
                            <div>
                                <button id="applyFilters" class="btn btn-primary me-2">
                                    <i class="fas fa-filter me-1"></i> Apply
                                </button>
                                <button id="clearFilters" class="btn btn-secondary">
                                    <i class="fas fa-times me-1"></i> Clear
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="recordsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Service Date</th>
                                        <th>Fridge</th>
                                        <th>Technician</th>
                                        <th>Service Type</th>
                                        <th>Description</th>
                                        <th>Cost</th>
                                        <th>Warranty</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model)
                                    {
                                        <tr>
                                            <td>@record.ServiceDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <strong>@record.Fridge?.SerialNumber</strong>
                                                <br><small class="text-muted">@record.Fridge?.Model</small>
                                            </td>
                                            <td>@record.Technician?.UserAccount?.FirstName @record.Technician?.UserAccount?.LastName</td>
                                            <td>
                                                <span class="badge @GetServiceTypeBadge(record.ServiceType)">
                                                    @record.ServiceType
                                                </span>
                                            </td>
                                            <td>@record.Description.Truncate(50)</td>
                                            <td>@record.Cost.ToString("C")</td>
                                            <td>
                                                @if (record.IsWarrantyClaim)
                                                {
                                                    <span class="badge bg-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">No</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Details" asp-route-id="@record.Id"
                                                       class="btn btn-info" title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Upsert" asp-route-id="@record.Id"
                                                       class="btn btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (User.IsInRole("Administrator"))
                                                    {
                                                        <button type="button" class="btn btn-danger delete-record"
                                                                data-id="@record.Id" title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-tools fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Maintenance Records Found</h4>
                            <p class="text-muted">Get started by creating your first maintenance record.</p>
                            <a asp-action="Upsert" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i> Create Record
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#recordsTable').DataTable({
                "order": [[0, "desc"]],
                "responsive": true,
                "columnDefs": [
                    { "orderable": false, "targets": [7] } // Disable sorting for actions column
                ]
            });

            // Filter functionality
            $('#applyFilters').click(function () {
                const fridgeId = $('#fridgeFilter').val();
                const fromDate = $('#fromDateFilter').val();
                const toDate = $('#toDateFilter').val();

                let url = '@Url.Action("Index")?';
                const params = [];

                if (fridgeId) params.push(`fridgeId=${fridgeId}`);
                if (fromDate) params.push(`fromDate=${fromDate}`);
                if (toDate) params.push(`toDate=${toDate}`);

                if (params.length > 0) {
                    url += params.join('&');
                }

                window.location.href = url;
            });

            $('#clearFilters').click(function () {
                window.location.href = '@Url.Action("Index")';
            });

            // Delete record functionality
            $('.delete-record').click(function () {
                const recordId = $(this).data('id');
                if (confirm('Are you sure you want to delete this maintenance record? This action cannot be undone.')) {
                    $.post('@Url.Action("Delete")', { id: recordId }, function () {
                        location.reload();
                    }).fail(function () {
                        alert('Error deleting record');
                    });
                }
            });
        });
    </script>
}