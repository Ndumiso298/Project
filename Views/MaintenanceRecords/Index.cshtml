@model IEnumerable<MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-clipboard-list me-2"></i>@ViewData["Title"]</h1>
    <a asp-action="Upsert" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Record
    </a>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="fridgeId" class="form-label">Fridge</label>
                <select name="fridgeId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Fridges</option>
                    @foreach (var fridge in ViewBag.FridgeList)
                    {
                        <option value="@fridge.Value" selected="@(fridge.Value == ViewBag.SelectedFridgeId?.ToString())">
                            @fridge.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="fromDate" class="form-label">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
            </div>
            <div class="col-md-3">
                <label for="toDate" class="form-label">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="mb-0">Maintenance History</h5>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">@Model.Count() records found</small>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                <h5>No maintenance records found</h5>
                <p class="text-muted">Get started by creating your first maintenance record</p>
                <a asp-action="Upsert" class="btn btn-primary">Create Record</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Service Date</th>
                            <th>Fridge</th>
                            <th>Technician</th>
                            <th>Service Type</th>
                            <th>Condition</th>
                            <th>Follow-up</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td>@record.ServiceDate?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <strong>@record.Fridge?.SerialNumber</strong><br>
                                    <small class="text-muted">@record.Fridge?.FridgeModel?.ModelName</small>
                                </td>
                                <td>
                                    @record.Technician?.UserAccount?.FirstName @record.Technician?.UserAccount?.LastName
                                </td>
                                <td>
                                    @if (record.MaintenanceVisitId.HasValue)
                                    {
                                        <span class="badge bg-info">Scheduled Visit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ad-hoc Service</span>
                                    }
                                </td>
@*                                 <td>
                                    @if (record.ConditionRating.HasValue)
                                    {
                                        <div class="star-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= record.ConditionRating.Value ? "text-warning" : "text-muted")"></i>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not rated</span>
                                    }
                                </td>
                                <td>
                                    @if (record.FollowUpRequired)
                                    {
                                        <span class="badge bg-warning">Follow-up</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td> *@
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@record.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Upsert" asp-route-id="@record.Id"
                                           class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (User.IsInRole(SD.AdminRole))
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@record.Id" />
                                                <button type="submit" class="btn btn-outline-danger"
                                                        title="Delete" onclick="return confirm('Are you sure you want to delete this record?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .star-rating {
        font-size: 0.9em;
    }
</style>