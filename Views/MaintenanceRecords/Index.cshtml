@model IEnumerable<MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance Records";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-tools me-2"></i>Maintenance Records
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Maintenance Record
            </a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Search & Filter
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="fridgeId" class="form-label">Fridge</label>
                    <select class="form-select" id="fridgeId" name="fridgeId">
                        <option value="">All Fridges</option>
                        @foreach (var item in ViewBag.FridgeList)
                        {
                            <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedFridgeId?.ToString())">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="fromDate" class="form-label">From Date</label>
                    <input type="date" class="form-control" id="fromDate" name="fromDate" value="@ViewBag.FromDate">
                </div>
                <div class="col-md-3">
                    <label for="toDate" class="form-label">To Date</label>
                    <input type="date" class="form-control" id="toDate" name="toDate" value="@ViewBag.ToDate">
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search me-2"></i>Apply Filters
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Records Card -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Service Date</th>
                                <th>Fridge Serial</th>
                                <th>Technician</th>
                                <th>Service Type</th>
                                <th>Duration</th>
                                <th>Cost</th>
                                <th>Warranty Claim</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model)
                            {
                                <tr>
                                    <td>
                                        @(record.ServiceDate.HasValue
                                            ? record.ServiceDate.Value.ToString("dd/MM/yyyy")
                                            : "-")
                                    </td>
                                    <td>
                                        <a asp-controller="Fridges" asp-action="Details" asp-route-id="@record.FridgeId"
                                           class="text-decoration-none" title="View Fridge Details">
                                            @record.Fridge?.SerialNumber
                                        </a>
                                    </td>
                                    <td>@record.Technician?.UserAccount?.FirstName @record.Technician?.UserAccount?.LastName</td>
                                    <td>
                                        <span class="badge bg-@GetServiceTypeBadge(record.ServiceType)">
                                            @record.ServiceType
                                        </span>
                                    </td>
                                    <td>
                                        @if (record.StartTime.HasValue && record.EndTime.HasValue)
                                        {
                                            var duration = record.EndTime.Value - record.StartTime.Value;
                                            <span>@duration.Hours h @duration.Minutes m</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not recorded</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.Cost.HasValue)
                                        {
                                            <span>R @record.Cost.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.IsWarrantyClaim)
                                        {
                                            <span class="badge bg-success">Yes</span>
                                            <small class="d-block text-muted">@record.WarrantyReference</small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@record.Id"
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Upsert" asp-route-id="@record.Id"
                                               class="btn btn-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (User.IsInRole(SD.AdminRole))
                                            {
                                                <button onclick="confirmDelete(@record.Id, '@(record.ServiceDate?.ToString("dd/MM/yyyy") ?? "-")')">
                                                    <i class="fas fa-trash me-2"></i>Delete Record
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Statistics -->
                <div class="row mt-4">
                    <div class="col-md-3 col-6">
                        <div class="card bg-primary text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Count()</h5>
                                <small class="card-text">Total Records</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-success text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">R @Model.Where(r => r.Cost.HasValue).Sum(r => r.Cost.Value).ToString("N2")</h5>
                                <small class="card-text">Total Cost</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-warning text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Count(r => r.IsWarrantyClaim)</h5>
                                <small class="card-text">Warranty Claims</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-info text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Select(r => r.FridgeId).Distinct().Count()</h5>
                                <small class="card-text">Fridges Serviced</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-tools fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Maintenance Records Found</h5>
                    <p class="text-muted">Try adjusting your search criteria or create a new maintenance record.</p>
                    <a asp-action="Upsert" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Create First Record
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, serviceDate) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to delete maintenance record for ${serviceDate}. This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { id: id }, function () {
                        Swal.fire(
                            'Deleted!',
                            'Maintenance record has been deleted.',
                            'success'
                        ).then(() => {
                            window.location.reload();
                        });
                    }).fail(function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the record.',
                            'error'
                        );
                    });
                }
            });
        }
    </script>
}

@functions {
    public string GetServiceTypeBadge(ServicingType serviceType)
    {
        return serviceType switch
        {
            ServicingType.Installation => "primary",
            ServicingType.PreventiveMaintenance => "warning",
            ServicingType.CorrectiveMaintenance => "danger",
            ServicingType.Inspection => "success",
            _ => "secondary"
        };
    }
}