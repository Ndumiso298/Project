@model Project.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Delete Maintenance Record";
}

<h2 class="mb-3">Delete Maintenance Record</h2>

<div class="alert alert-warning">
    <strong>Are you sure?</strong> This will mark the record as inactive (soft delete).
</div>

<dl class="row">
    <dt class="col-sm-3">Service Date</dt>
    <dd class="col-sm-9">
        @(Model.ServiceDate.HasValue
            ? Model.ServiceDate.Value.ToString("dd/MM/yyyy")
            : "-")
    </dd>

    <dt class="col-sm-3">Fridge</dt>
    <dd class="col-sm-9">@Model.Fridge?.SerialNumber</dd>

    <dt class="col-sm-3">Technician</dt>
    <dd class="col-sm-9">@($"{Model.Technician?.UserAccount?.FirstName} {Model.Technician?.UserAccount?.LastName}")</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Cancel
    </a>
</form>
