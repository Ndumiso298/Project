@{
    var recentRecords = ViewBag.RecentMaintenanceRecords as IEnumerable<MaintenanceRecord> ?? new List<MaintenanceRecord>();
    var stats = ViewBag.MaintenanceStats as dynamic;
}

<div class="card">
    <div class="card-header bg-warning text-white">
        <h5 class="mb-0">
            <i class="fas fa-tools me-2"></i>Recent Maintenance
        </h5>
    </div>
    <div class="card-body">
        @if (recentRecords.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var record in recentRecords.Take(5))
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@record.Fridge?.SerialNumber</div>
                            <small class="text-muted">
                                @(record.ServiceDate?.ToString("dd/MM/yyyy") ?? "-")
                            </small>
                        </div>
                        <a asp-controller="MaintenanceRecords" asp-action="Details" asp-route-id="@record.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                }
            </div>

            <div class="mt-3 text-center">
                <a asp-controller="MaintenanceRecords" asp-action="Index" class="btn btn-sm btn-outline-warning">
                    View All Maintenance
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-3">
                <i class="fas fa-tools fa-2x text-muted mb-2"></i>
                <p class="text-muted mb-0">No recent maintenance</p>
                <a asp-controller="MaintenanceRecords" asp-action="Upsert" class="btn btn-sm btn-warning mt-2">
                    <i class="fas fa-plus me-1"></i>Create Record
                </a>
            </div>
        }
    </div>
</div>