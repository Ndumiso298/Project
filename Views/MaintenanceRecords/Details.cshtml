@model MaintenanceRecord
@{
    ViewData["Title"] = $"Maintenance Record - {Model.ServiceDate:dd/MM/yyyy}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-clipboard-list me-2"></i>Maintenance Record
        <small class="text-muted">@Model.ServiceDate?.ToString("dd/MM/yyyy")</small>
    </h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
    </div>
</div>

<div class="row">
    <!-- Main Information -->
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Service Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th class="w-40">Service Date:</th>
                                <td>@Model.ServiceDate?.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Fridge:</th>
                                <td>
                                    <strong>@Model.Fridge?.SerialNumber</strong><br>
                                    <small class="text-muted">@Model.Fridge?.FridgeModel?.Manufacturer @Model.Fridge?.FridgeModel?.ModelName</small>
                                </td>
                            </tr>
                            <tr>
                                <th>Technician:</th>
                                <td>@Model.Technician?.UserAccount?.FirstName @Model.Technician?.UserAccount?.LastName</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                        </table>
                    </div>
                </div>

                <!-- Service Notes -->
                @if (!string.IsNullOrEmpty(Model.ServiceNotes))
                {
                    <div class="mt-4">
                        <h6><i class="fas fa-sticky-note me-2"></i>Service Notes</h6>
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(Model.ServiceNotes?.Replace("\n", "<br>"))
                        </div>
                    </div>
                }

@*         <!-- Technical Checks -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-wrench me-2"></i>Technical Checks</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center">
                        <div class="mb-3">
                            <i class="fas @(Model.CompressorWorking == true ? "fa-check text-success" : "fa-times text-danger") fa-2x mb-2"></i>
                            <div>Compressor</div>
                            <small class="text-muted">@(Model.CompressorWorking == true ? "Working" : "Not Working")</small>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="mb-3">
                            <i class="fas @(Model.CondenserClean == true ? "fa-check text-success" : "fa-times text-danger") fa-2x mb-2"></i>
                            <div>Condenser</div>
                            <small class="text-muted">@(Model.CondenserClean == true ? "Clean" : "Dirty")</small>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="mb-3">
                            <i class="fas @(Model.DoorSealIntact == true ? "fa-check text-success" : "fa-times text-danger") fa-2x mb-2"></i>
                            <div>Door Seal</div>
                            <small class="text-muted">@(Model.DoorSealIntact == true ? "Intact" : "Damaged")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> *@

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Fridge Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-refrigerator me-2"></i>Fridge Information</h5>
            </div>
            <div class="card-body">
                @if (Model.Fridge != null)
                {
                    <strong>@Model.Fridge.SerialNumber</strong>

                    <br>
                    <small class="text-muted">
                        @Model.Fridge.FridgeModel?.Manufacturer @Model.Fridge.FridgeModel?.ModelName<br>
                        Capacity: @Model.Fridge.FridgeModel?.CapacityLiters liters<br>
                        Status: <span class="badge bg-info">@Model.Fridge.Status</span><br>
                        Condition: <span class="badge bg-success">@Model.Fridge.Condition</span>
                    </small>
                }
            </div>
        </div>

        <!-- Related Visit -->
        @if (Model.MaintenanceVisitId.HasValue && Model.MaintenanceVisit != null)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Related Visit</h5>
                </div>
                <div class="card-body">
                    <strong>Visit #@Model.MaintenanceVisit.Id</strong><br>
                    <small class="text-muted">
                        Scheduled: @Model.MaintenanceVisit.ScheduledDate.ToString("dd/MM/yyyy")<br>
                        Status: <span class="badge @Model.MaintenanceVisit.StatusBadgeClass">@Model.MaintenanceVisit.Status</span>
                    </small>
                    <div class="mt-2">
                        <a asp-controller="MaintenanceVisits" asp-action="Details"
                           asp-route-id="@Model.MaintenanceVisit.Id" class="btn btn-outline-info btn-sm">
                            View Visit Details
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Audit Information -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Audit Information</h5>
            </div>
            <div class="card-body">
                <small class="text-muted">
                    <strong>Created:</strong><br>
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") by @Model.CreatedBy<br><br>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <strong>Last Updated:</strong>

                        <br>
                        @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                        @Model.UpdatedBy
                            }
                </small>
            </div>
        </div>
    </div>
</div>

<style>
    .star-rating {
        font-size: 1.1em;
    }
</style>