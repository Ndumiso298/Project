@using Project.Utilities.Enums
@model MaintenanceRecord
@{
    ViewData["Title"] = "Maintenance Record Details";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-title-box">
                <h4 class="page-title">
                    <i class="fas fa-tools me-2"></i> @ViewData["Title"]
                </h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Maintenance Records</a></li>
                        <li class="breadcrumb-item active">Details</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i> Service Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Service Date:</dt>
                        <dd class="col-sm-8">@Model.ServiceDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Service Type:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @GetServiceTypeBadge(Model.ServiceType)">
                                @Model.ServiceType
                            </span>
                        </dd>

                        <dt class="col-sm-4">Fridge:</dt>
                        <dd class="col-sm-8">
                            @Model.Fridge?.SerialNumber - @Model.Fridge?.Model
                            <br><small class="text-muted">ID: @Model.FridgeId</small>
                        </dd>

                        <dt class="col-sm-4">Technician:</dt>
                        <dd class="col-sm-8">
                            @Model.Technician?.UserAccount?.FirstName @Model.Technician?.UserAccount?.LastName
                            <br><small class="text-muted">ID: @Model.TechnicianId</small>
                        </dd>

                        @if (Model.MaintenanceVisitId.HasValue)
                        {
                            <dt class="col-sm-4">Maintenance Visit:</dt>
                            <dd class="col-sm-8">
                                Visit #@Model.MaintenanceVisitId
                                <br><small class="text-muted">
                                    Scheduled: @Model.MaintenanceVisit?.ScheduledDate.ToString("dd/MM/yyyy")
                                </small>
                            </dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-clock me-2"></i> Time Tracking
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        @if (Model.StartTime.HasValue)
                        {
                            <dt class="col-sm-4">Start Time:</dt>
                            <dd class="col-sm-8">@Model.StartTime.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }

                        @if (Model.EndTime.HasValue)
                        {
                            <dt class="col-sm-4">End Time:</dt>
                            <dd class="col-sm-8">@Model.EndTime.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }

                        @if (Model.DurationMinutes.HasValue)
                        {
                            <dt class="col-sm-4">Duration:</dt>
                            <dd class="col-sm-8">
                                @(Model.DurationMinutes.Value / 60)h @(Model.DurationMinutes.Value % 60)m
                                <br><small class="text-muted">(@Model.DurationMinutes.Value minutes)</small>
                            </dd>
                        }

                        <dt class="col-sm-4">Work Hours:</dt>
                        <dd class="col-sm-8">
                            @(Model.WorkHours?.ToString("F1") ?? "N/A") hours
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-receipt me-2"></i> Cost & Parts
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Service Cost:</dt>
                        <dd class="col-sm-8 h5 text-success">@Model.Cost.ToString("C")</dd>

                        <dt class="col-sm-4">Service Complexity:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @GetComplexityBadge(Model.ServiceComplexity)">
                                @Model.ServiceComplexity
                            </span>
                        </dd>

                        <dt class="col-sm-4">Warranty Claim:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsWarrantyClaim)
                            {
                                <span class="badge bg-success">Yes</span>
                                @if (!string.IsNullOrEmpty(Model.WarrantyReference))
                                {
                                    <br>

                                    <small class="text-muted">Ref: @Model.WarrantyReference</small>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.PartsUsed))
                        {
                            <dt class="col-sm-4">Parts Used:</dt>
                            <dd class="col-sm-8">@Model.PartsUsed</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-alt me-2"></i> Notes & Description
                    </h5>
                </div>
                <div class="card-body">
                    <h6>Description:</h6>
                    <p class="mb-3">@Model.Description</p>

                    @if (!string.IsNullOrEmpty(Model.ServiceNotes))
                    {
                        <h6>Service Notes:</h6>
                        <p class="mb-0">@Model.ServiceNotes</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Record Management</h5>
                    <div>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i> Edit Record
                        </a>
                        @if (User.IsInRole("Administrator"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this record?')">
                                    <i class="fas fa-trash me-1"></i> Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetServiceTypeBadge(ServicingType serviceType)
    {
        return serviceType switch
        {
            ServicingType.PreventiveMaintenance => "bg-primary",
            ServicingType.CorrectiveRepair => "bg-warning",
            ServicingType.EmergencyService => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public string GetComplexityBadge(string complexity)
    {
        return complexity switch
        {
            "High" => "bg-danger",
            "Medium" => "bg-warning",
            "Low" => "bg-success",
            _ => "bg-secondary"
        };
    }
}