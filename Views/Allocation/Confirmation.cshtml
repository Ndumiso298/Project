@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Request Confirmation";
}

<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header bg-success text-white text-center py-4">
            <h2 class="fw-bold mb-1">Request Successfully Placed</h2>
            <p class="mb-0">Thank you for choosing our services</p>
        </div>

        <!-- Body -->
        <div class="card-body p-5">
            <div class="row text-center mb-4">
                <div class="col-12">
                    <i class="bi bi-check-circle-fill text-success display-3 mb-3"></i>
                    <h4 class="fw-semibold">Your fridge request has been successfully placed!</h4>
                    <p class="text-muted">We have received your order and our team is processing it.</p>
                </div>
            </div>

            <!-- Payment Details -->
            <div class="row justify-content-center mb-5">
                <div class="col-md-8">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Payment Details</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-2"><strong>Bank Name:</strong> Standard Bank</p>
                            <p class="mb-2"><strong>Account Number:</strong> 123 456 789</p>
                            <p class="mb-2"><strong>Branch Code:</strong> 051001</p>
                            <p class="mb-2"><strong>Reference:</strong> Your Request ID</p>
                            <p class="text-muted small mt-3">
                                ⚠️ Please ensure you use your <strong>Request ID</strong> as the payment reference to avoid delays.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Follow-up Info -->
            <div class="row text-center">
                <div class="col-12">
                    <h5 class="fw-semibold">What’s Next?</h5>
                    <p class="text-muted mb-4">One of our consultants will give you a call within <strong>24 hours</strong> to confirm delivery and finalize details.</p>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary rounded-pill px-5 py-2">
                        <i class="bi bi-house-door me-2"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
