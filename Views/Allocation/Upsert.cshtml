@model AllocationVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
    <div class="row">
        <div class="col-12 text-center">
                <h2 class="text-white py-2"> @(Model.Allocation.AllocationId!=0?"Update":"Create") Allocation</h2>
        </div>
    </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <input asp-for="Allocation.AllocationId" hidden />
           
            <div class="row">
                <div class="col-10">
                    <div class="border p-3">
                        @*<div asp-validation-summary="ModelOnly"></div>*@
                        <div class="form-floating py-2 col-12">
                            <select  class="form-select border-0 shadow">
                                <option disabled selected>--Select Fridges--</option>
                            </select>
                            <label  class="ms-2"></label>
                            <span  class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <select  asp-items="@Model.UserList" class="form-select border-0 shadow">
                                <option disabled selected>--Select Users--</option>
                            </select>
                            <label  class="ms-2"></label>
                            <span  class="text-danger"></span>
                        </div>
                       

                        <div class="form-floating py-2 col-12">
                            <input  class="form-control border-0 shadow" />
                            <label  class="ms-2"></label>
                            <span  class="text-danger"></span>
                        </div>
                        <div class="form-floating py-2 col-12">
                            <input  class="form-control border-0 shadow" />
                            <label  class="ms-2"></label>
                            <span  class="text-danger"></span>
                        </div>

                        <div class="row pt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Allocation.AllocationId != 0)
                                {
                                    <button type="submit" class="btn btn-primary form-control">Update</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary form-control">Create</button>
                                }   
                            </div>
                            <div class="col-6 col-md-3">
                                <a asp-controller="Allocation" asp-action="Index" class="btn btn-outline-primary border  form-control">
                                    Back to List
                                </a>
                            </div>
                        </div>


                    </div>
                </div>
              
            </div>
           
        </form>
    </div>
</div>




@section Scripts{
    <script>
        tinymce.init({
            selector: 'textarea',
            plugins: 'anchor autolink charmap codesample emoticons  lists   table visualblocks wordcount',
            toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough |  align lineheight | numlist bullist indent outdent',
        });
    </script>
    @{
    <partial name="_ValidationScriptsPartial"/>
    }
}