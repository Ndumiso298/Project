@model AllocationVM
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Allocations</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Allocation" asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i>  Create New Allocation
                </a>
            </div>
        </div>

        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>
                        Fridge Maanufacure
                    </th>
                    <th>
                        Sirial Number
                    </th>
                    <th>
                        Fridge Number
                    </th>
                    <th>
                        Fridge Type
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Action
                    </th>
                </tr>
            </thead>
            <tbody>
            @*     @foreach (var obj in Model.OrderBy(u => u.AllocationId))
                {
                    <tr>
                        <td>
                            @obj.Fridge.FridgeNo+<br />+@obj.Fridge.FridgeManufacture+<br />+@obj.Fridge.FridgeType
                        </td>
                        <td>
                            @obj.ApplicationUser.FirstName + " " + @obj.ApplicationUser.LastName
                        </td>
                        <td>
                            @obj.AllocationDate
                        </td>
                        <td>
                            @obj.ReturnDate
                        </td>

                                    <!-- Details -->
                                    <div class="col-12 col-md-5">
                                        <h5 class="fw-bold text-dark mb-1">@item.Fridge.Brand</h5>
                                        <p class="text-muted small mb-2">@Html.Raw(item.Fridge.Description)</p>
                                        <div class="fw-semibold text-primary">
                                            @item.Fridge.RentalPricePerMonth.ToString("c")
                                            <span class="text-muted">&nbsp;x&nbsp;</span>@item.Count
                                        </div>
                                    </div>

                        <td>
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Allocation" asp-action="Index" asp-route-id="@obj.AllocationId" class="btn btn-primary mx-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-controller="Allocation" asp-action="Index" asp-route-id="@obj.AllocationId" class="btn btn-danger mx-2">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                } *@
            </tbody>
        </table>

            <!-- Footer -->
            <div class="card-footer bg-light border-0 p-4">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        <h5 class="text-dark fw-semibold mb-0">Total (ZAR)</h5>
                        <h3 class="fw-bold text-primary mt-1">@Model.RequestHeader.RequestTotal.ToString("c")</h3>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        @if (Model.AllocationList != null && Model.AllocationList.Any())
                        {
                            <a asp-action="Summary" class="btn btn-primary w-100 w-md-auto py-3 px-5 fs-5 fw-semibold rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i> Proceed to Summary
                            </a>
                        }
                        else
                        {
                            <!-- Optional: show disabled button or nothing -->
                            <button class="btn btn-secondary w-100 w-md-auto py-3 px-5 fs-5 fw-semibold rounded-pill shadow" disabled>
                                <i class="bi bi-check-circle me-2"></i> Proceed to Summary
                            </button>
                        }
                    </div>
    </div>
</div>

</form>

@section Scripts {
    <script src="~/js/Product.js"></script>
}
