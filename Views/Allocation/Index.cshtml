@model FridgeAllocationVM
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="card-header bg-primary text-light py-4">
                <div class="row align-items-center">
                    <div class="col-12 text-center">
                        <h2 class="fw-bold text-white mb-0">Shopping Cart</h2>
                        <p class="opacity-75 mb-0">Review your items before checkout</p>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <!-- Continue Shopping -->
                <div class="row mb-4">
                    <div class="col-12 col-md-3">
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Cart Items -->
                <div class="row">
                    <div class="col-12">
                        @if (Model.AllocationList != null && Model.AllocationList.Any())
                        {
                            @foreach (var item in Model.AllocationList)
                            {
                                <div class="row align-items-center border-bottom py-3 mb-3">
                                    <!-- Image -->
                                    <div class="col-12 col-md-2 text-center mb-3 mb-md-0">
                                        <img src="@item.Fridge.ImageUrl" alt="@item.Fridge.Manufacturer @item.Fridge.Model"
                                             class="img-fluid rounded shadow-sm" style="max-height:120px;" />
                                    </div>

                                    <!-- Details -->
                                    <div class="col-12 col-md-5">
                                        <h5 class="fw-bold text-dark mb-1">@item.Fridge.Manufacturer</h5>
                                        <p class="text-muted small mb-2">@Html.Raw(item.Fridge.Description)</p>
                                        <div class="fw-semibold text-primary">
                                            @item.Fridge.RentalPricePerMonth.ToString("c")
                                            <span class="text-muted">&nbsp;x&nbsp;</span>@item.Quantity
                                        </div>
                                    </div>

                                    <!-- Actions -->
                                    <div class="col-12 col-md-5 d-flex justify-content-md-end align-items-center mt-3 mt-md-0">
                                        <div class="btn-group me-3" role="group">
                                            <a asp-action="Plus" asp-route-id="@item.Id"
                                               class="btn btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-plus-lg"></i>
                                            </a>
                                            <a asp-action="Minus" asp-route-id="@item.Id"
                                               class="btn btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-dash-lg"></i>
                                            </a>
                                        </div>
                                        <a asp-action="Remove" asp-route-id="@item.Id"
                                           class="btn btn-danger rounded-pill px-3">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info text-center rounded-3 shadow-sm">
                                <i class="bi bi-cart-x fs-3 d-block mb-2"></i>
                                Your cart is empty.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer bg-light border-0 p-4">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        <h5 class="text-dark fw-semibold mb-0">Total (ZAR)</h5>
                        <h3 class="fw-bold text-primary mt-1">@Model.RequestHeader.RequestTotal.ToString("c")</h3>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        @if (Model.AllocationList != null && Model.AllocationList.Any())
                        {
                            <a asp-action="Summary" class="btn btn-primary w-100 w-md-auto py-3 px-5 fs-5 fw-semibold rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i> Proceed to Summary
                            </a>
                        }
                        else
                        {
                            <!-- Optional: show disabled button or nothing -->
                            <button class="btn btn-secondary w-100 w-md-auto py-3 px-5 fs-5 fw-semibold rounded-pill shadow" disabled>
                                <i class="bi bi-check-circle me-2"></i> Proceed to Summary
                            </button>
                        }
                    </div>
                </div>
            </div>

</form>

@section Scripts {
    <script src="~/js/Product.js"></script>
}
