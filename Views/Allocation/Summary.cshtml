@model AllocationVM
@{
    Layout = "_CustomerLayout";
}

<form method="post" id="orderForm">
    <input asp-for="RequestHeader.RequestHeaderId" type="hidden" />
    <input asp-for="RequestHeader.CustomerID" type="hidden" />

    <div class="container py-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="card-header bg-primary text-light py-4 position-relative">
                <div class="row align-items-center">
                    <div class="col-12 text-center">
                        <h2 class="text-white fw-bold mb-1">Order Summary</h2>
                        <p class="text-light mb-0 opacity-75">Review your shipping details & order before checkout</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <!-- Back Button -->
                <div class="row mb-4">
                    <div class="col-12 col-md-3">
                        <a asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i> Back to Cart
                        </a>
                    </div>
                </div>

                <div class="row g-5">
                    <!-- Shipping Details -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-truck me-2"></i> Shipping Details
                        </h3>

                        <div class="specs-container mb-4">
                            <div class="mb-3">
                                <label asp-for="RequestHeader.FirstName" class="form-label fw-semibold text-dark">First Name *</label>
                                <input asp-for="RequestHeader.FirstName" class="form-control" required />
                                <span asp-validation-for="RequestHeader.FirstName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.LastName" class="form-label fw-semibold text-dark">Last Name *</label>
                                <input asp-for="RequestHeader.LastName" class="form-control" required />
                                <span asp-validation-for="RequestHeader.LastName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.CellNumber" class="form-label fw-semibold text-dark">Phone Number *</label>
                                <input asp-for="RequestHeader.CellNumber" class="form-control" required />
                                <span asp-validation-for="RequestHeader.CellNumber" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.StreetAddress" class="form-label fw-semibold text-dark">Street Address *</label>
                                <input asp-for="RequestHeader.StreetAddress" class="form-control" required />
                                <span asp-validation-for="RequestHeader.StreetAddress" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.City" class="form-label fw-semibold text-dark">City *</label>
                                <input asp-for="RequestHeader.City" class="form-control" required />
                                <span asp-validation-for="RequestHeader.City" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.State" class="form-label fw-semibold text-dark">State/Province *</label>
                                <input asp-for="RequestHeader.State" class="form-control" required />
                                <span asp-validation-for="RequestHeader.State" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="RequestHeader.PostalCode" class="form-label fw-semibold text-dark">Postal Code *</label>
                                <input asp-for="RequestHeader.PostalCode" class="form-control" required />
                                <span asp-validation-for="RequestHeader.PostalCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-12 col-lg-6">
                        <h3 class="section-title mb-3 text-primary fw-bold">
                            <i class="bi bi-receipt me-2"></i> Order Summary
                        </h3>

                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body p-0">
                                <div class="list-group list-group-flush">
                                    @foreach (var details in Model.AllocationList)
                                    {
                                        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                            <div class="flex-grow-1">
                                                <h6 class="fw-semibold mb-1 text-dark">@details.Fridge.Brand</h6>
                                                <small class="text-muted">Model: @details.Fridge.Brand</small>
                                                <div class="mt-1">
                                                    <small class="text-muted">Quantity: <span class="fw-bold">@details.Count</span></small>
                                                    
                                                </div>
                                            </div>
                                            <span class="fw-bold text-primary fs-6">@((details.Price * details.Count).ToString("c"))</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Order Total -->
                        <div class="card border-primary border-2 mb-4">
                            <div class="card-body text-center py-3">
                                <h4 class="text-primary mb-0">Order Total</h4>
                                <div class="fs-2 fw-bold text-primary">@Model.RequestHeader.RequestTotal.ToString("c")</div>
                            </div>
                        </div>

                        <!-- Delivery Estimate -->
                        <div class="card border-0 bg-light shadow-sm">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-calendar-check text-primary fs-4 me-3"></i>
                                    <div>
                                        <h6 class="fw-bold mb-1">Estimated Delivery</h6>
                                        <p class="mb-0 text-muted">
                                            @DateTime.Now.AddDays(7).ToString("MMMM dd, yyyy") - @DateTime.Now.AddDays(14).ToString("MMMM dd, yyyy")
                                        </p>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Delivery times may vary based on location and product availability
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms and Conditions -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0 text-dark">
                                    <i class="bi bi-shield-check me-2 text-primary"></i>
                                    Terms & Conditions
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="terms-content" style="max-height: 200px; overflow-y: auto; border: 1px solid #e9ecef; border-radius: 0.375rem; padding: 1rem;">
                                    <h6 class="fw-bold">SmartChill Solutions Rental Agreement</h6>
                                    <ol class="small">
                                        <li class="mb-2">
                                            <strong>Rental Period:</strong> The rental period begins on the delivery date and continues monthly until terminated by either party with 30 days' written notice.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Payment Terms:</strong> Monthly rental fees are due in advance. Late payments may incur a 5% penalty fee.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Maintenance:</strong> SmartChill Solutions is responsible for routine maintenance and repairs. Customers must report any issues within 24 hours.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Liability:</strong> Customers are liable for damages resulting from negligence, misuse, or unauthorized repairs.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Cancellation:</strong> Orders can be cancelled within 24 hours of placement without penalty. After delivery, standard rental terms apply.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Delivery:</strong> Delivery dates are estimates. SmartChill Solutions is not liable for delays due to unforeseen circumstances.
                                        </li>
                                        <li class="mb-2">
                                            <strong>Usage:</strong> Equipment must be used in compliance with manufacturer guidelines and local regulations.
                                        </li>
                                    </ol>
                                    <p class="small text-muted mb-0">
                                        By placing this order, you acknowledge that you have read, understood, and agree to be bound by these Terms and Conditions.
                                    </p>
                                </div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                                    <label class="form-check-label fw-semibold" for="agreeTerms">
                                        I have read and agree to the Terms & Conditions *
                                    </label>
                                    <div class="invalid-feedback">
                                        You must agree to the terms and conditions before placing your order.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <button type="submit" class="btn btn-primary w-100 py-3 fs-5 fw-semibold rounded-pill shadow" id="placeOrderBtn" disabled>
                    <i class="bi bi-check-circle me-2"></i> Place Order
                </button>
                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-lock me-1"></i>
                        Your order will be processed securely
                    </small>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const agreeCheckbox = document.getElementById('agreeTerms');
            const placeOrderBtn = document.getElementById('placeOrderBtn');
            const orderForm = document.getElementById('orderForm');

            // Enable/disable place order button based on terms agreement
            agreeCheckbox.addEventListener('change', function () {
                placeOrderBtn.disabled = !this.checked;
            });

            // Form submission handler
            orderForm.addEventListener('submit', function (e) {
                e.preventDefault();

                if (!agreeCheckbox.checked) {
                    // Show error if terms not agreed
                    Swal.fire({
                        icon: 'warning',
                        title: 'Terms Required',
                        text: 'Please read and agree to the Terms & Conditions before placing your order.',
                        confirmButtonColor: '#3085d6',
                        confirmButtonText: 'I Understand'
                    });
                    return;
                }

                // Show confirmation dialog
                Swal.fire({
                    title: 'Confirm Your Order',
                    html: `
                        <div class="text-start">
                            <p class="mb-2">Are you ready to place your order?</p>
                            <div class="alert alert-info border-0 py-2 mb-3">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Total Amount:</strong> @Model.RequestHeader.RequestTotal.ToString("c")
                            </div>
                            <p class="small text-muted mb-0">
                                Your cart items will be converted to a rental order. You can track your order status in your account dashboard.
                            </p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, Place Order!',
                    cancelButtonText: 'Review Order',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Show processing state
                        placeOrderBtn.disabled = true;
                        placeOrderBtn.innerHTML = '<i class="bi bi-arrow-repeat spin me-2"></i> Processing Order...';

                        // Submit the form
                        orderForm.submit();
                    }
                });
            });

            // Add spinner animation style
            const style = document.createElement('style');
            style.innerHTML = `
                .spin { animation: spin 1s linear infinite; }
                keyframes spin { 100% { transform: rotate(360deg); } }
            `;
            document.head.appendChild(style);
        });
    </script>
}