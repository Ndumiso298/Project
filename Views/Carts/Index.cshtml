<!-- Views/Carts/Index.cshtml -->
@model AllocationCartVM
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "My Fridge Cart";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-shopping-cart me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-light text-dark fs-6">
                                <i class="fas fa-boxes me-1"></i>@Model.Items.Count items
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Items.Any())
                    {
                        <div class="row">
                            <!-- Cart Items -->
                            <div class="col-lg-8">
                                <div class="card mb-4">
                                    <div class="card-header bg-light">
                                        <h5 class="card-title mb-0">Cart Items</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Fridge Model</th>
                                                        <th>Monthly Rental</th>
                                                        <th>Quantity</th>
                                                        <th>Available Stock</th>
                                                        <th>Monthly Subtotal</th>
                                                        <th>Contract Value</th>
                                                        <th>Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="cartItemsBody">
                                                    @foreach (var item in Model.Items)
                                                    {
                                                        <tr data-temp-id="@item.TempId">
                                                            <td>
                                                                <div class="d-flex align-items-center">
                                                                    <div class="flex-shrink-0">
                                                                        <i class="fas fa-refrigerator fa-2x text-primary"></i>
                                                                    </div>
                                                                    <div class="flex-grow-1 ms-3">
                                                                        <h6 class="mb-1">@item.ModelName</h6>
                                                                        <small class="text-muted">
                                                                           @item.Manufacturer • (@item.FridgeModel?.CapacityLiters ?? 0) L
                                                                        </small>
                                                                        <br />
                                                                        <small class="text-muted">Model: (@item.FridgeModel?.ModelCode)</small>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td class="align-middle">
                                                                R @item.MonthlyRentalPrice.ToString("N2")
                                                            </td>
                                                            <td class="align-middle">
                                                                <div class="input-group input-group-sm" style="width: 120px;">
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            onclick="updateQuantity('@item.TempId', @item.Quantity - 1)">
                                                                        <i class="fas fa-minus"></i>
                                                                    </button>
                                                                    <input type="number" class="form-control text-center quantity-input"
                                                                           value="@item.Quantity" min="1"
                                                                           onchange="updateQuantity('@item.TempId', this.value)"
                                                                           data-temp-id="@item.TempId" />
                                                                    <button class="btn btn-outline-secondary" type="button"
                                                                            onclick="updateQuantity('@item.TempId', @item.Quantity + 1)">
                                                                        <i class="fas fa-plus"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                            <td class="align-middle">
                                                                @if (item.HasSufficientStock)
                                                                {
                                                                    <span class="badge bg-success">@item.AvailableStock available</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge bg-warning">Only @item.AvailableStock available</span>
                                                                }
                                                            </td>
                                                            <td class="align-middle monthly-subtotal">
                                                                R @item.MonthlyTotal.ToString("N2")
                                                            </td>
                                                            <td class="align-middle contract-value">
                                                                R @item.LineTotal.ToString("N2")
                                                            </td>
                                                            <td class="align-middle">
                                                                <button class="btn btn-sm btn-outline-danger"
                                                                        onclick="removeItem('@item.TempId')"
                                                                        title="Remove from cart">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Add Item Form -->
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <h5 class="card-title mb-0">Add More Fridges</h5>
                                    </div>
                                    <div class="card-body">
                                        <form id="addItemForm" method="post" asp-action="AddItem">
                                            @Html.AntiForgeryToken()
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label for="FridgeModelId" class="form-label required">Fridge Model</label>
                                                    <select id="FridgeModelId" name="FridgeModelId" class="form-select" required>
                                                        <option value="">-- Select Fridge Model --</option>
                                                        @foreach (var fridgeModel in ViewBag.FridgeModelList)
                                                        {
                                                            <option value="@fridgeModel.Value">@fridgeModel.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label for="Quantity" class="form-label required">Quantity</label>
                                                    <input type="number" id="Quantity" name="Quantity" class="form-control"
                                                           min="1" value="1" required />
                                                </div>
                                                <div class="col-md-3">
                                                    <label for="RentalDuration" class="form-label required">Duration (Months)</label>
                                                    <select id="RentalDuration" name="RentalDuration" class="form-select" required>
                                                        <option value="12">12 months</option>
                                                        <option value="24" selected>24 months</option>
                                                        <option value="36">36 months</option>
                                                        <option value="48">48 months</option>
                                                    </select>
                                                </div>
                                                <div class="col-12">
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="fas fa-plus-circle me-1"></i>Add to Cart
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Cart Summary & Checkout -->
                            <div class="col-lg-4">
                                <div class="card sticky-top" style="top: 20px;">
                                    <div class="card-header bg-success text-white">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-receipt me-2"></i>Cart Summary
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Items:</span>
                                            <strong id="summaryItemCount">@Model.Items.Count</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Total Monthly Rental:</span>
                                            <strong id="summaryMonthlyTotal">R @Model.TotalMonthlyRental.ToString("N2")</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span>Contract Duration:</span>
                                            <strong>24 months</strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-3 fs-5">
                                            <span>Total Contract Value:</span>
                                            <strong id="summaryContractValue">R @Model.TotalContractValue.ToString("N2")</strong>
                                        </div>
                                        <hr />

                                        <!-- Customer Information -->
                                        <div class="mb-4">
                                            <h6 class="text-muted mb-3">Delivery Information</h6>
                                            <div class="small">
                                                <div><strong>@Model.CustomerName</strong></div>
                                                <div>@Model.CustomerBusinessType</div>
                                                <div class="text-muted">@Model.Email</div>
                                                <div class="text-muted">@Model.PhoneNumber</div>
                                            </div>
                                        </div>

                                        <!-- Checkout Button -->
                                        <form method="post" asp-action="SubmitRequest">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="CustomerId" value="@Model.CustomerId" />
                                            <button type="submit" class="btn btn-primary w-100 btn-lg"
                                            @(Model.IsValid ? "" : "disabled")>
                                                <i class="fas fa-paper-plane me-2"></i>
                                                Submit Allocation Request
                                            </button>
                                        </form>

                                        <!-- Continue Shopping -->
                                        <div class="text-center mt-3">
                                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                                                <i class="fas fa-arrow-left me-1"></i>Continue Shopping
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Empty Cart State -->
                        <div class="text-center py-5">
                            <div class="empty-cart-icon mb-4">
                                <i class="fas fa-shopping-cart fa-4x text-muted"></i>
                            </div>
                            <h4 class="text-muted mb-3">Your cart is empty</h4>
                            <p class="text-muted mb-4">Start adding fridges to your cart to create an allocation request.</p>
                            <div class="row justify-content-center">
                                <div class="col-md-6">
                                    <!-- Add Item Form for Empty Cart -->
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title">Add Your First Fridge</h5>
                                            <form id="addItemForm" method="post" asp-action="AddItem">
                                                @Html.AntiForgeryToken()
                                                <div class="row g-3">
                                                    <div class="col-12">
                                                        <label for="FridgeModelId" class="form-label required">Fridge Model</label>
                                                        <select id="FridgeModelId" name="FridgeModelId" class="form-select" required>
                                                            <option value="">-- Select Fridge Model --</option>
                                                            @foreach (var fridgeModel in ViewBag.FridgeModelList)
                                                            {
                                                                <option value="@fridgeModel.Value">@fridgeModel.Text</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="Quantity" class="form-label required">Quantity</label>
                                                        <input type="number" id="Quantity" name="Quantity" class="form-control"
                                                               min="1" value="1" required />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="RentalDuration" class="form-label required">Duration</label>
                                                        <select id="RentalDuration" name="RentalDuration" class="form-select" required>
                                                            <option value="12">12 months</option>
                                                            <option value="24" selected>24 months</option>
                                                            <option value="36">36 months</option>
                                                            <option value="48">48 months</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-12">
                                                        <button type="submit" class="btn btn-success w-100">
                                                            <i class="fas fa-plus-circle me-1"></i>Add to Cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Spinner Modal -->
<div class="modal fade" id="loadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mb-0">Updating cart...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update quantity function
        function updateQuantity(tempId, newQuantity) {
            if (newQuantity < 1) return;

            showLoading();

            fetch('@Url.Action("UpdateItem", "Carts")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    tempId: tempId,
                    quantity: parseInt(newQuantity),
                    rentalDuration: 24 // Fixed for now, could be made dynamic
                })
            })
            .then(response => response.json())
            .then(data => {
                hideLoading();
                if (data.success) {
                    // Update the row with new values
                    const row = document.querySelector(`tr[data-temp-id="${tempId}"]`);
                    if (row) {
                        const monthlySubtotal = (data.item.monthlyRentalPrice * newQuantity).toFixed(2);
                        const contractValue = (data.item.monthlyRentalPrice * newQuantity * 24).toFixed(2);

                        row.querySelector('.monthly-subtotal').textContent = 'R ' + monthlySubtotal;
                        row.querySelector('.contract-value').textContent = 'R ' + contractValue;

                        // Update stock badge
                        const stockBadge = row.querySelector('.badge');
                        if (data.item.hasSufficientStock) {
                            stockBadge.className = 'badge bg-success';
                            stockBadge.textContent = data.item.availableStock + ' available';
                        } else {
                            stockBadge.className = 'badge bg-warning';
                            stockBadge.textContent = 'Only ' + data.item.availableStock + ' available';
                        }
                    }

                    // Update summary
                    updateCartSummary(data.summary);
                    showToast('Item updated successfully', 'success');
                } else {
                    showToast(data.message, 'error');
                    // Reload the page to sync state
                    setTimeout(() => location.reload(), 1000);
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Error updating item:', error);
                showToast('Error updating item', 'error');
            });
        }

        // Remove item function
        function removeItem(tempId) {
            if (!confirm('Are you sure you want to remove this item from your cart?')) {
                return;
            }

            showLoading();

            fetch('@Url.Action("RemoveItem", "Carts")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ tempId: tempId })
            })
            .then(response => {
                hideLoading();
                if (response.ok) {
                    // Remove the row from table
                    const row = document.querySelector(`tr[data-temp-id="${tempId}"]`);
                    if (row) {
                        row.remove();
                    }

                    // Update summary
                    updateCartSummaryFromServer();
                    showToast('Item removed from cart', 'success');

                    // If no items left, reload to show empty state
                    if (document.querySelectorAll('#cartItemsBody tr').length === 0) {
                        setTimeout(() => location.reload(), 1000);
                    }
                } else {
                    showToast('Error removing item', 'error');
                }
            })
            .catch(error => {
                hideLoading();
                console.error('Error removing item:', error);
                showToast('Error removing item', 'error');
            });
        }

        // Update cart summary from server
        function updateCartSummaryFromServer() {
            fetch('@Url.Action("GetSummary", "Carts")')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        updateCartSummary(data.summary);
                    }
                })
                .catch(error => console.error('Error getting cart summary:', error));
        }

        // Update cart summary display
        function updateCartSummary(summary) {
            document.getElementById('summaryItemCount').textContent = summary.itemCount;
            document.getElementById('summaryMonthlyTotal').textContent = 'R ' + summary.totalMonthlyRental.toFixed(2);
            document.getElementById('summaryContractValue').textContent = 'R ' + summary.totalContractValue.toFixed(2);
        }

        // Loading modal functions
        function showLoading() {
            new bootstrap.Modal(document.getElementById('loadingModal')).show();
        }

        function hideLoading() {
            const modal = bootstrap.Modal.getInstance(document.getElementById('loadingModal'));
            if (modal) {
                modal.hide();
            }
        }

        // Toast notification function
        function showToast(message, type = 'info') {
            // Create toast element
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : type} border-0`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;

            // Add to container
            const container = document.getElementById('toastContainer') || createToastContainer();
            container.appendChild(toast);

            // Show toast
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();

            // Remove after hide
            toast.addEventListener('hidden.bs.toast', () => {
                toast.remove();
            });
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toastContainer';
            container.className = 'toast-container position-fixed top-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
            return container;
        }

        // Form validation for add item
        document.getElementById('addItemForm')?.addEventListener('submit', function(e) {
            const fridgeModel = document.getElementById('FridgeModelId');
            const quantity = document.getElementById('Quantity');

            if (!fridgeModel.value || !quantity.value || quantity.value < 1) {
                e.preventDefault();
                showToast('Please select a fridge model and quantity', 'error');
            }
        });

        // Initialize quantity inputs
        document.addEventListener('DOMContentLoaded', function() {
            // Prevent invalid quantity inputs
            document.querySelectorAll('.quantity-input').forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value < 1) {
                        this.value = 1;
                    }
                });
            });

            // Update cart summary on load
            updateCartSummaryFromServer();
        });
    </script>
}