@model AllocationCartSummaryVM

<div class="cart-summary">
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Items:</span>
        <span class="fw-semibold" id="summary-item-count">@Model.ItemCount</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Total Monthly Rental:</span>
        <span class="fw-semibold text-success" id="summary-monthly-rental">@Model.TotalMonthlyRental.ToString("C")</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Contract Duration:</span>
        <span class="fw-semibold" id="summary-duration">@Model.AverageRentalDuration months</span>
    </div>
    <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
        <span class="text-muted">Total Contract Value:</span>
        <span class="fw-semibold text-success" id="summary-total-value">@Model.TotalContractValue.ToString("C")</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Savings:</span>
        <span class="fw-semibold text-success" id="summary-savings">@Model.DiscountSavings.ToString("C")</span>
    </div>
    <div class="d-flex justify-content-between fs-5 fw-bold pt-2 border-top">
        <span>Final Amount:</span>
        <span class="text-success" id="summary-final-amount">@Model.FinalAmount.ToString("C")</span>
    </div>
</div>

@if (!Model.HasItems)
{
    <div class="text-center text-muted py-3">
        <i class="fas fa-shopping-cart fa-2x opacity-25 mb-2"></i>
        <p class="mb-0">Your cart is empty</p>
    </div>
}