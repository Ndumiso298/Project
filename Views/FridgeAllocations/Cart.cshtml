@model AllocationCartVM
@{
    ViewData["Title"] = "My Fridge Cart";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Allocations
                    </a>
                    @if (Model.Allocations.Any())
                    {
                        <form asp-action="SubmitRequest" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-paper-plane"></i> Submit Request
                            </button>
                        </form>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (Model.Allocations.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Fridge Serial</th>
                                    <th>Model</th>
                                    <th>Capacity</th>
                                    <th>Allocation Date</th>
                                    <th>Monthly Rental</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var allocation in Model.Allocations)
                                {
                                    <tr>
                                        <td>@allocation.Fridge?.SerialNumber</td>
                                        <td>@allocation.Fridge?.Model</td>
                                        <td>@allocation.Fridge?.CapacityLiters L</td>
                                        <td>@allocation.AllocationDate.ToString("dd/MM/yyyy")</td>
@*                                         <td>@allocation.Fridge?.RentalPricePerMonth.ToString("C")</td>
 *@                                        <td>
                                            <a asp-action="Details" asp-route-id="@allocation.Id"
                                               class="btn btn-sm btn-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-active">
                                    <td colspan="4" class="text-end"><strong>Total Monthly Cost:</strong></td>
                                    <td><strong>@Model.Total.ToString("C")</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-8">
                            <div class="alert alert-info">
                                <h5><i class="fas fa-info-circle"></i> Important Information</h5>
                                <ul class="mb-0">
                                    <li>Your allocation request will be reviewed by our team</li>
                                    <li>You will receive a confirmation email once approved</li>
                                    <li>Monthly billing will start from the allocation date</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                        <h4>Your cart is empty</h4>
                        <p class="text-muted">You don't have any fridge allocations in your cart.</p>
                        <a asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-search"></i> Browse Available Fridges
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>