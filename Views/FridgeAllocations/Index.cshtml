@model IEnumerable<FridgeAllocationVM>
@{
    ViewData["Title"] = "Fridge Allocations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-truck-loading me-2"></i>@ViewData["Title"]</h1>
    @if (User.IsInRole("Admin") || User.IsInRole("CustomerSupport"))
    {
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Allocation
        </a>
    }
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <h5 class="mb-0">Active Allocations</h5>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">@Model.Count() allocations found</small>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5>No allocations found</h5>
                <p class="text-muted">Get started by creating your first fridge allocation.</p>
                <a asp-action="Upsert" class="btn btn-primary">Create Allocation</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Allocation ID</th>
                            <th>Customer</th>
                            <th>Fridge</th>
                            <th>Location</th>
                            <th>Allocation Date</th>
                            <th>Monthly Rental</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>#@item.Id.ToString("00000")</strong>
                                </td>
                                <td>
                                    <div class="fw-bold">@item.CustomerDetails?.BusinessName</div>
                                    <small class="text-muted">@item.CustomerDetails?.BusinessType</small>
                                </td>
                                <td>
                                    @if (item.FridgeDetails != null)
                                    {
                                        <div>@item.FridgeDetails.DisplayName</div>
                                        <small class="text-muted">@item.FridgeDetails.SerialNumber</small>
                                    }
                                </td>
                                <td>
                                    @item.LocationDetails?.ToString()
                                </td>
                                <td>@item.AllocationDate.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold text-success">@item.MonthlyRentalPrice.ToString("C")</td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass">@item.Status</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.CanEdit)
                                        {
                                            <a asp-action="Upsert" asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (item.CanDeallocate)
                                        {
                                            <a asp-action="Deallocate" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning" title="Deallocate">
                                                <i class="fas fa-undo"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>