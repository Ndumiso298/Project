@model IEnumerable<FridgeAllocation>
@{
    ViewData["Title"] = "Fridge Allocations";
    var isCustomer = User.IsInRole("Customer");
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                @if (!isCustomer)
                {
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus"></i> New Allocation
                    </a>
                }
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered" id="allocationsTable">
                            <thead>
                                <tr>
                                    <th>Fridge Serial</th>
                                    <th>Customer</th>
                                    <th>Allocation Date</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var allocation in Model)
                                {
                                    <tr>
                                        <td>@allocation.Fridge?.SerialNumber</td>
                                        <td>@allocation.Customer?.TradingName</td>
                                        <td>@allocation.AllocationDate.ToString("dd/MM/yyyy")</td>
                                        <td>@allocation.AllocationLocation?.Name</td>
                                        <td>
                                            <span class="badge @(allocation.ActualReturnDate == null ? "bg-success" : "bg-secondary")">
                                                @(allocation.ActualReturnDate == null ? "Active" : "Deallocated")
                                            </span>
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@allocation.Id"
                                                   class="btn btn-sm btn-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (!isCustomer)
                                                {
                                                    <a asp-action="Upsert" asp-route-id="@allocation.Id"
                                                       class="btn btn-sm btn-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (allocation.ActualReturnDate == null)
                                                    {
                                                        <a asp-action="Deallocate" asp-route-id="@allocation.Id"
                                                           class="btn btn-sm btn-danger" title="Deallocate">
                                                            <i class="fas fa-undo"></i>
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> No allocations found.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#allocationsTable').DataTable({
                "order": [[2, "desc"]],
                "responsive": true
            });
        });
    </script>
}