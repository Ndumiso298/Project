<!-- Views/FridgeAllocations/Index.cshtml -->
@model IEnumerable<FridgeAllocationVM>
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "Fridge Allocations";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isCustomer = User.IsInRole(SD.CustomerRole);
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-refrigerator me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        @if (!isCustomer)
                        {
                            <div class="col-auto">
                                <a class="btn btn-success" asp-action="Upsert">
                                    <i class="fas fa-plus-circle me-1"></i>New Allocation
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Allocations Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Allocation #</th>
                                    <th>Allocation Date</th>
                                    <th>Fridge Serial</th>
                                    <th>Customer</th>
                                    <th>Location</th>
                                    <th>Monthly Rental</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var allocation in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>#@allocation.Id</strong>
                                        </td>
                                        <td>@allocation.AllocationDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (allocation.FridgeDetails != null)
                                            {
                                                <span class="badge bg-secondary">@allocation.FridgeDetails.SerialNumber</span>
                                            }
                                        </td>
                                        <td>
                                            <div>@allocation.CustomerDetails?.TradingName</div>
                                            <small class="text-muted">@allocation.CustomerDetails?.BusinessType</small>
                                        </td>
                                        <td>
                                            @if (allocation.LocationDetails != null)
                                            {
                                                <div>@allocation.LocationDetails.ToString()</div>
                                            }
                                        </td>
                                        <td>R @allocation.MonthlyRentalPrice.ToString("N2")</td>
                                        <td>@GetStatusBadge(allocation.Status)</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@allocation.Id"
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (!isCustomer && allocation.CanEdit)
                                                {
                                                    <a asp-action="Upsert" asp-route-id="@allocation.Id"
                                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }
                                                @if (!isCustomer && allocation.CanDeallocate)
                                                {
                                                    <a asp-action="Deallocate" asp-route-id="@allocation.Id"
                                                       class="btn btn-sm btn-outline-info" title="Deallocate">
                                                        <i class="fas fa-undo"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-refrigerator fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Active Allocations</h4>
                            <p class="text-muted">No fridge allocations found matching your criteria.</p>
                            @if (!isCustomer)
                            {
                                <a asp-action="Upsert" class="btn btn-primary">
                                    <i class="fas fa-plus-circle me-1"></i>Create First Allocation
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private IHtmlContent GetStatusBadge(AllocationStatus status)
    {
        var badgeClass = status switch
        {
            AllocationStatus.Pending => "bg-secondary",
            AllocationStatus.Active => "bg-success",
            AllocationStatus.Suspended => "bg-warning",
            AllocationStatus.Completed => "bg-info",
            AllocationStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }
}