<!-- Views/FridgeAllocations/Deallocate.cshtml -->
@model DeallocationVM
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "Deallocate Fridge";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-undo me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Details" asp-route-id="@Model.AllocationId" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Back to Details
                            </a>
                        </div>
                    </div>
                </div>
                <form asp-action="Deallocate" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AllocationId" />
                    
                    <div class="card-body">
                        <!-- Allocation Summary -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Allocation Summary</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr>
                                                <td><strong>Fridge:</strong></td>
                                                <td>@Model.FridgeSerialNumber</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Model:</strong></td>
                                                <td>@Model.FridgeModel</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Customer:</strong></td>
                                                <td>@Model.CustomerName</td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <table class="table table-sm table-borderless">
                                            <tr>
                                                <td><strong>Business Type:</strong></td>
                                                <td>@Model.CustomerBusinessType</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Allocation Date:</strong></td>
                                                <td>@Model.AllocationDate.ToString("dd/MM/yyyy")</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Monthly Rental:</strong></td>
                                                <td>R @Model.MonthlyRental.ToString("N2")</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Deallocation Details -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Deallocation Details</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label asp-for="DeallocationDate" class="form-label required">Deallocation Date *</label>
                                        <input asp-for="DeallocationDate" type="date" class="form-control" required />
                                        <span asp-validation-for="DeallocationDate" class="text-danger"></span>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label asp-for="ReturnCondition" class="form-label required">Fridge Condition *</label>
                                        <select asp-for="ReturnCondition" asp-items="Model.FridgeConditionList" class="form-select" required>
                                            <option value="">-- Select Condition --</option>
                                        </select>
                                        <span asp-validation-for="ReturnCondition" class="text-danger"></span>
                                    </div>
                                    
                                    <div class="col-12">
                                        <label asp-for="DeallocationReason" class="form-label required">Deallocation Reason *</label>
                                        <textarea asp-for="DeallocationReason" class="form-control" rows="3" 
                                                  placeholder="Please provide the reason for deallocation..." required></textarea>
                                        <span asp-validation-for="DeallocationReason" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fridge Disposition -->
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Fridge Disposition</h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="CanBeReallocated" value="true" id="reallocateYes">
                                            <label class="form-check-label" for="reallocateYes">
                                                <strong>Available for Reallocation</strong>
                                                <br />
                                                <small class="text-muted">Fridge is in good condition and can be reallocated to another customer</small>
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="RequiresMaintenance" value="true" id="maintenanceYes">
                                            <label class="form-check-label" for="maintenanceYes">
                                                <strong>Requires Maintenance</strong>
                                                <br />
                                                <small class="text-muted">Fridge needs maintenance before it can be reallocated</small>
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="ShouldBeScrapped" value="true" id="scrapYes">
                                            <label class="form-check-label" for="scrapYes">
                                                <strong>Should Be Scrapped</strong>
                                                <br />
                                                <small class="text-muted">Fridge is beyond repair and should be disposed of</small>
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="col-12" id="maintenanceDetails" style="display: none;">
                                        <label asp-for="MaintenanceRequired" class="form-label">Maintenance Required</label>
                                        <textarea asp-for="MaintenanceRequired" class="form-control" rows="3" 
                                                  placeholder="Describe what maintenance is required..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Final Notes -->
                        <div class="card">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Final Notes</h5>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="AdditionalNotes" class="form-label">Additional Notes</label>
                                    <textarea asp-for="AdditionalNotes" class="form-control" rows="3"
                                              placeholder="Any additional notes about the deallocation..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer bg-light">
                        <div class="row">
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-warning me-2">
                                    <i class="fas fa-undo me-1"></i>Confirm Deallocation
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.AllocationId" class="btn btn-secondary">Cancel</a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script>
        $(document).ready(function() {
            // Set default deallocation date to today
            var today = new Date().toISOString().split('T')[0];
            $('#DeallocationDate').val(today);
            
            // Show/hide maintenance details based on radio selection
            $('input[type="radio"]').change(function() {
                if ($('#maintenanceYes').is(':checked')) {
                    $('#maintenanceDetails').show();
                } else {
                    $('#maintenanceDetails').hide();
                }
            });
            
            // Initialize on page load
            if ($('#maintenanceYes').is(':checked')) {
                $('#maintenanceDetails').show();
            }
        });
    </script>
}