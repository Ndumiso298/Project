@model FridgeAllocationVM
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Allocation" : "Edit Allocation";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="Upsert" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="FridgeId" class="form-label"></label>
                                <select asp-for="FridgeId" asp-items="Model.FridgeList" class="form-select">
                                    <option value="">-- Select Fridge --</option>
                                </select>
                                <span asp-validation-for="FridgeId" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="CustomerId" class="form-label"></label>
                                <select asp-for="CustomerId" asp-items="Model.CustomerList" class="form-select">
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="AllocationLocationId" class="form-label"></label>
                                <select asp-for="AllocationLocationId" asp-items="Model.LocationList" class="form-select">
                                    <option value="">-- Select Location --</option>
                                </select>
                                <span asp-validation-for="AllocationLocationId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="AllocationDate" class="form-label"></label>
                                <input asp-for="AllocationDate" class="form-control" />
                                <span asp-validation-for="AllocationDate" class="text-danger"></span>
                            </div>

                            @if (Model.Id != 0)
                            {
                                    <div class="form-group mb-3">
                                        <label asp-for="DeallocationDate" class="form-label"></label>
                                        <input asp-for="DeallocationDate" class="form-control" />
                                        <span asp-validation-for="DeallocationDate" class="text-danger"></span>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label asp-for="DeallocationReason" class="form-label"></label>
                                        <textarea asp-for="DeallocationReason" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="DeallocationReason" class="text-danger"></span>
                                    </div>
                            }
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <div class="btn-group" role="group">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> @(Model.Id == 0 ? "Create" : "Update")
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        <script>
            $(document).ready(function () {
                $('#AllocationDate').datetimepicker({
                    format: 'DD/MM/YYYY HH:mm',
                    sideBySide: true
                });

                $('#DeallocationDate').datetimepicker({
                    format: 'DD/MM/YYYY HH:mm',
                    sideBySide: true
                });
            });
        </script>
}