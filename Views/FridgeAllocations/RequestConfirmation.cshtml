@model int
@{
    ViewData["Title"] = "Request Submitted";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="text-success mb-4">
                    <i class="fas fa-check-circle fa-5x"></i>
                </div>

                <h2 class="text-success">Request Submitted Successfully!</h2>

                <p class="lead mt-3">
                    Your fridge allocation request has been received and is being processed.
                </p>

                <div class="alert alert-info mt-4">
                    <h5><i class="fas fa-info-circle"></i> What happens next?</h5>
                    <ul class="text-start mb-0">
                        <li>Your request will be reviewed by our team</li>
                        <li>You will receive a confirmation email shortly</li>
                        <li>Our support team may contact you for additional information</li>
                    </ul>
                </div>

                <div class="mt-4">
                    <p><strong>Reference Number:</strong> #@Model.ToString("D6")</p>
                </div>

                <div class="mt-5">
                    <a asp-action="Index" class="btn btn-primary me-2">
                        <i class="fas fa-list"></i> View My Allocations
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-home"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>