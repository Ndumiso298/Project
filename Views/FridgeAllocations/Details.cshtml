<!-- Views/FridgeAllocations/Details.cshtml -->
@model FridgeAllocationVM
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = $"Allocation Details #{Model.Id}";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isCustomer = User.IsInRole(SD.CustomerRole);
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-refrigerator me-2"></i>@ViewData["Title"]
                    </h3>
                    <div>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Action Buttons -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="btn-group" role="group">
                                @if (!isCustomer && Model.CanEdit)
                                {
                                    <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning">
                                        <i class="fas fa-edit me-1"></i>Edit Allocation
                                    </a>
                                }
                                @if (!isCustomer && Model.CanDeallocate)
                                {
                                    <a asp-action="Deallocate" asp-route-id="@Model.Id" class="btn btn-info">
                                        <i class="fas fa-undo me-1"></i>Deallocate Fridge
                                    </a>
                                }
                                @if (User.IsInRole(SD.AdminRole) && Model.Status == AllocationStatus.Pending)
                                {
                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                        <i class="fas fa-trash me-1"></i>Delete
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Allocation Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Allocation Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Allocation #:</strong></td>
                                            <td>#@Model.Id</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>@GetStatusBadge(Model.Status)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Allocation Date:</strong></td>
                                            <td>@Model.AllocationDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Expected Return:</strong></td>
                                            <td>@(Model.ExpectedReturnDate?.ToString("dd/MM/yyyy") ?? "Not specified")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Actual Return:</strong></td>
                                            <td>@(Model.ActualReturnDate?.ToString("dd/MM/yyyy") ?? "Not returned")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Monthly Rental:</strong></td>
                                            <td>R @Model.MonthlyRentalPrice.ToString("N2")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Quantity:</strong></td>
                                            <td>@Model.Quantity</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Fridge Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Fridge Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Serial Number:</strong></td>
                                            <td>@Model.FridgeDetails?.SerialNumber</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Model:</strong></td>
                                            <td>@Model.FridgeDetails?.FridgeModelDetails?.DisplayName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Manufacturer:</strong></td>
                                            <td>@Model.FridgeDetails?.FridgeModelDetails?.Manufacturer</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Capacity:</strong></td>
                                            <td>@Model.FridgeDetails?.FridgeModelDetails?.CapacityLiters L</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Current Status:</strong></td>
                                            <td>@GetFridgeStatusBadge(Model.FridgeDetails?.Status ?? FridgeStatus.QualityControl)</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- Customer Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Customer Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Customer:</strong></td>
                                            <td>@Model.CustomerDetails?.TradingName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Business Type:</strong></td>
                                            <td>@Model.CustomerDetails?.BusinessType</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Contact:</strong></td>
                                            <td>@Model.CustomerDetails?.FullName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Phone:</strong></td>
                                            <td>@Model.CustomerDetails?.BusinessPhoneNumber</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Email:</strong></td>
                                            <td>@Model.CustomerDetails?.BusinessEmail</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Delivery Information -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-light">
                                    <h5 class="card-title mb-0">Delivery Information</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Delivery Location:</strong></td>
                                            <td>@Model.LocationDetails?.ToString()</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Allocated By:</strong></td>
                                            <td>
                                            <td>
                                                    @Model.AllocatedByEmployeeName
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Processed By:</strong></td>
                                            <td>
                                                @Model.ProcessedByEmployeeName
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-light">
                                <h5 class="card-title mb-0">Notes</h5>
                            </div>
                            <div class="card-body">
                                <p class="mb-0">@Model.Notes</p>
                            </div>
                        </div>
                    }

                    <!-- Maintenance History -->
                    @if (Model.MaintenanceVisits?.Any() == true)
                    {
                        <div class="card mb-4">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">Maintenance History</h5>
                                <span class="badge bg-primary">@Model.MaintenanceVisits.Count visits</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Visit #</th>
                                                <th>Date</th>
                                                <th>Status</th>
                                                <th>Technician</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var visit in Model.MaintenanceVisits)
                                            {
                                                <tr>
                                                    <td>#@visit.Id</td>
                                                    <td>@visit.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@GetServiceStatusBadge(visit.Status)</td>
                                                    <td>
                                                        @if (visit.Technician != null)
                                                        {
                                                            @visit.Technician.UserAccount?.FirstName @visit.Technician.UserAccount?.LastName
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="text-truncate" style="max-width: 200px;">
                                                            @visit.IssueDescription
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Fault History -->
                    @if (Model.FaultReports?.Any() == true)
                    {
                        <div class="card">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0">Fault History</h5>
                                <span class="badge bg-warning">@Model.FaultReports.Count faults</span>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Fault #</th>
                                                <th>Reported Date</th>
                                                <th>Status</th>
                                                <th>Priority</th>
                                                <th>Description</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var fault in Model.FaultReports)
                                            {
                                                <tr>
                                                    <td>#@fault.Id</td>
                                                    <td>@fault.ReportedDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@GetFaultStatusBadge(fault.Status)</td>
                                                    <td>@GetFaultPriorityBadge(fault.Priority)</td>
                                                    <td>
                                                        <div class="text-truncate" style="max-width: 200px;">
                                                            @fault.Description
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
@if (User.IsInRole(SD.AdminRole) && Model.Status == AllocationStatus.Pending)
{
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Delete Allocation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form method="post" asp-action="SoftDelete" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p>Are you sure you want to delete allocation <strong>#@Model.Id</strong>?</p>
                        <p class="text-muted">This action will make the fridge available for reallocation and cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete Allocation</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@functions {
    private IHtmlContent GetStatusBadge(AllocationStatus status)
    {
        var badgeClass = status switch
        {
            AllocationStatus.Pending => "bg-secondary",
            AllocationStatus.Active => "bg-success",
            AllocationStatus.Suspended => "bg-warning",
            AllocationStatus.Completed => "bg-info",
            AllocationStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetFridgeStatusBadge(FridgeStatus status)
    {
        var badgeClass = status switch
        {
            FridgeStatus.Available => "bg-success",
            FridgeStatus.Allocated => "bg-primary",
            FridgeStatus.InService => "bg-warning",
            FridgeStatus.Quarantined => "bg-danger",
            FridgeStatus.Scrapped => "bg-dark",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetServiceStatusBadge(ServicingStatus status)
    {
        var badgeClass = status switch
        {
            ServicingStatus.Scheduled => "bg-info",
            ServicingStatus.InProgress => "bg-warning",
            ServicingStatus.Completed => "bg-success",
            ServicingStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetFaultStatusBadge(FaultStatus status)
    {
        var badgeClass = status switch
        {
            FaultStatus.Reported => "bg-secondary",
            FaultStatus.InProgress => "bg-info",
            FaultStatus.Resolved => "bg-success",
            FaultStatus.Closed => "bg-dark",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetFaultPriorityBadge(FaultPriority priority)
    {
        var badgeClass = priority switch
        {
            FaultPriority.Low => "bg-success",
            FaultPriority.Medium => "bg-warning",
            FaultPriority.High => "bg-danger",
            FaultPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{priority}</span>");
    }
}