@model IEnumerable<Project.Models.FridgeReplacement>
@{
    ViewData["Title"] = "Manage Replacement Requests";
    Layout = "_CustomerLayout";
}

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-4">Manage Replacement Requests</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped table-hover">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Old Fridge No</th>
                <th>Reason</th>
                <th>Request Date</th>
                <th>Status</th>
                <th>Handled By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.FridgeReplacementId</td>
                    <td>@r.Customer?.ApplicationUser?.FirstName @r.Customer?.ApplicationUser?.LastName</td>
                    <td>@r.OldFridgeNo</td>
                    <td>@r.ReasonForReplacement</td>
                    <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (r.ReplacementStatus == Project.Utility.SD.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (r.ReplacementStatus == Project.Utility.SD.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </td>
                    <td>@r.ApplicationUser?.UserName</td>
                    <td>
                        @if (r.ReplacementStatus == Project.Utility.SD.Pending)
                        {
                            <form asp-action="ApproveReplacement" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@r.FridgeReplacementId" />
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>

                            <form asp-action="RejectReplacement" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@r.FridgeReplacementId" />
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">No actions available</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
