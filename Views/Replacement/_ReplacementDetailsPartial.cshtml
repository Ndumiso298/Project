@model Project.Models.FridgeReplacement

<div class="row">
    <div class="col-md-6">
        <h6 class="fw-bold text-primary mb-3">Customer Information</h6>
        <div class="mb-2">
            <strong>Name:</strong> @Model.Customer?.ApplicationUser?.FirstName @Model.Customer?.ApplicationUser?.LastName
        </div>
        <div class="mb-2">
            <strong>Customer ID:</strong> @Model.CustomerID
        </div>
        <div class="mb-2">
            <strong>Customer Number:</strong> @Model.Customer?.CustomerNumber
        </div>
    </div>

    <div class="col-md-6">
        <h6 class="fw-bold text-primary mb-3">Fridge Information</h6>
        <div class="mb-2">
            <strong>Old Fridge Number:</strong> <span class="badge bg-light text-dark">@Model.OldFridgeNo</span>
        </div>
        <div class="mb-2">
            <strong>Request Date:</strong> @Model.RequestDate.ToString("MMM dd, yyyy hh:mm tt")
        </div>
        <div class="mb-2">
            <strong>Replacement Date:</strong> @Model.ReplacementDate.ToString("MMM dd, yyyy")
        </div>
    </div>
</div>

<hr class="my-4">

<div class="row">
    <div class="col-12">
        <h6 class="fw-bold text-primary mb-3">Replacement Details</h6>
        <div class="mb-3">
            <strong>Reason for Replacement:</strong>
            <p class="mt-1">@Model.ReasonForReplacement</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
        {
            <div class="mb-3">
                <strong>Additional Notes:</strong>
                <p class="mt-1">@Model.AdditionalNotes</p>
            </div>
        }

        <div class="mb-3">
            <strong>Status:</strong>
            @if (Model.ReplacementStatus == SD.Pending)
            {
                <span class="badge bg-warning text-dark ms-2">
                    <i class="bi bi-clock me-1"></i>Pending
                </span>
            }
            else if (Model.ReplacementStatus == SD.Approved)
            {
                <span class="badge bg-success ms-2">
                    <i class="bi bi-check-circle me-1"></i>Approved
                </span>
            }
            else
            {
                <span class="badge bg-danger ms-2">
                    <i class="bi bi-x-circle me-1"></i>Rejected
                </span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ActionBy))
        {
            <div class="mb-3">
                <strong>Processed By:</strong> @Model.ActionBy
            </div>
            <div class="mb-3">
                <strong>Processed On:</strong> @Model.ActionDate?.ToString("MMM dd, yyyy hh:mm tt")
            </div>
        }

        @if (Model.NewFridgeInStockId.HasValue)
        {
            <div class="mb-3">
                <strong>New Fridge:</strong>
                <span class="badge bg-success ms-2">
                    @Model.NewFridgeInStock?.FridgeNo
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
        {
            <div class="mb-3">
                <strong>Technician Notes:</strong>
                <p class="mt-1">@Model.TechnicianNotes</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.DeclineReason))
        {
            <div class="mb-3">
                <strong>Decline Reason:</strong>
                <p class="mt-1 text-danger">@Model.DeclineReason</p>
            </div>
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
    </div>
</div>