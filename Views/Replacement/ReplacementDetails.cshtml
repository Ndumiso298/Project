@model Project.Models.FridgeReplacement
@{
    ViewData["Title"] = "Replacement Details";
    Layout = "_CustomerLayout";
}

<div class="container py-4">
    <h2 class="fw-bold text-primary mb-4">Replacement Request Details</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="mb-3 text-secondary">Request Info</h5>
            <dl class="row">
                <dt class="col-sm-3">Request ID:</dt>
                <dd class="col-sm-9">@Model.FridgeReplacementId</dd>

                <dt class="col-sm-3">Old Fridge No:</dt>
                <dd class="col-sm-9">@Model.OldFridgeNo</dd>

                <dt class="col-sm-3">Fridge Model:</dt>
                <dd class="col-sm-9">@Model.FridgeVisit?.RequestHeader?.RequestFridges?.FirstOrDefault()?.Fridge?.Model</dd>

                <dt class="col-sm-3">Reason for Replacement:</dt>
                <dd class="col-sm-9">@Model.ReasonForReplacement</dd>

                <dt class="col-sm-3">Additional Notes:</dt>
                <dd class="col-sm-9">@Model.AdditionalNotes</dd>

                <dt class="col-sm-3">Replacement Date:</dt>
                <dd class="col-sm-9">@Model.ReplacementDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Request Date:</dt>
                <dd class="col-sm-9">@Model.RequestDate.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    @if (Model.ReplacementStatus == Project.Utility.SD.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (Model.ReplacementStatus == Project.Utility.SD.Approved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (Model.ReplacementStatus == Project.Utility.SD.Rejected)
                    {
                        <span class="badge bg-danger">Rejected</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="ReplacementRequests" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>
