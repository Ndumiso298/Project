@model IEnumerable<AllocationRequestHeader>

@{
    ViewData["Title"] = "Allocation Requests";
    var isCustomer = User.IsInRole("Customer");
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">@ViewData["Title"]</h2>
        </div>
        <div class="col-6 text-end">
            @if (!isCustomer)
            {
                <a asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> &nbsp; Create New Request
                </a>
            }
            else
            {
                <a asp-action="Upsert" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> &nbsp; New Fridge Request
                </a>
            }
        </div>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select" asp-items="ViewBag.StatusList">
                        <option value="All">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="searchString" class="form-label">Search</label>
                    <input type="text" id="searchString" name="searchString" class="form-control"
                           placeholder="Search by customer, name, or phone..." value="@ViewBag.SearchString">
                </div>
                <div class="col-md-3">
                    <label class="form-label">&nbsp;</label>
                    <div>
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-funnel"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Requests Table -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Request #</th>
                                <th>Customer</th>
                                <th>Request Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>@request.Id</td>
                                    <td>
                                        <strong>@request.Customer?.TradingName</strong><br>
                                        <small class="text-muted">@request.FirstName @request.LastName</small>
                                    </td>
                                    <td>@request.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@request.RequestTotal.ToString("C")</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(request.Status)">@request.Status</span>
                                    </td>
                                    <td>@request.RequestedFridges.Sum(rd => rd.Quantity) items</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@request.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            @if (request.Status == "Pending" || !isCustomer)
                                            {
                                                <a asp-action="Upsert" asp-route-id="@request.Id"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                            }
                                            @if (User.IsInRole("Administrator") || User.IsInRole("CustomerLiaison"))
                                            {
                                                if (request.Status == "Pending")
                                                {
                                                    <form method="post" asp-action="Process" asp-route-id="@request.Id"
                                                          class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                                            <i class="bi bi-play-circle"></i> Process
                                                        </button>
                                                    </form>
                                                }
                                                else if (request.Status == "In Progress")
                                                {
                                                    <form method="post" asp-action="Allocate" asp-route-id="@request.Id"
                                                          class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-check-circle"></i> Allocate
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="text-muted">No allocation requests found</h4>
                    <p class="text-muted">@(isCustomer ? "You haven't made any fridge requests yet." : "There are no allocation requests matching your criteria.")</p>
                    <a asp-action="Upsert" class="btn btn-primary mt-3">
                        <i class="bi bi-plus-circle"></i> Create New Request
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable({
                pageLength: 25,
                ordering: true,
                order: [[2, 'desc']] // Sort by request date descending
            });
        });
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "In Progress" => "bg-info",
            "Allocated" => "bg-success",
            "Shipped" => "bg-primary",
            "Completed" => "bg-secondary",
            "Cancelled" => "bg-danger",
            "Deleted" => "bg-dark",
            _ => "bg-secondary"
        };
    }
}