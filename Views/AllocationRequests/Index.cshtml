@model IEnumerable<AllocationRequestSummaryVM>
@{
    ViewData["Title"] = "Allocation Requests";
    var statusList = ViewBag.StatusList as IEnumerable<SelectListItem>;
    var currentStatus = ViewBag.CurrentStatus as AllocationRequestStatus?;
    var searchString = ViewBag.SearchString as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-clipboard-list me-2"></i>@ViewData["Title"]</h1>
    <a asp-action="Upsert" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Request
    </a>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="status" class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var status in statusList)
                    {
                        <option value="@status.Value" selected="@(status.Value == currentStatus?.ToString())">
                            @status.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="searchString" class="form-label">Search</label>
                <input type="text" name="searchString" class="form-control"
                       value="@searchString" placeholder="Search by customer, contact, or request ID...">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-search me-1"></i>Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="mb-0">Allocation Requests</h5>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">
                    Showing @Model.Count() of @ViewBag.TotalItems requests
                    @if (currentStatus.HasValue)
                    {
                        <span>- Filtered by: @currentStatus.Value</span>
                    }
                </small>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <h5>No allocation requests found</h5>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(searchString) || currentStatus.HasValue)
                    {
                        <span>Try adjusting your search criteria</span>
                    }
                    else
                    {
                        <span>Get started by creating your first allocation request</span>
                    }
                </p>
                <a asp-action="Upsert" class="btn btn-primary">Create Request</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Request #</th>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Request Date</th>
                            <th>Type</th>
                            <th>Priority</th>
                            <th>Items</th>
                            <th>Total Value</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.RequestNumber</strong>
                                    @if (item.IsUrgent)
                                    {
                                        <span class="badge bg-danger ms-1" title="Urgent">!</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.CustomerName</div>
                                    <small class="text-muted">@item.BusinessType</small>
                                </td>
                                <td>@item.ContactPerson</td>
                                <td>@item.RequestDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @item.RequestTypeBadgeClass">
                                        @item.RequestTypeDisplayText
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @item.PriorityBadgeClass">
                                        @item.PriorityDisplayText
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold">@item.TotalItems</span> items
                                </td>
                                <td class="fw-bold text-success">@item.TotalValue.ToString("C")</td>
                                <td>
                                    <span class="badge @item.StatusBadgeClass">@item.StatusDisplayText</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.CanEdit)
                                        {
                                            <a asp-action="Upsert" asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                        @if (item.CanProcess)
                                        {
                                            <a asp-action="Submit" asp-route-id="@item.Id"
                                               class="btn btn-outline-success" title="Submit"
                                               onclick="return confirm('Are you sure you want to submit this request?')">
                                                <i class="fas fa-paper-plane"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new { status = currentStatus, searchString = searchString, page = i, pageSize = ViewBag.PageSize })">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>