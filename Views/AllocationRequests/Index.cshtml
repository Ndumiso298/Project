<!-- Views/AllocationRequests/Index.cshtml -->
@model IEnumerable<AllocationRequestSummaryVM>
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "Allocation Requests";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-list-check me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        @if (User.IsInRole(SD.CustomerRole))
                        {
                            <div class="col-auto">
                                <a class="btn btn-success" asp-action="Upsert">
                                    <i class="fas fa-plus-circle me-1"></i>New Request
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filter Section -->
                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label for="status" class="form-label">Status</label>
                            <select name="status" class="form-select" asp-items="ViewBag.StatusList">
                                <option value="">All Statuses</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="searchString" class="form-label">Search</label>
                            <input type="text" name="searchString" class="form-control"
                                   placeholder="Search by customer, contact, phone..."
                                   value="@ViewBag.SearchString">
                        </div>
                        <div class="col-md-2">
                            <label for="pageSize" class="form-label">Page Size</label>
                            <select name="pageSize" class="form-select" onchange="this.form.submit()">
                                <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                                <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                                <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-filter me-1"></i>Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-refresh me-1"></i>Clear
                            </a>
                        </div>
                    </form>

                    <!-- Requests Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Request #</th>
                                    <th>Date</th>
                                    <th>Customer</th>
                                    <th>Contact Person</th>
                                    <th>Type</th>
                                    <th>Priority</th>
                                    <th>Items</th>
                                    <th>Monthly Rental</th>
                                    <th>Total Value</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>#@request.Id</strong>
                                        </td>
                                        <td>@request.RequestDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <div>@request.CustomerName</div>
                                            <small class="text-muted">@request.BusinessType</small>
                                        </td>
                                        <td>@request.ContactPerson</td>
                                        <td>
                                            <span class="badge bg-info">@request.RequestType</span>
                                        </td>
                                        <td>
                                            @GetPriorityBadge(request.Priority)
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@request.TotalItems</span>
                                        </td>
                                        <td>R @request.TotalMonthlyRental.ToString("N2")</td>
                                        <td>R @request.TotalValue.ToString("N2")</td>
                                        <td>
                                            @GetStatusBadge(request.Status)
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@request.Id"
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (request.Status == AllocationRequestStatus.Draft)
                                                {
                                                    <a asp-action="Upsert" asp-route-id="@request.Id"
                                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-status="@ViewBag.CurrentStatus"
                                       asp-route-searchString="@ViewBag.SearchString"
                                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                                       asp-route-pageSize="@ViewBag.PageSize">Previous</a>
                                </li>

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-status="@ViewBag.CurrentStatus"
                                           asp-route-searchString="@ViewBag.SearchString"
                                           asp-route-page="@i"
                                           asp-route-pageSize="@ViewBag.PageSize">@i</a>
                                    </li>
                                }

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-status="@ViewBag.CurrentStatus"
                                       asp-route-searchString="@ViewBag.SearchString"
                                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                                       asp-route-pageSize="@ViewBag.PageSize">Next</a>
                                </li>
                            </ul>
                        </nav>
                    }

                    <!-- Summary -->
                    <div class="text-muted mt-3">
                        Showing @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) to
                        @Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems) of
                        @ViewBag.TotalItems requests
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private IHtmlContent GetStatusBadge(AllocationRequestStatus status)
    {
        var badgeClass = status switch
        {
            AllocationRequestStatus.Draft => "bg-secondary",
            AllocationRequestStatus.Submitted => "bg-info",
            AllocationRequestStatus.Approved => "bg-success",
            AllocationRequestStatus.Rejected => "bg-danger",
            AllocationRequestStatus.Cancelled => "bg-warning",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }

    private IHtmlContent GetPriorityBadge(CustomerRequestPriority priority)
    {
        var badgeClass = priority switch
        {
            CustomerRequestPriority.Low => "bg-success",
            CustomerRequestPriority.Medium => "bg-warning",
            CustomerRequestPriority.High => "bg-danger",
            CustomerRequestPriority.Critical => "bg-danger",
            _ => "bg-secondary"
        };

        var icon = priority switch
        {
            CustomerRequestPriority.Low => "fa-arrow-down",
            CustomerRequestPriority.Medium => "fa-minus",
            CustomerRequestPriority.High => "fa-arrow-up",
            CustomerRequestPriority.Critical => "fa-triangle-exclamation",
            _ => "fa-minus"
        };

        return Html.Raw($"<span class='badge {badgeClass}'><i class='fas {icon} me-1'></i>{priority}</span>");
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.table').DataTable({
                "paging": false,
                "searching": false,
                "info": false,
                "order": [[0, 'desc']]
            });
        });
    </script>
}