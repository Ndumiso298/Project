@model AllocationRequestHeader

@{
    ViewData["Title"] = "Allocation Request Details";
    var isCustomer = User.IsInRole("Customer");
    var canEdit = Model.Status == "Pending" || !isCustomer;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">Request #@Model.Id - Details</h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
            @if (canEdit)
            {
                    <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit Request
                    </a>
            }
        </div>
    </div>

    <!-- Status Alert -->
    <div class="alert alert-@GetStatusAlertClass(Model.Status)" role="alert">
        <h5 class="alert-heading">
            <i class="bi @GetStatusIcon(Model.Status)"></i> Status: @Model.Status
        </h5>
        <p class="mb-0">
            Request Date: <strong>@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</strong>
            @if (Model.ShippingDate.HasValue)
            {
                <text> | Shipping Date: <strong>@Model.ShippingDate.Value.ToString("dd/MM/yyyy HH:mm")</strong></text>
            }
        </p>
    </div>

    <div class="row">
        <!-- Customer Information -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-person"></i> Customer Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Customer:</dt>
                        <dd class="col-sm-8">@Model.Customer?.TradingName</dd>

                        <dt class="col-sm-4">Contact Name:</dt>
                        <dd class="col-sm-8">@Model.FirstName @Model.LastName</dd>

                        <dt class="col-sm-4">Phone:</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Address:</dt>
                        <dd class="col-sm-8">
                            @Model.AddressLine1<br>
                            @if (!string.IsNullOrEmpty(Model.AddressLine2))
                            {
                                @Model.AddressLine2

                                <br>
                            }
                            @Model.City, @Model.Province @Model.PostalCode
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.Carrier))
                        {
                                <dt class="col-sm-4">Carrier:</dt>
                                <dd class="col-sm-8">@Model.Carrier</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <!-- Request Summary -->
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-receipt"></i> Request Summary
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Total Amount:</dt>
                        <dd class="col-sm-7"><strong>@Model.RequestTotal.ToString("C")</strong></dd>

                        <dt class="col-sm-5">Total Items:</dt>
                        <dd class="col-sm-7">@Model.RequestedFridges.Sum(rd => rd.Quantity)</dd>

                        <dt class="col-sm-5">Request Date:</dt>
                        <dd class="col-sm-7">@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</dd>

                        @if (Model.ShippingDate.HasValue)
                        {
                                <dt class="col-sm-5">Shipping Date:</dt>
                                <dd class="col-sm-7">@Model.ShippingDate.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }

                        @if (Model.PaymentDueDate.HasValue)
                        {
                                <dt class="col-sm-5">Payment Due:</dt>
                                <dd class="col-sm-7">@Model.PaymentDueDate.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- Action Buttons -->
            @if (!isCustomer)
            {
                    <div class="card">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-gear"></i> Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                            @if (Model.Status == "Pending")
                            {
                                        <form method="post" asp-action="Process" asp-route-id="@Model.Id">
                                            <button type="submit" class="btn btn-warning btn-block">
                                                <i class="bi bi-play-circle"></i> Start Processing
                                            </button>
                                        </form>
                            }
                            else if (Model.Status == "In Progress")
                            {
                                        <form method="post" asp-action="Allocate" asp-route-id="@Model.Id">
                                            <button type="submit" class="btn btn-success btn-block">
                                                <i class="bi bi-check-circle"></i> Allocate Fridges
                                            </button>
                                        </form>
                            }

                            @if (Model.Status == "Pending")
                            {
                                        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" 
                                              onsubmit="return confirm('Are you sure you want to delete this request?');">
                                            <button type="submit" class="btn btn-danger btn-block">
                                                <i class="bi bi-trash"></i> Delete Request
                                            </button>
                                        </form>
                            }
                            </div>
                        </div>
                    </div>
            }
        </div>
    </div>

    <!-- Requested Items -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="card-title mb-0">
                <i class="bi bi-list-check"></i> Requested Fridges
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Fridge Model</th>
                            <th>Serial Number</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.RequestedFridges)
                        {
                                <tr>
                                    <td>@detail.Fridge?.Model</td>
                                    <td>@detail.Fridge?.SerialNumber</td>
                                    <td>@detail.Quantity</td>
                                    <td>@detail.Price.ToString("C")</td>
                                    <td>@((detail.Quantity * detail.Price).ToString("C"))</td>
                                </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-primary">
                            <td colspan="3"></td>
                            <td><strong>Grand Total:</strong></td>
                            <td><strong>@Model.RequestTotal.ToString("C")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Allocations History -->
    @if (Model.Allocations?.Any() == true)
    {
            <div class="card mt-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history"></i> Allocation History
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fridge</th>
                                    <th>Allocation Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var allocation in Model.Allocations)
                            {
                                        <tr>
                                            <td>@allocation.Fridge?.SerialNumber</td>
                                            <td>@allocation.AllocationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @(allocation.IsActive ? "bg-success" : "bg-secondary")">
                                            @(allocation.IsActive ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                        </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
    }
</div>

@section Scripts {
        <script>
            $(document).ready(function () {
                $('.table').DataTable({
                    searching: false,
                    paging: false,
                    info: false
                });
            });
        </script>
}

@functions {
    public string GetStatusAlertClass(string status)
    {
        return status switch
        {
            "Pending" => "warning",
            "In Progress" => "info",
            "Allocated" => "success",
            "Shipped" => "primary",
            "Completed" => "secondary",
            "Cancelled" => "danger",
            _ => "secondary"
        };
    }

    public string GetStatusIcon(string status)
    {
        return status switch
        {
            "Pending" => "bi-hourglass-split",
            "In Progress" => "bi-gear",
            "Allocated" => "bi-check-circle",
            "Shipped" => "bi-truck",
            "Completed" => "bi-check-lg",
            "Cancelled" => "bi-x-circle",
            _ => "bi-question-circle"
        };
    }
}