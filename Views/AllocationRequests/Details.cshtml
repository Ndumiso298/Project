@model AllocationRequestHeaderVM
@{
    ViewData["Title"] = $"Request Details - {Model.RequestNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-clipboard-list me-2"></i>Request Details
        <small class="text-muted">@Model.RequestNumber</small>
    </h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
        @if (Model.CanBeEdited)
        {
            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
        }
    </div>
</div>

<div class="row">
    <!-- Main Information -->
    <div class="col-lg-8">
        <!-- Request Summary Card -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Request Summary</h5>
                <div>
                    <span class="badge @Model.StatusBadgeClass me-1">@Model.Status</span>
                    <span class="badge @Model.PriorityBadgeClass">@Model.Priority</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th class="w-40">Request Number:</th>
                                <td class="fw-bold">@Model.RequestNumber</td>
                            </tr>
                            <tr>
                                <th>Request Date:</th>
                                <td>@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Request Type:</th>
                                <td><span class="badge @Model.RequestTypeBadgeClass">@Model.RequestType</span></td>
                            </tr>
                            <tr>
                                <th>Priority:</th>
                                <td><span class="badge @Model.PriorityBadgeClass">@Model.Priority</span></td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th class="w-40">Total Items:</th>
                                <td class="fw-bold">@Model.TotalQuantity</td>
                            </tr>
                            <tr>
                                <th>Monthly Rental:</th>
                                <td class="fw-bold text-success">@Model.TotalMonthlyRental.ToString("C")</td>
                            </tr>
                            <tr>
                                <th>Total Value:</th>
                                <td class="fw-bold text-success">@Model.TotalContractValue.ToString("C")</td>
                            </tr>
                            @if (Model.DiscountPercentage > 0)
                            {
                                <tr>
                                    <th>Discount (@Model.DiscountPercentage%):</th>
                                    <td class="fw-bold text-danger">-@Model.DiscountAmount.ToString("C")</td>
                                </tr>
                                <tr>
                                    <th>Final Amount:</th>
                                    <td class="fw-bold text-success">@Model.FinalAmount.ToString("C")</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                @if (Model.IsReplacementRequest)
                {
                    <div class="alert alert-warning mt-3">
                        <h6><i class="fas fa-exchange-alt me-2"></i>Replacement Request</h6>
                        <p class="mb-1"><strong>Reason:</strong> @Model.ReplacementReason</p>
                        @if (Model.IsUrgentReplacement)
                        {
                            <span class="badge bg-danger">Urgent Replacement</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Customer Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Customer Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <strong>@Model.CustomerBusinessName</strong><br>
                        <span class="text-muted">@Model.CustomerBusinessType</span>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">
                            Contact: @Model.ContactPerson<br>
                            Phone: @Model.ContactPhoneNumber<br>
                            Email: @Model.ContactEmail
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Request Items -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-list me-2"></i>Request Items</h5>
            </div>
            <div class="card-body">
                @if (Model.RequestDetails.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Fridge Model</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-center">Duration</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Monthly Total</th>
                                    <th class="text-end">Line Total</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RequestDetails)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.ModelName</strong><br>
                                            <small class="text-muted">@item.Manufacturer - @item.Capacity</small>
                                        </td>
                                        <td class="text-center fw-bold">@item.Quantity</td>
                                        <td class="text-center">@item.RentalDurationMonths months</td>
                                        <td class="text-end">@item.MonthlyRentalPrice.ToString("C")</td>
                                        <td class="text-end fw-bold text-success">@item.MonthlyTotal.ToString("C")</td>
                                        <td class="text-end fw-bold text-success">@item.LineTotal.ToString("C")</td>
                                        <td>
                                            <span class="badge @(item.HasSufficientStock ? "bg-success" : "bg-danger")">
                                                @item.StockStatus
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="4">Totals</th>
                                    <th class="text-end fw-bold text-success">@Model.TotalMonthlyRental.ToString("C")</th>
                                    <th class="text-end fw-bold text-success">@Model.TotalContractValue.ToString("C")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="fas fa-inbox fa-2x mb-2"></i>
                        <p>No items added to this request</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar - Actions and Status -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.CanBeEdited)
                    {
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                            <i class="fas fa-edit me-1"></i>Edit Request
                        </a>
                    }

                    @if (Model.RequiresApproval && (User.IsInRole("Admin") || User.IsInRole("CustomerSupport")))
                    {
                        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal">
                            <i class="fas fa-check me-1"></i>Approve Request
                        </button>
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="fas fa-times me-1"></i>Reject Request
                        </button>
                    }

                    @if (Model.Status == AllocationRequestStatus.Draft || Model.Status == AllocationRequestStatus.Submitted)
                    {
                        <form asp-action="Submit" method="post" class="d-grid">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-info btn-sm"
                                    onclick="return confirm('Are you sure you want to submit this request?')">
                                <i class="fas fa-paper-plane me-1"></i>Submit for Review
                            </button>
                        </form>
                    }

                    @if (Model.CanBeEdited)
                    {
                        <form asp-action="Cancel" method="post" class="d-grid">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="cancellationReason" value="Cancelled by user" />
                            <button type="submit" class="btn btn-warning btn-sm"
                                    onclick="return confirm('Are you sure you want to cancel this request?')">
                                <i class="fas fa-ban me-1"></i>Cancel Request
                            </button>
                        </form>
                    }

                    <a href="#" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-print me-1"></i>Print Request
                    </a>
                </div>
            </div>
        </div>

        <!-- Delivery Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-truck me-2"></i>Delivery Information</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>Location:</strong><br>
                    @Model.LocationAddress
                </p>
                @if (!string.IsNullOrEmpty(Model.DeliveryInstructions))
                {
                    <p class="mb-2">
                        <strong>Instructions:</strong><br>
                        @Model.DeliveryInstructions
                    </p>
                }
                @if (Model.PreferredDeliveryDate.HasValue)
                {
                    <p class="mb-0">
                        <strong>Preferred Date:</strong><br>
                        @Model.PreferredDeliveryDate.Value.ToString("dd/MM/yyyy")
                    </p>
                }
            </div>
        </div>

        <!-- Status History -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Status History</h5>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-marker bg-primary"></div>
                        <div class="timeline-content">
                            <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            <p class="mb-1">Request Created</p>
                            <small>by @Model.CreatedBy</small>
                        </div>
                    </div>
                    @if (Model.ApprovalDate.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <small class="text-muted">@Model.ApprovalDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                <p class="mb-1">Request Approved</p>
                                <small>by @Model.ApprovedBy</small>
                            </div>
                        </div>
                    }
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker bg-info"></div>
                            <div class="timeline-content">
                                <small class="text-muted">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                <p class="mb-1">Last Updated</p>
                                <small>by @Model.UpdatedBy</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check me-2"></i>Approve Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Approve" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="approvalNotes" class="form-label">Approval Notes (Optional)</label>
                        <textarea name="approvalNotes" class="form-control" rows="3"
                                  placeholder="Add any notes about this approval..."></textarea>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        Approving this request will create fridge allocations and update inventory.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Approve Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-times me-2"></i>Reject Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Reject" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label required">Rejection Reason</label>
                        <textarea name="rejectionReason" class="form-control" rows="3" required
                                  placeholder="Please provide a reason for rejecting this request..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 20px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 15px;
    }

    .timeline-marker {
        position: absolute;
        left: -20px;
        top: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .timeline-content {
        padding-bottom: 10px;
    }

    .w-40 {
        width: 40% !important;
    }
</style>