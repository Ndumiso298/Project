<!-- Views/AllocationRequests/Delete.cshtml -->
@model AllocationRequestHeaderVM
@inject ApplicationDbContext _db
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Project.Data

@{
    ViewData["Title"] = "Delete Allocation Request";
    var claimsIdentity = (ClaimsIdentity)User.Identity;
    var userId = claimsIdentity.FindFirst(ClaimTypes.NameIdentifier)?.Value;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-trash me-2"></i>@ViewData["Title"]
                            </h3>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Index" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Warning!
                        </h4>
                        <p class="mb-0">
                            You are about to permanently delete allocation request <strong>#@Model.Id</strong>.
                            This action cannot be undone and will remove all associated request details.
                        </p>
                    </div>

                    <!-- Request Summary -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Request Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Request #:</strong></td>
                                            <td>#@Model.Id</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Request Date:</strong></td>
                                            <td>@Model.RequestDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Customer:</strong></td>
                                            <td>@Model.CustomerName</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Contact Person:</strong></td>
                                            <td>@Model.ContactPerson</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Status:</strong></td>
                                            <td>@GetStatusBadge(Model.Status)</td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>Request Type:</strong></td>
                                            <td>@Model.RequestType</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Priority:</strong></td>
                                            <td>@Model.Priority</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Total Items:</strong></td>
                                            <td>@Model.RequestDetails.Count</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Monthly Rental:</strong></td>
                                            <td>R @Model.TotalMonthlyRental.ToString("N2")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Request Details -->
                    <div class="card mb-4">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Requested Items</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Fridge Model</th>
                                            <th>Quantity</th>
                                            <th>Monthly Rental</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detail in Model.RequestDetails)
                                        {
                                            <tr>
                                                <td>@detail.FridgeModel?.DisplayName</td>
                                                <td>@detail.Quantity</td>
                                                <td>R @detail.FridgeModel?.MonthlyRentalPrice.ToString("N2")</td>
                                                <td>R @((detail.FridgeModel?.MonthlyRentalPrice * detail.Quantity)?.ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Confirmation -->
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h5 class="card-title mb-0">Confirm Deletion</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Id" />

                                <div class="mb-3">
                                    <label for="deleteReason" class="form-label required">Reason for Deletion</label>
                                    <textarea class="form-control" id="deleteReason" name="deleteReason"
                                              rows="3" required placeholder="Please provide a reason for deleting this request..."></textarea>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                    <label class="form-check-label" for="confirmDelete">
                                        I understand that this action cannot be undone and I confirm that I want to permanently delete this allocation request.
                                    </label>
                                </div>

                                <div class="text-end">
                                    <a asp-action="Index" class="btn btn-secondary me-2">Cancel</a>
                                    <button type="submit" class="btn btn-danger" id="deleteButton" disabled>
                                        <i class="fas fa-trash me-1"></i>Permanently Delete
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmDelete').addEventListener('change', function() {
            document.getElementById('deleteButton').disabled = !this.checked;
        });
    </script>
}

@functions {
    private IHtmlContent GetStatusBadge(AllocationRequestStatus status)
    {
        var badgeClass = status switch
        {
            AllocationRequestStatus.Draft => "bg-secondary",
            AllocationRequestStatus.Submitted => "bg-info",
            AllocationRequestStatus.Approved => "bg-success",
            AllocationRequestStatus.Rejected => "bg-danger",
            AllocationRequestStatus.Cancelled => "bg-warning",
            _ => "bg-secondary"
        };

        return Html.Raw($"<span class='badge {badgeClass}'>{status}</span>");
    }
}