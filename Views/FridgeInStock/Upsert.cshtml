@model Project.Models.FridgeInStock

@{
    ViewData["Title"] = Model.FridgeInStockId == 0 ? "Add Fridge Unit" : "Edit Fridge Unit";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Upsert" method="post">
    <div class="form-group">
        <label asp-for="FridgeId">Fridge Model</label>
        <select asp-for="FridgeId" class="form-control" asp-items="ViewBag.Fridges">
            <option value="">--Select Model--</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="FridgeNo"></label>
        <input asp-for="FridgeNo" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Condition"></label>
        <input asp-for="Condition" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="LastMaintenanceDate"></label>
        <input asp-for="LastMaintenanceDate" class="form-control" type="date" />
    </div>

    @* <div class="form-group">
        <label asp-for="AvailabilityStatus"></label>
        <select asp-for="AvailabilityStatus" class="form-control">
            <option value="Available">Available</option>
            <option value="Rented">Rented</option>
        </select>
    </div> *@

    <div class="form-group">
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
