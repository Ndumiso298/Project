@model Project.Models.ViewModel.CreateFridgeInstancesVM

@{
    ViewData["Title"] = "Add Fridge Instances";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-primary text-light py-3">
            <h4 class="mb-0 text-center">Add Fridge Instances - @Model.FridgeModel</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="FridgeId" />
                <input type="hidden" asp-for="FridgeModel" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Number of Instances</label>
                        <input asp-for="Quantity" class="form-control" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                        <small class="form-text text-muted">How many physical fridges do you want to add?</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastMaintenanceDate" class="form-label fw-semibold">Last Maintenance Date</label>
                        <input asp-for="LastMaintenanceDate" type="date" class="form-control" />
                        <span asp-validation-for="LastMaintenanceDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Condition" class="form-label fw-semibold">Condition</label>
                        <select asp-for="Condition" class="form-select">
                            <option value="Excellent">Excellent</option>
                            <option value="Good">Good</option>
                            <option value="Fair">Fair</option>
                            <option value="Needs Maintenance">Needs Maintenance</option>
                        </select>
                        <span asp-validation-for="Condition" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label fw-semibold">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g., Warehouse, Store Room" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Note:</strong> Each instance will be assigned a unique fridge number automatically.
                    Example: FRG-SAM-GAL-001, FRG-SAM-GAL-002, etc.
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Manage" asp-route-id="@Model.FridgeId" class="btn btn-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fas fa-plus me-2"></i>Create Instances
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}