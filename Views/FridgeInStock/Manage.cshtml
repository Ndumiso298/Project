@model Project.Models.ViewModel.FridgeStockVM

@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Manage Fridge Instances";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h3 fw-bold text-primary mb-1">
                        @Model.FridgeModel.Brand @Model.FridgeModel.Model - Instances
                    </h2>
                    <p class="text-muted mb-0">Manage and track all fridge units for this model</p>
                </div>
                <a asp-action="Create" asp-route-fridgeId="@Model.FridgeModel.FridgeId"
                   class="btn btn-primary d-flex align-items-center shadow-sm">
                    <i class="bi bi-plus-circle me-2"></i> Add Instances
                </a>
            </div>
        </div>
    </div>

    <!-- Card Section -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
            <h5 class="m-0 fw-bold text-primary">Fridge Instances</h5>

            <div class="d-flex align-items-center gap-2">
                <!-- Filter Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-filter me-1"></i> Filter
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="filterDropdown">
                        <li><a class="dropdown-item" href="#">All</a></li>
                        <li><a class="dropdown-item" href="#">Available</a></li>
                        <li><a class="dropdown-item" href="#">Rented</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-4">
            <!-- Statistics Section -->
            <div class="row mb-4 text-center">
                <div class="col-md-4 mb-3">
                    <div class="card border-0 bg-light shadow-sm">
                        <div class="card-body">
                            <h3 class="fw-bold text-primary">@Model.TotalInstances</h3>
                            <p class="text-muted mb-0">Total Instances</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 bg-success text-white shadow-sm">
                        <div class="card-body">
                            <h3 class="fw-bold">@Model.AvailableInstances</h3>
                            <p class="mb-0">Available</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="card border-0 bg-warning text-dark shadow-sm">
                        <div class="card-body">
                            <h3 class="fw-bold">@Model.RentedInstances</h3>
                            <p class="mb-0">Rented</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Fridge Instances Table -->
            @if (Model.FridgeInstances != null && Model.FridgeInstances.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="instanceTable">
                        <thead class="table-light">
                            <tr>
                                <th>Fridge Number</th>
                                <th>Condition</th>
                                <th>Last Maintenance</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var instance in Model.FridgeInstances)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@instance.FridgeNo</td>
                                    <td>
                                        <span class="badge
                                            @(instance.Condition == "Excellent" ? "bg-success" :
                                              instance.Condition == "Good" ? "bg-info" :
                                              instance.Condition == "Fair" ? "bg-warning text-dark" : "bg-danger")">
                                            @instance.Condition
                                        </span>
                                    </td>
                                    <td>@instance.LastMaintenanceDate.ToString("yyyy-MM-dd")</td>
                                    <td>@instance.Location</td>
                                    <td>
                                        @if (instance.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Rented</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                                            <a asp-action="Edit" asp-route-id="@instance.FridgeInStockId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-action="ToggleAvailability" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@instance.FridgeInStockId" />
                                                <button type="submit"
                                                        class="btn btn-sm @(instance.IsAvailable ? "btn-outline-warning" : "btn-outline-success")"
                                                        title="Toggle Availability">
                                                    <i class="bi @(instance.IsAvailable ? "bi-x-circle" : "bi-check-circle")"></i>
                                                </button>
                                            </form>

                                            <form asp-action="Delete" asp-route-id="@instance.FridgeInStockId" method="post"
                                                  onsubmit="return confirmDelete(event, this)">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-refrigerator display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No fridge instances found</h5>
                    <p class="text-muted">Add fridge instances to get started</p>
                    <a asp-action="Create" asp-route-fridgeId="@Model.FridgeModel.FridgeId"
                       class="btn btn-primary rounded-pill shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i> Add First Instance
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // 🧹 SweetAlert Delete Confirmation
        function confirmDelete(event, form) {
            event.preventDefault();

            Swal.fire({
                title: "Are you sure?",
                text: "This fridge instance will be permanently deleted!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "No, cancel!",
                confirmButtonColor: "#198754",
                cancelButtonColor: "#dc3545"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                } else {
                    Swal.fire({
                        title: "Cancelled",
                        text: "The fridge instance was not deleted.",
                        icon: "info"
                    });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // 🔍 Add search input
            const searchInput = document.createElement('input');
            searchInput.type = 'text';
            searchInput.placeholder = 'Search instances...';
            searchInput.className = 'form-control form-control-sm w-25 ms-auto';
            document.querySelector('.card-header').appendChild(searchInput);

            const rows = document.querySelectorAll('#instanceTable tbody tr');

            // 🔎 Search functionality
            searchInput.addEventListener('keyup', function () {
                const query = this.value.toLowerCase();
                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(query) ? '' : 'none';
                });
            });

            // 🔽 Filter functionality
            document.querySelectorAll('.dropdown-menu .dropdown-item').forEach(item => {
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    const filter = this.textContent.trim().toLowerCase();

                    rows.forEach(row => {
                        const badge = row.querySelector('td:nth-child(5) .badge');
                        const status = badge ? badge.textContent.toLowerCase() : '';

                        if (filter === 'all') row.style.display = '';
                        else if (status.includes(filter)) row.style.display = '';
                        else row.style.display = 'none';
                    });

                    // Update dropdown text
                    document.getElementById('filterDropdown').innerHTML =
                        `<i class="bi bi-filter me-1"></i> ${this.textContent}`;
                });
            });
        });
    </script>
}
