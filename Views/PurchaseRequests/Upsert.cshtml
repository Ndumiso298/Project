@model PurchaseRequestVM
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Purchase Request" : "Edit Purchase Request";
    var isEdit = Model.Id != 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas @(isEdit ? "fa-edit" : "fa-plus-circle") text-primary me-2"></i>
            @ViewData["Title"]
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <form asp-action="Upsert" method="post" id="purchaseRequestForm">
        <div class="row">
            <!-- Main Form -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-info-circle me-2"></i>Request Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Id" />
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RequestedById" class="form-label required"></label>
                                    <select asp-for="RequestedById" asp-items="Model.EmployeeList" class="form-select">
                                        <option value="">-- Select Employee --</option>
                                    </select>
                                    <span asp-validation-for="RequestedById" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Status" class="form-label required"></label>
                                    <select asp-for="Status" asp-items="Model.StatusList" class="form-select"></select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Reason" class="form-label required"></label>
                                    <select asp-for="Reason" asp-items="Model.ReasonList" class="form-select" id="reasonSelect">
                                        <option value="">-- Select Reason --</option>
                                    </select>
                                    <span asp-validation-for="Reason" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Urgency" class="form-label required"></label>
                                    <select asp-for="Urgency" asp-items="Model.UrgencyList" class="form-select"></select>
                                    <span asp-validation-for="Urgency" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Reason (shown only when Reason is Other) -->
                        <div class="row mb-3" id="customReasonRow" style="display: none;">
                            <div class="col-12">
                                <label asp-for="CustomReason" class="form-label required"></label>
                                <input asp-for="CustomReason" class="form-control" placeholder="Please specify the reason..." />
                                <span asp-validation-for="CustomReason" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RequiredByDate" class="form-label required"></label>
                                    <input asp-for="RequiredByDate" type="date" class="form-control" />
                                    <span asp-validation-for="RequiredByDate" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EstimatedTotalCost" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">R</span>
                                        <input asp-for="EstimatedTotalCost" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="EstimatedTotalCost" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Items Section -->
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="card-title mb-0 d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-list me-2"></i>Request Items</span>
                            <button type="button" class="btn btn-light btn-sm" onclick="addNewItem()">
                                <i class="fas fa-plus me-1"></i>Add Item
                            </button>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div id="itemsContainer">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <div class="item-row border rounded p-3 mb-3">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label class="form-label required">Fridge Model</label>
                                                <select asp-for="Items[i].FridgeModelId" asp-items="Model.FridgeModelList" class="form-select fridge-model-select">
                                                    <option value="">-- Select Model --</option>
                                                </select>
                                                <span asp-validation-for="Items[i].FridgeModelId" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="mb-3">
                                                <label class="form-label required">Quantity</label>
                                                <input asp-for="Items[i].Quantity" class="form-control quantity-input" type="number" min="1" />
                                                <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="mb-3">
                                                <label class="form-label">Unit Price (R)</label>
                                                <input asp-for="Items[i].EstimatedUnitPrice" class="form-control price-input" type="number" step="0.01" min="0" />
                                                <span asp-validation-for="Items[i].EstimatedUnitPrice" class="text-danger"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="mb-3">
                                                <label class="form-label">Line Total</label>
                                                <input type="text" class="form-control line-total" readonly value="R @Model.Items[i].LineTotal.ToString("N2")" />
                                            </div>
                                        </div>
                                        <div class="col-md-1">
                                            <div class="mb-3">
                                                <label class="form-label">&nbsp;</label>
                                                <button type="button" class="btn btn-danger w-100" onclick="removeItem(this)">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="mb-3">
                                                <label class="form-label">Notes</label>
                                                <textarea asp-for="Items[i].Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                                                <span asp-validation-for="Items[i].Notes" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <input type="hidden" asp-for="Items[i].Id" />
                                </div>
                            }
                        </div>

                        <!-- Empty state -->
                        <div id="noItemsMessage" class="text-center py-4 @(Model.Items.Any() ? "d-none" : "")">
                            <i class="fas fa-box-open fa-2x text-muted mb-3"></i>
                            <h5>No Items Added</h5>
                            <p class="text-muted">Add items to this purchase request by clicking the "Add Item" button.</p>
                        </div>

                        <!-- Totals -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Summary</h6>
                                        <div class="d-flex justify-content-between">
                                            <span>Total Items:</span>
                                            <strong id="totalItems">@Model.Items.Count</strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Total Quantity:</span>
                                            <strong id="totalQuantity">@Model.Items.Sum(i => i.Quantity)</strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Estimated Total:</span>
                                            <strong id="totalCost">R @Model.Items.Sum(i => i.LineTotal).ToString("N2")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Actions Card -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-info text-white py-3">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-cogs me-2"></i>Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>
                                @(isEdit ? "Update Request" : "Create Request")
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            @if (isEdit)
                            {
                                <button type="button" class="btn btn-outline-danger" onclick="confirmDelete(@Model.Id)">
                                    <i class="fas fa-trash me-1"></i>Delete Request
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Budget Information -->
                <div class="card shadow-sm">
                    <div class="card-header bg-warning text-dark py-3">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-coins me-2"></i>Budget Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="ApprovedBudget" class="form-label">Approved Budget (R)</label>
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                <input asp-for="ApprovedBudget" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="ApprovedBudget" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <small>
                                <i class="fas fa-info-circle me-1"></i>
                                <strong>Estimated Total:</strong>
                                <span id="sidebarTotalCost">R @Model.Items.Sum(i => i.LineTotal).ToString("N2")</span>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let itemIndex = @Model.Items.Count;

        // Show/hide custom reason based on reason selection
        document.getElementById('reasonSelect').addEventListener('change', function() {
            const customReasonRow = document.getElementById('customReasonRow');
            customReasonRow.style.display = this.value === 'Other' ? 'block' : 'none';
        });

        // Initialize custom reason visibility
        document.addEventListener('DOMContentLoaded', function() {
            const reasonSelect = document.getElementById('reasonSelect');
            if (reasonSelect) {
                const customReasonRow = document.getElementById('customReasonRow');
                customReasonRow.style.display = reasonSelect.value === 'Other' ? 'block' : 'none';
            }

            // Attach event listeners to existing items
            attachItemEventListeners();
        });

        function addNewItem() {
            const container = document.getElementById('itemsContainer');
            const noItemsMessage = document.getElementById('noItemsMessage');

            const template = `
                <div class="item-row border rounded p-3 mb-3">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label required">Fridge Model</label>
                                <select name="Items[${itemIndex}].FridgeModelId" class="form-select fridge-model-select">
                                    <option value="">-- Select Model --</option>
        @foreach (var item in Model.FridgeModelList ?? new List<SelectListItem>())
        {
                                            <option value="@item.Value">@item.Text</option>
        }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="mb-3">
                                <label class="form-label required">Quantity</label>
                                <input name="Items[${itemIndex}].Quantity" class="form-control quantity-input" type="number" min="1" value="1" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label">Unit Price (R)</label>
                                <input name="Items[${itemIndex}].EstimatedUnitPrice" class="form-control price-input" type="number" step="0.01" min="0" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="mb-3">
                                <label class="form-label">Line Total</label>
                                <input type="text" class="form-control line-total" readonly value="R 0.00" />
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="mb-3">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" class="btn btn-danger w-100" onclick="removeItem(this)">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea name="Items[${itemIndex}].Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="Items[${itemIndex}].Id" value="0" />
                </div>
            `;

            container.insertAdjacentHTML('beforeend', template);
            itemIndex++;

            // Hide no items message
            noItemsMessage.classList.add('d-none');

            // Attach event listeners to new item
            attachItemEventListenersToLastItem();
            updateTotals();
        }

        function removeItem(button) {
            const itemRow = button.closest('.item-row');
            itemRow.remove();
            updateTotals();

            // Show no items message if no items left
            const container = document.getElementById('itemsContainer');
            const noItemsMessage = document.getElementById('noItemsMessage');
            if (container.children.length === 0) {
                noItemsMessage.classList.remove('d-none');
            }
        }

        function attachItemEventListeners() {
            document.querySelectorAll('.quantity-input, .price-input').forEach(input => {
                input.addEventListener('input', updateLineTotal);
            });
        }

        function attachItemEventListenersToLastItem() {
            const container = document.getElementById('itemsContainer');
            const lastItem = container.lastElementChild;
            lastItem.querySelectorAll('.quantity-input, .price-input').forEach(input => {
                input.addEventListener('input', updateLineTotal);
            });
        }

        function updateLineTotal(event) {
            const itemRow = event.target.closest('.item-row');
            const quantity = parseFloat(itemRow.querySelector('.quantity-input').value) || 0;
            const price = parseFloat(itemRow.querySelector('.price-input').value) || 0;
            const lineTotal = quantity * price;

            itemRow.querySelector('.line-total').value = `R ${lineTotal.toFixed(2)}`;
            updateTotals();
        }

        function updateTotals() {
            let totalItems = 0;
            let totalQuantity = 0;
            let totalCost = 0;

            document.querySelectorAll('.item-row').forEach(row => {
                totalItems++;
                const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
                const price = parseFloat(row.querySelector('.price-input').value) || 0;

                totalQuantity += quantity;
                totalCost += quantity * price;
            });

            document.getElementById('totalItems').textContent = totalItems;
            document.getElementById('totalQuantity').textContent = totalQuantity;
            document.getElementById('totalCost').textContent = `R ${totalCost.toFixed(2)}`;
            document.getElementById('sidebarTotalCost').textContent = `R ${totalCost.toFixed(2)}`;

            // Update the hidden EstimatedTotalCost field
            document.getElementById('EstimatedTotalCost').value = totalCost;
        }

        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this purchase request? This action cannot be undone.')) {
                $.post('@Url.Action("Delete")/' + id, function () {
                    window.location.href = '@Url.Action("Index")';
                });
            }
        }

        // Initialize totals on page load
        document.addEventListener('DOMContentLoaded', updateTotals);
    </script>
}