@model IEnumerable<PurchaseRequest>
@{
    ViewData["Title"] = "Purchase Requests";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-shopping-cart me-2"></i>Purchase Requests
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Upsert" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Purchase Request
            </a>
        </div>
    </div>

    <!-- Purchase Requests Card -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Request #</th>
                                <th>Status</th>
                                <th>Requested By</th>
                                <th>Reason</th>
                                <th>Urgency</th>
                                <th>Required By</th>
                                <th>Items</th>
                                <th>Estimated Cost</th>
                                <th>Approved Budget</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@request.Id</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadge(request.Status)">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td>
                                        @request.RequestedBy?.UserAccount?.FullName
                                        <br>
                                        <small class="text-muted">@request.RequestedBy?.EmployeeNumber</small>
                                    </td>
                                    <td>
                                        @request.Reason
                                        @if (!string.IsNullOrEmpty(request.CustomReason))
                                        {
                                            <br>
                                            <small class="text-muted">@request.CustomReason</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetUrgencyBadge(request.Urgency)">
                                            @request.Urgency
                                        </span>
                                    </td>
                                    <td>
                                        @if (request.RequiredByDate.HasValue)
                                        {
                                            @request.RequiredByDate.Value.ToString("dd/MM/yyyy")
                                            @if (request.RequiredByDate.Value < DateTime.Today && request.Status != PurchaseRequestStatus.Approved && request.Status != PurchaseRequestStatus.Submitted)
                                            {
                                                <div><span class="badge bg-danger">Overdue</span></div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </td>
                                    <td>
                                        @request.Items.Count item(s)
                                        <br>
                                        <small class="text-muted">
                                            @string.Join(", ", request.Items.Take(2).Select(i => $"{i.Quantity}x {i.FridgeModel?.Manufacturer} {i.FridgeModel?.ModelName}"))
                                            @if (request.Items.Count > 2)
                                            {
                                                <text>...</text>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        @if (request.EstimatedTotalCost > 0)
                                        {
                                            <span class="fw-bold text-warning">R @request.EstimatedTotalCost.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (request.ApprovedBudget > 0)
                                        {
                                            <span class="fw-bold text-success">R @request.ApprovedBudget.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @request.CreatedAt.ToString("dd/MM/yyyy")
                                        <br>
                                        <small class="text-muted">@request.CreatedAt.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Upsert" asp-route-id="@request.Id"
                                               class="btn btn-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    onclick="confirmDelete(@request.Id, '@request.Id')" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Statistics -->
                <div class="row mt-4">
                    <div class="col-md-3 col-6">
                        <div class="card bg-primary text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Count()</h5>
                                <small class="card-text">Total Requests</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-warning text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Count(r => r.Status == PurchaseRequestStatus.Draft)</h5>
                                <small class="card-text">Pending</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-success text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">@Model.Count(r => r.Status == PurchaseRequestStatus.Approved)</h5>
                                <small class="card-text">Approved</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card bg-danger text-white text-center">
                            <div class="card-body py-3">
                                <h5 class="card-title">R @Model.Where(r => r.EstimatedTotalCost > 0).Sum(r => r.EstimatedTotalCost).ToString("N2")</h5>
                                <small class="card-text">Total Estimated</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Purchase Requests Found</h5>
                    <p class="text-muted">Create your first purchase request to get started.</p>
                    <a asp-action="Upsert" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Create First Request
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, requestNumber) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to delete purchase request #${requestNumber}. This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { id: id }, function () {
                        Swal.fire(
                            'Deleted!',
                            'Purchase request has been deleted.',
                            'success'
                        ).then(() => {
                            window.location.reload();
                        });
                    }).fail(function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the purchase request.',
                            'error'
                        );
                    });
                }
            });
        }
    </script>
}

@functions {
    public string GetStatusBadge(PurchaseRequestStatus status)
    {
        return status switch
        {
            PurchaseRequestStatus.Draft => "secondary",
            PurchaseRequestStatus.UnderReview => "warning",
            PurchaseRequestStatus.Approved => "success",
            PurchaseRequestStatus.Rejected => "danger",
            PurchaseRequestStatus.Submitted => "info",
            _ => "secondary"
        };
    }

    public string GetUrgencyBadge(PurchaseRequestUrgency urgency)
    {
        return urgency switch
        {
            PurchaseRequestUrgency.Low => "success",
            PurchaseRequestUrgency.Medium => "warning",
            PurchaseRequestUrgency.High => "danger",
            PurchaseRequestUrgency.Critical => "dark",
            _ => "secondary"
        };
    }
}