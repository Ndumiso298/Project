@model IEnumerable<PurchaseRequest>
@{
    ViewData["Title"] = "Purchase Requests";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-shopping-cart text-primary me-2"></i>Purchase Requests
        </h1>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Create Request
        </a>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Requests
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Pending Approval
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(r => r.Status == PurchaseRequestStatus.Draft || r.Status == PurchaseRequestStatus.UnderReview)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Urgent Requests
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(r => r.IsUrgent)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Approved
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(r => r.Status == PurchaseRequestStatus.Approved)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Purchase Requests Grid -->
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-list me-2"></i>Purchase Requests
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Requested By</th>
                                <th>Status</th>
                                <th>Urgency</th>
                                <th>Items</th>
                                <th>Total Quantity</th>
                                <th>Estimated Cost</th>
                                <th>Required By</th>
                                <th>Days Left</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>PR#@request.Id</strong>
                                    </td>
                                    <td>
                                        @request.RequestedBy?.UserAccount?.FullName
                                        <br>
                                        <small class="text-muted">@request.RequestDate.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(request.Status)">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetUrgencyBadgeClass(request.Urgency)">
                                            @request.Urgency
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold">@request.Items.Count</span> items
                                    </td>
                                    <td>
                                        <span class="fw-bold">@request.TotalQuantity</span> units
                                    </td>
                                    <td>
                                        <strong>R @request.TotalEstimatedCost.ToString("N2")</strong>
                                    </td>
                                    <td>@request.RequiredByDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @GetDaysLeftBadgeClass(request.DaysUntilDue)">
                                            @request.DaysUntilDue days
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@request.Id" 
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Upsert" asp-route-id="@request.Id" 
                                               class="btn btn-outline-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="confirmDelete(@request.Id)" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                    <h4>No Purchase Requests</h4>
                    <p class="text-muted">Get started by creating your first purchase request.</p>
                    <a asp-action="Upsert" class="btn btn-primary">Create Purchase Request</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this purchase request? This action cannot be undone.')) {
                $.post('@Url.Action("Delete")/' + id, function () {
                    location.reload();
                });
            }
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(PurchaseRequestStatus status)
    {
        return status switch
        {
            PurchaseRequestStatus.Draft => "bg-secondary",
            PurchaseRequestStatus.UnderReview => "bg-warning",
            PurchaseRequestStatus.Approved => "bg-success",
            PurchaseRequestStatus.Rejected => "bg-danger",
            PurchaseRequestStatus.Ordered => "bg-info",
            PurchaseRequestStatus.Fulfilled => "bg-primary",
            _ => "bg-secondary"
        };
    }

    public string GetUrgencyBadgeClass(PurchaseRequestUrgency urgency)
    {
        return urgency switch
        {
            PurchaseRequestUrgency.Low => "bg-success",
            PurchaseRequestUrgency.Medium => "bg-warning",
            PurchaseRequestUrgency.High => "bg-danger",
            PurchaseRequestUrgency.Critical => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public string GetDaysLeftBadgeClass(int daysLeft)
    {
        return daysLeft switch
        {
             0 => "bg-danger",
             7 => "bg-warning",
            _ => "bg-success"
        };
    }
}