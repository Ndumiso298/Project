@using System.Security.Policy
@model PurchaseRequest
@{
    ViewData["Title"] = "Purchase Request Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-file-invoice text-primary me-2"></i>Purchase Request Details
        </h1>
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
            <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
            <a href="#" class="btn btn-info" onclick="window.print()">
                <i class="fas fa-print me-1"></i>Print
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Information -->
        <div class="col-lg-8">
            <!-- Header Information -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>Request Information - PR#@Model.Id
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Requested By</label>
                                <p class="form-control-plaintext">@Model.RequestedBy?.UserAccount?.FullName</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Request Date</label>
                                <p class="form-control-plaintext">@Model.RequestDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Reason</label>
                                <p class="form-control-plaintext">
                                    @Model.Reason
                                    @if (!string.IsNullOrEmpty(Model.CustomReason))
                                    {
                                        <br><small class="text-muted">@Model.CustomReason</small>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Status</label>
                                <div>
                                    <span class="badge @GetStatusBadgeClass(Model.Status) fs-6">
                                        @Model.Status
                                    </span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Urgency</label>
                                <div>
                                    <span class="badge @GetUrgencyBadgeClass(Model.Urgency) fs-6">
                                        @Model.Urgency
                                    </span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Required By Date</label>
                                <p class="form-control-plaintext">
                                    @Model.RequiredByDate.ToString("dd/MM/yyyy")
                                    <span class="badge @GetDaysLeftBadgeClass(Model.DaysUntilDue) ms-2">
                                        @Model.DaysUntilDue days left
                                    </span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Budget Information -->
                    <div class="row mt-3 pt-3 border-top">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Estimated Total Cost</label>
                                <p class="form-control-plaintext h5 text-primary">R @Model.TotalEstimatedCost.ToString("N2")</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Approved Budget</label>
                                <p class="form-control-plaintext h5 @(Model.ApprovedBudget.HasValue ? "text-success" : "text-muted")">
                                    @(Model.ApprovedBudget.HasValue ? $"R {Model.ApprovedBudget.Value:N2}" : "Not Set")
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Status Summary</label>
                                <p class="form-control-plaintext">@Model.StatusSummary</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items List -->
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Requested Items
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.Items.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fridge Model</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th>Line Total</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@item.FridgeModel?.Manufacturer @item.FridgeModel?.ModelName</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@item.Quantity</span>
                                            </td>
                                            <td>
                                                @if (item.EstimatedUnitPrice.HasValue)
                                                {
                                                    <span>R @item.EstimatedUnitPrice.Value.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Not set</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>R @item.EstimatedLineTotal.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <span class="badge @GetItemStatusBadgeClass(item.Status)">@item.Status</span>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Notes))
                                                {
                                                    <small class="text-muted">@item.Notes</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="2">Totals</th>
                                        <th></th>
                                        <th class="text-primary">R @Model.TotalEstimatedCost.ToString("N2")</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-box-open fa-2x text-muted mb-3"></i>
                            <p class="text-muted">No items in this purchase request.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Approval Information -->
            @if (Model.ApprovedBy != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-check-circle me-2"></i>Approval Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Approved By</label>
                            <p class="form-control-plaintext">@Model.ApprovedBy.UserAccount?.FullName</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Approval Date</label>
                            <p class="form-control-plaintext">@Model.ApprovalDate?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ApprovalNotes))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Approval Notes</label>
                                <div class="border rounded p-2 bg-light">
                                    @Model.ApprovalNotes
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Timeline -->
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="mb-1">Request Created</h6>
                                <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-warning"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Last Updated</h6>
                                    <small class="text-muted">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                        }
                        
                        @if (Model.ApprovalDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Approved</h6>
                                    <small class="text-muted">@Model.ApprovalDate.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card shadow-sm mt-4">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-1"></i>Edit Request
                        </a>
                        <button type="button" class="btn btn-outline-danger" onclick="confirmDelete(@Model.Id)">
                            <i class="fas fa-trash me-1"></i>Delete Request
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Are you sure you want to delete this purchase request? This action cannot be undone.')) {
                $.post('@Url.Action("Delete")/' + id, function () {
                    window.location.href = '@Url.Action("Index")';
                });
            }
        }
    </script>
}

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    
    .timeline-marker {
        position: absolute;
        left: -30px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        top: 5px;
    }
    
    .timeline-content {
        padding-bottom: 10px;
        border-left: 2px solid #dee2e6;
        padding-left: 15px;
    }
    
    .timeline-item:last-child .timeline-content {
        border-left: 2px solid transparent;
    }
</style>

@functions {
    public string GetStatusBadgeClass(PurchaseRequestStatus status)
    {
        return status switch
        {
            PurchaseRequestStatus.Draft => "bg-secondary",
            PurchaseRequestStatus.UnderReview => "bg-warning",
            PurchaseRequestStatus.Approved => "bg-success",
            PurchaseRequestStatus.Rejected => "bg-danger",
            PurchaseRequestStatus.Ordered => "bg-info",
            PurchaseRequestStatus.Fulfilled => "bg-primary",
            _ => "bg-secondary"
        };
    }

    public string GetUrgencyBadgeClass(PurchaseRequestUrgency urgency)
    {
        return urgency switch
        {
            PurchaseRequestUrgency.Low => "bg-success",
            PurchaseRequestUrgency.Medium => "bg-warning",
            PurchaseRequestUrgency.High => "bg-danger",
            PurchaseRequestUrgency.Critical => "bg-dark",
            _ => "bg-secondary"
        };
    }

    public string GetDaysLeftBadgeClass(int daysLeft)
    {
        return daysLeft switch
        {
             0 => "bg-danger",
             7 => "bg-warning",
            _ => "bg-success"
        };
    }

    public string GetItemStatusBadgeClass(string status)
    {
        return status switch
        {
            "Complete" => "bg-success",
            "Partially Received" => "bg-warning",
            "Not Ordered" => "bg-secondary",
            _ => "bg-secondary"
        };
    }
}