@model Project.Models.FaultReport
@{
    ViewData["Title"] = "Fault Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Fault Report Details</h1>
            <p class="text-muted mb-0">Fault ID: #@Model.FaultReportId</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("ViewFaultStatus")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
            @if (Model.Status == "Declined")
            {
                <button class="btn btn-warning" onclick="relaunchFaultRequest(@Model.FaultReportId)">
                    <i class="fas fa-redo me-2"></i>Relaunch
                </button>
            }
        </div>
    </div>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Fault Information Card -->
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Fault Information</h6>
                    <span class="badge bg-@GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Fault Type:</strong>
                            <p class="mb-2">@Model.FaultType</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Priority:</strong>
                            <p class="mb-2">
                                <span class="badge bg-@GetPriorityBadgeClass(Model.Priority)">@Model.Priority</span>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <strong>Description:</strong>
                            <p class="mb-2">@Model.Description</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <strong>Reported Date:</strong>
                            <p class="mb-2">@Model.ReportedDate.ToString("MMM dd, yyyy at hh:mm tt")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Last Updated:</strong>
                            <p class="mb-2">@Model.ReportedDate.ToString("MMM dd, yyyy at hh:mm tt")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Appliance Information -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Appliance Details</h6>
                </div>
                <div class="card-body">
                    @if (Model.FridgeInStock?.Fridge != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Brand & Model:</strong>
                                <p class="mb-2">@Model.FridgeInStock.Fridge.Brand @Model.FridgeInStock.Fridge.Model</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Type & Capacity:</strong>
                                <p class="mb-2">@Model.FridgeInStock.Fridge.Type • @Model.FridgeInStock.Fridge.CapacityLiters L</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Serial Number:</strong>
                                <p class="mb-2">@(Model.FridgeInStock.FridgeNo ?? "Not Available")</p>
                            </div>
                            <div class="col-md-6">
                                <strong>Allocation Status:</strong>
                                <p class="mb-2">
                                    <span class="badge bg-success">Active & Allocated</span>
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Appliance information not available.
                        </div>
                    }
                </div>
            </div>

            <!-- Technician Assignment -->
            @if (Model.FaultTechnicians?.Any() == true)
            {
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">Repair Assignment</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var technician in Model.FaultTechnicians)
                        {
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Assigned Technician:</strong>
                                    <p class="mb-2">@technician.TechnicianAssigned</p>
                                </div>
                                <div class="col-md-6">
                                    <strong>Repair Status:</strong>
                                    <p class="mb-2">
                                        <span class="badge bg-@GetStatusBadgeClass(technician.RepairStatus)">@technician.RepairStatus</span>
                                    </p>
                                </div>
                            </div>
                            @if (technician.Bookingate.HasValue)
                            {
                                <div class="row">
                                    <div class="col-md-6">
                                        <strong>Scheduled Date:</strong>
                                        <p class="mb-2">@technician.Bookingate.Value.ToString("MMM dd, yyyy")</p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Scheduled Time:</strong>
                                        <p class="mb-2">@technician.Bookingate.Value.ToString("hh:mm tt")</p>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(technician.FaultDescription))
                            {
                                <div class="row">
                                    <div class="col-12">
                                        <strong>Technician Notes:</strong>
                                        <p class="mb-2">@technician.FaultDescription</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }

            <!-- Decline Information -->
            @if (Model.Status == "Declined" && !string.IsNullOrEmpty(Model.AdditionalNotes))
            {
                <div class="card shadow border-danger mb-4">
                    <div class="card-header py-3 bg-danger text-white">
                        <h6 class="m-0 font-weight-bold">
                            <i class="fas fa-exclamation-triangle me-2"></i>Request Declined
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-danger">
                            <strong>Decline Reason:</strong>
                            <p class="mb-2 mt-2">@Model.AdditionalNotes</p>
                        </div>
                        <div class="alert alert-info">
                            <strong>Next Steps:</strong>
                            <p class="mb-0 mt-2">
                                You can relaunch this request with additional information or contact customer support for more details.
                            </p>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button class="btn btn-warning me-md-2" onclick="relaunchFaultRequest(@Model.FaultReportId)">
                                <i class="fas fa-redo me-2"></i>Relaunch Request
                            </button>
                            <button class="btn btn-info" onclick="contactSupport()">
                                <i class="fas fa-headset me-2"></i>Contact Support
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <button class="btn btn-info mb-2" onclick="contactSupport()">
                            <i class="fas fa-headset me-2"></i>Contact Support
                        </button>
                        <a href="@Url.Action("CreateFault")" class="btn btn-primary mb-2">
                            <i class="fas fa-plus me-2"></i>New Fault Report
                        </a>
                        <a href="@Url.Action("ViewFaultStatus")" class="btn btn-secondary">
                            <i class="fas fa-list me-2"></i>View All Reports
                        </a>
                    </div>
                </div>
            </div>

            <!-- Status Timeline -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Status Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item @(Model.Status != "Declined" ? "active" : "")">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h6 class="mb-0">Report Submitted</h6>
                                <small class="text-muted">@Model.ReportedDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>

                        @if (Model.Status == "In Progress" || Model.Status == "Completed" || Model.Status == "Resolved")
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-0">In Progress</h6>
                                    <small class="text-muted">Technician assigned</small>
                                </div>
                            </div>
                        }

                        @if (Model.Status == "Completed" || Model.Status == "Resolved")
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker bg-success"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-0">Completed</h6>
                                    <small class="text-muted">Repair finished</small>
                                </div>
                            </div>
                        }

                        @if (Model.Status == "Declined")
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker bg-danger"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-0">Declined</h6>
                                    <small class="text-muted">Request not approved</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Relaunch Modal -->
<div class="modal fade" id="relaunchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Relaunch Fault Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You are about to relaunch fault request #@Model.FaultReportId. This will create a new request with the same appliance information.</p>
                <form id="relaunchForm" method="post" action="@Url.Action("RelaunchFault")">
                    <input type="hidden" name="faultReportId" value="@Model.FaultReportId" />
                    <div class="form-group mb-3">
                        <label class="form-label">Additional Information (Optional)</label>
                        <textarea class="form-control" name="additionalInfo" rows="3"
                                  placeholder="Add any additional details or updates about the fault..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitRelaunch()">
                    <i class="fas fa-redo me-2"></i>Relaunch Request
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }

        .timeline-marker {
            position: absolute;
            left: -30px;
            top: 0;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #dee2e6;
        }

        .timeline-item.active .timeline-marker {
            background: #4e73df;
        }

        .timeline-content {
            padding-left: 10px;
        }
    </style>
}

@section Scripts {
    <script>
        function relaunchFaultRequest(faultReportId) {
            new bootstrap.Modal(document.getElementById('relaunchModal')).show();
        }

        function submitRelaunch() {
            document.getElementById('relaunchForm').submit();
        }

        function contactSupport() {
            window.location.href = 'tel:1-800-HELP-NOW';
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "success",
            "in progress" => "info",
            "reported" => "warning",
            "declined" => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "high" or "critical" => "danger",
            "medium" => "warning",
            "low" => "info",
            _ => "secondary"
        };
    }
}