@model Project.Models.ViewModel.FaultReportVM
@{
    ViewData["Title"] = "Report Fault";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var customerFridges = ViewBag.CustomerFridges as List<CustomerFridge> ?? new List<CustomerFridge>();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Report Appliance Fault</h1>
            <p class="text-muted mb-0">Report issues with your allocated appliances</p>
        </div>
        <div>
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fault Report Details</h6>
                </div>
                <div class="card-body">
                    <form asp-action="CreateFault" method="post" enctype="multipart/form-data" id="faultForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Appliance Selection -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <label class="form-label fw-bold">Select Appliance *</label>
                                <p class="text-muted small mb-3">Choose the appliance that requires repair</p>

                                @if (customerFridges.Any())
                                {
                                    <div class="row">
                                        @foreach (var fridge in customerFridges)
                                        {
                                            <div class="col-md-6 mb-3">
                                                <div class="card appliance-card @(Model.FridgeInStockId == fridge.FridgeInStockId ? "border-primary selected" : "")"
                                                     data-fridge-id="@fridge.FridgeInStockId">
                                                    <div class="card-body">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio"
                                                                   name="FridgeInStockId" id="fridge_@fridge.FridgeInStockId"
                                                                   value="@fridge.FridgeInStockId"
                                                                   @(Model.FridgeInStockId == fridge.FridgeInStockId ? "checked" : "") required>
                                                            <label class="form-check-label w-100" for="fridge_@fridge.FridgeInStockId">
                                                                <h6 class="mb-1">@fridge.Fridge?.Brand @fridge.Fridge?.Model</h6>
                                                                <p class="text-muted small mb-1">
                                                                    <i class="fas fa-refrigerator me-1"></i>
                                                                    @fridge.Fridge?.Type • @fridge.Fridge?.CapacityLiters L
                                                                </p>
                                                                <p class="text-success small mb-0">
                                                                    <i class="fas fa-check-circle me-1"></i>
                                                                    Allocated & Active
                                                                </p>
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        You don't have any allocated appliances. Please request an appliance first.
                                        <a href="@Url.Action("CreateFridgeRequest")" class="alert-link">Request Appliance</a>
                                    </div>
                                }
                                <span asp-validation-for="FridgeInStockId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Fault Details -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="FaultType" class="form-label fw-bold">Fault Type *</label>
                                    <select asp-for="FaultType" class="form-select" required>
                                        <option value="">Select Fault Type</option>
                                        <option value="Not Cooling">Not Cooling</option>
                                        <option value="Strange Noises">Strange Noises</option>
                                        <option value="Water Leakage">Water Leakage</option>
                                        <option value="Electrical Issue">Electrical Issue</option>
                                        <option value="Door Problem">Door Problem</option>
                                        <option value="Display Error">Display Error</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <span asp-validation-for="FaultType" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Priority" class="form-label fw-bold">Priority Level</label>
                                    <select asp-for="Priority" class="form-select">
                                        <option value="Low">Low - Minor Issue</option>
                                        <option value="Medium" selected>Medium - Standard Repair</option>
                                        <option value="High">High - Urgent Repair</option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Fault Description -->
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Fault Description *</label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Please describe the fault in detail. Include when it started, what you observe, and any error messages..."
                                      required></textarea>
                            <div class="form-text">Be as detailed as possible to help us diagnose the issue quickly.</div>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Image Upload -->
                        <div class="form-group mb-4">
                            <label class="form-label fw-bold">Upload Photos</label>
                            <p class="text-muted small mb-2">Upload clear photos of the fault (optional but recommended)</p>

                            <div class="file-upload-area border rounded p-4 text-center">
                                <i class="fas fa-cloud-upload-alt fa-2x text-muted mb-3"></i>
                                <h5>Drag & Drop or Click to Upload</h5>
                                <p class="text-muted small mb-3">Supports JPG, PNG - Max 5MB per image</p>
                                <input type="file" name="faultImages" class="form-control"
                                       accept="image/*" multiple
                                       onchange="previewImages(this)" />
                            </div>

                            <div id="imagePreview" class="row mt-3" style="display: none;">
                                <!-- Image previews will be shown here -->
                            </div>
                        </div>

                        <!-- Request Replacement -->
                        <div class="form-group mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="requestReplacement" name="requestReplacement">
                                <label class="form-check-label fw-bold" for="requestReplacement">
                                    Request Replacement Appliance
                                </label>
                                <div class="form-text">
                                    Check this if you need a temporary replacement while your appliance is being repaired.
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <a href="@Url.Action("Dashboard")" class="btn btn-secondary me-md-2">
                                        <i class="fas fa-times me-2"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Submit Fault Report
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Help Information -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-info-circle me-2"></i>Need Help?
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="fw-bold">Emergency Contacts</h6>
                            <p class="small mb-1">Customer Support: <strong>1-800-HELP-NOW</strong></p>
                            <p class="small mb-1">Emergency Repairs: <strong>1-800-URGENT-FIX</strong></p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold">What to Expect</h6>
                            <p class="small mb-1">• Technician contact within 24 hours</p>
                            <p class="small mb-1">• Repair scheduling based on priority</p>
                            <p class="small mb-1">• Status updates via email/SMS</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .appliance-card {
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .appliance-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

            .appliance-card.selected {
                border: 2px solid #4e73df;
                background-color: #f8f9fc;
            }

        .file-upload-area {
            border: 2px dashed #dee2e6;
            transition: all 0.3s ease;
        }

            .file-upload-area:hover {
                border-color: #4e73df;
                background-color: #f8f9fc;
            }

        .image-preview-container {
            position: relative;
            margin-bottom: 10px;
        }

        .image-preview {
            max-width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
        }

        .remove-image {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
        }
    </style>
}

@section Scripts {
    <script>
        // Appliance card selection
        document.querySelectorAll('.appliance-card').forEach(card => {
            card.addEventListener('click', function() {
                document.querySelectorAll('.appliance-card').forEach(c => c.classList.remove('selected', 'border-primary'));
                this.classList.add('selected', 'border-primary');
                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;
            });
        });

        // Image preview functionality
        function previewImages(input) {
            const preview = document.getElementById('imagePreview');
            preview.innerHTML = '';
            preview.style.display = 'none';

            if (input.files && input.files.length > 0) {
                preview.style.display = 'block';

                for (let i = 0; i < input.files.length; i++) {
                    const file = input.files[i];
                    const reader = new FileReader();

                    reader.onload = function(e) {
                        const col = document.createElement('div');
                        col.className = 'col-md-3';
                        col.innerHTML = `
                            <div class="image-preview-container">
                                <img src="${e.target.result}" class="image-preview" alt="Preview">
                                <button type="button" class="remove-image" onclick="removeImage(this)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        `;
                        preview.appendChild(col);
                    }

                    reader.readAsDataURL(file);
                }
            }
        }

        function removeImage(button) {
            const container = button.closest('.col-md-3');
            container.remove();

            const preview = document.getElementById('imagePreview');
            if (preview.children.length === 0) {
                preview.style.display = 'none';
            }
        }

        // Form validation
        document.getElementById('faultForm').addEventListener('submit', function(e) {
            const selectedFridge = document.querySelector('input[name="FridgeInStockId"]:checked');
            if (!selectedFridge) {
                e.preventDefault();
                alert('Please select an appliance to report the fault for.');
                return false;
            }
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}