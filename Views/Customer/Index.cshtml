@model IEnumerable<Project.Models.Fridge>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Premium Fridge Rentals";

    
    var sortOptions = new List<(string Key, string DisplayText)>
    {
        ("price-low", "Price: Low to High"),
        ("price-high", "Price: High to Low"),
        ("capacity", "Capacity")
    };
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 fw-bold text-primary mb-1">Premium Fridge Rentals</h1>
                    <p class="text-muted">Find the perfect refrigeration solution for your needs</p>
                </div>
                <div class="d-flex align-items-center">
                    
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-filter me-1"></i> Sort By
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                            @foreach (var option in sortOptions)
                            {
                                <li><a class="dropdown-item" href="#" data-sort="@option.Key">@option.DisplayText</a></li>
                            }
                        </ul>
                    </div>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="viewMode" id="gridView" autocomplete="off" checked>
                        <label class="btn btn-outline-secondary" for="gridView"><i class="bi bi-grid-3x3-gap"></i></label>

                        <input type="radio" class="btn-check" name="viewMode" id="listView" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="listView"><i class="bi bi-list-ul"></i></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 col-md-4 d-none d-md-block">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-funnel me-2"></i>Filters</h6>
                        <a href="#" class="text-primary small text-decoration-none">Clear All</a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Price Range Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Monthly Price (R)</h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small text-muted">R0</span>
                                <span class="small text-muted">R2000</span>
                            </div>
                            <input type="range" class="form-range" id="priceRange" min="0" max="2000" step="50">
                        </div>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" placeholder="Min" value="0">
                            <input type="number" class="form-control form-control-sm" placeholder="Max" value="2000">
                        </div>
                    </div>

                    <!-- Brand Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Brand</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="samsungFilter" checked>
                            <label class="form-check-label small" for="samsungFilter">Samsung</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="lgFilter" checked>
                            <label class="form-check-label small" for="lgFilter">LG</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="defyFilter">
                            <label class="form-check-label small" for="defyFilter">Defy</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="hisenseFilter">
                            <label class="form-check-label small" for="hisenseFilter">Hisense</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="whirlpoolFilter">
                            <label class="form-check-label small" for="whirlpoolFilter">Whirlpool</label>
                        </div>
                    </div>

                    <!-- Capacity Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Capacity (Liters)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity100">
                            <label class="form-check-label small" for="capacity100">Up to 100L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity200" checked>
                            <label class="form-check-label small" for="capacity200">100L - 200L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity300">
                            <label class="form-check-label small" for="capacity300">200L - 300L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity400">
                            <label class="form-check-label small" for="capacity400">300L+</label>
                        </div>
                    </div>

                    <!-- Availability Filter -->
                    <div class="mb-3">
                        <h6 class="small fw-bold mb-3">Availability</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="inStock" checked>
                            <label class="form-check-label small" for="inStock">In Stock</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="outOfStock">
                            <label class="form-check-label small" for="outOfStock">Out of Stock</label>
                        </div>
                    </div>

                    <button class="btn btn-primary w-100 mt-2">Apply Filters</button>
                </div>
            </div>

    <!-- Fridge Cards -->
    <div class="row g-4" id="fridgeContainer">
        @foreach (var fridge in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6" data-price="@fridge.RentalPricePerMonth" data-capacity="@fridge.CapacityLiters">
                <div class="card h-100 border-0 shadow-sm rental-card">
                    <!-- Status Badge -->
                    @if (fridge.AvailabilityStatus == "Available")
                    {
                        <span class="badge bg-success position-absolute top-0 end-0 m-2">
                            <i class="bi bi-check-circle me-1"></i> Available
                        </span>
                    }
                    else if (fridge.AvailabilityStatus == "Unavailable")
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                            <i class="bi bi-x-circle me-1"></i> Unavailable
                        </span>
                    }
                    else if (fridge.AvailabilityStatus == "Maintenance")
                    {
                        <span class="badge bg-warning position-absolute top-0 end-0 m-2">
                            <i class="bi bi-tools me-1"></i> Maintenance
                        </span>
                    }

                    <!-- Fridge Image -->
                    <div class="rental-image-container">
                        <img src="@fridge.ImageUrl" class="card-img-top rental-image" alt="@fridge.Brand @fridge.Model">
                        <div class="image-overlay"></div>
                    </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">
                                <!-- Brand & Type -->
                                <div class="mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary small">@fridge.Brand</span>
                                    <span class="badge bg-light text-dark ms-1 small">@fridge.Type</span>
                                </div>

                                <!-- Title -->
                                <h6 class="card-title text-dark mb-2">@fridge.Brand @fridge.Model</h6>

                        <p class="card-text text-muted small flex-grow-1">
                            @if (!string.IsNullOrEmpty(fridge.Description) && fridge.Description.Length > 100)
                            {
                                @fridge.Description.Substring(0, 100)
                                <text>...</text>
                            }
                            else
                            {
                                @fridge.Description
                            }
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="h5 mb-0 text-primary">@fridge.RentalPricePerMonth.ToString("C")</span>
                                    <span class="text-muted small d-block">per month</span>
                                </div>
                            </div>

                                    <!-- Action Buttons -->
                                    <div class="d-grid gap-2">
                                        @if (fridge.Status == "Available")
                                        {
                                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@fridge.FridgeId"
                                               class="btn btn-primary">
                                                <i class="bi bi-cart-plus me-2"></i> Add to Cart
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary" disabled>
                                                <i class="bi bi-envelope me-2"></i> Notify When Available
                                            </button>
                                        }
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-dark btn-sm w-100">
                                                <i class="bi bi-heart"></i> Wishlist
                                            </button>
                                            <button class="btn btn-outline-dark btn-sm w-100 compare-btn-mobile">
                                                <i class="bi bi-shuffle"></i> Compare
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-refrigerator display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">No Fridges Available</h3>
            <p class="text-muted">We're currently updating our inventory. Please check back later.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-house me-2"></i> Return Home
            </a>
        </div>
    }
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

<style>
    .rental-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
    }

        .rental-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }

    .rental-image-container {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .rental-image {
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .rental-card:hover .rental-image {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.1));
    }

    .card-title {
        font-weight: 600;
        line-height: 1.3;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .btn-outline-primary {
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            transform: translateY(-1px);
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .rental-image-container {
            height: 180px;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add click animation to cards
            const cards = document.querySelectorAll('.rental-card');
            cards.forEach(card => {
                card.addEventListener('click', function (e) {
                    // Only trigger if not clicking a button or link
                    if (!e.target.closest('a') && !e.target.closest('button')) {
                        const link = this.querySelector('a');
                        if (link) {
                            link.style.transform = 'scale(0.98)';
                            setTimeout(() => {
                                link.style.transform = '';
                            }, 150);
                        }
                    }
                });
            });

            // Sort functionality
            const sortItems = document.querySelectorAll('.dropdown-item');
            const fridgeContainer = document.getElementById('fridgeContainer');
            const fridges = Array.from(fridgeContainer.children);

            sortItems.forEach(item => {
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    const sortType = this.getAttribute('data-sort');
                    const sortText = this.textContent;
                    const dropdownButton = document.getElementById('sortDropdown');
                    dropdownButton.innerHTML = '<i class="bi bi-filter me-1"></i> ' + sortText;

                    // Sort fridges based on sortType
                    let sortedFridges = [...fridges];

                    if (sortType === 'price-low') {
                        sortedFridges.sort((a, b) => {
                            const priceA = parseFloat(a.getAttribute('data-price') || 0);
                            const priceB = parseFloat(b.getAttribute('data-price') || 0);
                            return priceA - priceB;
                        });
                    } else if (sortType === 'price-high') {
                        sortedFridges.sort((a, b) => {
                            const priceA = parseFloat(a.getAttribute('data-price') || 0);
                            const priceB = parseFloat(b.getAttribute('data-price') || 0);
                            return priceB - priceA;
                        });
                    } else if (sortType === 'capacity') {
                        sortedFridges.sort((a, b) => {
                            const capacityA = parseFloat(a.getAttribute('data-capacity') || 0);
                            const capacityB = parseFloat(b.getAttribute('data-capacity') || 0);
                            return capacityB - capacityA; // Descending order (larger capacity first)
                        });
                    }

                    // Clear and re-append sorted fridges
                    fridgeContainer.innerHTML = '';
                    sortedFridges.forEach(fridge => fridgeContainer.appendChild(fridge));
                });
            });
        });
    </script>
}