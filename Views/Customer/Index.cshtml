@model IEnumerable<Project.Models.Fridge>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Premium Fridge Rentals";
}

<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 fw-bold text-primary mb-1">Premium Fridge Rentals</h1>
                    <p class="text-muted">Find the perfect refrigeration solution for your needs</p>
                </div>
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <span class="badge bg-success bg-opacity-10 text-success">
                            <i class="bi bi-check-circle-fill me-1"></i> @Model.Count() Available Units
                        </span>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-filter me-1"></i> Sort By
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                            <li><a class="dropdown-item" href="#">Price: Low to High</a></li>
                            <li><a class="dropdown-item" href="#">Price: High to Low</a></li>
                            <li><a class="dropdown-item" href="#">Capacity</a></li>
                            <li><a class="dropdown-item" href="#">Newest First</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridge Cards -->
    <div class="row g-4">
        foreach (var fridge in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm rental-card">
                    <!-- Status Badge -->
                    if (fridge.AvailabilityStatus == "Available")
                    {
                        <span class="badge bg-success position-absolute top-0 end-0 m-2">
                            <i class="bi bi-check-circle me-1"></i> Available
                        </span>
                    }
                    else if (fridge.AvailabilityStatus == "Unavailable")
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                            <i class="bi bi-x-circle me-1"></i> Unavailable
                        </span>
                    }
                    else if (fridge.AvailabilityStatus == "Maintenance")
                    {
                        <span class="badge bg-warning position-absolute top-0 end-0 m-2">
                            <i class="bi bi-tools me-1"></i> Maintenance
                        </span>
                    }

                    <!-- Fridge Image -->
                    <div class="rental-image-container">
                        <img src="fridge.ImageUrl" class="card-img-top rental-image" alt="fridge.Brand fridge.Model">
                        <div class="image-overlay"></div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary">fridge.Type</span>
                            <span class="badge bg-light text-dark ms-1">fridge.CapacityLiters L</span>
                        </div>

                        <h5 class="card-title text-dark">fridge.Brand fridge.Model</h5>

                        <p class="card-text text-muted small flex-grow-1">
                            if (!string.IsNullOrEmpty(fridge.Description) && fridge.Description.Length > 100)
                            {
                                @fridge.Description.Substring(0, 100)
                                <text>...</text>
                            }
                            else
                            {
                                fridge.Description
                            }
                        </p>

                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="h5 mb-0 text-primary">@fridge.RentalPricePerMonth.ToString("C")</span>
                                    <span class="text-muted small d-block">per month</span>
                                </div>
                                <div class="text-warning">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                </div>
                            </div> *@

                            <div class="d-grid gap-2">
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="fridge.FridgeId"
                                   class="btn btn-outline-primary">
                                    <i class="bi bi-info-circle me-2"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-refrigerator display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">No Fridges Available</h3>
            <p class="text-muted">We're currently updating our inventory. Please check back later.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-house me-2"></i> Return Home
            </a>
        </div>
    }
</div>

<style>
    .rental-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        overflow: hidden;
    }

        .rental-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
        }

    .rental-image-container {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .rental-image {
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .rental-card:hover .rental-image {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.1));
    }

    .card-title {
        font-weight: 600;
        line-height: 1.3;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .btn-outline-primary {
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-outline-primary:hover {
            transform: translateY(-1px);
        }

    .text-warning {
        font-size: 0.9rem;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .d-flex.justify-content-between.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .rental-image-container {
            height: 180px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Add click animation to cards
        const cards = document.querySelectorAll('.rental-card');

        cards.forEach(card => {
            card.addEventListener('click', function (e) {
                // Only trigger if not clicking a button or link
                if (!e.target.closest('a') && !e.target.closest('button')) {
                    const link = this.querySelector('a');
                    if (link) {
                        link.style.transform = 'scale(0.98)';
                        setTimeout(() => {
                            link.style.transform = '';
                        }, 150);
                    }
                }
            });
        });

        // Sort functionality (placeholder)
        const sortItems = document.querySelectorAll('.dropdown-item');
        sortItems.forEach(item => {
            item.addEventListener('click', function (e) {
                e.preventDefault();
                const sortText = this.textContent;
                const dropdownButton = document.getElementById('sortDropdown');
                dropdownButton.innerHTML = '<i class="bi bi-filter me-1"></i> ' + sortText;
                // Add actual sorting logic here
                console.log('Sorting by:', sortText);
            });
        });
    });
</script>