@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Quick View Modal functionality
            const quickViewButtons = document.querySelectorAll('.quick-view-btn');
            const quickViewModal = document.getElementById('quickViewModal');

            if (quickViewModal) {
                const quickViewTitle = document.getElementById('quickViewTitle');
                const quickViewImage = document.getElementById('quickViewImage');
                const quickViewPrice = document.getElementById('quickViewPrice');
                const quickViewDescription = document.getElementById('quickViewDescription');

                quickViewButtons.forEach(button => {
                    button.addEventListener('click', function() {
                        const card = this.closest('.rental-card');
                        const title = card.querySelector('.card-title').textContent;
                        const image = card.querySelector('.rental-image').src;
                        const price = card.querySelector('.h5.text-primary').textContent;
                        const description = card.querySelector('.card-text').textContent;

                                        const modal = new bootstrap.Modal(quickViewModal);
                modal.show();

                        quickViewTitle.textContent = title;
                        quickViewImage.src = image;
                        quickViewPrice.textContent = price;
                        quickViewDescription.textContent = description;
                    });
                });
            }

            // View mode toggle
            const gridView = document.getElementById('gridView');
            const listView = document.getElementById('listView');
            const productGrid = document.getElementById('productGrid');

            if (listView && productGrid) {
                listView.addEventListener('change', function() {
                    if (this.checked) {
                        productGrid.classList.add('list-view');
                        productGrid.classList.remove('row-cols-1', 'row-cols-md-2', 'row-cols-lg-3');
                        const cards = productGrid.querySelectorAll('.col-xl-4, .col-lg-6, .col-md-6');
                        cards.forEach(card => {
                            card.classList.remove('col-xl-4', 'col-lg-6', 'col-md-6');
                            card.classList.add('col-12', 'mb-4');
                        });
                    }
                });
            }

            if (gridView && productGrid) {
                gridView.addEventListener('change', function() {
                    if (this.checked) {
                        productGrid.classList.remove('list-view');
                        productGrid.classList.add('row-cols-1', 'row-cols-md-2', 'row-cols-lg-3');
                        const cards = productGrid.querySelectorAll('.col-12');
                        cards.forEach(card => {
                            card.classList.remove('col-12', 'mb-4');
                            card.classList.add('col-xl-4', 'col-lg-6', 'col-md-6');
                        });
                    }
                });
            }

            // Price range filter
            const priceRange = document.getElementById('priceRange');
            if (priceRange) {
                priceRange.addEventListener('input', function() {
                    const minPriceInput = this.form.querySelector('input[placeholder="Min"]');
                    if (minPriceInput) {
                        minPriceInput.value = this.value;
                    }
                });
            }
        });
    </script>
}