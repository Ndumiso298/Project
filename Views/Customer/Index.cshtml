@model IEnumerable<Fridge>
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Premium Fridge Rentals";
}

<!-- Enhanced Header with Hero Section -->
<div class="hero-banner bg-primary bg-gradient py-5 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold text-white mb-3">Premium Fridge Rentals</h1>
                <p class="lead text-white mb-4">Get the perfect refrigeration solution for your home or business with flexible rental terms and free delivery.</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-primary fs-6 py-2 px-3">
                        <i class="bi bi-truck me-1"></i> Free Delivery
                    </span>
                    <span class="badge bg-light text-primary fs-6 py-2 px-3">
                        <i class="bi bi-shield-check me-1"></i> 5-Year Warranty
                    </span>
                    <span class="badge bg-light text-primary fs-6 py-2 px-3">
                        <i class="bi bi-arrow-repeat me-1"></i> Easy Returns
                    </span>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1571175443880-49e1d25b2bc5?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80"
                         class="img-fluid rounded-3 shadow-lg" alt="Premium Fridges" style="max-height: 300px;">
                    <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-dark bg-opacity-50 text-white rounded-bottom-3">
                        <h5 class="mb-0">Rent Today, Enjoy Tomorrow</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid py-3">
    <!-- Quick Stats & Filter Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="d-flex align-items-center">
                    <span class="text-muted me-3 d-none d-md-block">Showing <strong>@Model.Count()</strong> products</span>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="categoryDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid me-1"></i> Categories
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="categoryDropdown">
                            <li><a class="dropdown-item" href="#">All Fridges</a></li>
                            <li><a class="dropdown-item" href="#">Single Door</a></li>
                            <li><a class="dropdown-item" href="#">Double Door</a></li>
                            <li><a class="dropdown-item" href="#">Side-by-Side</a></li>
                            <li><a class="dropdown-item" href="#">French Door</a></li>
                            <li><a class="dropdown-item" href="#">Mini Fridges</a></li>
                        </ul>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small d-none d-lg-block">Sort by:</span>
                    <div class="dropdown">
                        <button class="btn btn-light border dropdown-toggle" type="button" id="sortDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            Recommended
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="sortDropdown">
                            <li><a class="dropdown-item" href="#">Recommended</a></li>
                            <li><a class="dropdown-item" href="#">Price: Low to High</a></li>
                            <li><a class="dropdown-item" href="#">Price: High to Low</a></li>
                            <li><a class="dropdown-item" href="#">Customer Ratings</a></li>
                            <li><a class="dropdown-item" href="#">Newest First</a></li>
                            <li><a class="dropdown-item" href="#">Best Sellers</a></li>
                        </ul>
                    </div>
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="viewMode" id="gridView" autocomplete="off" checked>
                        <label class="btn btn-outline-secondary" for="gridView"><i class="bi bi-grid-3x3-gap"></i></label>

                        <input type="radio" class="btn-check" name="viewMode" id="listView" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="listView"><i class="bi bi-list-ul"></i></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 col-md-4 d-none d-md-block">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold"><i class="bi bi-funnel me-2"></i>Filters</h6>
                        <a href="#" class="text-primary small text-decoration-none">Clear All</a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Price Range Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Monthly Price (R)</h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small text-muted">R0</span>
                                <span class="small text-muted">R2000</span>
                            </div>
                            <input type="range" class="form-range" id="priceRange" min="0" max="2000" step="50">
                        </div>
                        <div class="d-flex gap-2">
                            <input type="number" class="form-control form-control-sm" placeholder="Min" value="0">
                            <input type="number" class="form-control form-control-sm" placeholder="Max" value="2000">
                        </div>
                    </div>

                    <!-- Brand Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Brand</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="samsungFilter" checked>
                            <label class="form-check-label small" for="samsungFilter">Samsung</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="lgFilter" checked>
                            <label class="form-check-label small" for="lgFilter">LG</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="defyFilter">
                            <label class="form-check-label small" for="defyFilter">Defy</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="hisenseFilter">
                            <label class="form-check-label small" for="hisenseFilter">Hisense</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="whirlpoolFilter">
                            <label class="form-check-label small" for="whirlpoolFilter">Whirlpool</label>
                        </div>
                    </div>

                    <!-- Capacity Filter -->
                    <div class="mb-4">
                        <h6 class="small fw-bold mb-3">Capacity (Liters)</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity100">
                            <label class="form-check-label small" for="capacity100">Up to 100L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity200" checked>
                            <label class="form-check-label small" for="capacity200">100L - 200L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity300">
                            <label class="form-check-label small" for="capacity300">200L - 300L</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="capacity400">
                            <label class="form-check-label small" for="capacity400">300L+</label>
                        </div>
                    </div>

                    <!-- Availability Filter -->
                    <div class="mb-3">
                        <h6 class="small fw-bold mb-3">Availability</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="inStock" checked>
                            <label class="form-check-label small" for="inStock">In Stock</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="outOfStock">
                            <label class="form-check-label small" for="outOfStock">Out of Stock</label>
                        </div>
                    </div>

                    <button class="btn btn-primary w-100 mt-2">Apply Filters</button>
                </div>
            </div>

            <!-- Special Offers Card -->
            <div class="card border-0 shadow-sm mb-4 bg-warning bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="bi bi-percent display-6 text-warning mb-3"></i>
                    <h5 class="card-title">Special Offer</h5>
                    <p class="card-text small">Get 15% off your first 3 months when you rent today!</p>
                    <button class="btn btn-warning btn-sm">Learn More</button>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-lg-9 col-md-8">
            <!-- Promotional Banner -->
            <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                <div>
                    <i class="bi bi-truck me-2"></i>
                    <strong>Free Delivery</strong> on orders over R500 |
                    <span class="ms-2"><i class="bi bi-shield-check me-1"></i>5-Year Warranty Included</span>
                </div>
                <div>
                    <a href="#" class="text-decoration-none">View Terms <i class="bi bi-chevron-right"></i></a>
                </div>
            </div>

            <!-- Fridge Cards -->
            <div class="row g-4" id="productGrid">
                @foreach (var fridge in Model)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rental-card position-relative">
                            <!-- Promotional Badges -->
                            @if (fridge.Status == "Available")
                            {
                                <span class="badge bg-success position-absolute top-0 start-0 m-2 z-2">
                                    <i class="bi bi-check-circle me-1"></i> In Stock
                                </span>
                                <span class="badge bg-warning position-absolute top-0 end-0 m-2 z-2">
                                    <i class="bi bi-lightning me-1"></i> Special
                                </span>
                            }
                            else if (fridge.Status == "Unavailable")
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2">
                                    <i class="bi bi-x-circle me-1"></i> Out of Stock
                                </span>
                            }
                            else if (fridge.Status == "Maintenance")
                            {
                                <span class="badge bg-secondary position-absolute top-0 start-0 m-2">
                                    <i class="bi bi-tools me-1"></i> Maintenance
                                </span>
                            }

                            <!-- Fridge Image with Hover Effects -->
                            <div class="rental-image-container position-relative">
                                <img src="@fridge.ImageUrl" class="card-img-top rental-image" alt="@fridge.Brand @fridge.Model">
                                <div class="image-overlay"></div>
                                <div class="position-absolute bottom-0 start-0 end-0 p-3 d-flex justify-content-center opacity-0 hover-opacity-100 transition-opacity">
                                    <button class="btn btn-light btn-sm me-2 quick-view-btn" data-bs-toggle="modal" data-bs-target="#quickViewModal" data-fridge-id="@fridge.FridgeId">
                                        <i class="bi bi-eye me-1"></i> Quick View
                                    </button>
                                    <button class="btn btn-light btn-sm compare-btn">
                                        <i class="bi bi-shuffle me-1"></i> Compare
                                    </button>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="card-body d-flex flex-column">
                                <!-- Brand & Type -->
                                <div class="mb-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary small">@fridge.Brand</span>
                                    <span class="badge bg-light text-dark ms-1 small">@fridge.Type</span>
                                </div>

                                <!-- Title -->
                                <h6 class="card-title text-dark mb-2">@fridge.Brand @fridge.Model</h6>

                                <!-- Features -->
                                <ul class="list-unstyled small text-muted mb-3">
                                    <li><i class="bi bi-check text-success me-1"></i> Capacity: @fridge.CapacityLiters Liters</li>
                                    <li><i class="bi bi-check text-success me-1"></i> Energy Efficient</li>
                                    <li><i class="bi bi-check text-success me-1"></i> Frost Free</li>
                                </ul>

                                <!-- Rating -->
                                <div class="mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="text-warning small">
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-fill"></i>
                                            <i class="bi bi-star-half"></i>
                                        </div>
                                        <span class="small text-muted ms-2">(128 reviews)</span>
                                    </div>
                                </div>

                                <div class="mt-auto">
                                    <!-- Pricing -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div>
                                            <span class="h5 mb-0 text-primary">R @fridge.RentalPricePerMonth.ToString("F2")</span>
                                            <span class="text-muted small d-block">per month</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="text-success small d-block">
                                                <i class="bi bi-truck me-1"></i> Free delivery
                                            </span>
                                            <span class="text-muted small"><s>R @((fridge.RentalPricePerMonth * 1.15).ToString("F2"))</s> Save 15%</span>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="d-grid gap-2">
                                        @if (fridge.Status == "Available")
                                        {
                                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@fridge.FridgeId"
                                               class="btn btn-primary">
                                                <i class="bi bi-cart-plus me-2"></i> Add to Cart
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary" disabled>
                                                <i class="bi bi-envelope me-2"></i> Notify When Available
                                            </button>
                                        }
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-outline-dark btn-sm w-100">
                                                <i class="bi bi-heart"></i> Wishlist
                                            </button>
                                            <button class="btn btn-outline-dark btn-sm w-100 compare-btn-mobile">
                                                <i class="bi bi-shuffle"></i> Compare
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <nav aria-label="Product pagination" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Previous</a>
                    </li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quickViewModalLabel">Product Quick View</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <img id="quickViewImage" src="" class="img-fluid rounded" alt="Product Image">
                    </div>
                    <div class="col-md-6">
                        <h4 id="quickViewTitle" class="mb-2"></h4>
                        <div class="mb-3">
                            <span class="h4 text-primary" id="quickViewPrice"></span>
                            <span class="text-muted">/month</span>
                        </div>
                        <div class="mb-3">
                            <div class="text-warning">
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-fill"></i>
                                <i class="bi bi-star-half"></i>
                                <span class="text-muted ms-1">(128 reviews)</span>
                            </div>
                        </div>
                        <p id="quickViewDescription" class="mb-3"></p>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary">Add to Cart</button>
                            <button class="btn btn-outline-secondary">Add to Wishlist</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Enhanced Footer -->
<footer class="enhanced-footer mt-5">
    <div class="container">
        <div class="footer-content">
            <div class="footer-column">
                <h3>Cool Appliances</h3>
                <p>Your trusted partner for premium appliance rentals in South Africa. Quality service since 2010.</p>
                <div class="social-icons">
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
            <div class="footer-column">
                <h3>Quick Links</h3>
                <ul class="footer-links">
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Home</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> About Us</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Fridge Rentals</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Special Offers</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Contact Us</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Customer Service</h3>
                <ul class="footer-links">
                    <li><a href="#"><i class="bi bi-chevron-right"></i> My Account</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Order Tracking</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> FAQ</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Returns & Refunds</a></li>
                    <li><a href="#"><i class="bi bi-chevron-right"></i> Support Center</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Contact Info</h3>
                <ul class="contact-info">
                    <li>
                        <i class="bi bi-geo-alt"></i>
                        <span>123 Main Street, Johannesburg, South Africa</span>
                    </li>
                    <li>
                        <i class="bi bi-telephone"></i>
                        <span>+27 11 123 4567</span>
                    </li>
                    <li>
                        <i class="bi bi-envelope"></i>
                        <span>info@coolappliances.co.za</span>
                    </li>
                </ul>
                <div class="newsletter-form">
                    <input type="email" class="form-control" placeholder="Your email address">
                    <button class="btn btn-warning">Subscribe</button>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="payment-methods">
                <i class="bi bi-credit-card"></i>
                <i class="bi bi-paypal"></i>
                <i class="bi bi-coin"></i>
            </div>
            <p class="mt-3">&copy; 2023 Cool Appliances. All Rights Reserved. | <a href="#">Privacy Policy</a> | <a href="#">Terms of Service</a></p>
        </div>
    </div>
</footer>

<style>
    .rental-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-radius: 12px;
        overflow: hidden;
    }

        .rental-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .rental-image-container {
        position: relative;
        overflow: hidden;
        height: 200px;
        background-color: #f8f9fa;
    }

    .rental-image {
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .rental-card:hover .rental-image {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0) 60%, rgba(0,0,0,0.05));
    }

    .card-title {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .price-tag {
        font-weight: 700;
        color: #0d6efd;
    }

    .rental-badge {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .hover-opacity-100 {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .rental-card:hover .hover-opacity-100 {
        opacity: 1;
    }

    .quick-view-btn:hover, .compare-btn:hover {
        background-color: #f8f9fa !important;
        transform: scale(1.05);
    }

    .hero-banner {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    }

    /* Enhanced Footer Styles */
    .enhanced-footer {
        background-color: #008cba;
        color: white;
        padding: 60px 0 30px;
        margin-top: auto;
        border-top: 5px solid #ff7e30;
        box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.1);
    }

    .footer-content {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
        margin-bottom: 40px;
    }

    .footer-column h3 {
        color: white;
        font-size: 1.3rem;
        margin-bottom: 25px;
        position: relative;
        padding-bottom: 10px;
    }

        .footer-column h3:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 40px;
            height: 3px;
            background-color: #ff7e30;
        }

    .footer-column p {
        margin-bottom: 20px;
        color: #e8f4fd;
    }

    .footer-links {
        list-style: none;
        padding: 0;
    }

        .footer-links li {
            margin-bottom: 15px;
        }

        .footer-links a {
            color: #e8f4fd;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

            .footer-links a:hover {
                color: #ff7e30;
                transform: translateX(5px);
            }

        .footer-links i {
            margin-right: 10px;
            color: #ff7e30;
        }

    .contact-info {
        list-style: none;
        padding: 0;
    }

        .contact-info li {
            margin-bottom: 15px;
            display: flex;
            align-items: flex-start;
        }

        .contact-info i {
            margin-right: 15px;
            color: #ff7e30;
            margin-top: 5px;
        }

    .social-icons {
        display: flex;
        gap: 15px;
        margin-top: 20px;
    }

        .social-icons a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.15);
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }

            .social-icons a:hover {
                background-color: #ff7e30;
                transform: translateY(-3px);
            }

    .newsletter-form {
        display: flex;
        margin-top: 15px;
    }

        .newsletter-form input {
            flex: 1;
            padding: 12px 15px;
            border: none;
            border-radius: 4px 0 0 4px;
            outline: none;
        }

        .newsletter-form button {
            background-color: #ff7e30;
            color: white;
            border: none;
            padding: 0 20px;
