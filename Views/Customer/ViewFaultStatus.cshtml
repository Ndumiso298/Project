@model PaginatedList<FaultReport>

@{
    ViewData["Title"] = "My Fault Reports";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-sm-flex align-items-center justify-content-between mb-4">
                <h1 class="h3 mb-0 text-gray-800 font-weight-bold">@ViewData["Title"]</h1>
                <a asp-action="CreateFaultSelection" class="btn btn-primary">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Report New Fault
                </a>
            </div>

            <!-- Search and Filter Section -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Search & Filter</h6>
                </div>
                <div class="card-body">
                    <form asp-action="ViewFaultStatus" method="get" class="form-inline">
                        <div class="form-group mr-2 mb-2">
                            <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]"
                                   placeholder="Search by fault type or status...">
                        </div>
                        <div class="form-group mr-2 mb-2">
                            <select name="sortOrder" class="form-control" onchange="this.form.submit()">
                                <option value="">Sort by...</option>
                                <option value="date_desc" selected>Newest First</option>
                                <option value="">Oldest First</option>
                                <option value="faulttype">Fault Type A-Z</option>
                                <option value="faulttype_desc">Fault Type Z-A</option>
                                <option value="priority">Priority Low-High</option>
                                <option value="priority_desc">Priority High-Low</option>
                                <option value="status">Status A-Z</option>
                                <option value="status_desc">Status Z-A</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary mb-2">
                            <i class="fas fa-search mr-1"></i> Search
                        </button>
                        <a asp-action="ViewFaultStatus" class="btn btn-outline-secondary mb-2 ml-2">Clear</a>
                    </form>
                </div>
            </div>

            <!-- Fault Reports Table -->
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fault Reports</h6>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Fridge</th>
                                        <th>Fault Type</th>
                                        <th>Description</th>
                                        <th>Priority</th>
                                        <th>Status</th>
                                        <th>Reported Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fault in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (fault.FridgeInStock?.Fridge != null)
                                                {
                                                    <strong>@fault.FridgeInStock.Fridge.Brand</strong>
                                        
                                                    <br>
                                                    <small class="text-muted">@fault.FridgeInStock.Fridge.Model</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>@fault.FaultType</td>
                                            <td>
                                                @if (fault.Description.Length > 50)
                                                {
                                                    @fault.Description.Substring(0, 50)
                                        
                                                    <text>...</text>
                                                }
                                                else
                                                {
                                                    @fault.Description
                                                }
                                            </td>
                                            <td>
                                                @switch (fault.Priority)
                                                {
                                                    case "High":
                                                        <span class="badge badge-danger">@fault.Priority</span>
                                                        break;
                                                    case "Medium":
                                                        <span class="badge badge-warning">@fault.Priority</span>
                                                        break;
                                                    case "Low":
                                                        <span class="badge badge-success">@fault.Priority</span>
                                                        break;
                                                    default:
                                                        <span class="badge badge-secondary">@fault.Priority</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @switch (fault.Status)
                                                {
                                                    case "Reported":
                                                        <span class="badge badge-info">@fault.Status</span>
                                                        break;
                                                    case "In Progress":
                                                        <span class="badge badge-warning">@fault.Status</span>
                                                        break;
                                                    case "Resolved":
                                                        <span class="badge badge-success">@fault.Status</span>
                                                        break;
                                                    case "Declined":
                                                        <span class="badge badge-danger">@fault.Status</span>
                                                        break;
                                                    default:
                                                        <span class="badge badge-secondary">@fault.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>@fault.ReportedDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <a asp-action="FaultDetails" asp-route-id="@fault.FaultReportId"
                                                   class="btn btn-info btn-sm" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                @if (fault.Status == "Declined")
                                                {
                                                    <button type="button" class="btn btn-warning btn-sm"
                                                            data-toggle="modal" data-target="#relaunchModal@(fault.FaultReportId)"
                                                            title="Relaunch Request">
                                                        <i class="fas fa-redo"></i>
                                                    </button>

                                                    <!-- Relaunch Modal -->
                                                    <div class="modal fade" id="relaunchModal@(fault.FaultReportId)" tabindex="-1" role="dialog">
                                                        <div class="modal-dialog" role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">Relaunch Fault Report</h5>
                                                                    <button type="button" class="close" data-dismiss="modal">
                                                                        <span>&times;</span>
                                                                    </button>
                                                                </div>
                                                                <form asp-action="RelaunchFault" method="post">
                                                                    <input type="hidden" name="faultReportId" value="@fault.FaultReportId" />
                                                                    <div class="modal-body">
                                                                        <div class="form-group">
                                                                            <label>Additional Information (Optional):</label>
                                                                            <textarea name="additionalInfo" class="form-control" rows="4"
                                                                          placeholder="Add any additional information or corrections..."></textarea>
                                                                        </div>
                                                                        <div class="alert alert-info">
                                                                            <i class="fas fa-info-circle"></i>
                                                                            This will create a new fault report based on the original declined request.
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                                                                        <button type="submit" class="btn btn-warning">Relaunch Report</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <p class="text-muted">
                                    Showing @((Model.PageIndex - 1) * Model.PageSize + 1) to
                                    @((Model.PageIndex - 1) * Model.PageSize + Model.Count) of
                                    @Model.TotalCount entries
                                </p>
                            </div>
                            <div class="col-md-6">
                                <nav>
                                    <ul class="pagination justify-content-end">
                                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="ViewFaultStatus"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-pageNumber="@(Model.PageIndex - 1)"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Previous
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                                <a class="page-link" asp-action="ViewFaultStatus"
                                                   asp-route-sortOrder="@ViewData["CurrentSort"]"
                                                   asp-route-pageNumber="@i"
                                                   asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                    @i
                                                </a>
                                            </li>
                                        }
                                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                            <a class="page-link" asp-action="ViewFaultStatus"
                                               asp-route-sortOrder="@ViewData["CurrentSort"]"
                                               asp-route-pageNumber="@(Model.PageIndex + 1)"
                                               asp-route-currentFilter="@ViewData["CurrentFilter"]">
                                                Next
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-exclamation-triangle fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Fault Reports Found</h4>
                            <p class="text-muted mb-4">You haven't reported any faults yet.</p>
                            <a asp-action="CreateFaultSelection" class="btn btn-primary btn-lg">
                                <i class="fas fa-exclamation-triangle mr-2"></i>Report Your First Fault
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            border-top: none;
            font-weight: 600;
        }

        .badge {
            font-size: 0.75em;
        }

        .btn-sm {
            margin-right: 5px;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Auto-submit sort order when changed
            $('select[name="sortOrder"]').on('change', function() {
                $(this).closest('form').submit();
            });

            // Initialize tooltips
            $('[title]').tooltip();

            // Auto-focus search input
            $('input[name="searchString"]').focus();

            console.log('Fault status page loaded successfully');
        });
    </script>
}