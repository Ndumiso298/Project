@model PaginatedList<Project.Models.FaultReport>
@{
    ViewData["Title"] = "My Fault Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">My Fault Reports</h1>
            <p class="text-muted mb-0">Track and manage your appliance repair requests</p>
        </div>
        <div class="btn-group">
            <a href="@Url.Action("Dashboard")" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Dashboard
            </a>
            <a href="@Url.Action("CreateFault")" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>New Report
            </a>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="searchString" class="form-control" 
                           placeholder="Search by fault type or status..." 
                           value="@ViewData["CurrentFilter"]" />
                </div>
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select" onchange="this.form.submit()">
                        <option value="">Sort by...</option>
                        <option value="date_desc" selected>Newest First</option>
                        <option value="date">Oldest First</option>
                        <option value="priority">Priority (Low to High)</option>
                        <option value="priority_desc">Priority (High to Low)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Fault Reports -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Fault Report History</h6>
            <span class="badge bg-primary">@Model.Count Total Reports</span>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var fault in Model)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex w-100 justify-content-between mb-2">
                                        <h6 class="mb-0">@fault.FaultType</h6>
                                        <div>
                                            <span class="badge bg-@GetStatusBadgeClass(fault.Status) me-2">@fault.Status</span>
                                            @if (!string.IsNullOrEmpty(fault.Priority))
                                            {
                                                <span class="badge bg-@GetPriorityBadgeClass(fault.Priority)">@fault.Priority Priority</span>
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-2 text-muted">@fault.Description</p>
                                    <div class="small text-muted">
                                        <i class="fas fa-calendar me-1"></i>
                                        Reported: @fault.ReportedDate.ToString("MMM dd, yyyy at hh:mm tt")
                                        @if (fault.FridgeInStock?.Fridge != null)
                                        {
                                            <span class="ms-3">
                                                <i class="fas fa-refrigerator me-1"></i>
                                                @fault.FridgeInStock.Fridge.Brand @fault.FridgeInStock.Fridge.Model
                                            </span>
                                        }
                                    </div>

                                    <!-- Technician Assignment -->
                                    @if (fault.FaultTechnicians?.Any() == true)
                                    {
                                        var technician = fault.FaultTechnicians.First();
                                        <div class="mt-2">
                                            <small class="text-info">
                                                <i class="fas fa-user-cog me-1"></i>
                                                Assigned Technician: @technician.TechnicianAssigned
                                                @if (technician.Bookingate.HasValue)
                                                {
                                                    <span class="ms-2">
                                                        <i class="fas fa-clock me-1"></i>
                                                        Scheduled: @technician.Bookingate.Value.ToString("MMM dd, yyyy")
                                                    </span>
                                                }
                                            </small>
                                        </div>
                                    }

                                    <!-- Decline Reason and Relaunch Option -->
                                    @if (fault.Status == "Declined" && !string.IsNullOrEmpty(fault.DeclineReason))
                                    {
                                        <div class="alert alert-warning mt-2 mb-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <strong><i class="fas fa-exclamation-triangle me-2"></i>Request Declined</strong>
                                                    <p class="mb-1 mt-1">Reason: @fault.DeclineReason</p>
                                                    <small>You can relaunch this request with additional information.</small>
                                                </div>
                                                <button class="btn btn-sm btn-warning" 
                                                        onclick="relaunchFaultRequest(@fault.FaultReportId)">
                                                    <i class="fas fa-redo me-1"></i>Relaunch
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-end">
                                    <div class="btn-group-vertical btn-group-sm">
                                        <a href="@Url.Action("FaultDetails", new { id = fault.FaultReportId })" 
                                           class="btn btn-outline-primary mb-1">
                                            <i class="fas fa-eye me-1"></i>View Details
                                        </a>
                                        @if (fault.Status == "Declined")
                                        {
                                            <button class="btn btn-outline-warning" 
                                                    onclick="relaunchFaultRequest(@fault.FaultReportId)">
                                                <i class="fas fa-redo me-1"></i>Relaunch
                                            </button>
                                        }
                                        @if (fault.Status == "Reported" || fault.Status == "In Progress")
                                        {
                                            <button class="btn btn-outline-info" onclick="contactSupport(@fault.FaultReportId)">
                                                <i class="fas fa-headset me-1"></i>Contact Support
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <div class="row mt-4">
                    <div class="col-12">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @if (Model.HasPreviousPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("ViewFaultStatus", new { page = Model.PageIndex - 1, sortOrder = ViewData["CurrentSort"], currentFilter = ViewData["CurrentFilter"] })">
                                            Previous
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">Previous</span>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("ViewFaultStatus", new { page = i, sortOrder = ViewData["CurrentSort"], currentFilter = ViewData["CurrentFilter"] })">
                                            @i
                                        </a>
                                    </li>
                                }

                                @if (Model.HasNextPage)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("ViewFaultStatus", new { page = Model.PageIndex + 1, sortOrder = ViewData["CurrentSort"], currentFilter = ViewData["CurrentFilter"] })">
                                            Next
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">Next</span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                    <h4 class="text-muted">No Fault Reports</h4>
                    <p class="text-muted mb-4">You haven't reported any faults yet.</p>
                    <a href="@Url.Action("CreateFault")" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus me-2"></i>Report Your First Fault
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Relaunch Modal -->
<div class="modal fade" id="relaunchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Relaunch Fault Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You are about to relaunch a previously declined fault request. This will create a new request with the same appliance information.</p>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Tip:</strong> You can add additional information or photos to help us process your request faster.
                </div>
                <form id="relaunchForm" method="post" action="@Url.Action("RelaunchFault")">
                    <input type="hidden" id="relaunchFaultId" name="faultReportId" />
                    <div class="form-group mb-3">
                        <label class="form-label">Additional Information (Optional)</label>
                        <textarea class="form-control" name="additionalInfo" rows="3" 
                                  placeholder="Add any additional details or updates about the fault..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitRelaunch()">
                    <i class="fas fa-redo me-2"></i>Relaunch Request
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function relaunchFaultRequest(faultReportId) {
            document.getElementById('relaunchFaultId').value = faultReportId;
            new bootstrap.Modal(document.getElementById('relaunchModal')).show();
        }

        function submitRelaunch() {
            document.getElementById('relaunchForm').submit();
        }

        function contactSupport(faultReportId) {
            window.location.href = 'tel:1-800-HELP-NOW';
        }
    </script>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "resolved" => "success",
            "in progress" => "info",
            "reported" => "warning",
            "declined" => "danger",
            _ => "secondary"
        };
    }

    public string GetPriorityBadgeClass(string priority)
    {
        return priority?.ToLower() switch
        {
            "high" or "critical" => "danger",
            "medium" => "warning",
            "low" => "info",
            _ => "secondary"
        };
    }
}