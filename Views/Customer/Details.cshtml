@model Allocation
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <input asp-for="AllocationId" type="hidden" />
    <input asp-for="FridgeId" type="hidden" />
<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="card-header bg-primary text-light py-4 position-relative">
            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <h2 class="text-white fw-bold mb-1">@Model.Brand Professional Series</h2>
                    <p class="text-light mb-0 opacity-75">Model: @Model.Model | Designed for commercial excellence</p>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body p-4 p-md-5">
            <!-- Back Button -->
            <div class="row mb-4">
                <div class="col-12 col-md-3">
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                    </a>
                </div>
            </div>

            <div class="row g-5">
                <!-- Image & Availability -->
                <div class="col-12 col-lg-5 text-center">
                    <img src="@Model.ImageUrl" class="fridge-image img-fluid rounded-3 shadow-sm"
                         alt="@Model.Brand @Model.Model commercial refrigerator">
                    <div class="mt-3">
                        @if (Model.AvailabilityStatus == "Available")
                        {
                            <span class="badge bg-success px-4 py-2 fs-6">@Model.AvailabilityStatus</span>
                        }
                        else if (Model.AvailabilityStatus == "Unavailable")
                        {
                            <span class="badge bg-danger px-4 py-2 fs-6">@Model.AvailabilityStatus</span>
                        }
                        else if (Model.AvailabilityStatus == "Maintenance")
                        {
                            <span class="badge bg-warning text-dark px-4 py-2 fs-6">@Model.AvailabilityStatus</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-4 py-2 fs-6">@Model.AvailabilityStatus</span>
                        }
                    </div>
                </div>

                <!-- Details -->
                <div class="col-12 col-lg-7">
                    <h3 class="section-title mb-3 text-primary fw-bold">Specification Details</h3>

                    <div class="specs-container mb-4">
                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-tag fs-4 text-primary me-3"></i>
                            <div><strong>Fridge Number:</strong> @Model.FridgeNo</div>
                        </div>

                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-grid-3x3 fs-4 text-primary me-3"></i>
                            <div><strong>Type:</strong> @Model.Type</div>
                        </div>

                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-arrows-fullscreen fs-4 text-primary me-3"></i>
                            <div><strong>Capacity:</strong> @Model.CapacityLiters Liters</div>
                        </div>

                        <div class="spec-item d-flex align-items-center">
                            <i class="bi bi-info-circle fs-4 text-primary me-3"></i>
                            <div><strong>Status:</strong> @Model.AvailabilityStatus</div>
                        </div>

                    </div>

                    <h3 class="section-title mb-3 text-primary fw-bold">Description</h3>
                    <p class="text-secondary mb-4 lh-lg">@Model.Description</p>

                    <!-- Pricing -->
                    <div class="price-tag bg-light p-4 rounded-3 shadow-sm mb-4">
                        <div class="fs-6 text-muted">Monthly Rental Fee</div>
                        <div class="fs-1 fw-bold text-primary mt-1">@Model.RentalPricePerMonth.ToString("c")</div>
                        <div class="small text-muted mt-2">Plus applicable taxes & delivery fee</div>
                    </div>

                    <!-- Rental Form -->
                    <form method="post" class="rental-form">
                        <h4 class="fw-semibold text-dark mb-3">Rental Request</h4>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Preferred Rental Period</label>
                                <select class="form-select rounded-3">
                                    <option>3 Months</option>
                                    <option>6 Months</option>
                                    <option selected>12 Months</option>
                                    <option>24 Months</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Number of Units Needed</label>
                                <input type="number" value="1" min="1" class="form-control rounded-3 text-end" />
                            </div>
                        </div>

                        <div class="mt-4">
                            <h5 class="mb-3 text-primary fw-bold">Commercial Rental Benefits</h5>
                            <ul class="benefits-list text-secondary lh-lg list-unstyled">
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                    Flexible rental terms with upgrade options
                                </li>
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                    Full maintenance and service included
                                </li>
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                    24/7 technical support
                                </li>
                                <li class="d-flex align-items-start">
                                    <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
                                    Delivery and installation service available
                                </li>
                            </ul>

                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100 py-3 fs-5 fw-semibold rounded-pill shadow">
                                    <i class="bi bi-check-circle me-2"></i> Submit Rental Request
                                </button>
                                <p class="text-center text-muted small mt-3">
                                    By requesting, you agree to our rental terms. A representative will contact you within 24 hours to confirm details.
                                </p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


</form>