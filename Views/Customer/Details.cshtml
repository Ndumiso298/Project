@using Project.Utilities.Enums
@model FridgeAllocation
@{
    Layout = "_CustomerLayout";
}

<form method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="FridgeId" type="hidden" />
<div class="container py-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <!-- Header -->
        <div class="card-header bg-primary text-light py-4 position-relative">
            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <h2 class="text-white fw-bold mb-1">@Model.Fridge.Manufacturer Professional Series</h2>
                    <p class="text-light mb-0 opacity-75">Model: @Model.Fridge.Model | Designed for commercial excellence</p>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="card-body p-4 p-md-5">
            <!-- Back Button -->
            <div class="row mb-4">
                <div class="col-12 col-md-3">
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary w-100 rounded-pill">
                        <i class="bi bi-arrow-left me-1"></i> Back to Catalog
                    </a>
                </div>
            </div>

            <div class="row g-5">
                <!-- Image & Availability -->
                <div class="col-12 col-lg-5 text-center">
                    <img src="@Model.Fridge.ImageUrl" class="fridge-image img-fluid rounded-3 shadow-sm"
                         alt="@Model.Fridge.Manufacturer @Model.Fridge.Model commercial refrigerator">
                    <div class="mt-3">
                        @if (Model.Fridge.Status == FridgeStatus.Available)
                        {
                            <span class="badge bg-success px-4 py-2 fs-6">@Model.Fridge.Status</span>
                        }
                        else if (Model.Fridge.Status == FridgeStatus.Quarantined)
                        {
                            <p class="text-center text-danger small mt-3">
                                By requesting, you agree to our rental terms. A representative will contact you within 24 hours to confirm details.
                            </p>
                        }
                        else if (Model.Fridge.Status == FridgeStatus.UnderMaintenance)
                        {
                            <span class="badge bg-warning text-dark px-4 py-2 fs-6">@Model.Fridge.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-4 py-2 fs-6">@Model.Fridge.Status</span>
                        }
                    </div>
                </div>

                <!-- Details -->
                <div class="col-12 col-lg-7">
                    <h3 class="section-title mb-3 text-primary fw-bold">Specification Details</h3>

                    <div class="specs-container mb-4">
                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-tag fs-4 text-primary me-3"></i>
                            <div><strong>Fridge Number:</strong> @Model.Fridge.SerialNumber</div>
                        </div>

                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-grid-3x3 fs-4 text-primary me-3"></i>
                            <div><strong>Type:</strong> @Model.Fridge.Type</div>
                        </div>

                        <div class="spec-item d-flex align-items-center mb-3">
                            <i class="bi bi-arrows-fullscreen fs-4 text-primary me-3"></i>
                            <div><strong>Capacity:</strong> @Model.Fridge.CapacityLiters Liters</div>
                        </div>

                        <div class="row pl-2 mb-3">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label fw-semibold text-dark">Quantity</label>
                                    <input asp-for="Quantity" type="number" min="1" class="form-control text-end" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <h3 class="section-title mb-3 text-primary fw-bold">Description</h3>
                    <p class="text-secondary mb-4 lh-lg">@Model.Fridge.Description</p>

                    <!-- Pricing -->
                    <div class="price-tag bg-light p-4 rounded-3 shadow-sm mb-4">
                        <div class="fs-6 text-muted">Monthly Rental Fee</div>
@*                         <div class="fs-1 fw-bold text-primary mt-1">@Model.Fridge.RentalPricePerMonth.ToString("c")</ *@div>
                        <div class="small text-muted mt-2">Plus applicable taxes & delivery fee</div>
                    </div>
                   
                    <div class="row mt-4">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100 py-3 fs-5 fw-semibold rounded-pill shadow">
                                <i class="bi bi-check-circle me-2"></i> Add To Cart
                            </button>
                          
                        </div>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
</div>


</form>