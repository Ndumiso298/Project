@model Project.Models.ViewModel.AddToCartVM
@{
    ViewData["Title"] = "Fridge Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fridge Details</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" alt="@Model.Model" style="max-height: 300px;">
                            }
                            else
                            {
                                <div class="text-center mb-3">
                                    <i class="fas fa-refrigerator fa-5x text-gray-300"></i>
                                </div>
                            }

                            <h4 class="text-primary">@Model.Brand @Model.Model</h4>
                            <p class="text-muted">@Model.Description</p>
                            <div class="mb-3">
                                <p><i class="fas fa-arrows-alt-v text-primary"></i> <strong>Capacity:</strong> @Model.CapacityLiters Liters</p>
                                <p><i class="fas fa-tag text-primary"></i> <strong>Type:</strong> @Model.Type</p>
                                <p>
                                    <i class="fas fa-money-bill-wave text-success"></i> <strong>Monthly Rental:</strong>
                                    @if (Model.RentalPricePerMonth.HasValue)
                                    {
                                        <text>R @Model.RentalPricePerMonth.Value.ToString("F2")</text>
                                    }
                                    else
                                    {
                                        <text>Price not available</text>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-cart-plus"></i> Add to Cart</h5>
                                </div>
                                <div class="card-body">
                                    <form asp-action="Details" method="post">
                                        <input type="hidden" asp-for="FridgeId" />

                                        <div class="form-group">
                                            <label asp-for="Count" class="control-label font-weight-bold">Quantity</label>
                                            <select asp-for="Count" class="form-control">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <option value="@i">@i</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Count" class="text-danger"></span>
                                        </div>

                                        <div class="form-group mt-4">
                                            <button type="submit" class="btn btn-primary btn-lg btn-block">
                                                <i class="fas fa-cart-plus"></i> Add to Cart
                                            </button>
                                            <a asp-action="Index" class="btn btn-outline-secondary btn-block">
                                                <i class="fas fa-arrow-left"></i> Back to Fridge List
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}