@model Project.Models.ViewModel.AllocationVM
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_CustomerLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">My Shopping Cart</h6>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Continue Shopping
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.AllocationList.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Fridge</th>
                                        <th>Brand</th>
                                        <th>Model</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.AllocationList)
                                    {
                                        <tr>
                                            <td>@item.Fridge?.Type</td>
                                            <td>@item.Fridge?.Brand</td>
                                            <td>@item.Fridge?.Model</td>
                                            <td>R @item.Price.ToString()</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Minus" asp-route-id="@item.AllocationId" class="btn btn-outline-primary btn-sm">-</a>
                                                    <span class="btn btn-light btn-sm disabled">@item.Count</span>
                                                    <a asp-action="Plus" asp-route-id="@item.AllocationId" class="btn btn-outline-primary btn-sm">+</a>
                                                </div>
                                            </td>
                                            <td>R @((item.Price * item.Count).ToString())</td>
                                            <td>
                                                <a asp-action="Remove" asp-route-id="@item.AllocationId" class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Are you sure you want to remove this item?')">
                                                    <i class="fas fa-trash"></i> Remove
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="font-weight-bold">
                                    <tr>
                                        <td colspan="5" class="text-right">Total:</td>
                                        <td>R @Model.RequestHeader.RequestTotal.ToString("F2")</td>
                                        <td>
                                            <a asp-action="Summary" class="btn btn-success btn-block">
                                                <i class="fas fa-check"></i> Proceed to Checkout
                                            </a>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-shopping-cart fa-3x text-gray-300 mb-3"></i>
                            <p class="text-muted">Your cart is empty.</p>
                            <a asp-controller="Customer" asp-action="Index" class="btn btn-primary">
                                <i class="fas fa-refrigerator"></i> Browse Fridges
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>