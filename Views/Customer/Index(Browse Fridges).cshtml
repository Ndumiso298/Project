@model IEnumerable<Project.Models.Fridge>
@{
    ViewData["Title"] = "Available Fridges";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary">Available Fridges for Rent</h6>
                    <a asp-action="Cart" class="btn btn-primary btn-sm">
                        <i class="fas fa-shopping-cart"></i> View Cart
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="row">
                            @foreach (var fridge in Model)
                            {
                                <div class="col-xl-4 col-md-6 mb-4">
                                    <div class="card border-left-primary shadow h-100">
                                        <div class="card-body">
                                            <div class="row no-gutters align-items-center">
                                                <div class="col mr-2">
                                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                                        @fridge.Brand @fridge.Model
                                                    </div>
                                                    <div class="h6 mb-0 font-weight-bold text-gray-800">
                                                        R @fridge.RentalPricePerMonth.ToString("F2")/month
                                                    </div>
                                                    <div class="text-xs text-muted mt-1">
                                                        <i class="fas fa-arrows-alt-v"></i> @fridge.CapacityLiters L
                                                        <br>
                                                        <i class="fas fa-tag"></i> @fridge.Type
                                                    </div>
                                                    <div class="text-xs text-muted mt-2">
                                                        @fridge.Description
                                                    </div>
                                                </div>
                                                <div class="col-auto">
                                                    <i class="fas fa-refrigerator fa-2x text-gray-300"></i>
                                                </div>
                                            </div>
                                            <div class="mt-3">
                                                <a asp-action="Details" asp-route-id="@fridge.FridgeId"
                                                   class="btn btn-primary btn-sm btn-block">
                                                    <i class="fas fa-info-circle"></i> View Details & Add to Cart
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-refrigerator fa-3x text-gray-300 mb-3"></i>
                            <p class="text-muted">No fridges available at the moment.</p>
                            <p class="text-muted small">Please check back later or contact support.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>