@model MaintenanceDashboardVM
@{
    ViewData["Title"] = "Maintenance Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-tachometer-alt me-2"></i>@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="fas fa-list me-1"></i>View All Visits
    </a>
</div>

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Total Visits
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalVisits</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-calendar-alt fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Scheduled
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.ScheduledVisits</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-clock fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                            In Progress
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.InProgressVisits</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-wrench fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-start-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            Completed
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.CompletedVisits</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Overdue Visits -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header bg-danger text-white">
                <h6 class="m-0 font-weight-bold">
                    <i class="fas fa-exclamation-triangle me-2"></i>Overdue Visits
                </h6>
            </div>
            <div class="card-body">
                @if (Model.OverdueVisits.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var visit in Model.OverdueVisits.Take(5))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@visit.Fridge?.SerialNumber</strong><br>
                                    <small class="text-muted">@visit.Customer?.BusinessName</small>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">@visit.ScheduledDate.ToString("dd/MM/yyyy")</small><br>
                                    <span class="badge bg-danger">Overdue</span>
                                </div>
                            </div>
                        }
                    </div>
                    @if (Model.OverdueVisits.Count > 5)
                    {
                        <div class="text-center mt-3">
                            <a asp-action="Index" asp-route-status="Overdue" class="btn btn-outline-danger btn-sm">
                                View All @Model.OverdueVisits.Count Overdue Visits
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="fas fa-check-circle fa-2x mb-2"></i>
                        <p>No overdue visits</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Upcoming Visits -->
    <div class="col-lg-6 mb-4">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h6 class="m-0 font-weight-bold">
                    <i class="fas fa-calendar-check me-2"></i>Upcoming Visits (Next 7 Days)
                </h6>
            </div>
            <div class="card-body">
                @if (Model.UpcomingVisits.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var visit in Model.UpcomingVisits)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@visit.Fridge?.SerialNumber</strong><br>
                                    <small class="text-muted">@visit.Customer?.BusinessName</small>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">@visit.ScheduledDate.ToString("dd/MM/yyyy HH:mm")</small><br>
                                    <span class="badge bg-info">@visit.AssignedTechnician?.UserAccount?.FirstName</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="fas fa-calendar-times fa-2x mb-2"></i>
                        <p>No upcoming visits</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h6 class="m-0 font-weight-bold">
                    <i class="fas fa-bolt me-2"></i>Quick Actions
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <a asp-action="Upsert" class="btn btn-outline-primary w-100 h-100 py-3">
                            <i class="fas fa-plus fa-2x mb-2"></i><br>
                            Schedule Visit
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-controller="MaintenanceRecords" asp-action="Upsert"
                           class="btn btn-outline-success w-100 h-100 py-3">
                            <i class="fas fa-clipboard-list fa-2x mb-2"></i><br>
                            Create Record
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Index" asp-route-status="Scheduled"
                           class="btn btn-outline-info w-100 h-100 py-3">
                            <i class="fas fa-clock fa-2x mb-2"></i><br>
                            View Scheduled
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a asp-action="Index" asp-route-status="InProgress"
                           class="btn btn-outline-warning w-100 h-100 py-3">
                            <i class="fas fa-wrench fa-2x mb-2"></i><br>
                            In Progress
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>