@model CompleteMaintenanceVM
@{
    ViewData["Title"] = "Complete Maintenance Visit";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-check-circle me-2"></i>@ViewData["Title"]
    </h1>
    <a asp-action="Details" asp-route-id="@Model.VisitId" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Back to Visit
    </a>
</div>

<div class="card">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0"><i class="fas fa-clipboard-check me-2"></i>Visit Completion</h5>
    </div>
    <div class="card-body">
        <form asp-action="Complete" method="post" id="completionForm">
            <input type="hidden" asp-for="VisitId" />

            <!-- Visit Information -->
            <div class="alert alert-info mb-4">
                <h6><i class="fas fa-info-circle me-2"></i>Visit Information</h6>
                <p class="mb-1"><strong>Fridge:</strong> @Model.FridgeInfo</p>
                <p class="mb-0"><strong>Customer:</strong> @Model.CustomerInfo</p>
            </div>

            <!-- Completion Status -->
            <div class="mb-4">
                <label asp-for="Status" class="form-label required"></label>
                <select asp-for="Status" class="form-select">
                    <option value="@ServicingStatus.Completed">Completed</option>
                    <option value="@ServicingStatus.Cancelled">Cancelled</option>
                    <option value="@ServicingStatus.Rescheduled">No Access</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <!-- Service Checklist (Mandatory) -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="fas fa-check-circle me-2"></i>Service Checklist</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="form-check">
                            <input asp-for="IsChecklistCompleted" class="form-check-input" id="checklistCompleted" />
                            <label asp-for="IsChecklistCompleted" class="form-check-label required">
                                I confirm that the service checklist has been completed
                            </label>
                        </div>
                        <span asp-validation-for="IsChecklistCompleted" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ChecklistNotes" class="form-label">Checklist Notes</label>
                        <textarea asp-for="ChecklistNotes" class="form-control" rows="3"
                                  placeholder="Add any notes about the checklist completion, issues found, or additional work required..."></textarea>
                        <span asp-validation-for="ChecklistNotes" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Technician Notes -->
            <div class="mb-4">
                <label asp-for="TechnicianNotes" class="form-label">Technician Notes & Observations</label>
                <textarea asp-for="TechnicianNotes" class="form-control" rows="4"
                          placeholder="Describe the service performed, any issues encountered, parts replaced, or recommendations for the customer..."></textarea>
                <span asp-validation-for="TechnicianNotes" class="text-danger"></span>
            </div>

            <!-- Form Actions -->
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Details" asp-route-id="@Model.VisitId" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-check me-1"></i>Complete Visit
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Real-time validation for checklist completion
            $('#completionForm').submit(function(e) {
                if (!$('#checklistCompleted').is(':checked')) {
                    e.preventDefault();
                    alert('Please confirm that the service checklist has been completed.');
                    $('#checklistCompleted').focus();
                }
            });
        });
    </script>
}