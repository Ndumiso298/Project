@model MaintenanceVisit
@{
    ViewData["Title"] = $"Maintenance Visit - #{Model.Id:00000}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <i class="fas fa-calendar-alt me-2"></i>Maintenance Visit
        <small class="text-muted">#@Model.Id.ToString("00000")</small>
    </h1>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
        <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-edit me-1"></i>Edit
        </a>
        @if (Model.CanBeStarted || Model.CanBeCompleted)
        {
            <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="fas fa-check me-1"></i>Complete
            </a>
        }
    </div>
</div>

<div class="row">
    <!-- Main Information -->
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Visit Information</h5>
                <div>
                    <span class="badge @Model.StatusBadgeClass me-1">@Model.Status</span>
                    @if (Model.IsOverdue)
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th class="w-40">Scheduled Date:</th>
                                <td>@Model.ScheduledDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            <tr>
                                <th>Actual Start:</th>
                                <td>@(Model.ActualStartDate?.ToString("dd/MM/yyyy HH:mm") ?? "Not started")</td>
                            </tr>
                            <tr>
                                <th>Actual End:</th>
                                <td>@(Model.ActualEndDate?.ToString("dd/MM/yyyy HH:mm") ?? "Not completed")</td>
                            </tr>
                            <tr>
                                <th>Duration:</th>
                                <td>
                                    @if (Model.DurationHours.HasValue)
                                    {
                                        <span class="fw-bold">@Model.DurationHours.Value.ToString("F1") hours</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-borderless">
                            <tr>
                                <th class="w-40">Condition Rating:</th>
                                <td>
                                    @if (Model.ConditionRating.HasValue)
                                    {
                                        <div class="star-rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= Model.ConditionRating.Value ? "text-warning" : "text-muted")"></i>
                                            }
                                        </div>
                                        <small class="text-muted">(@Model.ConditionRating.Value/5)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not rated</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Temperature:</th>
                                <td>
                                    @if (Model.TemperatureReading.HasValue)
                                    {
                                        <span class="fw-bold @(Model.TemperatureReading.Value > 5 ? "text-danger" : "text-success")">
                                            @Model.TemperatureReading.Value°C
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not recorded</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th>Checklist:</th>
                                <td>
                                    @if (Model.IsChecklistCompleted)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Service Details -->
                @if (Model.MaintenancePerformed && !string.IsNullOrEmpty(Model.MaintenanceDetails))
                {
                    <div class="mt-4">
                        <h6><i class="fas fa-wrench me-2"></i>Maintenance Performed</h6>
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(Model.MaintenanceDetails?.Replace("\n", "<br>"))
                        </div>
                    </div>
                }

                <!-- Technician Notes -->
                @if (!string.IsNullOrEmpty(Model.TechnicianNotes))
                {
                    <div class="mt-3">
                        <h6><i class="fas fa-sticky-note me-2"></i>Technician Notes</h6>
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(Model.TechnicianNotes?.Replace("\n", "<br>"))
                        </div>
                    </div>
                }

                <!-- Checklist Notes -->
                @if (!string.IsNullOrEmpty(Model.ChecklistNotes))
                {
                    <div class="mt-3">
                        <h6><i class="fas fa-check-circle me-2"></i>Checklist Notes</h6>
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(Model.ChecklistNotes?.Replace("\n", "<br>"))
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Customer & Fridge Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>Customer & Fridge Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Customer</h6>
                        <strong>@Model.Customer?.BusinessName</strong><br>
                        <small class="text-muted">
                            @Model.Customer?.BusinessType<br>
                            Contact: @Model.Customer?.ContactPerson<br>
                            Phone: @Model.Customer?.BusinessPhoneNumber
                        </small>
                    </div>
                    <div class="col-md-6">
                        <h6>Fridge</h6>
                        <strong>@Model.Fridge?.SerialNumber</strong><br>
                        <small class="text-muted">
                            @Model.Fridge?.FridgeModel?.Manufacturer @Model.Fridge?.FridgeModel?.ModelName<br>
                            Capacity: @Model.Fridge?.FridgeModel?.CapacityLiters liters<br>
                            Status: <span class="badge bg-info">@Model.Fridge?.Status</span>
                        </small>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <h6>Location</h6>
                        <strong>@Model.Location?.FullAddress</strong><br>
                        <small class="text-muted">
                            @Model.Location?.City, @Model.Location?.Suburb<br>
                            @Model.Location?.StreetAddress
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Issues & Follow-up -->
        @if (Model.FaultsFound || Model.ReplacementRecommended || Model.FollowUpRequired)
        {
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Issues & Follow-up</h5>
                </div>
                <div class="card-body">
                    @if (Model.FaultsFound)
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>Faults Found:</strong> @Model.CreatedFaults.Count fault(s) reported during this visit
                        </div>
                    }

                    @if (Model.ReplacementRecommended)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exchange-alt me-2"></i>
                            <strong>Replacement Recommended</strong><br>
                            @Model.ReplacementReason
                        </div>
                    }

                    @if (Model.FollowUpRequired)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-calendar-plus me-2"></i>
                            <strong>Follow-up Required</strong><br>
                            @if (Model.FollowUpDate.HasValue)
                            {
                                <span>Scheduled for: @Model.FollowUpDate.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (Model.NextServiceDue.HasValue)
                            {
                                <br>

                                <span>Next service due: @Model.NextServiceDue.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Created Faults -->
        @if (Model.CreatedFaults.Any())
        {
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-bug me-2"></i>Faults Reported</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fault ID</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Reported Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fault in Model.CreatedFaults)
                                {
                                    <tr>
                                        <td>#@fault.Id</td>
                                        <td>@fault.Title</td>
                                        <td><span class="badge bg-info">@fault.Status</span></td>
                                        <td><span class="badge @(fault.Priority == FaultPriority.High ? "bg-danger" : "bg-warning")">@fault.Priority</span></td>
                                        <td>@fault.ReportedDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    @if (Model.CanBeStarted)
                    {
                        <form asp-action="StartVisit" method="post" class="d-grid">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-warning btn-sm">
                                <i class="fas fa-play me-1"></i>Start Visit
                            </button>
                        </form>
                    }

                    @if (Model.CanBeCompleted)
                    {
                        <a asp-action="Complete" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                            <i class="fas fa-check me-1"></i>Complete Visit
                        </a>
                    }

                    @if (Model.CanBeCancelled)
                    {
                        <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="fas fa-times me-1"></i>Cancel Visit
                        </button>
                    }

                    <a asp-controller="MaintenanceRecords" asp-action="Upsert" asp-route-visitId="@Model.Id"
                       class="btn btn-info btn-sm">
                        <i class="fas fa-clipboard-list me-1"></i>Create Record
                    </a>

                    <a href="#" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-print me-1"></i>Print Report
                    </a>
                </div>
            </div>
        </div>

        <!-- Technician Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-user-tie me-2"></i>Assigned Technician</h5>
            </div>
            <div class="card-body">
                <strong>@Model.AssignedTechnician?.UserAccount?.FirstName @Model.AssignedTechnician?.UserAccount?.LastName</strong><br>
                <small class="text-muted">
                    @Model.AssignedTechnician?.EmployeeType<br>
                    Phone: @Model.AssignedTechnician?.UserAccount?.PhoneNumber<br>
                    Email: @Model.AssignedTechnician?.UserAccount?.Email
                </small>
            </div>
        </div>

        <!-- Customer Feedback -->
        @if (!string.IsNullOrEmpty(Model.CustomerFeedback) || Model.CustomerRating.HasValue)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Customer Feedback</h5>
                </div>
                <div class="card-body">
                    @if (Model.CustomerRating.HasValue)
                    {
                        <div class="star-rating mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star @(i <= Model.CustomerRating.Value ? "text-warning" : "text-muted")"></i>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.CustomerFeedback))
                    {
                        <div class="border rounded p-2 bg-light">
                            <small>@Model.CustomerFeedback</small>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Audit Information -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-history me-2"></i>Audit Information</h5>
            </div>
            <div class="card-body">
                <small class="text-muted">
                    <strong>Created:</strong><br>
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm") by @Model.CreatedBy<br><br>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <strong>Last Updated:</strong>

                        <br>
                        @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                        @Model.UpdatedBy
                            }
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-times me-2"></i>Cancel Visit</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CancelVisit" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="cancelReason" class="form-label required">Cancellation Reason</label>
                        <textarea name="cancelReason" class="form-control" rows="3" required
                                  placeholder="Please provide a reason for cancelling this visit..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Cancel Visit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .star-rating {
        font-size: 1.1em;
    }
</style>