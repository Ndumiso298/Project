@model IEnumerable<MaintenanceVisit>
@{
    ViewData["Title"] = "Maintenance Visits";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-6">
            <h2 class="text-primary">
                <i class="fas fa-calendar-check me-2"></i>Maintenance Visits
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Upsert" class="btn btn-primary me-2">
                <i class="fas fa-plus me-2"></i>Schedule Visit
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-info">
                <i class="fas fa-chart-bar me-2"></i>Dashboard
            </a>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Search & Filter
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="All">All Statuses</option>
                        @foreach (var item in ViewBag.StatusList)
                        {
                            <option value="@item.Value" selected="@(item.Value == ViewBag.CurrentStatus?.ToString())">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" class="form-control" id="search" name="search"
                           value="@ViewBag.SearchString" placeholder="Fridge, customer, technician...">
                </div>
                <div class="col-md-2">
                    <label for="fromDate" class="form-label">From Date</label>
                    <input type="date" class="form-control" id="fromDate" name="fromDate" value="@ViewBag.FromDate">
                </div>
                <div class="col-md-2">
                    <label for="toDate" class="form-label">To Date</label>
                    <input type="date" class="form-control" id="toDate" name="toDate" value="@ViewBag.ToDate">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search me-2"></i>Apply
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>

            <!-- Quick Status Filters -->
            <div class="row mt-3">
                <div class="col-12">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="showCompleted" name="showCompleted"
                        @(ViewBag.ShowCompleted ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label" for="showCompleted">Show Completed</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="showCancelled" name="showCancelled"
                        @(ViewBag.ShowCancelled ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label" for="showCancelled">Show Cancelled</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visits Card -->
    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Visit ID</th>
                                <th>Scheduled Date</th>
                                <th>Customer</th>
                                <th>Fridge</th>
                                <th>Location</th>
                                <th>Technician</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var visit in Model)
                            {
                                <tr>
                                    <td>#@visit.Id</td>
                                    <td>
                                        <div>@visit.ScheduledDate.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@visit.ScheduledDate.ToString("HH:mm")</small>
                                        @if (visit.ScheduledDate < DateTime.Now && visit.Status != ServicingStatus.Completed && visit.Status != ServicingStatus.Cancelled)
                                        {
                                            <div><span class="badge bg-danger">Overdue</span></div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">@visit.Customer?.TradingName</div>
                                        <small class="text-muted">@visit.Customer?.UserAccount?.FirstName @visit.Customer?.UserAccount?.LastName</small>
                                    </td>
                                    <td>
                                        <a asp-controller="Fridges" asp-action="Details" asp-route-id="@visit.FridgeId"
                                           class="text-decoration-none">
                                            @visit.Fridge?.SerialNumber
                                        </a>
                                    </td>
                                    <td>
                                        <small>@visit.Location?.FullAddress</small>
                                    </td>
                                    <td>
                                        @if (visit.Technician != null)
                                        {
                                            <div>@visit.Technician.UserAccount?.FirstName @visit.Technician.UserAccount?.LastName</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assigned</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetVisitTypeBadge(visit.VisitType)">
                                            @visit.VisitType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@GetStatusBadge(visit.Status)">
                                            @visit.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@visit.Id"
                                               class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Upsert" asp-route-id="@visit.Id"
                                               class="btn btn-primary btn-sm" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (visit.Status == ServicingStatus.Scheduled || visit.Status == ServicingStatus.InProgress)
                                            {
                                                <a asp-action="Complete" asp-route-id="@visit.Id"
                                                   class="btn btn-success btn-sm" title="Complete">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                            }
                                            @if (User.IsInRole(SD.AdminRole))
                                            {
                                                <button type="button" class="btn btn-danger btn-sm"
                                                        onclick="confirmDelete(@visit.Id, '@visit.ScheduledDate.ToString("dd/MM/yyyy")')" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Statistics -->
                <div class="row mt-4">
                    <div class="col-md-2 col-6">
                        <div class="card bg-primary text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count()</h6>
                                <small class="card-text">Total</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-success text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(v => v.Status == ServicingStatus.Scheduled)</h6>
                                <small class="card-text">Scheduled</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-warning text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(v => v.Status == ServicingStatus.InProgress)</h6>
                                <small class="card-text">In Progress</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-info text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(v => v.Status == ServicingStatus.Completed)</h6>
                                <small class="card-text">Completed</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-danger text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(v => v.ScheduledDate < DateTime.Now && v.Status != ServicingStatus.Completed && v.Status != ServicingStatus.Cancelled)</h6>
                                <small class="card-text">Overdue</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2 col-6">
                        <div class="card bg-secondary text-white text-center">
                            <div class="card-body py-2">
                                <h6 class="card-title mb-1">@Model.Count(v => v.Status == ServicingStatus.Cancelled)</h6>
                                <small class="card-text">Cancelled</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Maintenance Visits Found</h5>
                    <p class="text-muted">Try adjusting your search criteria or schedule a new maintenance visit.</p>
                    <a asp-action="Upsert" class="btn btn-primary mt-3">
                        <i class="fas fa-plus me-2"></i>Schedule First Visit
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, scheduledDate) {
            Swal.fire({
                title: 'Are you sure?',
                text: `You are about to delete maintenance visit scheduled for ${scheduledDate}. This action cannot be undone.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete")', { id: id }, function () {
                        Swal.fire(
                            'Deleted!',
                            'Maintenance visit has been deleted.',
                            'success'
                        ).then(() => {
                            window.location.reload();
                        });
                    }).fail(function () {
                        Swal.fire(
                            'Error!',
                            'An error occurred while deleting the visit.',
                            'error'
                        );
                    });
                }
            });
        }
    </script>
}

@functions {
    public string GetStatusBadge(ServicingStatus status)
    {
        return status switch
        {
            ServicingStatus.Scheduled => "primary",
            ServicingStatus.InProgress => "warning",
            ServicingStatus.Completed => "success",
            ServicingStatus.Cancelled => "danger",
            _ => "secondary"
        };
    }

    public string GetVisitTypeBadge(ServicingType serviceType)
    {
        return serviceType switch
        {
            ServicingType.Installation => "primary",
            ServicingType.PreventiveMaintenance => "warning",
            ServicingType.CorrectiveMaintenance => "danger",
            ServicingType.Inspection => "success",
            _ => "secondary"
        };
    }
}