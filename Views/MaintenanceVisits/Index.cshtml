@model IEnumerable<MaintenanceVisit>
@{
    ViewData["Title"] = "Maintenance Visits";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-calendar-alt me-2"></i>@ViewData["Title"]</h1>
    <div>
        <a asp-action="Dashboard" class="btn btn-info me-2">
            <i class="fas fa-tachometer-alt me-1"></i>Dashboard
        </a>
        <a asp-action="Upsert" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Schedule Visit
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label for="status" class="form-label">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    @foreach (var status in ViewBag.StatusList)
                    {
                        <option value="@status.Value" selected="@(status.Value == ViewBag.CurrentStatus?.ToString())">
                            @status.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="fromDate" class="form-label">From Date</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
            </div>
            <div class="col-md-3">
                <label for="toDate" class="form-label">To Date</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
            </div>
            <div class="col-md-3">
                <label for="search" class="form-label">Search</label>
                <input type="text" name="search" class="form-control" value="@ViewBag.SearchString"
                       placeholder="Search fridge, customer, technician...">
            </div>
            <div class="col-12">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="showCompleted" value="true"
                           id="showCompleted" @(ViewBag.ShowCompleted ? "checked" : "") onchange="this.form.submit()">
                    <label class="form-check-label" for="showCompleted">Show Completed</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="showCancelled" value="true"
                           id="showCancelled" @(ViewBag.ShowCancelled ? "checked" : "") onchange="this.form.submit()">
                    <label class="form-check-label" for="showCancelled">Show Cancelled</label>
                </div>
                <button type="submit" class="btn btn-outline-primary float-end">
                    <i class="fas fa-filter me-1"></i>Apply Filters
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="mb-0">Scheduled Maintenance Visits</h5>
            </div>
            <div class="col-md-6 text-end">
                <small class="text-muted">@Model.Count() visits found</small>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                <h5>No maintenance visits found</h5>
                <p class="text-muted">Schedule your first maintenance visit to get started</p>
                <a asp-action="Upsert" class="btn btn-primary">Schedule Visit</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Scheduled Date</th>
                            <th>Customer</th>
                            <th>Fridge</th>
                            <th>Location</th>
                            <th>Technician</th>
                            <th>Status</th>
                            <th>Follow-up</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in Model)
                        {
                            <tr class="@(visit.IsOverdue ? "table-warning" : "")">
                                <td>
                                    @visit.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                                    @if (visit.IsOverdue)
                                    {
                                        <br>

                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                </td>
                                <td>
                                    <strong>@visit.Customer?.BusinessName</strong><br>
                                    <small class="text-muted">@visit.Customer?.BusinessType</small>
                                </td>
                                <td>
                                    @visit.Fridge?.SerialNumber<br>
                                    <small class="text-muted">@visit.Fridge?.FridgeModel?.ModelName</small>
                                </td>
                                <td>
                                    <small>@visit.Location?.FullAddress</small>
                                </td>
                                <td>
                                    @visit.AssignedTechnician?.UserAccount?.FirstName @visit.AssignedTechnician?.UserAccount?.LastName
                                </td>
                                <td>
                                    <span class="badge @visit.StatusBadgeClass">@visit.Status</span>
                                </td>
                                <td>
                                    @if (visit.FollowUpRequired)
                                    {
                                        <span class="badge bg-warning">Required</span>
                                        @if (visit.FollowUpDate.HasValue)
                                        {
                                            <br>

                                            <small>@visit.FollowUpDate.Value.ToString("dd/MM/yyyy")</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@visit.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Upsert" asp-route-id="@visit.Id"
                                           class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (visit.CanBeStarted || visit.CanBeCompleted)
                                        {
                                            <a asp-action="Complete" asp-route-id="@visit.Id"
                                               class="btn btn-outline-success" title="Complete">
                                                <i class="fas fa-check"></i>
                                            </a>
                                        }
                                        @if (User.IsInRole(SD.AdminRole))
                                        {
                                            <form asp-action="Delete" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@visit.Id" />
                                                <button type="submit" class="btn btn-outline-danger"
                                                        title="Delete" onclick="return confirm('Are you sure you want to delete this visit?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>