@model Project.Models.ViewModel.AdminVM
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_CustomerLayout";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
        <div class="d-none d-sm-inline-block">
            <span class="text-muted">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")</span>
        </div>
    </div>

    <!-- Statistics Cards Row -->
    <div class="row">
        <!-- User Statistics -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Users</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalUsers</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-xs">
                        <span class="text-success">@Model.TotalCustomers Customers</span> |
                        <span class="text-info">@Model.TotalEmployees Employees</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge Statistics -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Fridge Inventory</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalFridgeInstances</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-refrigerator fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-xs">
                        <span class="text-success text-black">@Model.AvailableFridges Available</span> |
                        <span class="text-warning text-black">@Model.RentedFridges Rented</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Monthly Revenue</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">R @Model.MonthlyRevenue.ToString("N2")</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-xs">
                        <span class="text-success">@Model.ActiveRentals Active Rentals</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Requests Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total Requests</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalRequests</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                    <div class="mt-2 text-xs">
                        <span class="text-success text-black">@Model.ApprovedRequests Approved</span> |
                        <span class="text-danger text-black">@Model.RejectedRequests Rejected</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fridge Stock Alerts Row -->
    <div class="row">
        <!-- Low Stock Fridges -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-danger">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Low Stock Fridges
                    </h6>
                    <span class="badge text-black badge-danger">@Model.LowStockFridges.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.LowStockFridges.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless">
                                <thead>
                                    <tr>
                                        <th>Fridge Model</th>
                                        <th>Available</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fridge in Model.LowStockFridges)
                                    {
                                        <tr>
                                            <td>@fridge.FridgeModel</td>
                                            <td>@fridge.AvailableStock</td>
                                            <td>@fridge.TotalStock</td>
                                            <td>
                                                <span class="badge text-black badge-@(fridge.StockLevel == "Out of Stock" ? "danger" : fridge.StockLevel == "Low Stock" ? "warning" : "info")">
                                                    @fridge.StockLevel
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No low stock fridges</p>
                    }
                </div>
            </div>
        </div>

        <!-- Maintenance Due -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-warning">
                        <i class="fas fa-tools mr-2"></i>Maintenance Due
                    </h6>
                    <span class="badge badge-warning">@Model.MaintenanceDueFridges.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.MaintenanceDueFridges.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless">
                                <thead>
                                    <tr>
                                        <th>Fridge No</th>
                                        <th>Model</th>
                                        <th>Last Maintenance</th>
                                        <th>Condition</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fridge in Model.MaintenanceDueFridges)
                                    {
                                        <tr>
                                            <td>@fridge.FridgeNo</td>
                                            <td>@fridge.FridgeModel</td>
                                            <td>@(fridge.LastMaintenanceDate?.ToString("MM/dd/yyyy") ?? "Never")</td>
                                            <td>
                                                <span class="badge badge-@(fridge.Condition == "Excellent" ? "success" : fridge.Condition == "Good" ? "info" : "warning")">
                                                    @fridge.Condition
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">All fridges are up to date with maintenance</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row">
        <!-- Requests by Status Chart -->
        <div class="col-xl-4 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Requests by Status</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="requestsStatusChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge Stock Status -->
        <div class="col-xl-4 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Fridge Stock Status</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="fridgeStockStatusChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Maintenance Status -->
        <div class="col-xl-4 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Maintenance Status</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="maintenanceStatusChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row">
        <!-- Monthly Request Trend -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Monthly Request Trend</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="monthlyTrendChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fridge Stock Levels -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 10 Fridge Stock Levels</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="stockLevelsChart" width="400" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities Row -->
    <div class="row">
        <!-- Recent Requests -->
        <div class="col-xl-3 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Requests</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td class="text-" style="max-width: 100px;" title="@request.CustomerName">@request.CustomerName</td>
                                        <td>R @request.TotalAmount.ToString("N0")</td>
                                        <td><span class="badge text-black badge-@(request.Status == "Approved" ? "success" : request.Status == "Pending" ? "warning" : "danger")">@request.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Visits -->
        <div class="col-xl-3 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Visits</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var visit in Model.RecentVisits)
                                {
                                    <tr>
                                        <td class="text-dark" style="max-width: 100px;" title="@visit.CustomerName">@visit.CustomerName</td>
                                        <td>@visit.VisitDate.ToString("MM/dd")</td>
                                        <td><span class="badge text-black badge-@(visit.Status == "Passed" ? "success" : visit.Status == "Failed" ? "danger" : "warning")">@visit.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Stock Updates -->
        <div class="col-xl-3 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Stock</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless">
                            <thead>
                                <tr>
                                    <th>Fridge No</th>
                                    <th>Status</th>
                                    <th>Condition</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in Model.RecentStockUpdates)
                                {
                                    <tr>
                                        <td class="text-truncate" style="max-width: 80px;" title="@stock.FridgeNo">@stock.FridgeNo</td>
                                        <td>
                                            <span class="badge text-black badge-@(stock.IsAvailable ? "success" : "warning")">
                                                @(stock.IsAvailable ? "Available" : "Rented")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge text-black badge-@(stock.Condition == "Excellent" ? "success" : stock.Condition == "Good" ? "info" : "warning")">
                                                @stock.Condition
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Performing Fridges -->
        <div class="col-xl-3 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Top Performers</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless">
                            <thead>
                                <tr>
                                    <th>Model</th>
                                    <th>Revenue</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var fridge in Model.TopPerformingFridges)
                                {
                                    <tr>
                                        <td class="text-truncate" style="max-width: 100px;" title="@fridge.FridgeModel">@fridge.FridgeModel</td>
                                        <td>R @fridge.Revenue.ToString("N0")</td>
                                        <td>
                                            <span class="badge text-black badge-@(fridge.StockLevel == "High Stock" ? "success" : fridge.StockLevel == "Medium Stock" ? "info" : fridge.StockLevel == "Low Stock" ? "warning" : "danger")">
                                                @fridge.StockLevel
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Requests by Status Chart (Pie)
        var requestsStatusCtx = document.getElementById('requestsStatusChart').getContext('2d');
        var requestsStatusChart = new Chart(requestsStatusCtx, {
            type: 'pie',
            data: {
                labels: ['@Html.Raw(string.Join("','", Model.RequestsByStatus.Select(r => r.Label)))'],
                datasets: [{
                    data: [@string.Join(",", Model.RequestsByStatus.Select(r => r.Value))],
                    backgroundColor: ['#1cc88a', '#f6c23e', '#e74a3b', '#36b9cc']
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Fridge Stock Status Chart (Pie)
        var fridgeStockStatusCtx = document.getElementById('fridgeStockStatusChart').getContext('2d');
        var fridgeStockStatusChart = new Chart(fridgeStockStatusCtx, {
            type: 'pie',
            data: {
                labels: ['@Html.Raw(string.Join("','", Model.FridgeStockStatus.Select(s => s.Label)))'],
                datasets: [{
                    data: [@string.Join(",", Model.FridgeStockStatus.Select(s => s.Value))],
                    backgroundColor: ['#e74a3b', '#f6c23e', '#36b9cc', '#1cc88a']
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Maintenance Status Chart (Pie)
        var maintenanceStatusCtx = document.getElementById('maintenanceStatusChart').getContext('2d');
        var maintenanceStatusChart = new Chart(maintenanceStatusCtx, {
            type: 'pie',
            data: {
                labels: ['@Html.Raw(string.Join("','", Model.FridgeMaintenanceStatus.Select(m => m.Label)))'],
                datasets: [{
                    data: [@string.Join(",", Model.FridgeMaintenanceStatus.Select(m => m.Value))],
                    backgroundColor: ['#f6c23e', '#1cc88a']
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Monthly Trend Chart (Line)
        var monthlyTrendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        var monthlyTrendChart = new Chart(monthlyTrendCtx, {
            type: 'line',
            data: {
                labels: ['@Html.Raw(string.Join("','", Model.MonthlyRequestTrend.Select(m => m.Label)))'],
                datasets: [{
                    label: 'Requests',
                    data: [@string.Join(",", Model.MonthlyRequestTrend.Select(m => m.Value))],
                    backgroundColor: 'rgba(78, 115, 223, 0.05)',
                    borderColor: 'rgba(78, 115, 223, 1)',
                    pointBackgroundColor: 'rgba(78, 115, 223, 1)',
                    pointBorderColor: '#fff',
                    pointHoverBackgroundColor: '#fff',
                    pointHoverBorderColor: 'rgba(78, 115, 223, 1)'
                }]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Stock Levels Chart (Bar)
        var stockLevelsCtx = document.getElementById('stockLevelsChart').getContext('2d');
        var stockLevelsChart = new Chart(stockLevelsCtx, {
            type: 'bar',
            data: {
                labels: ['@Html.Raw(string.Join("','", Model.FridgeStockLevels.Select(s => s.Label)))'],
                datasets: [{
                    label: 'Available Stock',
                    data: [@string.Join(",", Model.FridgeStockLevels.Select(s => s.Value))],
                    backgroundColor: 'rgba(28, 200, 138, 0.8)',
                    borderColor: 'rgba(28, 200, 138, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
}