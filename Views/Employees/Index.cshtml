@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Manage Employees";
}

<p>
    <a asp-action="Create">Create New Employee</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Employee Number</th>
            <th>Name</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeNumber</td>
                <td>@item.UserAccount.FirstName @item.UserAccount.LastName</td>
                <td>@item.EmployeeType</td>
                <td>
                    @if (item.UserAccount.LockoutEnd > DateTime.Now)
                    {
                        <span class="badge badge-danger">Locked</span>
                    }
                    else
                    {
                        <span class="badge badge-success">Active</span>
                    }
                </td>
                <td>
                    <a asp-action="RoleManagement" asp-route-id="@item.Id" class="btn btn-info">Manage Role</a>
                    <button class="btn btn-warning lock-unlock-btn" data-id="@item.Id">
                        @(item.UserAccount.LockoutEnd > DateTime.Now ? "Unlock" : "Lock")
                    </button>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.lock-unlock-btn').click(function() {
                var id = $(this).data('id');
                $.post('@Url.Action("LockUnlock", "Employees")', { id: id })
                    .done(function(data) {
                        if (data.success) {
                            location.reload();
                        } else {
                            alert(data.message);
                        }
                    })
                    .fail(function() {
                        alert('An error occurred');
                    });
            });
        });
    </script>
}
