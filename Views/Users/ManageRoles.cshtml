@model RolesVM
@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-user-tag me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <form asp-action="ManageRoles" method="post">
                <input asp-for="User.Id" type="hidden" />

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-users-cog me-2"></i>Role Assignment for @Model.User.Email
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- User Information -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-bold">User Email</label>
                                    <input asp-for="User.Email" class="form-control" disabled />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-bold">Current Roles</label>
                                    <div class="p-2 border rounded bg-light">
                                        @{
                                            var currentRoles = Model.RoleList.Where(r => r.IsSelected).Select(r => r.RoleName);
                                        }
                                        @if (currentRoles.Any())
                                        {
                                            foreach (var role in currentRoles)
                                            {
                                                <span class="badge bg-primary me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No roles assigned</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Role Selection -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-header bg-light">
                                        <h6 class="card-title mb-0">
                                            <i class="fas fa-tasks me-2"></i>Available Roles
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.RoleList.Count; i++)
                                            {
                                                <div class="col-md-4 mb-3">
                                                    <div class="form-check card border-0 shadow-sm">
                                                        <div class="card-body">
                                                            <input asp-for="RoleList[i].RoleName" type="hidden" />
                                                            <input asp-for="RoleList[i].IsSelected" class="form-check-input" />
                                                            <label class="form-check-label fw-bold" asp-for="RoleList[i].IsSelected">
                                                                @Model.RoleList[i].RoleName
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-times me-2"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>Update Roles
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .form-check .card {
            transition: all 0.2s ease-in-out;
        }

        .form-check-input:checked + .card {
            border-color: #198754;
            background-color: #f8fff9;
        }

        .form-check-label {
            cursor: pointer;
        }
    </style>
}