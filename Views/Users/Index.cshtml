@model IEnumerable<UserManagementVM>
@{
    ViewData["Title"] = "User Management";
    var searchString = Context.Request.Query["searchString"];
    var roleFilter = Context.Request.Query["roleFilter"];
    var statusFilter = Context.Request.Query["statusFilter"];
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-users me-2"></i>@ViewData["Title"]
                </h1>
                <div class="btn-group">
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New User
                    </a>
                    <a asp-action="PendingApprovals" class="btn btn-warning">
                        <i class="fas fa-clock me-2"></i>Pending Approvals
                        @if (ViewBag.PendingCount > 0)
                        {
                            <span class="badge bg-danger ms-1">@ViewBag.PendingCount</span>
                        }
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-filter me-2"></i>Search & Filter Users
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index" class="row g-3">
                        <div class="col-md-4">
                            <label for="searchString" class="form-label">Search Users</label>
                            <input type="text" class="form-control" id="searchString" name="searchString"
                                   value="@searchString" placeholder="Search by name, email, or phone...">
                        </div>

                        <div class="col-md-3">
                            <label for="roleFilter" class="form-label">Filter by Role</label>
                            <select class="form-select" id="roleFilter" name="roleFilter">
                                <option value="All">All Roles</option>
                                @foreach (var role in ViewBag.RoleFilterList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@role.Value" selected="@(role.Value == roleFilter)">@role.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="statusFilter" class="form-label">Filter by Status</label>
                            <select class="form-select" id="statusFilter" name="statusFilter">
                                <option value="All">All Statuses</option>
                                @foreach (var status in ViewBag.StatusFilterList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@status.Value" selected="@(status.Value == statusFilter)">@status.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <div class="btn-group w-100" role="group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search me-1"></i>Search
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-refresh me-1"></i>Clear
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Users
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Users
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(u => !u.IsDeleted)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Pending Approval
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(u => u.AccountStatus == AccountStatus.PendingApproval)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Employees
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @Model.Count(u => u.UserRole != "Customer")
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-id-badge fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Users (@Model.Count())
                    </h5>
                    <div class="text-muted small">
                        Showing @Model.Count() users
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>User Details</th>
                                        <th>Contact Information</th>
                                        <th>Role & Status</th>
                                        <th>Account Info</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                    {
                                                        <img src="@user.ProfilePictureUrl" class="rounded-circle me-3"
                                                             alt="@user.FullName" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                             style="width: 40px; height: 40px;">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <strong class="d-block">@user.FullName</strong>
                                                        <small class="text-muted">@user.UserRole</small>
                                                        @if (!string.IsNullOrEmpty(user.EmployeeNumber))
                                                        {
                                                            <div><small class="text-info">@user.EmployeeNumber</small></div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(user.BusinessName))
                                                        {
                                                            <div><small class="text-success">@user.BusinessName</small></div>
                                                        }
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <i class="fas fa-envelope me-2 text-muted"></i>
                                                    <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                                </div>
                                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                {
                                                    <div class="mt-1">
                                                        <i class="fas fa-phone me-2 text-muted"></i>
                                                        <a href="tel:@user.PhoneNumber" class="text-decoration-none">@user.PhoneNumber</a>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(user.BusinessPhoneNumber))
                                                {
                                                    <div class="mt-1">
                                                        <i class="fas fa-building me-2 text-muted"></i>
                                                        <span class="text-muted">@user.BusinessPhoneNumber</span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <span class="badge bg-info">@user.UserRole</span>
                                                    @if (user.UserRole != SD.CustomerRole)
                                                    {
                                                        <div>
                                                            <small class="text-muted mt-1 d-block">
                                                                @user.EmployeeType.ToString().Replace("_", " ")
                                                            </small>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="mt-2">
                                                    @if (!user.IsDeleted)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check-circle me-1"></i>Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-times-circle me-1"></i>Suspended
                                                        </span>
                                                    }
                                                </div>
                                                <div class="mt-1">
                                                    @if (user.AccountStatus == AccountStatus.PendingApproval)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-clock me-1"></i>Pending Approval
                                                        </span>
                                                    }
                                                    else if (user.AccountStatus == AccountStatus.Approved)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check me-1"></i>Approved
                                                        </span>
                                                    }
                                                    else if (user.AccountStatus == AccountStatus.Rejected)
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-times me-1"></i>Rejected
                                                        </span>
                                                    }
                                                </div>
                                                @if (user.AvailabilityStatus.HasValue)
                                                {
                                                    <div class="mt-1">
                                                        <small class="text-muted">@user.AvailabilityStatus.Value.ToString().Replace("_", " ")</small>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div class="small text-muted">
                                                    <div>
                                                        <i class="fas fa-calendar me-1"></i>
                                                        Created: @user.CreatedAt.ToString("dd/MM/yyyy")
                                                    </div>
                                                    @if (user.LastLoginDate.HasValue)
                                                    {
                                                        <div>
                                                            <i class="fas fa-sign-in-alt me-1"></i>
                                                            Last Login: @user.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div>
                                                            <i class="fas fa-clock me-1"></i>
                                                            Never logged in
                                                        </div>
                                                    }
                                                    @if (user.UpdatedAt.HasValue)
                                                    {
                                                        <div>
                                                            <i class="fas fa-edit me-1"></i>
                                                            Updated: @user.UpdatedAt.Value.ToString("dd/MM/yyyy")
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-2">
                                                    <!-- Main Action Buttons -->
                                                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                                                        <!-- Edit Button -->
                                                        <a asp-action="Upsert" asp-route-id="@user.UserId"
                                                           class="btn btn-sm btn-outline-primary" title="Edit User">
                                                            <i class="fas fa-edit"></i>
                                                        </a>

                                                        <!-- Role Management Button -->
                                                        <a asp-action="ManageRoles" asp-route-userId="@user.UserId"
                                                           class="btn btn-sm btn-outline-info" title="Manage Roles">
                                                            <i class="fas fa-user-tag"></i>
                                                        </a>

                                                        <!-- Toggle Status Button -->
                                                        <form method="post" asp-action="ToggleStatus" class="d-inline">
                                                            <input type="hidden" name="id" value="@user.UserId" />
                                                            @Html.AntiForgeryToken()
                                                            @if (!user.IsDeleted)
                                                            {
                                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                                        title="Suspend User"
                                                                        onclick="return confirm('Are you sure you want to suspend this user?')">
                                                                    <i class="fas fa-pause"></i>
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                                        title="Activate User"
                                                                        onclick="return confirm('Are you sure you want to activate this user?')">
                                                                    <i class="fas fa-play"></i>
                                                                </button>
                                                            }
                                                        </form>

                                                        <!-- Reset Password Button -->
                                                        <form method="post" asp-action="ResetPassword" class="d-inline">
                                                            <input type="hidden" name="id" value="@user.UserId" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                                    title="Reset Password"
                                                                    onclick="return confirm('Are you sure you want to reset this user\\'s password? A temporary password will be generated.')">
                                                                <i class="fas fa-key"></i>
                                                            </button>
                                                        </form>
                                                    </div>

                                                    <!-- Customer Approval Buttons -->
                                                    @if (user.UserRole == "Customer" && user.AccountStatus == AccountStatus.PendingApproval)
                                                    {
                                                        <div class="d-flex justify-content-center gap-1 mt-1">
                                                            <form method="post" asp-action="ApproveCustomer" class="d-inline">
                                                                <input type="hidden" name="id" value="@user.UserId" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-success"
                                                                        title="Approve Customer"
                                                                        onclick="return confirm('Are you sure you want to approve this customer?')">
                                                                    <i class="fas fa-check me-1"></i>Approve
                                                                </button>
                                                            </form>
                                                            <button type="button" class="btn btn-sm btn-danger reject-customer-btn"
                                                                    title="Reject Customer"
                                                                    data-user-id="@user.UserId"
                                                                    data-business-name="@user.BusinessName">
                                                                <i class="fas fa-times me-1"></i>Reject
                                                            </button>
                                                        </div>
                                                    }

                                                    <!-- Employee Availability -->
                                                    @if (user.UserRole != SD.CustomerRole && user.EmployeeType != null)
                                                    {
                                                        <div class="d-flex justify-content-center gap-1 mt-1">
                                                            <form method="post" asp-action="UpdateEmployeeAvailability" class="d-inline">
                                                                <input type="hidden" name="id" value="@user.UserId" />
                                                                <input type="hidden" name="status" value="@AvailabilityStatus.Available" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                                        title="Set Available"
                                                                        onclick="return confirm('Set @user.FullName as available?')">
                                                                    <i class="fas fa-user-check"></i>
                                                                </button>
                                                            </form>
                                                            <form method="post" asp-action="UpdateEmployeeAvailability" class="d-inline">
                                                                <input type="hidden" name="id" value="@user.UserId" />
                                                                <input type="hidden" name="status" value="@AvailabilityStatus.Unavailable" />
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                                                        title="Set Unavailable"
                                                                        onclick="return confirm('Set @user.FullName as unavailable?')">
                                                                    <i class="fas fa-user-slash"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    }

                                                    <!-- Additional Actions Dropdown -->
                                                    <div class="dropdown text-center">
                                                        <button class="btn btn-sm btn-outline-dark dropdown-toggle" type="button"
                                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                            More
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li>
                                                                <a class="dropdown-item" asp-action="ManageClaims" asp-route-userId="@user.UserId">
                                                                    <i class="fas fa-shield-alt me-2"></i>Manage Claims
                                                                </a>
                                                            </li>
                                                            <li>
                                                                <a class="dropdown-item" asp-action="UserDetails" asp-route-id="@user.UserId">
                                                                    <i class="fas fa-eye me-2"></i>View Details
                                                                </a>
                                                            </li>
                                                            <li><hr class="dropdown-divider"></li>
                                                            <li>
                                                                <form method="post" asp-action="DeleteUser" class="d-inline">
                                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="dropdown-item text-danger"
                                                                            onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                                                        <i class="fas fa-trash me-2"></i>Delete User
                                                                    </button>
                                                                </form>
                                                            </li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Users Found</h4>
                            <p class="text-muted">No users match your search criteria.</p>
                            <a asp-action="Index" class="btn btn-outline-primary me-2">Clear Filters</a>
                            <a asp-action="Upsert" class="btn btn-primary">Create New User</a>
                        </div>
                    }
                </div>

                @if (Model.Any())
                {
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                Total: @Model.Count() users
                            </div>
                            <div class="small text-muted">
                                <i class="fas fa-lightbulb me-1"></i>
                                Use actions to manage user status and permissions
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reject Customer Modal -->
<div class="modal fade" id="rejectCustomerModal" tabindex="-1" aria-labelledby="rejectCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="rejectCustomerModalLabel">
                    <i class="fas fa-times-circle me-2"></i>Reject Customer Application
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="RejectCustomer" id="rejectCustomerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectUserId" />
                <div class="modal-body">
                    <p>You are about to reject <strong id="rejectBusinessName"></strong>.</p>
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason *</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason"
                                  rows="3" placeholder="Please provide a reason for rejection..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Reject Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-submit form when filter dropdowns change
            const roleFilter = document.getElementById('roleFilter');
            const statusFilter = document.getElementById('statusFilter');

            if (roleFilter) {
                roleFilter.addEventListener('change', function() {
                    this.form.submit();
                });
            }

            if (statusFilter) {
                statusFilter.addEventListener('change', function() {
                    this.form.submit();
                });
            }

            // Enhanced search with debounce
            let searchTimeout;
            const searchInput = document.getElementById('searchString');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        this.form.submit();
                    }, 500);
                });
            }

            // Reject Customer Modal
            const rejectCustomerModal = new bootstrap.Modal(document.getElementById('rejectCustomerModal'));
            document.querySelectorAll('.reject-customer-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const userId = this.getAttribute('data-user-id');
                    const businessName = this.getAttribute('data-business-name');

                    document.getElementById('rejectUserId').value = userId;
                    document.getElementById('rejectBusinessName').textContent = businessName;
                    rejectCustomerModal.show();
                });
            });

            // Enhanced form submission with loading states
            document.addEventListener('submit', function(e) {
                if (e.target.matches('form[asp-action="ToggleStatus"], form[asp-action="ResetPassword"], form[asp-action="ApproveCustomer"], form[asp-action="RejectCustomer"], form[asp-action="UpdateEmployeeAvailability"]')) {
                    const submitBtn = e.target.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                        submitBtn.disabled = true;
                    }
                }
            });

            // Toast notifications for TempData messages
            $(document).ready(function() {
                // Check for success message
                if ('@TempData["success"]' !== '') {
                    toastr.success('@TempData["success"]', 'Success', {
                        timeOut: 5000,
                        positionClass: 'toast-top-right'
                    });
                }

                // Check for error message
                if ('@TempData["error"]' !== '') {
                    toastr.error('@TempData["error"]', 'Error', {
                        timeOut: 5000,
                        positionClass: 'toast-top-right'
                    });
                }
            });
        });
    </script>

    <style>
        .required::after {
            content: " *";
            color: #dc3545;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        .table td {
            vertical-align: middle;
        }

        .badge {
            font-size: 0.7rem;
            padding: 0.35em 0.65em;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .table-responsive {
                font-size: 0.875rem;
            }

            .btn-group {
                flex-direction: column;
            }

                .btn-group .btn {
                    margin-bottom: 0.25rem;
                }

            .modal-dialog {
                margin: 0.5rem;
            }

            .d-flex.gap-1 {
                gap: 0.25rem !important;
            }
        }

        /* Card hover effects */
        .card {
            transition: transform 0.2s ease-in-out;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        /* Badge enhancements */
        .badge {
            font-weight: 500;
        }
    </style>
}