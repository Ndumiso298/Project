@model IEnumerable<UserManagementVM>
@{
    ViewData["Title"] = "User Management";
    var searchString = Context.Request.Query["searchString"];
    var roleFilter = Context.Request.Query["roleFilter"];
    var statusFilter = Context.Request.Query["statusFilter"];
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-users me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Upsert" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Create New User
                </a>
            </div>
            <hr />
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-filter me-2"></i>Search & Filter Users
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index" class="row g-3">
                        <div class="col-md-4">
                            <label for="searchString" class="form-label">Search Users</label>
                            <input type="text" class="form-control" id="searchString" name="searchString"
                                   value="@searchString" placeholder="Search by name, email, or phone...">
                        </div>

                        <div class="col-md-3">
                            <label for="roleFilter" class="form-label">Filter by Role</label>
                            <select class="form-select" id="roleFilter" name="roleFilter">
                                <option value="All">All Roles</option>
                                @foreach (var role in ViewBag.RoleFilterList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@role.Value" selected="@(role.Value == roleFilter)">@role.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="statusFilter" class="form-label">Filter by Status</label>
                            <select class="form-select" id="statusFilter" name="statusFilter">
                                <option value="All">All Statuses</option>
                                @foreach (var status in ViewBag.StatusFilterList as IEnumerable<SelectListItem>)
                                {
                                    <option value="@status.Value" selected="@(status.Value == statusFilter)">@status.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 d-flex align-items-end">
                            <div class="btn-group w-100" role="group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search me-1"></i>Search
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-refresh me-1"></i>Clear
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Users (@Model.Count())
                    </h5>
                    <div class="text-muted small">
                        Showing @Model.Count() users
                    </div>
                </div>

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>User Details</th>
                                        <th>Contact Information</th>
                                        <th>Role & Status</th>
                                        <th>Account Info</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                    {
                                                        <img src="@user.ProfilePictureUrl" class="rounded-circle me-3"
                                                             alt="@user.FullName" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                             style="width: 40px; height: 40px;">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                    <div>
                                                        <strong class="d-block">@user.FullName</strong>
                                                        <small class="text-muted">@user.UserRole</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div>
                                                    <i class="fas fa-envelope me-2 text-muted"></i>
                                                    <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                                </div>
                                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                {
                                                    <div class="mt-1">
                                                        <i class="fas fa-phone me-2 text-muted"></i>
                                                        <a href="tel:@user.PhoneNumber" class="text-decoration-none">@user.PhoneNumber</a>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <span class="badge bg-info">@user.UserRole</span>
                                                </div>
                                                <div class="mt-1">
                                                    @if (user.IsActive)
                                                    {
                                                        <span class="badge bg-success">
                                                            <i class="fas fa-check-circle me-1"></i>Active
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">
                                                            <i class="fas fa-times-circle me-1"></i>Suspended
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="small text-muted">
                                                    <div>
                                                        <i class="fas fa-calendar me-1"></i>
                                                        Created: @user.CreatedAt.ToString("dd/MM/yyyy")
                                                    </div>
                                                    @if (user.LastLoginDate.HasValue)
                                                    {
                                                        <div>
                                                            <i class="fas fa-sign-in-alt me-1"></i>
                                                            Last Login: @user.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div>
                                                            <i class="fas fa-clock me-1"></i>
                                                            Never logged in
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex justify-content-center gap-1">
                                                    <!-- Edit Button -->
                                                    <a asp-action="Upsert" asp-route-id="@user.UserId"
                                                       class="btn btn-sm btn-outline-primary" title="Edit User">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    <!-- Toggle Status Button -->
                                                    <form method="post" asp-action="ToggleStatus" class="d-inline">
                                                        <input type="hidden" name="id" value="@user.UserId" />
                                                        @if (user.IsActive)
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-outline-warning"
                                                                    title="Suspend User"
                                                                    onclick="return confirm('Are you sure you want to suspend this user?')">
                                                                <i class="fas fa-pause"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-outline-success"
                                                                    title="Activate User"
                                                                    onclick="return confirm('Are you sure you want to activate this user?')">
                                                                <i class="fas fa-play"></i>
                                                            </button>
                                                        }
                                                    </form>

                                                    <!-- Reset Password Button -->
                                                    <form method="post" asp-action="ResetPassword" class="d-inline">
                                                        <input type="hidden" name="id" value="@user.UserId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-info"
                                                                title="Reset Password"
                                                                onclick="return confirm('Are you sure you want to reset this user\\'s password? A temporary password will be generated.')">
                                                            <i class="fas fa-key"></i>
                                                        </button>
                                                    </form>

                                                    <!-- Delete Button (Soft Delete) -->
                                                    @if (user.IsActive)
                                                    {
                                                        <form method="post" asp-action="Delete" class="d-inline">
                                                            <input type="hidden" name="id" value="@user.UserId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                    title="Delete User"
                                                                    onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-users fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Users Found</h4>
                            <p class="text-muted">No users match your search criteria.</p>
                            <a asp-action="Index" class="btn btn-outline-primary me-2">Clear Filters</a>
                            <a asp-action="Upsert" class="btn btn-primary">Create New User</a>
                        </div>
                    }
                </div>

                @if (Model.Any())
                {
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                Total: @Model.Count() users
                            </div>
                            <div class="small text-muted">
                                <i class="fas fa-lightbulb me-1"></i>
                                Use actions to manage user status and passwords
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Password Reset Confirmation Modal -->
<div class="modal fade" id="passwordResetModal" tabindex="-1" aria-labelledby="passwordResetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="passwordResetModalLabel">
                    <i class="fas fa-key me-2"></i>Password Reset Confirmation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info">
                    <h6 class="alert-heading">
                        <i class="fas fa-info-circle me-2"></i>Important Security Information
                    </h6>
                    <p class="mb-0">When you reset a user's password, a temporary password will be generated and displayed. The user will need to use this temporary password to log in and then change it immediately.</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">User Selected:</label>
                    <div id="selectedUserInfo" class="p-2 border rounded bg-light">
                        <!-- User info will be populated by JavaScript -->
                    </div>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="confirmReset">
                    <label class="form-check-label" for="confirmReset">
                        I understand that this action will reset the user's password and generate a temporary password.
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmResetBtn" disabled>
                    <i class="fas fa-key me-2"></i>Reset Password
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Temporary Password Display Modal -->
<div class="modal fade" id="tempPasswordModal" tabindex="-1" aria-labelledby="tempPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="tempPasswordModalLabel">
                    <i class="fas fa-check-circle me-2"></i>Password Reset Successful
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success">
                    <h6 class="alert-heading">
                        <i class="fas fa-check me-2"></i>Password has been reset successfully!
                    </h6>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">User:</label>
                    <div id="resetUserInfo" class="p-2 border rounded bg-light">
                        <!-- User info will be populated by JavaScript -->
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Temporary Password:</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="tempPasswordDisplay" readonly>
                        <button class="btn btn-outline-secondary" type="button" id="copyPasswordBtn">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                    <small class="form-text text-muted">
                        <i class="fas fa-exclamation-triangle me-1 text-warning"></i>
                        This password will be shown only once. Please provide it to the user securely.
                    </small>
                </div>

                <div class="alert alert-warning">
                    <h6 class="alert-heading">
                        <i class="fas fa-shield-alt me-2"></i>Security Instructions
                    </h6>
                    <ul class="mb-0 small">
                        <li>Share this password through a secure channel</li>
                        <li>Advise the user to change their password immediately after login</li>
                        <li>Do not store this password in an unsecured location</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                    <i class="fas fa-check me-2"></i>I have securely recorded the password
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto-submit form when filter dropdowns change
            const roleFilter = document.getElementById('roleFilter');
            const statusFilter = document.getElementById('statusFilter');

            if (roleFilter) {
                roleFilter.addEventListener('change', function() {
                    this.form.submit();
                });
            }

            if (statusFilter) {
                statusFilter.addEventListener('change', function() {
                    this.form.submit();
                });
            }

            // Enhance search with debounce
            let searchTimeout;
            const searchInput = document.getElementById('searchString');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    searchTimeout = setTimeout(() => {
                        this.form.submit();
                    }, 500);
                });
            }

            // Password reset confirmation logic
            const confirmResetCheckbox = document.getElementById('confirmReset');
            const confirmResetBtn = document.getElementById('confirmResetBtn');

            if (confirmResetCheckbox && confirmResetBtn) {
                confirmResetCheckbox.addEventListener('change', function() {
                    confirmResetBtn.disabled = !this.checked;
                });
            }

            // Copy password functionality
            const copyPasswordBtn = document.getElementById('copyPasswordBtn');
            if (copyPasswordBtn) {
                copyPasswordBtn.addEventListener('click', function() {
                    const tempPasswordInput = document.getElementById('tempPasswordDisplay');
                    tempPasswordInput.select();
                    document.execCommand('copy');

                    // Show copy confirmation
                    const originalHtml = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-check"></i>';
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('btn-success');

                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                        this.classList.remove('btn-success');
                        this.classList.add('btn-outline-secondary');
                    }, 2000);
                });
            }

            // Enhanced password reset with confirmation modal
            document.querySelectorAll('form[asp-action="ResetPassword"]').forEach(form => {
                const submitBtn = form.querySelector('button[type="submit"]');
                const userId = form.querySelector('input[name="id"]').value;

                submitBtn.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Find user info from the table row
                    const row = this.closest('tr');
                    const userName = row.querySelector('strong').textContent;
                    const userEmail = row.querySelector('a[href^="mailto:"]').textContent;
                    const userRole = row.querySelector('.badge.bg-info').textContent;

                    // Populate confirmation modal
                    document.getElementById('selectedUserInfo').innerHTML = `
                        <div><strong>Name:</strong> ${userName}</div>
                        <div><strong>Email:</strong> ${userEmail}</div>
                        <div><strong>Role:</strong> ${userRole}</div>
                    `;

                    // Store form reference
                    document.getElementById('confirmResetBtn').dataset.form = form.id;
                    document.getElementById('confirmResetBtn').dataset.userId = userId;
                    document.getElementById('confirmResetBtn').dataset.userName = userName;
                    document.getElementById('confirmResetBtn').dataset.userEmail = userEmail;

                    // Show confirmation modal
                    const confirmationModal = new bootstrap.Modal(document.getElementById('passwordResetModal'));
                    confirmationModal.show();
                });
            });

            // Confirm reset button handler
            if (confirmResetBtn) {
                confirmResetBtn.addEventListener('click', function() {
                    const form = document.querySelector(`form[asp-action="ResetPassword"] input[value="${this.dataset.userId}"]`).closest('form');

                    // Submit the form
                    form.submit();

                    // Close confirmation modal
                    const confirmationModal = bootstrap.Modal.getInstance(document.getElementById('passwordResetModal'));
                    confirmationModal.hide();
                });
            }

            // Show temp password modal if TempData contains success message with password
        @if (TempData["success"] != null && TempData["success"].ToString().Contains("temporary password"))
        {
            <text>
                    // Extract password from success message (this is a simplified example)
                    // In a real application, you might want to pass the password differently
                    const successMessage = '@TempData["success"]';
                    const passwordMatch = successMessage.match(/temporary password: (.+)$/);

                    if (passwordMatch && passwordMatch[1]) {
                        // This is just an example - in production, you'd want a more secure way to pass the password
                        document.getElementById('tempPasswordDisplay').value = passwordMatch[1];

                        const tempPasswordModal = new bootstrap.Modal(document.getElementById('tempPasswordModal'));
                        tempPasswordModal.show();
                    }
            </text>
        }

            // Toast notifications for TempData messages
            $(document).ready(function() {
                // Check for success message
                if ('@TempData["success"]' !== '') {
                    toastr.success('@TempData["success"]', 'Success', {
                        timeOut: 5000,
                        positionClass: 'toast-top-right'
                    });
                }

                // Check for error message
                if ('@TempData["error"]' !== '') {
                    toastr.error('@TempData["error"]', 'Error', {
                        timeOut: 5000,
                        positionClass: 'toast-top-right'
                    });
                }
            });
        });

        // Enhanced form submission with loading states
        document.addEventListener('submit', function(e) {
            if (e.target.matches('form[asp-action="ToggleStatus"], form[asp-action="ResetPassword"], form[asp-action="Delete"]')) {
                const submitBtn = e.target.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                    submitBtn.disabled = true;
                }
            }
        });
    </script>
}

<style>
    .required::after {
        content: " *";
        color: #dc3545;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
    }

    .badge {
        font-size: 0.7rem;
        padding: 0.35em 0.65em;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
    }

    .font-monospace {
        font-family: 'Courier New', monospace;
        font-weight: 600;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }

        .btn-group {
            flex-direction: column;
        }

            .btn-group .btn {
                margin-bottom: 0.25rem;
            }

        .modal-dialog {
            margin: 0.5rem;
        }
    }
</style>