@model ClaimsVM
@{
    ViewData["Title"] = "Manage User Claims";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-shield-alt me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <form method="post">
                <input asp-for="User.Id" hidden />

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-user-shield me-2"></i>Claims Management for @Model.User.Email
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- User Information -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-bold">User Email</label>
                                    <input asp-for="User.Email" disabled class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label fw-bold">Full Name</label>
                                    <input asp-for="User.FirstName" disabled class="form-control" />
                                </div>
                            </div>
                        </div>

                        <!-- Claims Assignment -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card border-0 shadow-sm mb-4">
                                    <div class="card-header bg-light">
                                        <h6 class="card-title mb-0">
                                            <i class="fas fa-list-check me-2"></i>Available Claims
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            @for (int i = 0; i < Model.ClaimList.Count; i++)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <div class="form-check card border-0 shadow-sm">
                                                        <div class="card-body">
                                                            <input asp-for="@Model.ClaimList[i].ClaimType" hidden />
                                                            <input asp-for="@Model.ClaimList[i].IsSelected" class="form-check-input" />
                                                            <label class="form-check-label fw-bold" asp-for="@Model.ClaimList[i].IsSelected">
                                                                @Model.ClaimList[i].ClaimType
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-times me-2"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        <i class="fas fa-save me-2"></i>Update Claims
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .form-check .card {
            transition: all 0.2s ease-in-out;
        }

        .form-check-input:checked + .card {
            border-color: #198754;
            background-color: #f8fff9;
        }

        .form-check-label {
            cursor: pointer;
        }
    </style>
}