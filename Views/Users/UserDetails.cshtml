@model UserManagementVM
@{
    ViewData["Title"] = "User Details - " + Model.FullName;
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-user me-2"></i>User Details
                </h1>
                <div class="btn-group">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to List
                    </a>
                    <a asp-action="Upsert" asp-route-id="@Model.UserId" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit User
                    </a>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- User Profile Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <img src="@Model.ProfilePictureUrl" class="rounded-circle"
                                     alt="@Model.FullName" style="width: 100px; height: 100px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center"
                                     style="width: 100px; height: 100px;">
                                    <i class="fas fa-user text-white fa-3x"></i>
                                </div>
                            }
                        </div>
                        <div class="col">
                            <h3 class="mb-1">@Model.FullName</h3>
                            <p class="text-muted mb-2">@Model.Email</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge bg-primary">@Model.UserRole</span>
                                @if (!Model.IsDeleted)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle me-1"></i>Suspended
                                    </span>
                                }
                                @if (Model.AccountStatus == AccountStatus.PendingApproval)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="fas fa-clock me-1"></i>Pending Approval
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="col-auto">
                            <div class="btn-group-vertical">
                                <a asp-action="ManageRoles" asp-route-userId="@Model.UserId"
                                   class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-user-tag me-1"></i>Manage Roles
                                </a>
                                <a asp-action="ManageClaims" asp-route-userId="@Model.UserId"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="fas fa-shield-alt me-1"></i>Manage Claims
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Personal Information -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-id-card me-2"></i>Personal Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                <a href="tel:@Model.PhoneNumber" class="text-decoration-none">@Model.PhoneNumber</a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">
                            @(Model.DOB?.ToString("dd/MM/yyyy") ?? "Not provided")
                        </dd>

                        <dt class="col-sm-4">Account Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Last Login</dt>
                        <dd class="col-sm-8">
                            @(Model.LastLoginDate?.ToString("dd/MM/yyyy HH:mm") ?? "Never logged in")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Role & Status Information -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-shield me-2"></i>Account & Role Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">User Role</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.UserRole</span>
                        </dd>

                        <dt class="col-sm-4">Account Status</dt>
                        <dd class="col-sm-8">
                            @if (!Model.IsDeleted)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Suspended</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Approval Status</dt>
                        <dd class="col-sm-8">
                            @switch (Model.AccountStatus)
                            {
                                case AccountStatus.PendingApproval:
                                    <span class="badge bg-warning text-dark">Pending Approval</span>
                                    break;
                                case AccountStatus.Approved:
                                    <span class="badge bg-success">Approved</span>
                                    break;
                                case AccountStatus.Rejected:
                                    <span class="badge bg-danger">Rejected</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">Unknown</span>
                                    break;
                            }
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.EmployeeNumber))
                        {
                            <dt class="col-sm-4">Employee Number</dt>
                            <dd class="col-sm-8">@Model.EmployeeNumber</dd>
                        }

                        @if (Model.EmployeeType != null)
                        {
                            <dt class="col-sm-4">Employee Type</dt>
                            <dd class="col-sm-8">@Model.EmployeeType.ToString().Replace("_", " ")</dd>
                        }

                        @if (Model.AvailabilityStatus.HasValue)
                        {
                            <dt class="col-sm-4">Availability</dt>
                            <dd class="col-sm-8">
                                <span class="badge @(Model.AvailabilityStatus == AvailabilityStatus.Available ? "bg-success" : "bg-warning")">
                                    @Model.AvailabilityStatus.Value.ToString().Replace("_", " ")
                                </span>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Business Information (for Customers) -->
    @if (Model.UserRole == "Customer" && !string.IsNullOrEmpty(Model.BusinessName))
    {
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="fas fa-store me-2"></i>Business Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Business Name</dt>
                                    <dd class="col-sm-8">@Model.BusinessName</dd>

                                    <dt class="col-sm-4">Business Type</dt>
                                    <dd class="col-sm-8">@Model.BusinessType?.ToString().Replace("_", " ")</dd>

                                    <dt class="col-sm-4">Business Email</dt>
                                    <dd class="col-sm-8">
                                        <a href="mailto:@Model.BusinessEmail" class="text-decoration-none">@Model.BusinessEmail</a>
                                    </dd>

                                    <dt class="col-sm-4">Business Phone</dt>
                                    <dd class="col-sm-8">@Model.BusinessPhoneNumber</dd>
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <dl class="row">
                                    <dt class="col-sm-4">Address</dt>
                                    <dd class="col-sm-8">
                                        @Model.StreetAddress<br>
                                        @Model.Suburb, @Model.City<br>
                                        @Model.Province, @Model.PostalCode
                                    </dd>

                                    <dt class="col-sm-4">Business Document</dt>
                                    <dd class="col-sm-8">
                                        @if (!string.IsNullOrEmpty(Model.BusinessDocumentPath))
                                        {
                                            <a href="@Url.Content(Model.BusinessDocumentPath)" target="_blank"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-file-pdf me-1"></i>View Document
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No document uploaded</span>
                                        }
                                    </dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt me-2"></i>Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-auto">
                            <form method="post" asp-action="ToggleStatus" class="d-inline">
                                <input type="hidden" name="id" value="@Model.UserId" />
                                @Html.AntiForgeryToken()
                                @if (!Model.IsDeleted)
                                {
                                    <button type="submit" class="btn btn-warning"
                                            onclick="return confirm('Are you sure you want to suspend this user?')">
                                        <i class="fas fa-pause me-1"></i>Suspend User
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-success"
                                            onclick="return confirm('Are you sure you want to activate this user?')">
                                        <i class="fas fa-play me-1"></i>Activate User
                                    </button>
                                }
                            </form>
                        </div>

                        <div class="col-auto">
                            <form method="post" asp-action="ResetPassword" class="d-inline">
                                <input type="hidden" name="id" value="@Model.UserId" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-info"
                                        onclick="return confirm('Are you sure you want to reset this user\\'s password?')">
                                    <i class="fas fa-key me-1"></i>Reset Password
                                </button>
                            </form>
                        </div>

                        @if (Model.UserRole == "Customer" && Model.AccountStatus == AccountStatus.PendingApproval)
                        {
                            <div class="col-auto">
                                <form method="post" asp-action="ApproveCustomer" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.UserId" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success"
                                            onclick="return confirm('Approve @Model.BusinessName?')">
                                        <i class="fas fa-check me-1"></i>Approve Customer
                                    </button>
                                </form>
                            </div>

                            <div class="col-auto">
                                <button type="button" class="btn btn-danger reject-customer-btn"
                                        data-user-id="@Model.UserId"
                                        data-business-name="@Model.BusinessName">
                                    <i class="fas fa-times me-1"></i>Reject Customer
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Customer Modal -->
<div class="modal fade" id="rejectCustomerModal" tabindex="-1" aria-labelledby="rejectCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="rejectCustomerModalLabel">
                    <i class="fas fa-times-circle me-2"></i>Reject Customer Application
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="RejectCustomer" id="rejectCustomerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectUserId" />
                <div class="modal-body">
                    <p>You are about to reject <strong id="rejectBusinessName"></strong>.</p>
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason *</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason"
                                  rows="3" placeholder="Please provide a reason for rejection..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Reject Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Reject Customer Modal
            const rejectCustomerModal = new bootstrap.Modal(document.getElementById('rejectCustomerModal'));
            document.querySelectorAll('.reject-customer-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const userId = this.getAttribute('data-user-id');
                    const businessName = this.getAttribute('data-business-name');

                    document.getElementById('rejectUserId').value = userId;
                    document.getElementById('rejectBusinessName').textContent = businessName;
                    rejectCustomerModal.show();
                });
            });
        });
    </script>
}