@model IEnumerable<UserManagementVM>
@{
    ViewData["Title"] = "Pending User Approvals";
}

<div class="container-fluid">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-warning">
                    <i class="fas fa-clock me-2"></i>@ViewData["Title"]
                </h1>
                <div class="btn-group">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to All Users
                    </a>
                    <a asp-action="Upsert" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Create New User
                    </a>
                </div>
            </div>
            <div class="alert alert-warning mt-3">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>@Model.Count() users</strong> are waiting for approval. Please review their information and documents.
            </div>
            <hr />
        </div>
    </div>

    <!-- Pending Users Table -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-list me-2"></i>Pending Approval Users (@Model.Count())
                    </h5>
                </div>

                <div class="card-body p-0">
                    @if (Model.Any())
                    {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-warning">
                                        <tr>
                                            <th>User Details</th>
                                            <th>Business Information</th>
                                            <th>Contact Information</th>
                                            <th>Documents</th>
                                            <th class="text-center">Review Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var user in Model.Where(u => u.AccountStatus == AccountStatus.PendingApproval))
                                    {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(user.ProfilePictureUrl))
                                                    {
                                                                    <img src="@user.ProfilePictureUrl" class="rounded-circle me-3"
                                                                         alt="@user.FullName" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center me-3"
                                                                         style="width: 40px; height: 40px;">
                                                                        <i class="fas fa-user text-white"></i>
                                                                    </div>
                                                    }
                                                            <div>
                                                                <strong class="d-block">@user.FullName</strong>
                                                                <small class="text-muted">Customer</small>
                                                                <div class="mt-1">
                                                                    <span class="badge bg-warning text-dark">
                                                                        <i class="fas fa-clock me-1"></i>Pending Approval
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                @if (!string.IsNullOrEmpty(user.BusinessName))
                                                {
                                                                <div>
                                                                    <strong>@user.BusinessName</strong>
                                                                </div>
                                                }
                                                @if (user.BusinessType.HasValue)
                                                {
                                                                <div>
                                                                    <small class="text-muted">@user.BusinessType.Value.ToString().Replace("_", " ")</small>
                                                                </div>
                                                }
                                                        <div class="mt-2">
                                                            <small class="text-muted">
                                                                <i class="fas fa-calendar me-1"></i>
                                                                Applied: @user.CreatedAt.ToString("dd/MM/yyyy")
                                                            </small>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div>
                                                            <i class="fas fa-envelope me-2 text-muted"></i>
                                                            <a href="mailto:@user.Email" class="text-decoration-none">@user.Email</a>
                                                        </div>
                                                @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                                {
                                                                <div class="mt-1">
                                                                    <i class="fas fa-phone me-2 text-muted"></i>
                                                                    <a href="tel:@user.PhoneNumber" class="text-decoration-none">@user.PhoneNumber</a>
                                                                </div>
                                                }
                                                @if (!string.IsNullOrEmpty(user.BusinessPhoneNumber))
                                                {
                                                                <div class="mt-1">
                                                                    <i class="fas fa-building me-2 text-muted"></i>
                                                                    <span class="text-muted">@user.BusinessPhoneNumber</span>
                                                                </div>
                                                }
                                                @if (!string.IsNullOrEmpty(user.StreetAddress))
                                                {
                                                                <div class="mt-1">
                                                                    <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                                                                    <small class="text-muted">@user.StreetAddress, @user.City</small>
                                                                </div>
                                                }
                                                    </td>
                                                    <td>
                                                @if (!string.IsNullOrEmpty(user.BusinessDocumentPath))
                                                {
                                                                <a href="@Url.Content(user.BusinessDocumentPath)" target="_blank" 
                                                                   class="btn btn-sm btn-outline-primary" title="View Business Document">
                                                                    <i class="fas fa-file-pdf me-1"></i>View Document
                                                                </a>
                                                }
                                                else
                                                {
                                                                <span class="badge bg-secondary">No Document</span>
                                                }
                                                    </td>
                                                    <td>
                                                        <div class="d-flex flex-column gap-2 align-items-center">
                                                            <!-- Quick Approve Button -->
                                                            <form method="post" asp-action="ApproveCustomer" class="d-inline w-100">
                                                                <input type="hidden" name="id" value="@user.UserId" />
                                                        @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-sm btn-success w-100"
                                                                        title="Approve Customer"
                                                                        onclick="return confirm('Approve @user.BusinessName?')">
                                                                    <i class="fas fa-check me-1"></i>Approve
                                                                </button>
                                                            </form>

                                                            <!-- Reject Button with Modal -->
                                                            <button type="button" class="btn btn-sm btn-danger w-100 reject-customer-btn"
                                                                    title="Reject Customer"
                                                                    data-user-id="@user.UserId"
                                                                    data-business-name="@user.BusinessName">
                                                                <i class="fas fa-times me-1"></i>Reject
                                                            </button>

                                                            <!-- View Details Button -->
                                                            <a asp-action="UserDetails" asp-route-id="@user.UserId" 
                                                               class="btn btn-sm btn-outline-info w-100">
                                                                <i class="fas fa-eye me-1"></i>Details
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                    }
                    else
                    {
                            <div class="text-center py-5">
                                <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                                <h4 class="text-success">All Caught Up!</h4>
                                <p class="text-muted">There are no pending user approvals at this time.</p>
                                <a asp-action="Index" class="btn btn-primary">Back to User Management</a>
                            </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Customer Modal -->
<div class="modal fade" id="rejectCustomerModal" tabindex="-1" aria-labelledby="rejectCustomerModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-white">
                <h5 class="modal-title" id="rejectCustomerModalLabel">
                    <i class="fas fa-times-circle me-2"></i>Reject Customer Application
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-action="RejectCustomer" id="rejectCustomerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectUserId" />
                <div class="modal-body">
                    <p>You are about to reject <strong id="rejectBusinessName"></strong>.</p>
                    <div class="mb-3">
                        <label for="rejectionReason" class="form-label">Rejection Reason *</label>
                        <textarea class="form-control" id="rejectionReason" name="rejectionReason" 
                                  rows="3" placeholder="Please provide a reason for rejection..." required></textarea>
                        <small class="form-text text-muted">This reason will be communicated to the customer.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Reject Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Reject Customer Modal
                const rejectCustomerModal = new bootstrap.Modal(document.getElementById('rejectCustomerModal'));
                document.querySelectorAll('.reject-customer-btn').forEach(button => {
                    button.addEventListener('click', function() {
                        const userId = this.getAttribute('data-user-id');
                        const businessName = this.getAttribute('data-business-name');

                        document.getElementById('rejectUserId').value = userId;
                        document.getElementById('rejectBusinessName').textContent = businessName;
                        rejectCustomerModal.show();
                    });
                });

                // Enhanced form submission with loading states
                document.addEventListener('submit', function(e) {
                    if (e.target.matches('form[asp-action="ApproveCustomer"], form[asp-action="RejectCustomer"]')) {
                        const submitBtn = e.target.querySelector('button[type="submit"]');
                        if (submitBtn) {
                            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Processing...';
                            submitBtn.disabled = true;
                        }
                    }
                });
            });
        </script>
}