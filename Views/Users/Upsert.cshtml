@model UserManagementVM
@{
    ViewData["Title"] = Model.UserId == null ? "Create User" : "Edit User";
    var isEdit = !string.IsNullOrEmpty(Model.UserId);
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-6 text-primary">
                    <i class="fas fa-user me-2"></i>@ViewData["Title"]
                </h1>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-circle me-2"></i>User Information
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="Upsert" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="UserId" />

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Basic Information Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-info-circle me-2"></i>Basic Information
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label required"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label required"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label required"></label>
                                <input asp-for="Email" class="form-control" placeholder="Enter email address" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DOB" class="form-label required"></label>
                                <input asp-for="DOB" type="date" class="form-control" />
                                <span asp-validation-for="DOB" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LocationId" class="form-label"></label>
                                <select asp-for="LocationId" asp-items="Model.LocationList" class="form-select">
                                    <option value="">-- Select Location --</option>
                                </select>
                                <span asp-validation-for="LocationId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Role Selection Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-user-tag me-2"></i>Role & Account Settings
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="UserRole" class="form-label required"></label>
                                <select asp-for="UserRole" asp-items="Model.RoleList" class="form-select" id="roleSelect">
                                    <option value="">-- Select Role --</option>
                                </select>
                                <span asp-validation-for="UserRole" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account Status</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsActive" class="form-check-label"></label>
                                </div>
                                <small class="form-text text-muted">Active users can log into the system.</small>
                            </div>
                        </div>

                        <!-- Employee Specific Fields (Conditional) -->
                        <div id="employeeFields" class="row mb-4" style="display: none;">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-briefcase me-2"></i>Employee Details
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EmployeeNumber" class="form-label"></label>
                                <input asp-for="EmployeeNumber" class="form-control" placeholder="EMP001" />
                                <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EmployeeType" class="form-label"></label>
                                <select asp-for="EmployeeType" class="form-select" asp-items="ViewBag.EmployeeTypes">
                                    <option value="">-- Select Employee Type --</option>
                                </select>
                                <span asp-validation-for="EmployeeType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AvailabilityStatus" class="form-label"></label>
                                <select asp-for="AvailabilityStatus" class="form-select">
                                    <option value="Available">Available</option>
                                    <option value="Busy">Busy</option>
                                    <option value="OnLeave">On Leave</option>
                                </select>
                                <span asp-validation-for="AvailabilityStatus" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Customer Specific Fields (Conditional) -->
                        <div id="customerFields" class="row mb-4" style="display: none;">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-store me-2"></i>Business Information
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TradingName" class="form-label required"></label>
                                <input asp-for="TradingName" class="form-control" placeholder="Enter trading name" />
                                <span asp-validation-for="TradingName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessType" class="form-label required"></label>
                                <select asp-for="BusinessType" class="form-select" asp-items="ViewBag.BusinessTypes">
                                    <option value="">-- Select Business Type --</option>
                                </select>
                                <span asp-validation-for="BusinessType" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessEmail" class="form-label"></label>
                                <input asp-for="BusinessEmail" class="form-control" placeholder="business@example.com" />
                                <span asp-validation-for="BusinessEmail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="BusinessPhoneNumber" class="form-label"></label>
                                <input asp-for="BusinessPhoneNumber" class="form-control" placeholder="Business phone number" />
                                <span asp-validation-for="BusinessPhoneNumber" class="text-danger small"></span>
                            </div>

                            <!-- Address Fields -->
                            <div class="col-12 mt-3">
                                <h6 class="border-bottom pb-2 mb-3">Address Information</h6>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AddressLine1" class="form-label required"></label>
                                <input asp-for="AddressLine1" class="form-control" placeholder="Street address" />
                                <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AddressLine2" class="form-label"></label>
                                <input asp-for="AddressLine2" class="form-control" placeholder="Apartment, suite, etc." />
                                <span asp-validation-for="AddressLine2" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Suburb" class="form-label required"></label>
                                <input asp-for="Suburb" class="form-control" placeholder="Suburb" />
                                <span asp-validation-for="Suburb" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="City" class="form-label required"></label>
                                <input asp-for="City" class="form-control" placeholder="City" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="Province" class="form-label required"></label>
                                <input asp-for="Province" class="form-control" placeholder="Province" />
                                <span asp-validation-for="Province" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode" class="form-label required"></label>
                                <input asp-for="PostalCode" class="form-control" placeholder="Postal code" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="VATNumber" class="form-label"></label>
                                <input asp-for="VATNumber" class="form-control" placeholder="VAT number (optional)" />
                                <span asp-validation-for="VATNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Profile Picture Section -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-image me-2"></i>Profile Picture
                                </h5>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ProfileImage" class="form-label"></label>
                                <input asp-for="ProfileImage" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="ProfileImage" class="text-danger small"></span>
                                <small class="form-text text-muted">Upload a profile picture (JPEG, PNG, GIF)</small>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Current Picture</label>
                                <div>
                                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                    {
                                        <img src="@Model.ProfilePictureUrl" class="rounded" style="max-width: 100px; max-height: 100px;" alt="Current profile picture" />
                                    }
                                    else
                                    {
                                        <div class="text-muted">No profile picture set</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save me-2"></i>@(isEdit ? "Update User" : "Create User")
                                    </button>
                                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>

                                    @if (isEdit)
                                    {
                                        <div class="ms-auto">
                                            <button type="button" class="btn btn-outline-warning" id="resetPasswordBtn">
                                                <i class="fas fa-key me-2"></i>Reset Password
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleSelect = document.getElementById('roleSelect');
            const employeeFields = document.getElementById('employeeFields');
            const customerFields = document.getElementById('customerFields');
            const resetPasswordBtn = document.getElementById('resetPasswordBtn');

            function toggleRoleSpecificFields() {
                const selectedRole = roleSelect.value;

                // Hide all fields first
                employeeFields.style.display = 'none';
                customerFields.style.display = 'none';

                // Show relevant fields based on role
                if (selectedRole.includes('Employee') ||
                    selectedRole === 'Administrator' ||
                    selectedRole === 'CustomerSupport' ||
                    selectedRole === 'StockController' ||
                    selectedRole === 'MaintenanceTechnician' ||
                    selectedRole === 'FaultTechnician') {
                    employeeFields.style.display = 'block';
                } else if (selectedRole === 'Customer') {
                    customerFields.style.display = 'block';
                }
            }

            // Initial toggle based on current role
            toggleRoleSpecificFields();

            // Add event listener for role changes
            if (roleSelect) {
                roleSelect.addEventListener('change', toggleRoleSpecificFields);
            }

            // Reset password functionality
            if (resetPasswordBtn) {
                resetPasswordBtn.addEventListener('click', function() {
                    if (confirm('Are you sure you want to reset this user\'s password? A temporary password will be generated.')) {
                        // You can implement AJAX call here or redirect to reset action
                        window.location.href = '@Url.Action("ResetPassword", "Users")' + '?id=@Model.UserId';
                    }
                });
            }

            // Date validation for DOB (must be 18+ years)
            const dobInput = document.querySelector('input[asp-for="DOB"]');
            if (dobInput) {
                dobInput.addEventListener('change', function() {
                    const dob = new Date(this.value);
                    const today = new Date();
                    const age = today.getFullYear() - dob.getFullYear();

                    if (age < 18) {
                        alert('User must be at least 18 years old.');
                        this.value = '';
                    }
                });
            }

            // Toast notifications for TempData messages
            $(document).ready(function() {
                if ('@TempData["success"]' !== '') {
                    toastr.success('@TempData["success"]', 'Success', {
                        timeOut: 3000,
                        positionClass: 'toast-top-right'
                    });
                }

                if ('@TempData["error"]' !== '') {
                    toastr.error('@TempData["error"]', 'Error', {
                        timeOut: 5000,
                        positionClass: 'toast-top-right'
                    });
                }
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .required::after {
        content: " *";
        color: #dc3545;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .border-bottom {
        border-color: #dee2e6 !important;
    }

    /* Ensure proper spacing for form sections */
    .card-body .row {
        margin-bottom: 1rem;
    }

    /* Style for the form switch */
    .form-check-input:checked {
        background-color: #198754;
        border-color: #198754;
    }
</style>