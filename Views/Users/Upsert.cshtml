@model UserManagementVM
@{
    ViewData["Title"] = ViewBag.Action + " User";
    var isCreate = ViewBag.Action == "Create";
    var isCustomer = Model.UserRole == "Customer";
    var isEmployee = !isCustomer && Model.UserRole != "User";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3 text-primary">
                <i class="fas @(isCreate ? "fa-user-plus" : "fa-user-edit") me-2"></i>@ViewBag.Action User
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">User Management</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Action</li>
                </ol>
            </nav>
        </div>
        <div class="col-auto">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />

        <div class="row">
            <div class="col-lg-8">
                <!-- Basic Information Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-id-card me-2"></i>Basic Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label">First Name *</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label">Last Name *</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email Address *</label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DOB" class="form-label">Date of Birth</label>
                                <input asp-for="DOB" type="date" class="form-control" />
                                <span asp-validation-for="DOB" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserRole" class="form-label">User Role *</label>
                                <select asp-for="UserRole" asp-items="Model.RoleList" class="form-select" id="roleSelect">
                                    <option value="">-- Select Role --</option>
                                </select>
                                <span asp-validation-for="UserRole" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Role-Specific Information -->
                <div id="employeeSection" class="card border-0 shadow-sm mb-4" style="display: none;">
                    <div class="card-header bg-info text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-id-badge me-2"></i>Employee Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EmployeeNumber" class="form-label">Employee Number</label>
                                <input asp-for="EmployeeNumber" class="form-control" />
                                <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmployeeType" class="form-label">Employee Type</label>
                                <select asp-for="EmployeeType" asp-items="ViewBag.EmployeeTypes" class="form-select">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="EmployeeType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AvailabilityStatus" class="form-label">Availability Status</label>
                                <select asp-for="AvailabilityStatus" asp-items="ViewBag.AvailabilityStatuses" class="form-select">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="AvailabilityStatus" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LocationId" class="form-label">Work Location</label>
                                <select asp-for="LocationId" asp-items="ViewBag.LocationList" class="form-select">
                                    <option value="">-- Select Location --</option>
                                </select>
                                <span asp-validation-for="LocationId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="customerSection" class="card border-0 shadow-sm mb-4" style="display: none;">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-store me-2"></i>Business Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BusinessName" class="form-label">Business Name *</label>
                                <input asp-for="BusinessName" class="form-control" />
                                <span asp-validation-for="BusinessName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BusinessType" class="form-label">Business Type</label>
                                <select asp-for="BusinessType" asp-items="ViewBag.BusinessTypes" class="form-select">
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="BusinessType" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BusinessEmail" class="form-label">Business Email</label>
                                <input asp-for="BusinessEmail" type="email" class="form-control" />
                                <span asp-validation-for="BusinessEmail" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BusinessPhoneNumber" class="form-label">Business Phone</label>
                                <input asp-for="BusinessPhoneNumber" class="form-control" />
                                <span asp-validation-for="BusinessPhoneNumber" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Address Information -->
                <div id="addressSection" class="card border-0 shadow-sm mb-4" style="display: none;">
                    <div class="card-header bg-secondary text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-map-marker-alt me-2"></i>Address Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="StreetAddress" class="form-label">Street Address</label>
                                <input asp-for="StreetAddress" class="form-control" />
                                <span asp-validation-for="StreetAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Suburb" class="form-label">Suburb</label>
                                <input asp-for="Suburb" class="form-control" />
                                <span asp-validation-for="Suburb" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">City</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Province" class="form-label">Province</label>
                                <input asp-for="Province" class="form-control" />
                                <span asp-validation-for="Province" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PostalCode" class="form-label">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <!-- Actions Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0">
                            <i class="fas fa-cog me-2"></i>Actions
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-save me-1"></i>@ViewBag.Action User
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                        </div>
                    </div>
                </div>

                <!-- User Status Card -->
                @if (!isCreate)
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-info text-white py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>User Status
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Account Status</label>
                                <div>
                                    @if (!Model.IsDeleted)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Created</label>
                                <div class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Last Updated</label>
                                    <div class="text-muted">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            }
                            @if (Model.LastLoginDate.HasValue)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Last Login</label>
                                    <div class="text-muted">@Model.LastLoginDate.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Quick Actions Card -->
                @if (!isCreate)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-warning text-white py-3">
                            <h5 class="mb-0">
                                <i class="fas fa-bolt me-2"></i>Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <form method="post" action="@Url.Action("ResetPassword", new { id = Model.UserId })"
                                      onsubmit="return confirm('Reset password for @Model.Email?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-info w-100 mb-2">
                                        <i class="fas fa-key me-1"></i>Reset Password
                                    </button>
                                </form>

                                <form method="post" action="@Url.Action("ToggleStatus", new { id = Model.UserId })"
                                      onsubmit="return confirm('Are you sure you want to @(!Model.IsDeleted ? "suspend" : "activate") this user?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(!Model.IsDeleted ? "btn-outline-warning" : "btn-outline-success") w-100">
                                        <i class="fas @(!Model.IsDeleted ? "fa-pause" : "fa-play") me-1"></i>
                                        @(!Model.IsDeleted ? "Suspend User" : "Activate User")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            const employeeSection = document.getElementById('employeeSection');
            const customerSection = document.getElementById('customerSection');
            const addressSection = document.getElementById('addressSection');

            function toggleSections() {
                const selectedRole = roleSelect.value;

                // Hide all sections first
                employeeSection.style.display = 'none';
                customerSection.style.display = 'none';
                addressSection.style.display = 'none';

                // Show relevant sections based on role
                if (selectedRole === 'Customer') {
                    customerSection.style.display = 'block';
                    addressSection.style.display = 'block';
                } else if (selectedRole && selectedRole !== 'User') {
                    employeeSection.style.display = 'block';
                }
            }

            // Initial toggle
            toggleSections();

            // Add event listener for role changes
            roleSelect.addEventListener('change', toggleSections);

            // Form validation
            const form = document.querySelector('form');
            form.addEventListener('submit', function(e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    </script>
}