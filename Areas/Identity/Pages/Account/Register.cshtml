@page
@model Project.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_CustomerLayout";

    bool isAdmin = User.IsInRole("Admin");
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <div class="card-header bg-primary text-light py-4 text-center">
                <h2 class="text-white mb-1"><i class="bi bi-person-plus me-2"></i>Create a new account</h2>
                <p class="text-light mb-0 opacity-75">Join SmartChill Solutions today!</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personal Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                                        <label asp-for="Input.FirstName">First Name*</label>
                                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                                        <label asp-for="Input.LastName">Last Name*</label>
                                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.CellNumber" class="form-control" placeholder="Phone Number" />
                                        <label asp-for="Input.CellNumber">Phone Number*</label>
                                        <span asp-validation-for="Input.CellNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Business Document Section - Only show for Customers -->
                            <div id="documentSection" class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Document Upload</h5>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="Input.BusinessDocument" class="form-label fw-semibold">
                                            Business Proof Document
                                            <span id="documentRequired" style="color: red;">*</span>
                                        </label>
                                        <input asp-for="Input.BusinessDocument" type="file" class="form-control" />
                                        <span asp-validation-for="Input.BusinessDocument" class="text-danger"></span>
                                        <small class="text-muted">
                                            Upload a valid document (PDF, JPG, PNG).
                                            <span id="documentDescription">Required for Customer accounts.</span>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-house me-2"></i>Address Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.StreetAddress" class="form-control" placeholder="Street Address" />
                                        <label asp-for="Input.StreetAddress">Street Address*</label>
                                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.City" class="form-control" placeholder="City" />
                                        <label asp-for="Input.City">City*</label>
                                        <span asp-validation-for="Input.City" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.State" class="form-control" placeholder="State" />
                                        <label asp-for="Input.State">State*</label>
                                        <span asp-validation-for="Input.State" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.PostalCode" class="form-control" placeholder="Postal Code" />
                                        <label asp-for="Input.PostalCode">Postal Code*</label>
                                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>Login Credentials</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control" placeholder="Email" />
                                        <label asp-for="Input.Email">Email*</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>

                                    <!-- Password Fields - Only show for Customer role -->
                                    <div id="passwordSection">
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.Password" class="form-control" placeholder="Password" type="password" />
                                            <label asp-for="Input.Password">Password*</label>
                                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                                        </div>
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" type="password" />
                                            <label asp-for="Input.ConfirmPassword">Confirm Password*</label>
                                        </div>
                                    </div>

                                    <!-- Employee Password Notice - Only show for non-Customer roles -->
                                    <div id="employeePasswordNotice" class="alert alert-info mb-0" style="display: none;">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <strong>Employee Account:</strong> A strong password will be automatically generated and sent to the user's email.
                                    </div>
                                </div>
                            </div>

                            @if (isAdmin)
                            {
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-primary text-light">
                                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Account Type</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <select asp-for="Input.Role" class="form-select" id="roleSelect">
                                                @foreach (var role in Model.Input.RoleList.Where(r => r.Value != SD.CustomerRole))
                                                {
                                                    <option value="@role.Value">@role.Text</option>
                                                }
                                            </select>
                                            <label asp-for="Input.Role">User Role*</label>
                                            <span asp-validation-for="Input.Role" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Hidden field for non-admin users to always set role as Customer -->
                                <input type="hidden" asp-for="Input.Role" value="@SD.CustomerRole" />
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg py-2 fw-semibold">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleSelect = document.getElementById('roleSelect');
            const passwordSection = document.getElementById('passwordSection');
            const employeePasswordNotice = document.getElementById('employeePasswordNotice');
            const documentSection = document.getElementById('documentSection');
            const documentRequired = document.getElementById('documentRequired');
            const documentDescription = document.getElementById('documentDescription');

            function toggleFields() {
                // For non-admin users, always treat as Customer
                const isAdmin = @isAdmin.ToString().ToLower();
                let selectedRole = '@SD.CustomerRole'; // Default to Customer

                if (isAdmin && roleSelect) {
                    selectedRole = roleSelect.value;
                }

                const isCustomer = selectedRole === '@SD.CustomerRole' || selectedRole === '';

                // Show/hide document section
                if (isCustomer) {
                    documentSection.style.display = 'block';
                    documentRequired.style.display = 'inline';
                    documentDescription.textContent = 'Required for Customer accounts.';
                } else {
                    documentSection.style.display = 'none';
                    documentRequired.style.display = 'none';
                    documentDescription.textContent = 'Optional for employee accounts.';
                }

                // Show/hide password fields vs employee notice
                if (!isCustomer) {
                    // Hide visible password fields, show employee notice
                    passwordSection.style.display = 'none';
                    employeePasswordNotice.style.display = 'block';
                } else {
                    // Show visible password fields, hide employee notice
                    passwordSection.style.display = 'block';
                    employeePasswordNotice.style.display = 'none';
                }
            }

            // Initial toggle
            toggleFields();

            // Add event listener for role changes (only for admin users)
            if (roleSelect) {
                roleSelect.addEventListener('change', toggleFields);
            }
        });
    </script>
}