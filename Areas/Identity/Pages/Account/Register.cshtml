@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "_CustomerLayout";

    bool isAdmin = User.IsInRole("Admin"); // Check if logged-in user is Admin
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="card-header bg-primary text-light py-4 text-center">
                <h2 class="text-white mb-1"><i class="bi bi-person-plus me-2"></i>Create a new account</h2>
                <p class="text-light mb-0 opacity-75">Join SmartChill Solutions today!</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personal Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                                        <label asp-for="Input.FirstName">First Name*</label>
                                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                                        <label asp-for="Input.LastName">Last Name*</label>
                                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                    </div>                                
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.CellNumber" class="form-control" placeholder="Phone Number" />
                                        <label asp-for="Input.CellNumber">Phone Number*</label>
                                        <span asp-validation-for="Input.CellNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            @* Business Document Upload: only visible if not Admin *@
                            @if (!isAdmin)
                            {
                                <div class="card mb-4 border-0 shadow-sm">
                                    <div class="card-header bg-primary text-light">
                                        <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Business Verification</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="mb-3">
                                            <label asp-for="Input.BusinessDocument" class="form-label fw-semibold"></label>
                                            <input asp-for="Input.BusinessDocument" type="file" class="form-control" />
                                            <span asp-validation-for="Input.BusinessDocument" class="text-danger"></span>
                                            <small class="text-muted">Upload a valid document that proves your business (PDF, JPG, PNG).</small>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-house me-2"></i>Address Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.StreetAddress" class="form-control" placeholder="Street Address" />
                                        <label asp-for="Input.StreetAddress">Street Address*</label>
                                        <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.City" class="form-control" placeholder="City" />
                                        <label asp-for="Input.City">City*</label>
                                        <span asp-validation-for="Input.City" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.State" class="form-control" placeholder="State" />
                                        <label asp-for="Input.State">State*</label>
                                        <span asp-validation-for="Input.State" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.PostalCode" class="form-control" placeholder="Postal Code" />
                                        <label asp-for="Input.PostalCode">Postal Code*</label>
                                        <span asp-validation-for="Input.PostalCode" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>Login Credentials</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control" placeholder="Email" />
                                        <label asp-for="Input.Email">Email*</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Password" class="form-control" placeholder="Password" type="password" />
                                        <label asp-for="Input.Password">Password*</label>
                                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm Password" type="password" />
                                        <label asp-for="Input.ConfirmPassword">Confirm Password*</label>
                                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                                @* Role Dropdown: only visible to Admin *@
                                @if (isAdmin)
                                {
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-primary text-light">
                                            <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Account Type</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-floating mb-3">
                                                <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                                                    <option value="">--Select Role--</option>
                                                </select>
                                                <label asp-for="Input.Role">User Role*</label>
                                                <span asp-validation-for="Input.Role" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                          
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="d-grid gap-2 mt-4">
                        <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg py-2 fw-semibold">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
