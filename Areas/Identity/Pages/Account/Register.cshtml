@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header bg-primary text-light py-4 text-center">
                <h2 class="text-white mb-1"><i class="bi bi-person-plus me-2"></i>Create a new account</h2>
                <p class="text-light mb-0 opacity-75">Join SmartChill Solutions today!</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <!-- Left Column - Personal Information -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personal Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First Name" />
                                        <label asp-for="Input.FirstName">First Name*</label>
                                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Last Name" />
                                        <label asp-for="Input.LastName">Last Name*</label>
                                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.DOB" class="form-control" autocomplete="bday" type="date" aria-required="true" />
                                        <label asp-for="Input.DOB">Date of Birth*</label>
                                        <span asp-validation-for="Input.DOB" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" placeholder="Phone Number" />
                                        <label asp-for="Input.PhoneNumber">Phone Number*</label>
                                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>Login Credentials</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                                        <label asp-for="Input.Email">Email*</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                        <label asp-for="Input.Password">Password*</label>
                                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                        <label asp-for="Input.ConfirmPassword">Confirm Password*</label>
                                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- End of left column -->
                        <!-- Right Column - Address Information -->
                        <div class="col-md-6">
                            <div class="card mb-4 border-0 shadow-sm">
                                <div class="card-header bg-primary text-light">
                                    <h5 class="mb-0"><i class="bi bi-house me-2"></i>Address Information</h5>
                                </div>
                                <div class="card-body">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Location.AddressLine1" class="form-control" placeholder="Please enter your street address." required />
                                        <label asp-for="Input.Location.AddressLine1" class="form-label">Address Line 1*</label>
                                        <span asp-validation-for="Input.Location.AddressLine1" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Location.AddressLine2" class="form-control" placeholder="Please enter your street address." />
                                        <label asp-for="Input.Location.AddressLine2" class="form-label">Address Line 2</label>
                                        <span asp-validation-for="Input.Location.AddressLine2" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <select asp-for="Input.Location.Province" class="form-control" required id="provinceSelect">
                                            <option value="">--Select Province--</option>
                                        </select>
                                        <label asp-for="Input.Location.Province" class="form-label">Province*</label>
                                        <span asp-validation-for="Input.Location.Province" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <select asp-for="Input.Location.City" class="form-control" required id="citySelect">
                                            <option value="">--Select City--</option>
                                        </select>
                                        <label asp-for="Input.Location.City" class="form-label">City*</label>
                                        <span asp-validation-for="Input.Location.City" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <select asp-for="Input.Location.Suburb" class="form-control" required id="suburbSelect">
                                            <option value="">--Select Suburb--</option>
                                        </select>
                                        <label asp-for="Input.Location.Suburb" class="form-label">Suburb*</label>
                                        <span asp-validation-for="Input.Location.Suburb" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Location.PostalCode" class="form-control" placeholder="Postal Code will auto-fill" pattern="^\d{4}$" required id="postalCodeInput" />
                                        <label asp-for="Input.Location.PostalCode" class="form-label">Postal Code*</label>
                                        <span asp-validation-for="Input.Location.PostalCode" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            @if (User.IsInRole(SD.AdminRole))
                            {
                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-primary text-light">
                                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Account Type</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <select asp-for="Input.UserRole" asp-items="@Model.Input.RoleList" class="form-select">
                                                <option value="">--Select Role--</option>
                                            </select>
                                            <label asp-for="Input.UserRole">User Role*</label>
                                            <span asp-validation-for="Input.UserRole" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div> <!-- End of right column -->
                    </div> <!-- End of row -->

                    <div class="d-grid gap-2 mt-4">
                        <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg py-2 fw-semibold">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </button>
                    </div>
                </form>
            </div> <!-- End of card-body -->
        </div> <!-- End of card -->
    </div> <!-- End of col-md-10 -->
</div> <!-- End of row -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .card {
            border: none;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
        }

        .card-header {
            background: linear-gradient(135deg, #008cba 0%, #008cba 100%);
            border-bottom: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #008cba 0%, #008cba 100%);
            border: none;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 0.5rem 1.5rem rgba(13, 110, 253, 0.3);
            }
    </style>
    <script>
        // South African Provinces
        const provinces = [
            "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal",
            "Limpopo", "Mpumalanga", "North West", "Northern Cape", "Western Cape"
        ];

        // Cities and their suburbs (based on your seeded data)
        const citiesData = {
            "Johannesburg": ["CBD", "Sandton"],
            "Gqeberha": ["Walmer"],
            "Cape Town": ["Epping"],
            "Durban": ["Pinetown"],
            "Bloemfontein": ["Westdene"],
            "Mbombela": ["Riverside"],
            "Polokwane": ["Flora Park"],
            "Rustenburg": ["Bo-dorp"],
            "Kimberley": ["Monument Heights"]
        };

        // Populate Province dropdown
        const provinceSelect = document.getElementById('provinceSelect');
        provinces.forEach(province => {
            const option = document.createElement('option');
            option.value = province;
            option.textContent = province;
            provinceSelect.appendChild(option);
        });

        // When province changes, populate cities
        provinceSelect.addEventListener('change', function() {
            const citySelect = document.getElementById('citySelect');
            const suburbSelect = document.getElementById('suburbSelect');

            // Clear previous options
            citySelect.innerHTML = '<option value="">--Select City--</option>';
            suburbSelect.innerHTML = '<option value="">--Select Suburb--</option>';

            // Enable city selection
            citySelect.disabled = false;

            // Filter cities based on selected province (you can enhance this logic)
            Object.keys(citiesData).forEach(city => {
                const option = document.createElement('option');
                option.value = city;
                option.textContent = city;
                citySelect.appendChild(option);
            });
        });

        // When city changes, populate suburbs
        document.getElementById('citySelect').addEventListener('change', function() {
            const suburbSelect = document.getElementById('suburbSelect');
            const selectedCity = this.value;

            // Clear previous options
            suburbSelect.innerHTML = '<option value="">--Select Suburb--</option>';

            if (selectedCity && citiesData[selectedCity]) {
                // Enable suburb selection
                suburbSelect.disabled = false;

                // Populate suburbs
                citiesData[selectedCity].forEach(suburb => {
                    const option = document.createElement('option');
                    option.value = suburb;
                    option.textContent = suburb;
                    suburbSelect.appendChild(option);
                });
            }
        });

        // Auto-fill postal code based on suburb selection (you can extend this)
        document.getElementById('suburbSelect').addEventListener('change', function() {
            const postalCodeInput = document.getElementById('postalCodeInput');
            const selectedSuburb = this.value;

            // Simple mapping - extend this with actual postal codes
            const postalCodes = {
                "CBD": "2001",
                "Sandton": "2196",
                "Walmer": "6070",
                "Epping": "7460",
                "Pinetown": "3610",
                "Westdene": "9301",
                "Riverside": "1201",
                "Flora Park": "0700",
                "Bo-dorp": "0299",
                "Monument Heights": "8301"
            };

            if (postalCodes[selectedSuburb]) {
                postalCodeInput.value = postalCodes[selectedSuburb];
            }
        });
    </script>
}