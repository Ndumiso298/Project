@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    header.navbar,
    nav.navbar {
        display: none !important;
    }

    .login-background {
        background-image: url(/Images/LandingPage/PlatForm.jpg);
        background-size: cover;
        background-position: center;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .login-navbar {
        background-color: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        padding: 0.5rem 1rem;
        color: white;
        font-weight: bold;
        display: flex;
        align-items: center;
    }

        .login-navbar a {
            color: white;
            text-decoration: none;
            font-size: 1.3rem;
        }

            .login-navbar a:hover {
                color: #ddd;
            }

    .login-content-wrapper {
        flex-grow: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

    .login-form-container {
        background-color: rgba(255, 255, 255, 0.5);
        padding: 1.5rem 2rem;
        border-radius: 15px;
        box-shadow: 0 0 25px rgba(0, 0, 0, 0.25);
        max-width: 420px; 
        width: 100%;
        backdrop-filter: blur(10px);
    }

    h1, h2 {
        font-size: 1.25rem;
        text-align: center;
        margin-bottom: 0.75rem;
    }

    .form-floating {
        margin-bottom: 0.8rem;
    }

        .form-floating input {
            height: 42px;
            font-size: 0.95rem;
        }

    .form-label {
        font-size: 0.9rem;
    }

    .checkbox {
        font-size: 0.9rem;
        margin-bottom: 0.6rem;
    }

    .btn {
        padding: 0.5rem 1rem;
        font-size: 1rem;
    }

    .text-center a,
    .login-form-container a {
        font-size: 0.9rem;
    }
</style>

<div class="login-background">
    <!-- Transparent minimal navbar -->
    <nav class="login-navbar">
        <a asp-area="" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a>
    </nav>

    <div class="login-content-wrapper">
        <div class="login-form-container">
            <h1>@ViewData["Title"]</h1>
            <form id="account" method="post">
                <h2>Use a local account</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="Email" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="checkbox">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-primary">Log in</button>

                <div class="mt-2 text-center">
                    <p><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a></p>
                    <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
                    <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
