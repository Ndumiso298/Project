@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header text-light py-4 text-center" style="background-color: #008cba;">
                <h2 class="text-white mb-1"><i class="bi bi-key me-2"></i>@ViewData["Title"]</h2>
                <p class="text-light mb-0 opacity-75">Enter your email to reset your password</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email Address*</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-lg py-2 fw-semibold" style="background-color: #008cba; color: white;">
                            <i class="bi bi-envelope me-2"></i>Reset Password
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-0">
                        <a asp-page="./Login" class="text-decoration-none">Return to Login</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <style>
        .card {
            border: none;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
        }

        .btn {
            border: none;
            transition: all 0.3s;
        }

            .btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 0.5rem 1.5rem rgba(0, 140, 186, 0.3);
                background-color: #006687;
                color: white;
            }
    </style>
}
