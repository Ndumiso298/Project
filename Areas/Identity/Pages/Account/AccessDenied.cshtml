@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header text-light py-4 text-center" style="background-color: #dc3545;">
                <h2 class="text-white mb-1">
                    <i class="bi bi-shield-lock-fill me-2"></i>@ViewData["Title"]
                </h2>
                <p class="text-light mb-0 opacity-75">You do not have access to this resource</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-x-circle-fill" style="font-size: 3rem; color: #dc3545;"></i>
                </div>
                <p class="mb-4">
                    If you believe this is an error, please contact your administrator or return to the home page.
                </p>
                <div class="d-grid gap-2">
                    <a asp-page="/Index" class="btn btn-lg py-2 fw-semibold" style="background-color: #dc3545; color: white;">
                        <i class="bi bi-house-door-fill me-2"></i>Return Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
    }

    .btn {
        border: none;
        transition: all 0.3s;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(220, 53, 69, 0.3);
            background-color: #a71d2a;
            color: white;
        }
</style>

