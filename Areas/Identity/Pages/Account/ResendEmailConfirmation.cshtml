@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="card-header text-light py-4 text-center" style="background-color: #008cba;">
                <h2 class="text-white mb-1">
                    <i class="bi bi-envelope-paper me-2"></i>@ViewData["Title"]
                </h2>
                <p class="text-light mb-0 opacity-75">Enter your email to receive a new confirmation link</p>
            </div>

            <!-- Body -->
            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email*</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg py-2 fw-semibold" style="background-color: #008cba; color: white;">
                            <i class="bi bi-send me-2"></i>Resend
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="mb-0">
                        <a asp-page="./Login" class="text-decoration-none">Return to Login</a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border: none;
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
    }

    .btn {
        border: none;
        transition: all 0.3s;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1.5rem rgba(0, 140, 186, 0.3);
            background-color: #006687;
            color: white;
        }
</style>

